  <!--
    Looping alpha pulse for the reading-pane event-icon ring fill.
    Mirrors Native TutorialHighlightBrush (Modules/Native/GUI/Brushes/Tutorial.xml:132-159):
    a Default-state style with AnimationToPlayOnBegin auto-starts a Loop="true"
    animation that keyframes ONLY AlphaFactor. No code, no tick, no size change.
    Warm gold tint (#C89858) matches the ring's static fill colour.
  -->
  <Brush Name="EEChronicleIconGlow">
    <Layers>
      <BrushLayer Name="Default" Sprite="BlankWhiteSquare_9" />
    </Layers>
    <Styles>
      <Style Name="Default" AnimationToPlayOnBegin="IconGlowPulse">
        <BrushLayer Name="Default" Color="#C89858FF" AlphaFactor="0.13" />
      </Style>
    </Styles>
    <Animations>
      <Animation Name="IconGlowPulse" Duration="2.4" Loop="true">
        <AnimationProperty PropertyName="AlphaFactor" LayerName="Default">
          <KeyFrame Time="0.0" Value="0.13" />
          <KeyFrame Time="1.2" Value="0.30" />
          <KeyFrame Time="2.4" Value="0.13" />
        </AnimationProperty>
      </Animation>
    </Animations>
  </Brush>

