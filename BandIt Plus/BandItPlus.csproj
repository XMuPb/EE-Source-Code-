  <!-- Bannerlord holds BandItPlus.dll open while the game runs, so this target fails
       with MSB3027 mid-session. Pass -p:SkipModuleDeploy=true to build and run the
       unit tests without deploying (e.g. while the game is open for testing). -->
  <Target Name="CopyToModule" AfterTargets="Build" Condition="'$(SkipModuleDeploy)' != 'true'">
    <MakeDir Directories="$(ModuleFolder)\bin\Win64_Shipping_Client" />
    <MakeDir Directories="$(ModuleFolder)\ModuleData" />
    <MakeDir Directories="$(ModuleFolder)\ModuleData\Languages\EN" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ModuleFolder)\bin\Win64_Shipping_Client" />
    <Copy SourceFiles="$(TargetDir)$(AssemblyName).pdb" DestinationFolder="$(ModuleFolder)\bin\Win64_Shipping_Client" Condition="Exists('$(TargetDir)$(AssemblyName).pdb')" />
    <Copy SourceFiles="SubModule.xml" DestinationFolder="$(ModuleFolder)" />
    <ItemGroup>
      <ModuleDataFiles Include="ModuleData\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(ModuleDataFiles)" DestinationFolder="$(ModuleFolder)\ModuleData\%(RecursiveDir)" />
    <!-- Wave 4.6.7j: deploy GUI brushes/prefabs to module folder. -->
    <MakeDir Directories="$(ModuleFolder)\GUI\Brushes" />
    <ItemGroup>
      <GuiFiles Include="GUI\**\*.xml" Exclude="GUI\Prefabs\CampInfoPanel.xml;GUI\Prefabs\CampTopLeft.xml" />
    </ItemGroup>
    <Copy SourceFiles="@(GuiFiles)" DestinationFolder="$(ModuleFolder)\GUI\%(RecursiveDir)" Condition="'@(GuiFiles)' != ''" />
  </Target>

