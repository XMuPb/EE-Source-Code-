    <string id="bp_pf_hideoutbanditaipanel_008" text="Определяет размер отряда и ранг бойцов" />
    <string id="bp_pf_hideoutbanditaipanel_009" text="Состав" />
    <string id="bp_pf_hideoutbanditaipanel_010" text="Соотношение родов войск" />
    <string id="bp_pf_hideoutbanditaipanel_011" text="Агрессивность" />
