    <string id="bp_pf_lockpick_001" text="ЦИЛИНДР" />
    <string id="bp_pf_lockpick_002" text="ОТМЫЧКА" />
    <string id="bp_pf_lockpickprompt_001" text="F" />
    <string id="bp_pf_sneakshadowbar_001" text="BANDIT PLUS" />
    <string id="bp_raidbehavior_001" text="Бандиты" />
    <string id="bp_raidbehavior_002" text="Бандиты" />
    <string id="bp_raidbehavior_003" text="Лорд" />
    <string id="bp_raidbehavior_004" text="деревня" />
    <string id="bp_raidbehavior_005" text=" (бонус законника)" />
    <string id="bp_raidbehavior_006" text="Бандиты" />
    <string id="bp_raidbehavior_007" text="ГРАБЯТ сейчас" />
    <string id="bp_raidvillagequest_001" text="отмеченная деревня" />
    <string id="bp_raidvillagequest_002" text="вожак" />
    <string id="bp_raidvillagequest_003" text="отмеченный лорд" />
    <string id="bp_raidvillagequest_004" text="логово" />
    <string id="bp_raidvillagequest_005" text="уговорённое" />
    <string id="bp_raidvillagequest_006" text="жалкие гроши" />
    <string id="bp_raidvillagequest_007" text="{VILLAGE} горит — но не твоей рукой. {CHIEF} отсчитывает {REDUCED_REWARD} четвертью платы, и связь меж вами крепнет на зарубку помельче." />
    <string id="bp_raidvillagequest_008" text="{VILLAGE} горит, и {CHIEF} услышал слова из твоих собственных уст. {REWARD} денаров отсчитаны у костра вожака. Уговор закрыт." />
    <string id="bp_raidvillagequest_009" text="{CHIEF} назвал {VILLAGE}, владение лорда {LORD}, деревней, чьё сожжение закроет старый долг. {REWARD} денаров ждут у костра вожака, когда уговор будет закрыт." />
    <string id="bp_rankbehavior_001" text="Тать" />
    <string id="bp_rankbehavior_002" text="Налётчик" />
    <string id="bp_rankbehavior_003" text="Атаман разбойников" />
    <string id="bp_rankbehavior_004" text="Владыка изгоев" />
    <string id="bp_rankbehavior_005" text="Военачальник бандитов" />
    <string id="bp_rankbehavior_006" text="Бич Калрадии" />
    <string id="bp_rebelsiegehelper_001" text="Вайкос, Король Бандитов" />
    <string id="bp_rebelsiegehelper_002" text="Вайкос" />
    <string id="bp_rebelsiegehelper_003" text="вожаки изгоев без счёта." />
    <string id="bp_siegebehavior_001" text="Безумный Король снова выступает в поход" />
    <string id="bp_siegebehavior_002" text="Перемирие — пока что" />
    <string id="bp_signaturequest_001" text="Дело вожака" />
    <string id="bp_signaturequest_002" text="Вожак" />
    <string id="bp_signaturequest_003" text="Отмеченная колонна" />
    <string id="bp_signaturequest_004" text="Дорога закончила дело прежде, чем ты добрался. Вожак всё равно захочет услышать рассказ." />
    <string id="bp_signaturequest_005" text="Ты взял их монету и ничего не сказал вожаку. Иные счета не закрываются никогда." />
    <string id="bp_slaverprofiles_001" text="Халгар Железный Ошейник" />
    <string id="bp_slaverprofiles_002" text="Торговец пленниками" />
    <string id="bp_slaverprofiles_003" text="Вожак прислал тебя? Хм. Ступай осторожно. Я торгую плотью и сталью — и взвешиваю то и другое, прежде чем довериться." />
    <string id="bp_slaverprofiles_004" text="Что говорит Халгар" />
    <string id="bp_slaverprofiles_005" text="Что слышит Халгар" />
    <string id="bp_slaverprofiles_006" text="Мара Болотная Хитрость" />
    <string id="bp_slaverprofiles_007" text="Родилась в рыбацком клане с топей; разграбила столько имперских обозов, что бросила счёт. Халгар взял её в цепи; она выкупила себя за два сезона и так и осталась." />
    <string id="bp_slaverprofiles_008" text="Халгар опирается на груду ящиков и оглядывает тебя. &quot;Хочешь знать, чем я торгую? Сперва докажи, что годишься к делу. Убей трёх баттанийских командиров дозоров. Приведи мне восемь пленных. Это лёгкое задание.&quot;" />
    <string id="bp_slaverprofiles_009" text="Халгар хмыкает и бросает тебе кошель. &quot;Ты не дрогнул. Хорошо. Ещё поговорим.&quot;" />
    <string id="bp_slaverprofiles_010" text="Халгар роняет имя и число. &quot;На сей раз — сам лорд. Живым. И пять баттанийских голов в придачу. И принеси мне тридцать твёрдой древесины — цепи на деревьях не растут.&quot;" />
    <string id="bp_slaverprofiles_011" text="Халгар кивает. &quot;С тобой стоит водить знакомство. Возьми своё.&quot;" />
    <string id="bp_slaverprofiles_012" text="Халгар долго смотрит на тебя. &quot;Последняя проверка. Убей десятерых из ихних. Восемнадцать возьми живыми. Захвати лорда. И пятьдесят твёрдой древесины. После этого я покажу, что держу на самом деле.&quot;" />
    <string id="bp_slaverprofiles_013" text="Халгар откидывает люк в полу. &quot;Вниз. Тебе стоит на неё взглянуть.&quot;" />
    <string id="bp_slaverprofiles_014" text="Когда-то сам сидел в цепях в зерновом погребе вельможи {CULTURE_BAT}; выбрался тяжкой ценой и с тех пор не давал ни себе, ни другим забыть, что монета делает с человеком." />
    <string id="bp_slaverprofiles_015" text="Халгар откидывает люк. Первым поднимается запах — сырая земля, прелая солома, люди. Пять свечей горят в глиняных плошках, отбрасывая длинные тени от клеток. Купец {CULTURE_BAT} в цепях поднимает взгляд; глаза его устали так, как не исправить никаким отдыхом. Дочь сержанта {CULTURE_VLA} сидит на тюфяке, подтянув колени. Халгар кивает на третью клетку в глубине, скрытую за подвешенным плащом. &quot;Эту я держу для платящих гостей,&quot; говорит он. &quot;Тебе до неё ещё далеко.&quot;" />
    <string id="bp_slaverprofiles_016" text="Ты спросил. Большинство не спрашивает. Большинство глядит на клетки и уже всё решило, и уходит, зажав свою жалость под мышкой, как каравай, за который заплатило. Садись. Ремесло платит человеку то, что ему и так задолжали, а я расскажу, как я пришёл собирать долг.&#10;&#10;Был когда-то в Баттании один вельможа — жирный в поясе, жирный в голосе, — что бросил меня в зерновой погреб с цепью через ключицу за цену краденого вола. Четыре месяца. Внизу многому учишься. Учишься, что голод — это своего рода часы. Учишься очертаниям собственных рёбер под рубахой. Учишься, что человек с ключом — всего лишь человек с ключом, а ключи можно отнять, если ты терпелив и петля достаточно стара. Я выбрался тяжкой ценой. А вельможу оставил в погребе со своей цепью.&#10;&#10;После того я попробовал честные дороги. Подмастерье кузнеца, погонщик, возчик при обозе {CULTURE_VLA}. Монета шла скудно, а уходила и того скуднее, и у каждого лорда, которому я кланялся, была та же сальная ухмылка, что и у того, в погребе. Так я перестал кланяться. Я срезал ремень с повозки работорговца под &lt;span style=&quot;BandItPlus.Place&quot;&gt;Пен Канноком&lt;/span&gt; и купил свои первые три души на то, что лежало в сундуке под ней. Вот тот счёт, что я начал. С тех пор его и веду.&#10;&#10;Я не говорю себе, что я добрый человек. Доброта — монета, что я истратил там, во тьме, и назад не выручил. Что я есть — так это честен насчёт веса. Человек в цепях есть человек в цепях — я был им, я продаю его, железу всё равно, на чьей шее оно сидит. Ремесло платит, потому что на нём стоит весь мир, друг. Лорды просто прячут свои погреба лучше моего.&#10;&#10;Вот что меня сюда привело. Погреб, цепь, петля, что подалась. Иные выходят из тьмы и зарекаются. Я вышел из тьмы, узнал ей цену и теперь эту цену беру. Не делай удивлённого лица. Ты сам спросил." />
    <string id="bp_slaverprofiles_017" text="Дорога на &lt;span style=&quot;BandItPlus.Place&quot;&gt;Брионну&lt;/span&gt; нынче жирна. Повозки с шерстью {CULTURE_VLA} идут на восток с четырьмя стражниками, порой с тремя, а возчики пьют на последней станции перед лесом. Один мой человек в прошлую луну обчистил две такие повозки — возчиков оставил, а верховых охранников продал литейщику в &lt;span style=&quot;BandItPlus.Place&quot;&gt;Галенде&lt;/span&gt;, что не задаёт вопросов о вырванном языке. Та литейная берёт исправно. Платит серебром, не обещаниями, и любит товар помоложе — чтоб выдержал у мехов десять зим.&#10;&#10;&lt;span style=&quot;BandItPlus.Name&quot;&gt;Лорд Каладог&lt;/span&gt; из Волчьих Шкур теряет людей. Его дружина крепко потрёпана у брода Ллугви, и он оттянул дозоры на север зализывать рану, так что южные тропы меж &lt;span style=&quot;BandItPlus.Place&quot;&gt;Пен Канноком&lt;/span&gt; и низинными деревнями стоят открытыми. Девка {CULTURE_BAT} одна на тех тропах — это монета, что ходит на двух ногах. Я взял троих за этот сезон с того участка, а вожак так и не выслал ни единого всадника справиться о них. Лорд, что не умеет считать собственных пахарей, — лорд, которого я тихо благодарю.&#10;&#10;Есть барыга-работорговец {CULTURE_KHU}, промышляющий из &lt;span style=&quot;BandItPlus.Place&quot;&gt;Саналы&lt;/span&gt;, зовёт себя Ерланом. Берёт партиями по пять и больше, платит ниже рынка, зато сбывает товар на восток прежде, чем явится хоть один всадник клана. Я имел с ним дело дважды. Во второй раз он попытался недодать мне по денару с головы, и я сломал его двоюродному брату руку об стол — после того сочлись честно. Коли у тебя есть тела, что надо сбыть быстро, и высшая цена тебе не важна — он твоя дорога. А коли хочешь полную цену — езжай лучше в Эпикротею; тамошние арены до сих пор платят старым золотом и не торгуются из-за зубов.&#10;&#10;Поговаривают, лесные обозы {CULTURE_STU}, идущие вниз от &lt;span style=&quot;BandItPlus.Place&quot;&gt;Варчега&lt;/span&gt;, нынче тянут жидкую охрану — война на севере сожрала их наёмные мечи. Две телеги, шесть стражей, по большей части пьяные юнцы с копьями, что и держать-то не умеют. Человек с двадцатью клинками да тихий лес — и можно за полдня взять один такой обоз и уйти с тремя плотниками и мастером-лучником на вес золота. Плотники идут вдвое дороже у крепостей {CULTURE_ASE}, что отстраивают свои ворота. Я бы и сам взялся, кабы уже не сидел на товаре.&#10;&#10;И последнее. По холмам {CULTURE_BAT} бродит захожий поп, из деревни в деревню, скупает закованных и отпускает на волю — платит монетой, что выклянчивает у купцов {CULTURE_VLA}. Сентиментальный дурак, но его монета в ходу не хуже прочей. Я продал ему на той неделе старика, что всё равно бы не пережил дороги. Он поблагодарил. Я взял серебро. Ремеслу всё равно, через чью руку оно проходит, — важно лишь, чтоб рука была открыта." />
    <string id="bp_slaverprofiles_018" text="Скрег Одноухий" />
    <string id="bp_slaverprofiles_019" text="Хозяин ям" />
    <string id="bp_slaverprofiles_020" text="Был ничьим сыном; продал родного брата и больше о том не заикался. Торгует отчаявшимися." />
    <string id="bp_slaverprofiles_021" text="Вожак пустил тебя сюда? Дерзко. Постарайся не залить пол кровью." />
    <string id="bp_slaverprofiles_022" text="Скрег ведёт тебя вниз по лестнице, вырубленной в голой земле. Три ямы, крышки из покоробленных досок. Во второй что-то шевелится. Он не говорит, что. Четвёртая яма пуста — &quot;Эта твоя, коли перестанешь быть полезен,&quot; говорит он, и не шутит." />
    <string id="bp_slaverprofiles_023" text="Что говорит Скрег" />
    <string id="bp_slaverprofiles_024" text="Хочешь историю? Дешёвый вопрос. Ответ ещё дешевле. Я был ничьим сыном. Мать моя померла на дороге, и дорога ради неё не остановилась. Я рано усвоил, что тело стоит лишь того, что за него дадут, а в иные дни это меньше краюхи хлеба.&#10;&#10;Был у меня когда-то брат. Младший. Плакал он легче меня — то есть плакал вообще. Прошёл через наши края караван с пустыми клетками и полным кошелём, и я сам отвёл его к клетке. Сказал, что это игра. Взял монету. Купил хлеба, нож и место у огня, где моего лица никто не знал. С тех пор ни разу не произнёс его имени вслух. И ради тебя не произнесу.&#10;&#10;После того ремесло стало простым. Яма не просила ничего, чего я уже не отдал. Я выучил приметы — тех, кто бежит, тех, кто дерётся, тех, кто затихает и ждёт смерти. Тихие идут лучше всех. Особливо {CULTURE_EMP}. Их растили в вере, что кто-нибудь за ними придёт, оттого они и в клетке держат зубы целыми и спину прямой. Прямая спина — это серебро на цепи.&#10;&#10;Я это не люблю. И не ненавижу. Кто ненавидит своё дело, тот пропивает монету и кончает в собственных цепях. Я веду счёт. Я держу клетки. Я не даю дороге вернуться за мной так, как она вернулась за моей матерью. Вот что вводит человека в это ремесло — не жадность, не жестокость. Дорога. Дорога всегда за спиной, и единственное, что отдаляет тебя от неё, — чужая шея под твоей рукой.&#10;&#10;Ну вот. Ты спросил. Теперь встань с пола и скажи, за чем пришёл." />
    <string id="bp_slaverprofiles_025" text="Весть с дороги" />
    <string id="bp_slaverprofiles_026" text="Караваны {CULTURE_EMP} последние недели ходят по южной дороге от &lt;span style=&quot;BandItPlus.Place&quot;&gt;Амитатиса&lt;/span&gt;. Охрана жидкая. Сенат ныне платит обещаниями, а капитан, которому платят обещаниями, нанимает меньше копий. В прошлую луну я снял с той дороги трёх погонщиков. Двое пошли в яму. Одного продал целиком человеку, что не назвал своего имени.&#10;&#10;Есть вельможа из &lt;span style=&quot;BandItPlus.Place&quot;&gt;Фикаона&lt;/span&gt;, что потерял брата из-за бандитов и с тех пор не спит. Ездит с шестью людьми, и горе делает его глупым. Горе да тяжёлый кошель — мне доводилось видеть их на одном коне. Будь у хозяина ям честолюбие — тот ездит один мимо расколотого верстового камня каждый третий день на закате. Я лишь передаю, что говорит дорога.&#10;&#10;Разих покупает тихо. Торговля плотью там идёт через задворки дубильни — стучишь дважды, говоришь слово *соль*, не глядишь на людей в углу. Платят дирхемами, на вес, не счётом. Дубильщика называть не стану. Кто называет дубильщиков — кончает в дубильне.&#10;&#10;Есть новичок на восточном участке. Кличет себя Веллигом, говорит, был-де когда-то караван-мастером. Враньё. Он чей-то лордский ублюдок, что выучил ремесло за неделю и мнит, будто цепи — это верёвки. Он купил у меня в прошлом месяце девку {CULTURE_BAT} за полцены, и я ему позволил, ибо дурак с монетой — лучший покупатель, о каком может мечтать хозяин ям. К жатве он будет мёртв. Его монета — нет.&#10;&#10;{CULTURE_KHU} движутся к югу от &lt;span style=&quot;BandItPlus.Place&quot;&gt;Одоха&lt;/span&gt;, и степи пустеют — семьи пастухов на дороге, ни единого копья меж ними, лишь старик да мальчишка. Это не торговля, это жатва. Я беру, что даёт дорога. Тому меня научил брат, хоть и не хотел." />
    <string id="bp_slaverprofiles_027" text="Друст Резаное Лёгкое" />
    <string id="bp_slaverprofiles_028" text="Однажды пережил повешение, и следы от верёвки так и не сошли." />
    <string id="bp_slaverprofiles_029" text="Три пса {CULTURE_EMP}. Шесть пленных. Лёгкая работа для новой руки." />
    <string id="bp_slaverprofiles_030" text="Скрег дважды пересчитывает твою монету. Всё равно платит." />
    <string id="bp_slaverprofiles_031" text="Имя этого — на бумаге. Живым. Ещё пять тел. Двадцать твёрдой древесины на клетки." />
    <string id="bp_slaverprofiles_032" text="Скрег одобрительно хмыкает." />
    <string id="bp_slaverprofiles_033" text="Последнее. Десять мёртвых, пятнадцать живых, захваченный лорд, сорок твёрдой древесины." />
    <string id="bp_slaverprofiles_034" text="Скрег отпирает погреб." />
    <string id="bp_slaverprofiles_035" text="Волк Каменный Язык" />
    <string id="bp_slaverprofiles_036" text="Горный Ходок" />
    <string id="bp_slaverprofiles_037" text="Однажды в одиночку удержал перевал против трёх караванов; выжившие и дали ему прозвище. Он торгует людьми, потому что скот дешевле." />
    <string id="bp_slaverprofiles_038" text="Хм. Человек вожака. Здесь, внизу, мы доверяем нелегко. Покажи работу." />
    <string id="bp_slaverprofiles_039" text="Погреб вырублен в самой горе, холодный даже летом. Пленники Волка жмутся друг к другу в мехах — он держит их в живых лучше многих, ибо мёрзлое мясо идёт дешевле. Тан {CULTURE_STU}, прикованный в глубине, узнаёт тебя; коротко кивает. Он ведёт счёт дням. Волк делает вид, что не замечает этого счёта." />
    <string id="bp_slaverprofiles_040" text="Арифметика Горного Ходока" />
    <string id="bp_slaverprofiles_041" text="Сперва меня взял перевал. Три каравана поднялись по дороге той зимой, а на скалах был лишь один клинок — мой. Я держал теснину два дня. Когда выжившие выползли, они дали мне прозвище — Каменный Язык — потому что я не говорил об условиях, лишь считал мёртвых.&#10;&#10;После того работа стала простой. Человек узнаёт, что его руки делают лучше всего, а мои ломают строй там, где он гнётся. Я попробовал скот на один сезон — козы, пара мулов — и счёт вышел тощий. Скотина проедает снег и дохнет на склоне. А закованный человек сам сходит вниз к покупателю и несёт на себе свой вес в монете.&#10;&#10;Оттого я торгую людьми. По большей части {CULTURE_STU}. Они лезут на эти перевалы, думая, будто холод их знает. Холод не знает ничего. Я знаю холод. Я снимаю их с дороги прежде, чем дорога заберёт их, и гоню на юг, к счёту, что платит серебром, а не байками.&#10;&#10;Хочешь честного куска — за этим нет никакого долга. Ни потерянного брата, ни зарытой жены. Я взглянул на ремесло и увидел, что это такое. Дешевле, чем пасти скот. Тише, чем война. Метка на запястье держится дольше, чем клеймо на шкуре. Вот что вводит человека в это дело. Арифметика да добрый перевал, чтоб держать.&#10;&#10;Теперь покажи работу или ступай вниз по дороге обратно. Мне караваны считать." />
    <string id="bp_slaverprofiles_042" text="Весть с перевала" />
    <string id="bp_slaverprofiles_043" text="Дорога на Варновапол редеет за вторым поворотом. Обозы с шерстью {CULTURE_STU} ходят с четырьмя копьями вместо восьми — тамошний боярин потерял людей от снежной лихорадки и свежих не нанял. Я как-то в одиночку держал перевал против трёх караванов. Четыре копья — это не охрана. Четыре копья — это счёт ртам, что надо заткнуть.&#10;&#10;Есть тан к востоку от &lt;span style=&quot;BandItPlus.Place&quot;&gt;Ревила&lt;/span&gt;, покупает тихо. Имени на открытой дороге не назовёт. Берёт южный товар — {CULTURE_VLA}, {CULTURE_BAT}, всё, что не говорит на языке его палат. Платит старым серебром, тем, о каком никто не спрашивает. Я гоню к нему по два тела в месяц, и счёт остаётся чистым.&#10;&#10;Человек, что кличет себя Ярко, промышляет на Оморском проходе. Зовёт себя торговцем. А он скупщик краденого с дурными цепями и ещё худшими ценами. Коли спустишься через высокие сосны — не продавай ему: он метит товар клеймом на запястье, покупатели про это знают и платят ему за хлопоты меньше. Чище привести их ко мне.&#10;&#10;Поговаривают, княжий сборщик податей поедет к северу от Сибира в следующую луну с жидкой охраной. Двое челядинцев, писарь, сундук с казной. Сундук — меньшая из трёх поживы. Писарь — вот кто стоит цепей: писари грамотны, а грамотный человек идёт вдвое дороже на южных рынках, где нужны счетоводы и не спрашивают, отчего у него в шрамах руки.&#10;&#10;Я торгую людьми, потому что скот дешевле. Это и поныне так. Но цена на кузнеца {CULTURE_STU} только что подскочила на треть с тех пор, как империя снова взялась ковать, и перевалы полны кузнецов, что бредут домой с работы, которой у них больше нет. Приведи мне такого с крепкими запястьями — и оба сытно перезимуем." />
    <string id="bp_slaverprofiles_044" text="Хелька Хребтоходка" />
    <string id="bp_slaverprofiles_045" text="Выбралась из скальной темницы босиком по снегу." />
    <string id="bp_slaverprofiles_046" text="Трое {CULTURE_STU} мёртвыми на перевалах. Шесть пленных. Ступай." />
    <string id="bp_slaverprofiles_047" text="Волк подвигает к тебе мешочек с монетой." />
    <string id="bp_slaverprofiles_048" text="Отмеченный лорд {CULTURE_STU}. Живым. Ещё пять мёртвых. Двадцать мехов на стропы." />
    <string id="bp_slaverprofiles_049" text="Волк ухмыляется." />
    <string id="bp_slaverprofiles_050" text="Двенадцать мёртвых. Пятнадцать живых. Лорд. Пятьдесят мехов." />
    <string id="bp_slaverprofiles_051" text="Волк открывает схрон поглубже." />
    <string id="bp_slaverprofiles_052" text="Баян Железные Поводья" />
    <string id="bp_slaverprofiles_053" text="Резник караванов" />
    <string id="bp_slaverprofiles_054" text="Был конюшонком {CULTURE_KHU}, что видел, как его лорд сжёг родную деревню ради пастбищ. Ныне продаёт {CULTURE_KHU}." />
    <string id="bp_slaverprofiles_055" text="Вожак привёл тебя сюда. Хорошо. Скачи резво, убивай чисто, приноси, что прошу. Тогда и поговорим." />
    <string id="bp_slaverprofiles_056" text="Погреба тут нет — лишь юрта, поставленная поодаль от прочих, обнесённая железными кольями. Внутри шестеро пленных связаны запястье к запястью в круг, как волки стреноживают добычу. Жена вельможи {CULTURE_KHU} не желает встречаться с тобой взглядом; её свадебные косы срезаны и лежат грудой у входа. Баян смотрит, как она смотрит в пол, и молчит." />
    <string id="bp_slaverprofiles_057" text="Счёт Железных Поводьев" />
    <string id="bp_slaverprofiles_058" text="Ты спрашиваешь, что вводит человека в это ремесло. Взгляни на мои руки. Когда-то это были руки конюшонка, мягкие на узде, твёрдые ни в чём. Я чистил меринов моего лорда до восхода и после спал с ними в соломе. Это была жизнь. Чужая жизнь.&#10;&#10;Трава у нашей деревни истощилась одним летом, и мой лорд захотел её для своих табунов. Он спустился по склону с двенадцатью всадниками и факелом. Я смотрел из-за поилки, как мою мать поглотил дым. Смотрел, как отец пошёл за ней следом. Лорд увидел меня, скорчившегося там, и проехал мимо без единого слова — конюшонок не стоит и поворота головы. Вот был урок. Вельможа {CULTURE_KHU} спалит тебя ради травы и к ужину не вспомнит твоего лица.&#10;&#10;Так я взял поводья, которым он меня научил, и обратил их. Всякий караван {CULTURE_KHU}, что пересекает край степи, всякий погонщик с тугим кошелём и лордской печатью на поясе — я срезаю их с дороги и ставлю в цепь. Продаю на юг, продаю на восток, продаю всякому, чья монета не пахнет домом. Те, у кого знатная родня, идут дороже всех. Я веду счёт их клановым меткам и не забыл ни единой.&#10;&#10;Это не месть. Месть — для тех, кто мнит, будто счёт закрывается. Мой не закрывается. Всякая цепь, что я замыкаю на шее {CULTURE_KHU}, — это трава, возвращённая по клинку за раз. Ремесло платит щедро, ибо степь широка, а лордов много, и человек с железными поводьями может скакать долго, прежде чем у него кончатся глотки, чтоб вязать.&#10;&#10;Ты пришёл сюда за монетой и кивком вожака. Хорошо. Приводи мне {CULTURE_KHU} — погонщиков, дозорных, мягкоруких сынков тех, кто ездит под знамёнами, — и мы поговорим подольше. Приведёшь что иное — впустую переведёшь мою солому." />
    <string id="bp_slaverprofiles_059" text="Что Баян слышит на ветру" />
    <string id="bp_slaverprofiles_060" text="Торговая дорога к югу от &lt;span style=&quot;BandItPlus.Place&quot;&gt;Макеба&lt;/span&gt; нынче жирна. Заводные табуны {CULTURE_KHU} идут с летних пастбищ в зимнее становище, и нойон, что владеет ими, шлёт лишь четырёх копейщиков впереди, четырёх позади. Четыре и четыре. Я сам сосчитал их из высокой травы. Конюшонок учится считать людей так же, как другие мальчишки учатся считать звёзды, и я выучился рано.&#10;&#10;&lt;span style=&quot;BandItPlus.Name&quot;&gt;Лорд Месуи&lt;/span&gt; снова ездит пьяным. Его же челядь шепчется о том у колодца в Аксумеле — двое его сыновей погибли в восточных набегах, и теперь он пьёт кумыс до полудня, прежде чем сесть в седло. Его колонна тянется вереницей вдоль излучины реки. Кто не умеет держать строй, тот не удержит и глотки. Возьми его на излучине, а свиту его — под колодку.&#10;&#10;Покупатели меняются. Ортизия сделалась пугливой — слишком много имперских глаз с новым гарнизоном, — зато &lt;span style=&quot;BandItPlus.Place&quot;&gt;Куяз&lt;/span&gt; берёт всё, в чём есть пульс, и имени не спрашивает. Тамошний хозяин ям платит старыми &lt;span style=&quot;BandItPlus.Coin&quot;&gt;денарами&lt;/span&gt;, обрезанными, зато платит в тот же день, как въезжаешь. Есть ещё скупщик {CULTURE_STU}, что промышляет из погреба в &lt;span style=&quot;BandItPlus.Place&quot;&gt;Ревиле&lt;/span&gt; и покупает только женщин {CULTURE_KHU} — ни мужчин, ни детей. Я не спрашиваю, что он с ними делает. И счёт не спрашивает.&#10;&#10;Весть с окраины: некий {CULTURE_VLA} по имени Халгар держит клетку в западных предгорьях и сбивает нам всем цену на треть. Пусть его. Его товар идёт с караванных дорог — мягкие руки, мягкие ноги. Мой идёт со степи. Иное мясо, иной стол. {CULTURE_ASE} из &lt;span style=&quot;BandItPlus.Place&quot;&gt;Куяза&lt;/span&gt; платит степную цену за степную плоть, а западная цепь Халгара так далеко не дотягивается.&#10;&#10;И последнее, слушай. Купеческий караван вышел из Чайканда три дня тому — охрана лёгкая, оси тяжёлые. Тяжёлые оси означают монету, не зерно. Возчик — двоюродный брат ханского податного, а это значит выкуп сверх торговли. Скачи резво, верховых убей чисто, а брата приведи дышащим. Прочих можешь продать или зарыть — мне всё равно, лишь бы счёт закрылся." />
    <string id="bp_slaverprofiles_061" text="Тарса Кровавая Кобыла" />
    <string id="bp_slaverprofiles_062" text="Проскакала на краденом боевом коне {CULTURE_KHU} через два королевства, спасаясь от лорда, за которого не желала идти." />
    <string id="bp_slaverprofiles_063" text="Трое конников {CULTURE_KHU} повержены. Шесть пленных. Простая работа." />
    <string id="bp_slaverprofiles_064" text="Баян бросает кошель." />
    <string id="bp_slaverprofiles_065" text="Лорд {CULTURE_KHU}, живым. Пятеро мёртвых. Двадцать льна на путы." />
    <string id="bp_slaverprofiles_066" text="Баян мрачно кивает." />
    <string id="bp_slaverprofiles_067" text="Двенадцать мёртвых. Пятнадцать живых. Лорд. Пятьдесят льна." />
    <string id="bp_slaverprofiles_068" text="Баян глядит на восток, потом платит." />
    <string id="bp_slaverprofiles_069" text="Хьяльти Солёный Хребет" />
    <string id="bp_slaverprofiles_070" text="Ладейный боцман" />
    <string id="bp_slaverprofiles_071" text="Тянул весло на трёх разных командах. Собрал четвёртую. Продаёт всякого, кого выносит прибой." />
    <string id="bp_slaverprofiles_072" text="Соль в бороде уже завелась? Ха. Докажи, что способен тянуть свой груз." />
    <string id="bp_slaverprofiles_073" text="Погреб Хьяльти — это трюм вытащенной на берег ладьи, поднятой на прибрежную отмель. В трюме несёт смолой, рассолом и человеческими нечистотами. Восемь человек прикованы к килевой балке, всех мутит с морской болезни даже на суше. &quot;Море ломает их быстрее цепей,&quot; говорит Хьяльти. &quot;К тому часу, как продаётся корабль, они рады идти куда угодно, лишь бы пол не качался.&quot;" />
    <string id="bp_slaverprofiles_074" text="Что говорит Ладейный боцман" />
    <string id="bp_slaverprofiles_075" text="На трёх командах я тянул весло, прежде чем сам стал держать верёвку. Первая команда — мне было двенадцать, и боцман сломал мне нос за сбитый гребок. Вторая команда — капитан утопил мальчишку {CULTURE_STU} за бортом за то, что тот рыдал слишком громко. Третья команда — там я постиг всю хитрость: что человек на весле и человек в цепях тянут одно и то же дерево, только одному платят селёдкой, а другому — солёной водой в ноздрях.&#10;&#10;Так я собрал четвёртую команду сам. Купил киль у вдовы в &lt;span style=&quot;BandItPlus.Place&quot;&gt;Ривачеге&lt;/span&gt;, что не спрашивала, куда делся её муж. Половина моей первой добычи была рыбацкими мальчишками {CULTURE_STU}, другая половина — вагирский караван, что мнил, будто прибрежная дорога весной безопасна. Счёт мнений не держит. Счёт держит лишь вес.&#10;&#10;Что вводит человека в это ремесло. Я скажу. Море не платит — оно берёт. Разбой платит на одну зиму и на похороны. А цепь платит дважды. Раз — когда надеваешь её на него, и раз — когда снимаешь на рыночной площади, и кто-то суёт тебе серебро за труды. Вдвое против весла, и стоишь при этом сухим.&#10;&#10;Я продаю всякого, кого выносит прибой. Плащ не важен. {CULTURE_STU}, {CULTURE_BAT}, хоть родного брата, коли он мокрый и дышит. Прибой честен — он отделяет сильных от слабых прежде, чем я хоть пальцем трону. Я лишь жду на берегу с верёвкой да счётом.&#10;&#10;Ты спросил, что вводит человека в дело. Ничто тебя не вводит. Однажды утром просыпаешься на весле и понимаешь, что верёвка у кого-то в руке — так пусть уж будет в твоей. Соль в бороде уже завелась? Тогда ты и сам всё знаешь." />
    <string id="bp_slaverprofiles_076" text="Что Хьяльти слышит с приливом" />
    <string id="bp_slaverprofiles_077" text="Прибрежная дорога {CULTURE_STU} за &lt;span style=&quot;BandItPlus.Place&quot;&gt;Ревилом&lt;/span&gt; нынче жирна. Оттепель пришла поздно, и меховые обозы сгрудились у переправ — двенадцать, пятнадцать телег вереницей, по шесть стражей на каждую, и половина тех стражей — пьяные вагирские юнцы, нанятые впопыхах. В прошлую луну я снял человека с такого каравана. Взял за него восемьдесят &lt;span style=&quot;BandItPlus.Coin&quot;&gt;денаров&lt;/span&gt; в Оморе к закату. Ни вопросов, ни записей. У покупателя есть задняя дверь, что выходит на реку.&#10;&#10;Ополчение &lt;span style=&quot;BandItPlus.Name&quot;&gt;лорда Бакара&lt;/span&gt; ушло на юг гоняться за набегом {CULTURE_KHU}, которого там уже нет. Его северные деревни стоят пусты — старики, рыбачки, поп. Попа не трону. Прочие пойдут в трюм, и никто в &lt;span style=&quot;BandItPlus.Place&quot;&gt;Ревиле&lt;/span&gt; не хватится пропавших, пока лёд не тронется снова. На том же участке промышляет команда из Тиала — Ингвар Холодный Язык, теперь-то он кличет себя капитаном. Платит солью да недовесом. Обходи его стороной, а коли идёшь с ним в море — дели добычу до, а не после.&#10;&#10;Осторожные покупатели этого месяца: скупщик в Варноваполе, что берёт лишь крепкие спины — ни женщин, ни детей, — платит серебром {CULTURE_EMP} и спрашивает, грамотны ли они. Не ври ему; он проверяет. Есть и тихий дом в &lt;span style=&quot;BandItPlus.Place&quot;&gt;Правенде&lt;/span&gt;, за двором дубильщика — берут всякую плоть, что дышит, но цену срезают жёстко, отговариваются, будто указы Империи их пугают. Указы. Ха. Монета всё равно ходит. Только медленнее да через больше рук.&#10;&#10;Чайки доносят, что купеческий обоз {CULTURE_VLA} причалит в Оморе до равноденствия — восемь телег, наёмная охрана, набитые шерстью да сундук казначея. Начальник охраны — некий сэр Роланд, пьёт сверх меры и ставит дозорных у костра, а не поодаль от него. Я бы не брал телеги. Я бы взял обозную челядь да мальчишку при лошадях. Меньше шуму, а к второму городу — та же монета.&#10;&#10;И последнее. Некая женщина {CULTURE_BAT} расспрашивает обо мне по имени в Сибире. Сестра человека, что я продал три зимы назад, или жена — гонец не был уверен. Мне было бы больше дела, будь у неё монета. Её нет. Передай ей, коли она найдёт твой костёр, что Хьяльти в море, а море держит свой счёт запечатанным." />
    <string id="bp_slaverprofiles_078" text="Инга Волнорез" />
    <string id="bp_slaverprofiles_079" text="Доплыла до берега с обломков в кольчуге мёртвого ярла; так её и оставила." />
    <string id="bp_slaverprofiles_080" text="Трое прибрежных лордов {CULTURE_STU}. Шесть пленных. С этого и начни." />
    <string id="bp_slaverprofiles_081" text="Хьяльти сплёвывает и платит." />
    <string id="bp_slaverprofiles_082" text="Лорд {CULTURE_STU} живым. Пятеро мёртвых. Двадцать мехов на невольничий трюм." />
    <string id="bp_slaverprofiles_083" text="Хьяльти скалится гнилыми зубами." />
    <string id="bp_slaverprofiles_084" text="Двенадцать мёртвых. Пятнадцать живых. Лорд. Пятьдесят мехов. А после — уходим в море." />
    <string id="bp_slaverprofiles_085" text="Хьяльти крепко хлопает тебя по плечу." />
    <string id="bp_slaverprofiles_086" text="Юсуф Считающий Соль" />
    <string id="bp_slaverprofiles_087" text="Караванный налётчик" />
    <string id="bp_slaverprofiles_088" text="Однажды в тринадцать был продан с помоста {CULTURE_ASE}. К двадцати пяти выкупил себя обратно. Считает каждую монету." />
    <string id="bp_slaverprofiles_089" text="Слово вожака имеет вес — для него. Сделай так, чтоб и твоё чего-то стоило для меня." />
    <string id="bp_slaverprofiles_090" text="Погреб Юсуфа вырыт глубоко под песком, чтобы не пускать полуденный зной. Пленники сидят на корточках у прохладных глиняных стен и редко поднимают глаза. Он сам обходит их с бурдюком воды — &quot;Они идут дороже, коли не иссохнут,&quot; поясняет он. У дальней стены — деревянный столб, гладко истёртый закованными запястьями. Юсуф рассеянно касается его, проходя мимо. Не говорит, почему." />
    <string id="bp_slaverprofiles_091" text="Чему научила меня соль" />
    <string id="bp_slaverprofiles_092" text="Тринадцать. Такова была цена, что написали рядом с моим именем на помосте {CULTURE_ASE}. Не мои годы — серебро. Торговец из &lt;span style=&quot;BandItPlus.Place&quot;&gt;Куяза&lt;/span&gt; уплатил её, не глядя мне в лицо. Он глядел на мои зубы, мои запястья, на длину моего шага. Тот, кто продал меня, был мой родной дядя. Он дважды пересчитал монеты, прежде чем уйти, и ни разу не обернулся.&#10;&#10;Я простоял на том помосте четыре часа на солёном ветру. Соль въедается в ссадины от верёвки и остаётся там. Годы спустя, когда покупатель сбивает мне цену на динар, я всё ещё чувствую это — то малое белое жжение вдоль запястья, что твердит мне, чего стоит человек, за которого некому вступиться. Так я научился вступаться за себя сам. Научился считать. Всякую монету, что прошла через мою ладонь, я помечал, а всякую монету, что задолжал, помечал дважды.&#10;&#10;Двенадцать лет на то ушло. Двенадцать лет караванной работы, ножевой работы, сидения у костров людей, что не знали моего имени и были тем лучше. В двадцать пять я вернулся к тому же помосту с кошелём, тяжёлым настолько, чтоб купить трёх таких, как я, — и купил одного. Себя. Писарь не признал того мальчишку. Он записал сумму, взял свою долю и спросил, не нужна ли мне расписка. Я и поныне держу её сложенной за поясом.&#10;&#10;После того ремесло было единственным, что имело смысл. Кто был сочтён, тот не забывает счёта. Я не питаю ненависти к цепям — цепи честны. Динар честен. Ненавижу я дядю, что отводит взгляд, покуда серебро переходит из рук в руки, и вот его-то я продать не могу, ибо он уже где-то в пустыне, помер от собственной жажды, как я надеюсь.&#10;&#10;Так ты спрашиваешь, что вводит человека в это ремесло. Скажу тебе прямо. Ремесло вернуло мне отнятое, динар за динар, а после доплатило чуток сверху, и кто был сочтён, тот будет считать, покуда не иссякнет счёт. Приведи мне пленника, что стоит взвешивания, — и мы поговорим. Приди с лёгким кошелём — и не станем." />
    <string id="bp_slaverprofiles_093" text="Что считает Юсуф" />
    <string id="bp_slaverprofiles_094" text="Дорога от &lt;span style=&quot;BandItPlus.Place&quot;&gt;Куяза&lt;/span&gt; на Икбайль нынче скудна. Караваны {CULTURE_ASE} урезали охрану с двенадцати копий до восьми — султанский набор сожрал остальных, а купцы вместо того молятся своим звёздам. Звёзды не остановят кривой клинок в тени бархана. Я беру на третью ночь от колодца в Бахьяте; в этот час погонщики верблюдов спят крепче всего, а луна мала.&#10;&#10;Есть покупатель в &lt;span style=&quot;BandItPlus.Place&quot;&gt;Санале&lt;/span&gt;, носит чистое полотно и имён не спрашивает. Платит серебром, не золотом — дважды пересчитывает каждую монету, прежде чем даст коснуться кошеля. Он мне по нраву. В прошлое новолуние он взял у меня четырёх девок по сорок два &lt;span style=&quot;BandItPlus.Coin&quot;&gt;динара&lt;/span&gt; за голову, и счёт закрылся чисто. Поговаривают, он сбывает их на запад морем, но я не спрашиваю. Кто спрашивает слишком много, того продают дёшево.&#10;&#10;&lt;span style=&quot;BandItPlus.Name&quot;&gt;Лорд Ункид&lt;/span&gt; потерял второго сына от лихорадки и три каравана бандитам в один и тот же сезон, а его знаменосцам не платили с весенних дождей. Его провожатые ходят теперь медленно, глядят больше на песок, чем на окоём. Одна его колонна пройдёт через Хубьярский проход в следующую тёмную луну. Двадцать телег. Шесть стражей. Считай сам.&#10;&#10;Берегись человека по имени Хузайм — кличет себя торговцем солью, но гонит плоть из Даррина через задние ворота, а своим людям платит обещаниями. Двое моих пошли к нему прошлой зимой и вернулись ни с чем, кроме синяков да байки. Ныне я с ним дел не имею. Коли увидишь его караван на южной тропе — бери. О потере он не донесёт; не может.&#10;&#10;Караван-мастера {CULTURE_VLA} — вот мягкая пожива этого сезона: они шагают по нашему песку, будто по отцовскому пастбищу, а их сержанты пьют в полдень. Одного из них я в тринадцать лет продал на тот самый помост, где стоял сам, и я помню его лицо. Пустыня ведёт свой счёт. Я веду свой." />
    <string id="bp_slaverprofiles_095" text="Лейла Присягнувшая Песку" />
    <string id="bp_slaverprofiles_096" text="Семь дней брела через глубокую пустыню в одном лишь краденом купеческом халате." />
    <string id="bp_slaverprofiles_097" text="Трое {CULTURE_ASE} мёртвыми. Шесть пленных. Пустыня научит." />
    <string id="bp_slaverprofiles_098" text="Юсуф взвешивает твой кошель, улыбается." />
    <string id="bp_slaverprofiles_099" text="Лорд {CULTURE_ASE} — живым. Пятеро мёртвых. Двадцать соли на рассольные жбаны." />
    <string id="bp_slaverprofiles_100" text="Юсуф медленно кивает." />
    <string id="bp_slaverprofiles_101" text="Двенадцать мёртвых, пятнадцать живых, лорд. Пятьдесят соли." />
    <string id="bp_slaverprofiles_102" text="Юсуф отдёргивает занавес." />
    <string id="bp_slaverprofiles_103" text="Бранд Обмороженный" />
    <string id="bp_slaverprofiles_104" text="Хозяин льда" />
    <string id="bp_slaverprofiles_105" text="Потерял три пальца из-за невольничьей цепи в зиму {CULTURE_STU} и с тех пор так и не согрелся." />
    <string id="bp_slaverprofiles_106" text="Вожак к тебе потеплел, вот как? А холод — нет. Докажи, чего стоишь." />
    <string id="bp_slaverprofiles_107" text="Погреб — это полумёрзлый ледник, пленники уложены в солому, чтоб дыхание не растрачивало тепло. Бранд ходит меж них, считая пальцы — &quot;Потерял два — цена падает. Потерял четыре — идут псам.&quot; Один из пленников, мальчишка {CULTURE_STU} лет шестнадцати, следит за ним с мёртвым спокойствием того, кто уже перестал быть человеком." />
    <string id="bp_slaverprofiles_108" text="Что купил холод" />
    <string id="bp_slaverprofiles_109" text="Три пальца. Вот что забрала у меня цепь в ту первую зиму. Мне было четырнадцать, я был в невольничьих путах, и железо примёрзло к кости прежде, чем хозяин {CULTURE_STU} заметил, что его товар гниёт на цепи. Он сам отсёк их, на пне у длинного дома, и бросил псам. Я смотрел, как псы едят мои пальцы на снегу. Тогда-то в меня и вошёл холод, и с тех пор не выходил.&#10;&#10;Я тянул цепь ещё шесть зим, прежде чем порвал её. Убил хозяина тем самым ножом, которым он меня кромсал. Шёл на север, покуда не кончились деревья. Ты спрашиваешь, что вводит человека в это ремесло, — я скажу. Не монета. Счёт. Всякая глотка {CULTURE_STU}, что я вскрываю ныне, — это палец, возвращённый назад. Я ещё не досчитал.&#10;&#10;Разбойники нашли меня полумёртвым на льду и поняли, кто я, едва завидев культи. Кто побывал на цепи, тот знает цепь. Я читаю цену невольника по его плечам прежде, чем он раскроет рот. Я знаю, кто сломается за неделю, а кто протянет три сезона. Покупатели на юге платят мне щедро за это знание.&#10;&#10;Порой кто помоложе спрашивает, ненавижу ли я их — {CULTURE_STU}, закованных, покупателей, что ощупывают запястья, прежде чем платить. Я говорю: нет. Ненависть греет человека. А я не был в тепле с тех пор, как псы съели мои пальцы. Это просто работа. Цепь, метка, монета, следующий. Остальное делает холод.&#10;&#10;Так что когда спрашиваешь, что меня сюда привело, друг, взгляни на мою руку. Двух пальцев нет на левой, одного на правой. Каждый куплен {CULTURE_STU}, и каждый я собираю обратно. Медленное ремесло. Терпеливое ремесло. Счёт ведётся." />
    <string id="bp_slaverprofiles_110" text="Что Бранд слышит на ледяной дороге" />
    <string id="bp_slaverprofiles_111" text="Дорога к северу от &lt;span style=&quot;BandItPlus.Place&quot;&gt;Варчега&lt;/span&gt; нынче скудна. Дозоры {CULTURE_STU} стянулись внутрь, стеречь палаты Лорда, и торговая тропа меж двумя деревнями, что я называть не стану, везёт зерновые телеги с четырьмя стражами там, где прошлой зимой было десять. Человек с холодными руками да тихим луком возьмёт возчиков, а волов оставит — волы слишком бросаются в глаза. Я уже снял шестерых с той дороги. Шесть пар рук, что не знают слова «тепло».&#10;&#10;&lt;span style=&quot;BandItPlus.Name&quot;&gt;Лорд Братомир&lt;/span&gt; слёг с раной, что не желает затягиваться. Его хускарлы пьют в длинном доме, а дочь его разъезжает по лесным дорогам с одним присяжным мечом да двумя девками. Больше о том не скажу. Человек с моими пальцами не хвалится до добычи. Но счёт помнит, и кто-нибудь впишет ту строку до оттепели.&#10;&#10;Весть от дубильщика в &lt;span style=&quot;BandItPlus.Place&quot;&gt;Ревиле&lt;/span&gt; — есть за задними воротами покупатель, что платит южным серебром за женщин, которые умеют шить, и мужчин, которые умеют колоть дрова. О метке вопросов нет. Своего скупщика он шлёт во вторую луну, и никогда в один и тот же проулок. Я продал ему двоих в прошлом месяце. Платит медленно, но платит, и на клеймо не косится, как это делают законные рынки.&#10;&#10;По западным перевалам ныне промышляет ватага {CULTURE_BAT}. Кличет себя Куириг или как-то так — покупает дёшево, гонит жёстко, каждого третьего теряет на холоде. Дилетант. Он пересечёт мою дорогу до середины зимы, и тогда мы потолкуем о том, кто таскает невольников из МОЕГО снега. Имперские караваны, что поднимаются от &lt;span style=&quot;BandItPlus.Place&quot;&gt;Правенда&lt;/span&gt;, ходят с охраной потяжелее прежней, да только их дозорные — южные мальчишки. Они не знают, как движется ветер перед бурей. Трое из них замёрзли на той неделе, а четвёртого я взял в цепи, покуда он был ещё тёпел настолько, чтоб идти.&#10;&#10;И последнее — есть скупщик {CULTURE_ASE}, что зимует в потайной гавани к востоку отсюда. Берёт крепкие спины партиями по десять, сбывает на юг, пока лёд не тронулся. Платит монетой, что в ходу где угодно. Я перегоняю к нему свой зимний товар до того, как повернёт луна. Коли есть у тебя невольник, что стоит больше своей краюхи хлеба, — веди его, покуда цена ещё лезет вверх." />
    <string id="bp_slaverprofiles_112" text="Герд Железная Юбка" />
    <string id="bp_slaverprofiles_113" text="Убила ярла рыбацким ножом и осталась жива, чтоб посмеяться." />
    <string id="bp_slaverprofiles_114" text="Трое {CULTURE_STU}. Шесть пленных." />
    <string id="bp_slaverprofiles_115" text="Бранд платит холодным серебром." />
    <string id="bp_slaverprofiles_116" text="Лорд {CULTURE_STU} живым. Пятеро мёртвых. Двадцать мехов." />
    <string id="bp_slaverprofiles_117" text="Бранд предлагает выпить." />
    <string id="bp_slaverprofiles_118" text="Двенадцать мёртвых, пятнадцать живых, лорд, пятьдесят мехов." />
    <string id="bp_slaverprofiles_119" text="Бранд открывает холодный погреб." />
    <string id="bp_slaverprofiles_120" text="Венна из Камышей" />
    <string id="bp_slaverprofiles_121" text="Хозяйка топей" />
    <string id="bp_slaverprofiles_122" text="Утопила своего первого хозяина в трёх футах стоячей воды. С тех пор к сухой земле душа не лежит." />
    <string id="bp_slaverprofiles_123" text="Грязь не лжёт. Принеси мне доказательство, что способен пройти сквозь неё вброд." />
    <string id="bp_slaverprofiles_124" text="Погреб Венны наполовину затоплен — болото сочится снизу, местами по колено. Пленники стоят на помостах из вязаного тростника, лодыжки вечно мокрые. Она ходит по воде босиком, не морщась. &quot;Грязь ломает их волю быстрее цепей,&quot; — говорит она. На дне самой глубокой лужи лежит нечто, о чём Венна не говорит, а пленники не смотрят туда." />
    <string id="bp_slaverprofiles_125" text="Чему Топь Научила Венну" />
    <string id="bp_slaverprofiles_126" text="Мой первый хозяин думал, что стоячая вода безопасна. Он заходил в неё по голень проверять садки на угрей и смеялся надо мной за то, что я держусь тростника. Однажды в сумерках я пошла за ним с той цепью, что он поутру надел мне на горло, и обвила её раз вокруг его шеи, и сидела у него на плечах, пока не перестали идти пузыри. Три фута бурой воды. Собаку не утопить. А ему хватило.&#10;&#10;Я оставила его пиявкам и вышла в его плаще. Цепь оставила себе. Она и поныне висит у моего бедра — то же железо, тот же вес. В тот день я усвоила: топь берёт своё, не спрашивая дважды, а человек, что не умеет читать воду, — уже мертвец, который просто ещё не лёг.&#10;&#10;Ремесло само нашло меня потом. Налётчики {CULTURE_BAT} прошли болотом в поисках олова, а домой отправились в моих колодках, потому что не знали, какая кочка их удержит, а какая — зелёная крышка над шестью футами черноты. Первых троих я продала фактору {CULTURE_STU} за сорок &lt;span style=&quot;BandItPlus.Coin&quot;&gt;денаров&lt;/span&gt; и брусок соли. Сорок &lt;span style=&quot;BandItPlus.Coin&quot;&gt;денаров&lt;/span&gt; — это много верёвки. Верёвка покупает больше людей.&#10;&#10;Сухопутные работорговцы торгуются из-за зубов да плеч. Я торгуюсь из-за лёгких. {CULTURE_BAT}, что провёл ночь прикованным к колу, пока прибывала вода, пойдёт тихо к любому покупателю, перед которым ты его поставишь, — грязь сделала мою работу за меня. Вот что вводит человека в это ремесло, друг. Найти ту единственную вещь, что мир дал тебе даром, и научиться её продавать.&#10;&#10;Ты спросил прямо — я прямо и ответила. Теперь покажи, что можешь встать там, где стою я, и не утонуть, или уводи свои сапоги обратно на дорогу." />
    <string id="bp_slaverprofiles_127" text="Что Венна Слышит в Тростниках" />
    <string id="bp_slaverprofiles_128" text="Болотные тропы разносят вести не хуже сухих. Путники останавливаются у моих тростниковых хижин, потому что гать заливает дважды в месяц, а мокрый человек торгуется дёшево. Я сижу за столом, наливаю мутного пива и слушаю. Они забывают, что баба в углу — та самая, что к закату обмеряет им запястья.&#10;&#10;В двух долинах к северу есть тан {CULTURE_BAT} — Мабриг, зовёт себя лордом, — что истекает дружиной в распре с собственным двоюродным братом. По его западным тропам теперь ходят по трое стражей, по четверо в праздник. На прошлой неделе прошёл караван с солёной данью его брата, и я приметила колеи. Груз лёгкий, страху много. Тот, у кого двадцать луков, взял бы его, не повысив голоса. Я взяла бы сама, да предпочитаю товар, что ходит и дышит.&#10;&#10;Городок Ллингарт покупает тишину. Их староста прислал человека к краю болота в простой шерсти, и тот расспрашивал меня про крепкие спины — без наколок, без выбитых зубов, про рты, что не заорут на торгу. Он платил доброе серебро и скверную ложь. У их кузни заказов больше, чем свободных рук, а цеховые старшины не хотят, чтобы это писали в какой-либо счёт. Троих я уже отправила. Возьмут ещё.&#10;&#10;Говорят, некий {CULTURE_STU} по имени Ярвик работает в верхних топях, сбивает цену на баб. Платит мехами — значит, гонит их на восток, пока не закрылись снежные дороги. Я не завидую человеку в его ремесле, но он забрал девку из деревни, что я уже приметила, а долг в болотах платят стоячей водой. Он найдёт меня, или я его. Тростники ведут счёт.&#10;&#10;По старой гати к побережью движется колонна {CULTURE_VLA} — паломники, зовут они себя, да только паломники не таскают сундуков, что кренят телегу. Двенадцать стражей, все косятся по сторонам. Станут лагерем у сухих камней в Фрильдай, потому что больше негде, а сухие камни ко второй страже сидят в трёх футах чёрной воды. Однажды я утопила человека в трёх футах. Хватило." />
    <string id="bp_slaverprofiles_129" text="Аэрвен Чёрный Угорь" />
    <string id="bp_slaverprofiles_130" text="К шестнадцати знала каждую протоку между &lt;span style=&quot;BandItPlus.Place&quot;&gt;Правендом&lt;/span&gt; и морем." />
    <string id="bp_slaverprofiles_131" text="Трое {CULTURE_BAT} мертвы. Шесть пленников." />
    <string id="bp_slaverprofiles_132" text="Венна молча считает монеты." />
    <string id="bp_slaverprofiles_133" text="Лорд {CULTURE_BAT} жив. Пятеро мёртвых. Двадцать твёрдой древесины." />
    <string id="bp_slaverprofiles_134" text="Венна слегка улыбается." />
    <string id="bp_slaverprofiles_135" text="Двенадцать мёртвых, пятнадцать живых, лорд, пятьдесят твёрдой древесины." />
    <string id="bp_slaverprofiles_136" text="Венна ведёт тебя вниз." />
    <string id="bp_slaverprofiles_137" text="Ардвад Пряжкорез" />
    <string id="bp_slaverprofiles_138" text="Дорожный Мытарь" />
    <string id="bp_slaverprofiles_139" text="Был сыном знатного рода — да остановил на один караван больше, чем следовало, по пути на пир." />
    <string id="bp_slaverprofiles_140" text="Дороги {CULTURE_VLA} платят щедро. Приведи мне {CULTURE_VLA} — тогда и потолкуем." />
    <string id="bp_slaverprofiles_141" text="Погреб Ардвада — переделанный винный подвал; бочки исчезли, окованные железом дубовые двери остались. Пленников он держит в настоящих камерах, с настоящими замками и настоящими постелями — &quot;Отец воспитал меня благородным человеком,&quot; — говорит он без тени иронии. Сын рыцаря {CULTURE_VLA} злобно смотрит на него сквозь решётку. Ардвад насмешливо кланяется и идёт дальше." />
    <string id="bp_slaverprofiles_142" text="Ответ Мытаря" />
    <string id="bp_slaverprofiles_143" text="Мой отец держал усадьбу на западной дороге. Доброе вино, добрая посуда, пряжка {CULTURE_VLA} серебра на каждом поясе, что переступал его порог. В праздничный день я выехал встретить родню, что шла с &lt;span style=&quot;BandItPlus.Place&quot;&gt;Галенда&lt;/span&gt;. Вернулся два дня спустя с их кошелями и без единого спутника.&#10;&#10;Первый караван был забавой. Второй — долгом. К третьему руки знали работу лучше, чем знали винный кубок, а отец узнал моё лицо на розыскной грамоте раньше, чем мой голос за столом. Раз он заплатил старосте, чтоб тот отвёл глаза. Дважды. На третий раз он послал человека на дорогу сказать мне не возвращаться домой. На том человеке были добрые сапоги. Я оставил их себе.&#10;&#10;Что вводит человека в это ремесло? Больше всего — привычка. Сын знатного рода приучен брать всё, что мимо проходит. Остальному научила дорога — что купец {CULTURE_VLA} становится на колени так же, как сержант {CULTURE_VLA}, что серебро весит одинаково, срезал ли ты его с пояса или купил честно. Годами я резал пряжки, прежде чем понял, что тело в поясе стоит дороже пояса. Медленный урок. Дорогой учитель.&#10;&#10;Теперь я сижу на мытной заставе, за которую отец меня бы вздёрнул. Дорога, что кормила его, кормит меня. У родни, что я обобрал, теперь внуки ездят по ней, и я не знаю их лиц, а они не знают моего, и мы сводим счёты меж собой в цепях. В этом есть некая справедливость, в которую я не всматриваюсь слишком пристально.&#10;&#10;Приведи мне {CULTURE_VLA}. Я заплачу тебе той монетой, в которой отец мне отказал. В этом всё ремесло и весь ответ." />
    <string id="bp_slaverprofiles_144" text="Что Ардвад Слышит на Заставе" />
    <string id="bp_slaverprofiles_145" text="Дорога между Сарготом и Якуланом жирна в этот сезон. Три каравана прошло за две недели, все с тощей охраной — два арбалетчика да пьяный сержант, из тех, что купец нанимает, чтобы храбрее себя чувствовать. Пряжки, что я срезал с пояса последнего сержанта, всё ещё на моём столе. Он истёк кровью, выпрашивая назад имя своей жены.&#10;&#10;&lt;span style=&quot;BandItPlus.Name&quot;&gt;Лорд Каэлин&lt;/span&gt; с Западной Марки ездит теперь с шестью людьми, не с двенадцатью. Его казна отощала после того, как урожайная подать не задалась, и он не станет платить за должную свиту до весны. Человек, что знает лесную дорогу за Харасом, сказал мне, что дочь Каэлина едет в усадьбу тётки на новолуние — лёгкая охрана, крытая повозка. Я ещё не решил, стоит ли она поднятого шума. Знатные девицы {CULTURE_VLA} приносят монету в трёх портах, но они же приманивают знамёна.&#10;&#10;Солепромышленник в &lt;span style=&quot;BandItPlus.Place&quot;&gt;Пен Канноке&lt;/span&gt; берёт теперь и плоть. Тихо, вписывает их в счёт как «рабочий скот», гонит вниз по побережью на галеры. Платит меньше пустынных путей, зато обрезанными &lt;span style=&quot;BandItPlus.Coin&quot;&gt;денарами&lt;/span&gt; и не спрашивает про клеймо. Я шлю ему своих полевых работников {CULTURE_VLA}, а благородную кровь придерживаю для медлительных покупателей, что считают зубы да родословную.&#10;&#10;Человек, что зовёт себя Хардриком, работает переправу у &lt;span style=&quot;BandItPlus.Place&quot;&gt;Галенда&lt;/span&gt; в двух днях к востоку от меня. Режет глотки там, где я режу пряжки, — неряшливо, бросает тела на обочине, приманивает ополчение. Раз я послал ему весть, что его трупы губят мою заставу. Он прислал в ответ палец в тряпице. Теперь у нас уговор: он держится к востоку от мельничного ручья, я — к западу, и никто не трогает чужих меток.&#10;&#10;Поговаривают, король {CULTURE_VLA} к оттепели поднимет дорожный дозор. Две сотни конных, поклявшихся очистить большаки. Я когда-то жил в такой же усадьбе, как у него. Знаю, надолго ли хватает таких дозоров, когда вино льётся, а лордам делается скучно. Я скупаю цепи и нанимаю ещё двух лучников, пока не сошёл снег, — когда дозор выедет и притомится, купцы пойдут, думая, что дорога безопасна. Вот тогда и наполнится счёт." />
    <string id="bp_slaverprofiles_146" text="Тесса из Истдауна" />
    <string id="bp_slaverprofiles_147" text="В пятнадцать увела у родного отца коня и меч и сбежала." />
    <string id="bp_slaverprofiles_148" text="Трое {CULTURE_VLA} мертвы. Шесть пленников." />
    <string id="bp_slaverprofiles_149" text="Ардвад платит обрезанными монетами." />
    <string id="bp_slaverprofiles_150" text="Лорд {CULTURE_VLA} жив. Пятеро мёртвых. Двадцать зерна." />
    <string id="bp_slaverprofiles_151" text="Ардвад кивает." />
    <string id="bp_slaverprofiles_152" text="Двенадцать мёртвых, пятнадцать живых, лорд, пятьдесят зерна." />
    <string id="bp_slaverprofiles_153" text="Ардвад открывает сундук с казной." />
    <string id="bp_slaverprofiles_154" text="Тахир Хозяин Столбов" />
    <string id="bp_slaverprofiles_155" text="Капитан Колодок" />
    <string id="bp_slaverprofiles_156" text="Водит самый длинный невольничий караван к югу от столбовых колодок {CULTURE_ASE}. Продаёт всякого, кого выдаёт пустыня." />
    <string id="bp_slaverprofiles_157" text="Вождь за тебя ручается. Песок — нет. Поглядим, что вернут барханы." />
    <string id="bp_slaverprofiles_158" text="Караван-баши не держит погреба — лишь длинную вереницу скованных ярмом ходячих цепей, что тянутся от одного верблюжьего поезда к другому. На привале пленники сидят на корточках в тени сложенных товаров. Тахир идёт вдоль вереницы, считая головы, делая пометки на восковой табличке. Он единственный работорговец из твоих знакомцев, что ведёт писаные записи, и это, отчего-то, самое худшее." />
    <string id="bp_slaverprofiles_159" text="Что Тахир Рассказывает у Столба" />
    <string id="bp_slaverprofiles_160" text="Песок платит. В том всё и дело. Я пришёл на юг мальчишкой-погонщиком с двумя медяками да наполовину пустым бурдюком, и барханы быстро меня выучили — здесь человек стоит того, что скажет следующий покупатель, и ни зерном больше. Я видел, как мой первый хозяин умер от жажды в трёх днях пути от столбовых колодок. Я взял его верёвку. Взял его вереницу. {CULTURE_ASE}, которых он гнал, я продал у ближайшего колодезного стана, прежде чем остыло его тело.&#10;&#10;Столбовые колодки дали мне имя. Сорок станов между солончаками и южными рынками, каждый — кол, вбитый в скалу, каждый кол — место, чтобы приковать человека, пока ты его считаешь. Счёт я выучил рано — запястье, горло, лодыжка, язык. Больше всего покупатель хочет видеть язык. За немого дают половину. Я вожу самый длинный караван к югу от колодок {CULTURE_ASE}, потому что ни разу не сбился со счёта, а пустыня уважает того, кто и после песчаной бури ещё способен отличить сорок от тридцати девяти.&#10;&#10;Ты спрашиваешь, что вводит человека в это. Первым платит голод. Потом привычка. Потом счёт — и счёт хуже всех, ибо стоит твоему имени попасть в южные книги как человека, что доставляет, барханы будут подавать тебе тела, хочешь ты того или нет. Беглецы. Разорившиеся караванные стражи. Целые деревни, которых налётчикам было лень оставить себе. Песок отдаёт их, а я гоню дальше. В том и ремесло.&#10;&#10;Своих я не продаю. {CULTURE_ASE} — их я убиваю или заковываю, вот черта: они пустили кровь каравану моего первого хозяина, а значит, платят мыт вовеки. Всех прочих я взвешиваю. Хесса из колодезного стана читает мне кости, когда счёт скудеет; однажды она сказала, что я умру, задолжав пустыне больше, чем она мне. Может, и так. Здесь счёт идёт в обе стороны, и песок ведёт книги лучше моего.&#10;&#10;Так вот ты стоишь у моего столба и задаёшь вопрос, что задают люди перед тем, как наняться. Скажу тебе прямо. Никакого призвания тут нет. Нет истории, что стоила бы вздоха. Мальчишка с пустыми руками взял верёвку мертвеца, и верёвка так и не отпустила. Вождь за тебя ручается. Песок — нет. Держи счёт и держи язык, и поглядим, что вернут барханы." />
    <string id="bp_slaverprofiles_161" text="Что Тахир Слышит на Песке" />
    <string id="bp_slaverprofiles_162" text="Южные песчаные пути снова платят. Два зерновых каравана {CULTURE_ASE} прошли мимо моей вереницы в минувшую луну, по шесть стражей на каждый — шесть, где прежде ездило двенадцать. Засуха отощила их казну, а тощая казна — это тощие копья. Я отметил пути в своём счёте; следующая повозка, что пройдёт такой же худой, — беру целиком.&#10;&#10;Фактор {CULTURE_VLA} в &lt;span style=&quot;BandItPlus.Place&quot;&gt;Куйязе&lt;/span&gt; покупает тихо. У колодок он этого не скажет, но его человек приходит после сумерек и платит обрезанными &lt;span style=&quot;BandItPlus.Coin&quot;&gt;денарами&lt;/span&gt; за баб, что умеют шить. Троих я продал ему на прошлой неделе, никаких вопросов, откуда они. Барханы их отдали; он спросил лишь, крепки ли у них руки.&#10;&#10;У столба говорят, что Бану Хилал потеряли двоюродного брата шейха в набеге к югу от солончаков, и клан размяк на обидах — теперь выезжают вполсилы, на два дня позади всякой колонны, что гонят. Человек, знающий вади, увёл бы вереницу их пастухов и вернулся к своей чаше прежде, чем осядет пыль. Я в этот сезон не тот человек. Вождю нужна плоть, а не распря.&#10;&#10;Старый Рамун с западной вереницы умирает или близок к тому. Его колодочным парням месяц не платили, и двое его дозорных перекочевали ко мне, прося работы на веренице. Одного я взял — у другого была слабая рука на поводу, а слабая рука теряет тебе товар. Когда Рамун уйдёт, его пути пойдут задёшево, и я намерен первым добраться до его счёта.&#10;&#10;Пустыня отдаёт то, что отдаёт. Я держу цепи смазанными, а глаза — на южных колодцах, ибо жажда делает вольного человека дешевле любого торга." />
    <string id="bp_slaverprofiles_163" text="Сельма Скрытый Нож" />
    <string id="bp_slaverprofiles_164" text="Была женой купца — перерезала ему глотку и увела его караван." />
    <string id="bp_slaverprofiles_165" text="Трое {CULTURE_ASE} мертвы. Шесть пленников." />
    <string id="bp_slaverprofiles_166" text="Тахир одобрительно хмыкает." />
    <string id="bp_slaverprofiles_167" text="Лорд {CULTURE_ASE} жив. Пятеро мёртвых. Двадцать фиников." />
    <string id="bp_slaverprofiles_168" text="Тахир платит." />
    <string id="bp_slaverprofiles_169" text="Двенадцать мёртвых, пятнадцать живых, лорд, пятьдесят фиников." />
    <string id="bp_slaverprofiles_170" text="Тахир открывает самый дальний шатёр." />
    <string id="bp_slaverprofiles_171" text="Децим Разжалованный" />
    <string id="bp_slaverprofiles_172" text="Клеймёный Центурион" />
    <string id="bp_slaverprofiles_173" text="Лишился чина за преступление, которого не отрицал. Клеймо на щеке, два на спине. Продаёт имперцев, что некогда были выше его званием." />
    <string id="bp_slaverprofiles_174" text="Дисциплина всё ещё важна. Покажи, что она у тебя есть." />
    <string id="bp_slaverprofiles_175" text="Дециму погреб — что легионерская гауптвахта: шесть пленников стоят вольно, глаза вперёд, обращаются к ним по порядковому числу, а не по имени. Самый чистый погреб, что ты видел. &quot;Дисциплина {CULTURE_EMP} держит в обе стороны,&quot; — говорит он без улыбки. Клеймо центуриона на его щеке дёргается, когда он говорит. Никто из пленников на него не смотрит." />
    <string id="bp_slaverprofiles_176" text="Счёт Клеймёного Центуриона" />
    <string id="bp_slaverprofiles_177" text="Ты спрашиваешь, что вводит человека в это ремесло. Взгляни на моё лицо. Клеймо сидит там, стоит лишь спросить, — калёное железо в руке того, кто некогда принимал мои приказы. Они выжгли орла с моей щеки и оставили шрам в его форме, чтобы я нёс на себе легион даже после того, как легион со мной покончил.&#10;&#10;Я не отрицаю того, за что меня разжаловали. Я это сделал. Стоило ли оно того — это иной счёт. Суд отнял мой меч, мою пенсию, моё имя в списках. Ещё два клейма на спину, порядка ради. Потом отворили ворота и велели идти.&#10;&#10;Клеймёного не наймут стеречь караван. Не дадут ему надела земли. Ему остаётся одно ремесло, и это ремесло — то, что я уже знал: гнать людей в веренице, считать их, кормить ровно настолько, чтоб не сдохли. Разница лишь в том, что теперь цепь вместо походного строя да покупатель вместо квартирмейстера.&#10;&#10;Я продаю имперцев. Продаю тех, что прежде стояли званием выше меня и смотрели сквозь меня, будто я воздух. Иных я знал по имени ещё до того, как надел на них цепи. Я не злорадствую. Я взвешиваю их, назначаю цену, гоню дальше. Монета тратится одинаково, чья бы шея ни была под железом — крестьянская или трибунова, но, признаю, трибун сидит в счёте малость приятнее.&#10;&#10;Вот что вводит человека в это. Не жадность, не аппетит. Клеймо, затворённая дверь и то единственное умение, что оставил ему легион. Дисциплина в этом деле всё ещё важна, важнее, чем думают. Покажи, что она у тебя есть, и мы поладим. Покажи, что нет, — и узнаешь, каково это, вереница, изнутри." />
    <string id="bp_slaverprofiles_178" text="Что Децим Слышал на Лимесе" />
    <string id="bp_slaverprofiles_179" text="Когортная дорога из &lt;span style=&quot;BandItPlus.Place&quot;&gt;Амитатиса&lt;/span&gt; сейчас жирна. На прошлой неделе прошли два сундука с жалованьем, по двенадцать копий на каждый, но подкрепление с юга урезали до четырёх человек после призывного набора. Четвёртый хромает. Сам бы я не взялся — слишком близко к гарнизону, что ещё помнит моё лицо, — но ватага без клейма и с быстрой телегой сломала бы центуриону карьеру на том участке за одну ночь.&#10;&#10;В &lt;span style=&quot;BandItPlus.Place&quot;&gt;Фикаоне&lt;/span&gt; есть магистрат, что покупает тихо. Он с тобой не встретится, не напишет тебе, не назовёт твоего имени при свете дня. Его управитель приходит к задворкам винной лавки у южных ворот на третий вечер недели и платит старыми &lt;span style=&quot;BandItPlus.Coin&quot;&gt;денарами&lt;/span&gt; лишь за имперорождённых. Ему нужны грамотные. В прошлом месяце я послал ему писца из Лагеты — тот выплакал себе голос до хрипоты, прежде чем я пригнал его, а управитель заплатил выше счёта без единого слова торга. Служат они там в погребах, думаю. Наверх не возвращаются.&#10;&#10;Караван-баши Олинии, Кресос, водит тощую охрану на своей медной веренице, ибо мнит, что бумага {CULTURE_ASE} его хранит. От меня не хранит. Он движется в сумерках по старой дороге вдоль акведука каждый седьмой день, а его дозорные пьют. Есть ещё некий {CULTURE_VLA} по имени Беренгар, что работает тот же участок, — зовёт себя вольным всадником, продаёт всякого, кто падёт. Мы с ним не говорили. Коли сойдёшься с ним, делай это на дороге, не в городе; у него грамота от какого-то младшего сына из &lt;span style=&quot;BandItPlus.Place&quot;&gt;Галенда&lt;/span&gt;, и местные притворяются, будто она что-то значит.&#10;&#10;Собственные вербовщики империи — лучшие мои покупатели в этот сезон. Трибун на пограничной заставе под &lt;span style=&quot;BandItPlus.Place&quot;&gt;Пен Канноком&lt;/span&gt; даст тебе повозку зерна и серебра за всякого дезертира, что приведёшь ему ещё на ногах, — он приписывает их к штрафной когорте, а награду кладёт себе в карман. Троих я ему привёл. Он не спрашивает, откуда я знал, кого брать. Смотрит на мою щёку, пишет расписку и отворачивается. Дисциплина всё ещё важна, видишь ли. Даже с его стороны черты — всё ещё важна.&#10;&#10;Последнее слово, и даю его даром. Староста в Эпикротее спрашивает обо мне по моему старому имени — тому, что на клейме, не тому, что ношу. Коли явится к твоему стану человек, желающий купить одного-единственного Падшего Легионера, не спрашивай его цену. Зарежь его и закопай поглубже. Я узнаю, кто это сделал, и запомню." />
    <string id="bp_slaverprofiles_180" text="Марция Голое Клеймо" />
    <string id="bp_slaverprofiles_181" text="Дважды разжалована из двух легионов и ни за одно не повинилась." />
    <string id="bp_slaverprofiles_182" text="Трое имперцев мертвы. Шесть пленников." />
    <string id="bp_slaverprofiles_183" text="Децим насмешливо отдаёт честь и платит." />
    <string id="bp_slaverprofiles_184" text="Лорд {CULTURE_EMP} жив. Пятеро мёртвых. Двадцать зерна." />
    <string id="bp_slaverprofiles_185" text="Децим платит без выражения." />
    <string id="bp_slaverprofiles_186" text="Двенадцать мёртвых, пятнадцать живых, лорд, пятьдесят зерна." />
    <string id="bp_slaverprofiles_187" text="Децим открывает давно запертый сундук." />
    <string id="bp_slaverprofiles_188" text="Бран Соколиный Глаз" />
    <string id="bp_slaverprofiles_189" text="Скальный Дозорный" />
    <string id="bp_slaverprofiles_190" text="К двадцати одолел каждый утёс в нагорьях {CULTURE_BAT}. Продаёт тех, кто не смог." />
    <string id="bp_slaverprofiles_191" text="Нагорья не прощают слабости. Как и я." />
    <string id="bp_slaverprofiles_192" text="Погреб вовсе не погреб — выветренный уступ на полпути вниз по утёсу, с единственным железным кольцом, вбитым в камень. Четверо пленников привязаны к нему цепью в двенадцать футов каждый, так что сидеть могут, а уснуть — только сорвавшись. Внизу — тысяча футов пустоты. Бран смотрит на них без выражения. &quot;Учатся быстро,&quot; — говорит он. &quot;А кто медлит — учится долгой дорогой вниз.&quot;" />
    <string id="bp_slaverprofiles_193" text="Чему Научил Меня Утёс" />
    <string id="bp_slaverprofiles_194" text="Я лазил прежде, чем научился ходить. К двадцати мои руки легли на каждый утёс между Морем Звёзд и вересковыми пустошами — на каждую расселину, каждый нависающий карниз, каждый гнилой уступ, что притворяется, будто удержит вес человека. {CULTURE_BAT} там, наверху, поют о своих скалах так, будто камни им что-то должны. Не должны. Камень не должен никому.&#10;&#10;Ремеслу я выучился, глядя, кто срывается. Кто лезет мягко — гибнет на третьем участке. Кто лезет жёстко — иной раз доживает до четвёртого. Тех, кого я свожу теперь в цепях, я всю жизнь высматривал сверху. Козопасы. Углежоги. Размалёванные мальчишки, что играют в воинов на карнизах, которых их отцы не удержали бы. Я знаю, кто из них соскользнул бы до зимы. Я лишь взял этот срыв из их рук.&#10;&#10;Был сезон, когда я пробовал честный труд. Провёл сына купца {CULTURE_VLA} к стоячим камням за плату. Он расплатился серебром и смотрел на меня, как на пса, что показал трюк. На той же неделе я снял с козьей тропы дровосека {CULTURE_BAT}, и квартирмейстер Небесных Налётчиков заплатил мне втрое больше серебра и смотрел на меня, как на человека. Счёт творит свою арифметику. Я перестал делать вид, будто не прочёл его.&#10;&#10;Теперь я сижу на утёсе и смотрю. Вижу, кто отбился от деревни. Вижу, кто загнал свою охотничью собаку насмерть и забрёл глубже, чем следовало. Нагорья отдают их мне по одному, и я свожу их вниз на короткой верёвке. Иные идут тихо. Иные идут, толкуя о своих богах. Камню всё равно, а после двадцати лет наверху — и мне тоже.&#10;&#10;Ты спросил, что вводит человека в это. Ничто его не вводит. Холмы толкают его к самому краю ремесла, и однажды он смотрит вниз и обнаруживает, что уже стоит в нём. Вот и всё. Вот и вся история." />
    <string id="bp_slaverprofiles_195" text="Что Слышит Скальный Дозорный" />
    <string id="bp_slaverprofiles_196" text="По высокому перевалу над Лланруадом каждое третье утро идёт обоз {CULTURE_BAT}. Шесть стражей, две повозки, проводник, что пьёт. Я неделю следил за ними с утёса, прежде чем взял последнего. Утёсы делают половину работы — человек, прижатый к камню, торгуется быстрее человека на открытой дороге.&#10;&#10;&lt;span style=&quot;BandItPlus.Name&quot;&gt;Лорд Карадрос&lt;/span&gt; из западных владений истекает людьми в распре с собственным двоюродным братом. Дозоры его тощи, а управители тихо скупают — им нужны тела для каменоломни над Дунгланисом, и они не спрашивают, откуда тела. Гони свой товар через задние ворота затемно. Тамошний староста знает мою метку и берёт &lt;span style=&quot;BandItPlus.Coin&quot;&gt;денары&lt;/span&gt;, не считая дважды.&#10;&#10;Есть некий барышник живым товаром {CULTURE_VLA} по имени Остред, что работает у края низин. Платит хорошо за горянок, но медлит с монетой и ещё медленнее с правдой. Раз я имел с ним дело. Он попытался недодать мне четыре головы, и я оставил его на три пальца легче. Говорят, теперь он меня ищет. Пусть ищет. Утёсы прячут того, кто хочет остаться сокрытым.&#10;&#10;В минувшую луну ущельем прошёл караван паломников — двенадцать душ, два старых меча на всех, шли к какой-то святыне, названия не упомню. Паломники ходят так, будто дорога должна им безопасность. Не должна. Я приметил их путь и передал брату в нижних станах за долю. Легче, чем лазить.&#10;&#10;Городок &lt;span style=&quot;BandItPlus.Place&quot;&gt;Пен Каннок&lt;/span&gt; снова покупает. Тамошний кузнец потерял подмастерьев от мора и нуждается в руках, что не просят платы. Берёт мальчишек {CULTURE_BAT}, без вопросов, за полцены, зато монету в кулак. Гони по трое зараз, не больше, — тамошний пристав со скуки считает головы, а сочтённая голова — это повешенная голова." />
    <string id="bp_slaverprofiles_197" text="Уна из Орлиного Гнезда" />
    <string id="bp_slaverprofiles_198" text="Убила сокольничего его же рукавицей и забрала птицу." />
    <string id="bp_slaverprofiles_199" text="Трое {CULTURE_BAT} мертвы. Шесть пленников." />
    <string id="bp_slaverprofiles_200" text="Бран платит добрым серебром." />
    <string id="bp_slaverprofiles_201" text="Лорд {CULTURE_BAT} жив. Пятеро мёртвых. Двадцать твёрдой древесины." />
    <string id="bp_slaverprofiles_202" text="Бран протягивает руку." />
    <string id="bp_slaverprofiles_203" text="Двенадцать мёртвых, пятнадцать живых, лорд, пятьдесят твёрдой древесины." />
    <string id="bp_slaverprofiles_204" text="Бран показывает утёсную клетку." />
    <string id="bp_slaverprofiles_205" text="Таргуд Волчий Брат" />
    <string id="bp_slaverprofiles_206" text="Вожак Стаи" />
    <string id="bp_slaverprofiles_207" text="Охотился на дозорных {CULTURE_KHU}, как волки охотятся на оленя, — годами, зимой, с терпением." />
    <string id="bp_slaverprofiles_208" text="Стая узнаёт стаю. Покажи, что можешь бежать с нами." />
    <string id="bp_slaverprofiles_209" text="Свой погреб Таргуд зовёт логовом. Это крутая яма, накрытая решёткой из заострённых кольев, — пленники могут сидеть, но не могут встать в полный рост, не пустив крови. &quot;Волчья наука,&quot; — поясняет он. &quot;Загнанная в угол добыча не дерётся. Кровоточащая добыча не бежит.&quot; Он бросает объедки вниз сквозь решётку. Пленники не дерутся из-за них; они усвоили, что бывает с теми, кто дерётся." />
    <string id="bp_slaverprofiles_210" text="Что Говорит Таргуд" />
    <string id="bp_slaverprofiles_211" text="Мой отец бегал со стаей до меня. Он взял меня в зимнюю степь, когда я был мал настолько, что сидел на крупе за седлом, и научил, как волк читает след трёхдневной давности. Дозорные {CULTURE_KHU} прошли нашей долиной одной весной и сожгли, что не смогли увезти. Мой отец не пережил того пожара. Остальному ремеслу я выучился один, с его ножом на поясе и его именем на устах.&#10;&#10;Начал я с одного. Разведчик, отбившийся от дозора, конь захромал в сугробе. Я взял его в сумерках и вёл шестьдесят миль к прибрежному торговцу, что заплатил серебром и не задал вопросов. На ту монету я купил свой первый настоящий лук. Второй {CULTURE_KHU} купил мне второго человека в стаю. После того ремесло кормило само себя, как волчья стая кормит себя, стоит ей выучить облик оленя.&#10;&#10;Годы этого. Зимы ожидания на ветру с дыханием, замёрзшим на вороте, — высматривал костёр ради мгновения, когда человек отойдёт от братьев отлить. Терпение — вот всё ремесло. Степь награждает терпеливого и хоронит остальных. Я схоронил многих.&#10;&#10;Отчего я продаю их, а не убиваю. Монета держит стаю сытой, тёплой и вооружённой, а мёртвый {CULTURE_KHU} не платит ничего. Закованный платит в портах {CULTURE_ASE}, на прибрежных рынках, в руках всякого, у кого есть причина желать степного всадника сломленным. Ремесло чище мести, ибо ремесло не кончается. Месть кончается в тот миг, когда перерезано горло. А счёт идёт дальше.&#10;&#10;Вот что вводит меня в это. Кровь, что просила ответа, и ремесло, что платит лучше честной охоты. Я бегу по той же веренице, что бегал мой отец. Только оленя привожу назад живым." />
    <string id="bp_slaverprofiles_212" text="Что Таргуд Слышит на Ветру" />
    <string id="bp_slaverprofiles_213" text="Дозорные вереницы {CULTURE_KHU} отощали к северу от Ампрельского брода. Два дозора урезаны до одного всадника, второй оттянут на юг ради какой-то ханской свары, которой я не слежу. Волк чует, когда олений след пуст. Теперь я беру дорогу к броду в сумерках, три ночи кряду, а снег хранит то, что я оставляю позади.&#10;&#10;В Ортонгарде есть купец, что покупает, не спрашивая метки на запястье. По языку — {CULTURE_VLA}, по кошелю — степняк. Платит серебром и старой монетой {CULTURE_KHU}, и не торгуется за баб моложе двадцати зим. Четверых я продал ему в минувшую луну. Хочет ещё, и хочет тихих — без разбитых ртов, без выбитых зубов. Покупатели за его спиной едят чище моего.&#10;&#10;Караван ходит по веренице &lt;span style=&quot;BandItPlus.Place&quot;&gt;Макеб&lt;/span&gt;—&lt;span style=&quot;BandItPlus.Place&quot;&gt;Одох&lt;/span&gt; каждые десять дней, соль да шкуры, всего три стража. Головной страж пьёт. Я следил за ним с гряды две охоты назад и считал, сколько раз падала его голова. Шесть. Стая из четверых взяла бы это, не потеряв и зуба. Я не тронул, ибо кружу над добычей пожирнее, но след там для того, кто прочтёт его первым.&#10;&#10;Весть с ветра: младший сын &lt;span style=&quot;BandItPlus.Name&quot;&gt;боярина Урхуна&lt;/span&gt; выехал с соколиной охотой и не вернулся. Боярин сулит золото {CULTURE_KHU} за весть о нём. Думаю, мальчишка уже в чьей-то клетке, продан на восток к пастям {CULTURE_ASE}, а боярин заплатит дважды — раз за слух, раз за кости. Вот счёт, что я вёл бы осторожно.&#10;&#10;Этот участок работают ещё двое торговцев. Один — некий {CULTURE_STU} по имени Хрольф, что берёт лишь мужчин и лишь для ям; мы с ним не пересекаемся путями, мы пересекаемся товаром. Другой зовёт себя караван-баши, а гонит больше скованных глоток, чем бочек. Неряшлив. Его затравят собственные покупатели в один сезон, а как затравят, его пути освободятся. Я терпелив. Волки терпеливы." />
    <string id="bp_slaverprofiles_214" text="Эрден Длинный Клык" />
    <string id="bp_slaverprofiles_215" text="Убил трёх знатных {CULTURE_KHU} за одну зиму и оставил себе их кинжалы." />
    <string id="bp_slaverprofiles_216" text="Трое {CULTURE_KHU} мертвы. Шесть пленников." />
    <string id="bp_slaverprofiles_217" text="Таргуд хлопает тебя по плечу." />
    <string id="bp_slaverprofiles_218" text="Лорд {CULTURE_KHU} жив. Пятеро мёртвых. Двадцать льна." />
    <string id="bp_slaverprofiles_219" text="Таргуд взвывает от смеха." />
    <string id="bp_slaverprofiles_220" text="Двенадцать мёртвых, пятнадцать живых, лорд, пятьдесят льна." />
    <string id="bp_slaverprofiles_221" text="Таргуд открывает загон стаи." />
    <string id="bp_slaverprofiles_222" text="Старая Карга Хесса" />
    <string id="bp_slaverprofiles_223" text="Костогадалка" />
    <string id="bp_slaverprofiles_224" text="Зажилась на свете. Торгует душами — под коими разумеет людей. Улыбка её холоднее клинка вождя." />
    <string id="bp_slaverprofiles_225" text="Кости говорят, ты сгодишься на дело. Докажи им, что они не лгуны." />
    <string id="bp_slaverprofiles_226" text="Погреб Хессы круглый, стены расписаны знаками, что не читает уже ни один живой язык. Пленники сидят кругом, лицом внутрь, к жаровне, что никогда до конца не гаснет. У каждого на горле малый костяной знак — метка Хессы, говорит она. &quot;Указывает мертвецам, которые из них мои.&quot; Никто из пленников не говорит. Один из них мурлычет напев. Хесса подмурлыкивает." />
    <string id="bp_slaverprofiles_227" text="Чем Заплатили Кости" />
    <string id="bp_slaverprofiles_228" text="Сперва меня выучили кости. Мать бросала их на волчью шкуру, когда я была мала, и знаки сказали ей, что мой брат умрёт прежде снега. Он умер. Она бросила снова, и они сказали ей цену, что заплатит меченосец {CULTURE_BAT} за её вторую дочь. Он заплатил её. Вот первое, что я узнала о ремесле: кости не лгут, а покупатели не торгуются, когда знаки прочтены верно.&#10;&#10;Я читала их для культа после того, как она ушла в рощу и не вернулась. Старухи читают кости; старухи читают людей. Разница невелика. Череп трескается так же, как кошель, — чистым разломом по шву, и наружу высыпается то, что хранилось внутри. Я сидела у огня и говорила вождям, за кого дадут монету в &lt;span style=&quot;BandItPlus.Place&quot;&gt;Правенде&lt;/span&gt;, а кто годен лишь для алтаря. Права я бывала чаще, чем неправа. Живых мне стали приносить первыми, а мёртвых после.&#10;&#10;У души есть вес, видишь ли. Не жреческий вес, не эта чепуха про дыхание да свет. Я про вес в ладони, когда сжимаешь запястье и пульс бьётся под большим пальцем. Вот тот вес, которым я торгую. Я держала мальчишек, что не весили ничего, и стариков, что весили больше своих цепей. Кости говорят мне, кто есть кто, прежде чем я хоть пальцем коснусь.&#10;&#10;Я зажилась для тепла. Муж мой сорок зим в земле, дочери разбросаны по четырём культурам, а роща держит холод из моей хижины лучше всякого очага. Что осталось такой, как я, кроме счёта? Я веду учёт. Я читаю. Я продаю. Монета идёт культу, а культ кормит меня, и когда кости наконец назовут моё имя, я лягу в роще и перестану считать.&#10;&#10;Вот что вводит человека в это ремесло — или бабу, раз уж ты спросил о том меня. Сперва мне платил голод. После платили кости. А теперь платит привычка, что тяжелее всех трёх монет." />
    <string id="bp_slaverprofiles_229" text="Что Слышат Кости" />
    <string id="bp_slaverprofiles_230" text="Кости говорили минувшей ночью. Три позвонка легли к восточной дороге — шерстяные повозки {CULTURE_BAT} идут без должного числа копий. Я прочла четверых стражей, может, пятерых, и один из них хромает на левое бедро. Купец, что им платит, слишком тощ кошелём, чтоб нанять больше. Та дорога поспела для всякого, у кого хватит нутра перерезать постромки.&#10;&#10;Лорд к югу отсюда напивается до дури каждую третью ночь. Усадьба его наполовину пуста, дружина разбрелась, гоняясь за распрей, что он затеял пьяным. Дважды за неделю я слышала его имя от путников, что не знали, что что-то мне выдают. Такой человек теряет дочерей да конюших ещё до жатвы, и кости не лгут о том, в какую сторону кренится его усадьба.&#10;&#10;Соляной городок вниз по побережью — там теперь покупают тихо. У их старосты есть задняя комната и весы для монеты, и он не спрашивает про метку на запястье и откуда взялась цепь. Веди ему крепкие руки да молодые спины. Платит обрезанным серебром, но серебро настоящее, а это больше, чем я скажу о половине покупателей отсюда до реки.&#10;&#10;Есть один {CULTURE_VLA}, что зовёт себя барышником, работает в двух долинах к западу. Никакой он не барышник. Он гонит то же, что гоню я, и гонит дёшево, а значит, крадёт больше, чем покупает. Кости говорят, он повиснет в петле в течение года. А до того не сбивай ему цену на его же дороге — при нём трое убийц и пёс, что не лает прежде, чем укусит.&#10;&#10;А караван из речной крепости — тот, что ходит каждое новолуние с жреческой десятиной? Их капитана схоронили на прошлой неделе. Новый — мальчишка. Кости загремели, когда я спросила о нём. Такой грохот означает счёт, что ждёт, чтоб его заполнили." />
    <string id="bp_slaverprofiles_231" text="Меченый Брат" />
    <string id="bp_slaverprofiles_232" text="Носит шрамы, что Хесса вырезала, когда он был мальчишкой. Он не помнит зачем." />
    <string id="bp_slaverprofiles_233" text="Трое любой крови. Шесть пленников. Костям всё равно." />
    <string id="bp_slaverprofiles_234" text="Хесса кудахчет и платит старой монетой." />
    <string id="bp_slaverprofiles_235" text="Лорд жив. Пятеро мёртвых. Двадцать твёрдой древесины на костры." />
    <string id="bp_slaverprofiles_236" text="Хесса медленно улыбается." />
    <string id="bp_slaverprofiles_237" text="Двенадцать мёртвых, пятнадцать живых, лорд, пятьдесят твёрдой древесины. Кости шепчут." />
    <string id="bp_slaverprofiles_238" text="Хесса открывает дверь в глубокий камень." />
    <string id="bp_slaverquest_001" text="Убийства" />
    <string id="bp_slaverquest_002" text="Захвачено" />
    <string id="bp_slaverquest_003" text="Пленники" />
    <string id="bp_slaverquest_004" text="Собрано" />
    <string id="bp_spoils_001" text="Поле за тобой. Ты берёшь с павших:" />
    <string id="bp_spoils_002" text="Трофеи Победы" />
    <string id="bp_spoils_003" text="Продолжить" />
    <string id="bp_trustquest_001" text="Вождь чего-то от тебя ждёт." />
    <string id="bp_trustquest_002" text="Денары" />
    <string id="bp_trustquest_003" text="Разбойники" />
    <string id="bp_vendorprofiles_001" text="Садись поближе. Наклонись. Дым скрывает слова от ушей, что за них не платят. Ты заслужил шёпот, странник, — в минувшую луну солевоз с восточных дорог остановился здесь с разбитой губой и жаждой, и то, что он выплеснул вместе с элем, стоило больше монеты, что он оставил. Он сказал, &lt;span style=&quot;BandItPlus.Name&quot;&gt;лорд Каладог&lt;/span&gt; разорён. Разорён, как треснувший горшок. Его управитель скупал ячмень под долговую бирку у трёх разных мельников в &lt;span style=&quot;BandItPlus.Place&quot;&gt;Пен Канноке&lt;/span&gt;, и ни один не знает о других. Когда та соломенная башня рухнет, всякая цена на зерно отсюда до побережья подскочит на четверть. Скупай сейчас, копи или продавай загодя — твой выбор, но выбирай на этой неделе.&#10;&#10;Соляная дорога через ущелье под &lt;span style=&quot;BandItPlus.Place&quot;&gt;Дунгланисом&lt;/span&gt; идёт почти нагишом. Два сопровождающих, оба зелёные, оба пьяны к полудню, — козья пастушка сказала коробейнику, а тот моему дымовому мальцу. Говорю тебе это не затем, чтоб ты её ограбил. Говорю, чтоб ты знал, отчего цена на соль здесь вот-вот взлетит до &lt;span style=&quot;BandItPlus.Coin&quot;&gt;14 денаров&lt;/span&gt; за камень к жатвенной луне. Парни на деревьях уже приметили. А как парни примечают, купцы перестают ходить, а как купцы перестают ходить, даже моей свинине не хватает рассола.&#10;&#10;А вот кусок, что более всего стоит твоего уха. Есть жирный покупателишка в &lt;span style=&quot;BandItPlus.Place&quot;&gt;Марунате&lt;/span&gt; — зовёт себя квартирмейстером, рядится, как на свадьбу, — платит по &lt;span style=&quot;BandItPlus.Coin&quot;&gt;42 денара&lt;/span&gt; за бок копчёной свинины. Сорок два. Я тот же бок продаю у котла за шестнадцать. Он копит про запас для похода, о котором ещё никому не сказали, и он не торгуется. Коли есть у тебя мул да три дня, утроишь кошель и вернёшься прежде, чем снег сгноит последние окорока.&#10;&#10;Последнее, и отпущу тебя. Не бери в следующую луну высокий перевал. На той неделе прошёл пряный караван с ящиком перца, что не смогли продать в &lt;span style=&quot;BandItPlus.Place&quot;&gt;Эпикротее&lt;/span&gt; из-за какого-то нового закона о чужеземных товарах, — и клялись, что видели в седловине перевала знамя, которого никто из них не знал. Лес полон чужаков, что носят цвета, не подходящие к их лицам. Ешь. Пей. А потом езжай речной дорогой. Вот совет дымового мастера, и стоит он тебе лишь кивка на обратном пути." />
    <string id="bp_vendorprofiles_002" text="Хочешь секрет? Подойди ближе. Понюхай тот дым — это не дуб. Дубом жгут неумехи, а неумехи в &lt;span style=&quot;BandItPlus.Place&quot;&gt;Пен Канноке&lt;/span&gt; берут по два &lt;span style=&quot;BandItPlus.Coin&quot;&gt;денара&lt;/span&gt; за полоску свинины, что отдаёт кожевней. Мой — бук, срубленный на северном склоне, куда три лета назад ударила молния, сушенный две зимы под навесом и расколотый тонко, как лезвие. Бук даёт сладость. Но хитрость — настоящая хитрость — в яблоневом дереве, что я крошу в последние шесть часов. Не кусками. Крошкой. Мелкой, как нюхательный табак. Дым идёт из серого в золотой, а сало на свинине обретает цвет мёда, поднесённого к свече.&#10;&#10;А рассол — вот где Дымовая Мастерица зарабатывает своё имя. Соль, да, но крупная каменная соль с солонцов к востоку от ручья, никогда не морская; морская заставляет мясо плакать слишком скоро, и дыму не за что ухватиться. Ягоды можжевельника, толчёные, но не в порошок, — восемь на лопатку. Две головки дикого чеснока. И вот чего никто не знает: одна ложка соснового смоляного мёда, тёмного, какой лесовики соскребают из дуплистых деревьев поздней осенью. Мёд втягивает дым В мясо. Без него ты сдабриваешь одну лишь корку. С ним посол доходит до самой кости.&#10;&#10;Мой дед научил меня этому в зиму, когда мне сравнялось одиннадцать. Он истекал кровью на снегу — стрела лесовика, меж рёбер, — и заставил меня стать на колени и слушать, покуда шептал пропорции. Сказал, коптильня старше нашего рода и переживёт его, и кто-то должен знать. Сказал, забуду мёд — буду держать мясницкий сарай, а не коптильню, и в том разница. Я не забыла мёд. Три зимы миновало с моей похоронной записи, а я не забыла мёд.&#10;&#10;Последнее, раз ты показал себя полезным. Окорока, что я продаю караванам, идущим в &lt;span style=&quot;BandItPlus.Place&quot;&gt;Марунат&lt;/span&gt;, — те я вешаю на ладонь выше прочих. Дым холоднее, посол медленнее, двадцать восемь дней вместо двадцати одного. Держатся восемь месяцев в дороге, и купцы платят мне втрое. Коли когда пройдёшь той стороной и жирный человек по имени &lt;span style=&quot;BandItPlus.Name&quot;&gt;Хальмар Длинный Счёт&lt;/span&gt; станет сбивать тебе цену на солонину — скажи ему, Старая Брэ говорит: цена есть цена, а мёд стоит того, что стоит мёд." />
    <string id="bp_vendorprofiles_003" text="Три Зимы Как Мертва, а Всё Ещё Коптит" />
    <string id="bp_vendorprofiles_004" text="Вводит человека? Вводит и бабу, парень, и не забывай о том. Я родилась под стрехой &lt;span style=&quot;BandItPlus.Place&quot;&gt;Пен Каннока&lt;/span&gt;, когда он был ещё половиной частокола, а мой батя держал там коптильню для лесных счётчиков. Он рано помер от кашлевой хвори и оставил мне коптильный сарай, соляные кадки да долг баттанийскому тану, что я выплачивала окороками шесть долгих зим. К тому часу, как я закрыла тот счёт, я знала изнанку всякого ольхового огня и лицо всякого торгующегося ярла.&#10;&#10;Потом пришла беда. Лорд, чьего имени не назову, — южанин с чистым плащом и грязным ртом — заявил, что моя коптильня стоит на наделе его двоюродного брата. Прислал людей. Я отправила их назад с ножами в поясах и крюком не тем концом сквозь большой палец, а в ту же ночь ушла с тем, сколько соли смогла унести на спине пони. Лес принял меня, ибо лес принимает всякого, кого выплёвывают города, а у здешнего вождя была сотня налётчиков и ни единой души, что умела бы не дать мясу позеленеть к третьей неделе.&#10;&#10;Три зимы, как я по своей же похоронной записи мертва, говорят мне. Какой-то писарь в &lt;span style=&quot;BandItPlus.Place&quot;&gt;Правенде&lt;/span&gt; записал меня утопшей на болотной переправе — не та река, не та баба, но мне вполне подошло быть призраком в списках. Коптильный сарай, что видишь вон там, я срубила своими руками да одолженным теслом. Соль вымениваю щепотями с караванов &lt;span style=&quot;BandItPlus.Place&quot;&gt;Куйяза&lt;/span&gt;, как парни привезут повозку; ольху рублю сама; а свинина приходит на своих четырёх ногах с набегов, о которых я не спрашиваю.&#10;&#10;Полстана кормится с моих крюков. Вождь это знает, парни это знают, оттого-то ни один здесь и руки не подымет на Старую Брэ, как бы черно ни было моё настроение. Ногу копчёной лопатки я продаю за сорок &lt;span style=&quot;BandItPlus.Coin&quot;&gt;денаров&lt;/span&gt;, связку вяленых угрей за пятнадцать, а коли думаешь, что дорого, ступай грызи тетиву. Ремесло платит мне теплом, нужностью, тем, что помирать буду по своему расписанию для разнообразия.&#10;&#10;Вот что вводит тело в это ремесло, парень. Не монета — монета лишь счёт. А тоска по месту, где ни один писарь не запишет тебя мёртвым дважды." />
    <string id="bp_vendorprofiles_005" text="Что Слышит Дым" />
    <string id="bp_vendorprofiles_006" text="На оленьих тропах говорят, &lt;span style=&quot;BandItPlus.Place&quot;&gt;Пен Каннок&lt;/span&gt; спалил свои зимние соляные запасы за две недели — какой-то дурак-квартирмейстер там наверху платит по девять &lt;span style=&quot;BandItPlus.Coin&quot;&gt;денаров&lt;/span&gt; за фунт серой соли и не спрашивает, откуда она. Коли есть у тебя мул да тихая дорога — там монета сидит в бочке и ждёт, чтоб её увезли. Сама бы поехала, кабы колени ещё гнулись.&#10;&#10;Баттаниец гнал длинное стадо свиней на восток в минувшую луну к &lt;span style=&quot;BandItPlus.Place&quot;&gt;Марунату&lt;/span&gt;, и половина их вырвалась в папоротник к северу отсюда. &lt;span style=&quot;BandItPlus.Name&quot;&gt;Уэзер-Бан Погонщик&lt;/span&gt; сулит монету за находку всякой душе, что загонит беглянок обратно, — но между нами, парни выше по течению носят мне свинину, о которой я не спрашиваю, а я и не спрашиваю. Три зимы я вкапчиваю потерю того гурта в ваши ужины.&#10;&#10;Дурная весть для миски с кашей. Зерновые повозки из &lt;span style=&quot;BandItPlus.Place&quot;&gt;Дунгланиса&lt;/span&gt; в этот сезон не пойдут — мельникова жена занемогла, и колесо стоит с равноденствия. Значит, &lt;span style=&quot;BandItPlus.Place&quot;&gt;Кар Бансет&lt;/span&gt; станет скупать овёс со всякого каравана, что доберётся до них к крепкому морозу, и цена удвоится прежде снега. Запасайся сейчас или голодай с умом.&#10;&#10;С &lt;span style=&quot;BandItPlus.Place&quot;&gt;Эпикротеи&lt;/span&gt; идёт сладковинный поезд под вландским фактором по имени &lt;span style=&quot;BandItPlus.Name&quot;&gt;сэр Алдрек из Хатенга&lt;/span&gt; — три повозки, лёгкая охрана, идут южной тропой, ибо северную дорогу размыло. Купить ли у него или избавить от бремени — твоё дело, но у бродных камней он будет через восемь дней. Вождь знает. Вождь всегда знает.&#10;&#10;И последнее, раз уж ты стоял тут терпеливо. Хворь ползёт по яблоневым садам к востоку от &lt;span style=&quot;BandItPlus.Place&quot;&gt;Хертогеи&lt;/span&gt; — чёрная пятнистость, из тех, что губят сидр на три зимы. Коли есть у тебя друг с садом, скажи ему жечь падалицу сейчас. Я сама потеряла свою рощу от неё однажды, задолго до этой коптильни. Вот так я и узнала, какое ремесло держит тело сытым, когда деревья не держат." />
    <string id="bp_vendorprofiles_007" text="Старая Брэ из Коптильни" />
    <string id="bp_vendorprofiles_008" text="Дымовая Мастерица" />
    <string id="bp_vendorprofiles_009" text="Сорок зим коптила оленину для лесных деревень Баттании, пока вландский податной досмотрщик не спалил её сарай за &quot;беспатентный торг&quot;. Пришла к Ходу с тремя бочками соли и без одного зуба." />
    <string id="bp_vendorprofiles_079" text="Старая Брэ, странник. Парни Хода говорят, ты пришёл один, а слова вождя довольно, чтоб сберечь твою шкуру. Но коптильня Брэ — это Брэ, и твои сапоги ещё не заслужили и ломтя от неё. Принеси мне {BP_VENDOR_QUEST_DESC} — лесные деревни отощали этой зимой, — и я отрежу тебе первый кусок с жерди." />
    <string id="bp_vendorprofiles_010" text="Брэ коптит на ольхе, странник, — не на зелёном дубе, каким гонят низинные кладовые. Ольха пускает соль внутрь медленно. Три недели на окорок; лесные деревни знали разницу, пока лорд не забыл, что они есть." />
    <string id="bp_vendorprofiles_011" text="Принеси мне три мешка соли и упреди за зиму, странник, — Брэ закоптит тебе окорок, за подачу коего вландский наместник вздёрнул бы своего же управителя. Проба за счёт заведения. Возвращайся, как сможешь." />
    <string id="bp_vendorprofiles_012" text="Была у меня когда-то жена — Мара с верхнего березняка. Увела мальчишек на запад, когда пришли виселичные люди; после первой зимы не прислала ни слова. Брэ всё ещё шлёт копчёный окорок в лесные деревни каждую весну в месяц её рождения — на случай, если дорога ведёт в обе стороны." />
    <string id="bp_vendorprofiles_013" text="Тётушка Лиен держит коптильню-корчму на правендском перекрёстке — укрыта под мясницким навесом. Скажи ей, Старая Брэ коптила оленя, которого парни Хода ели в ночь, когда вздёрнули Брека. Она усадит тебя в задней комнате. Вот монета для мытного писаря." />
    <string id="bp_vendorprofiles_014" text="Наклонись, друг. Ты заслужил ухо, а у меня их два, и оба полны на этой неделе. Лудильщик из &lt;span style=&quot;BandItPlus.Place&quot;&gt;Пен Каннока&lt;/span&gt; прокатил три ночи назад, ось визжала так, что мёртвых разбудит, и за чашей моего худшего проговорился, что &lt;span style=&quot;BandItPlus.Name&quot;&gt;лорд Карадок&lt;/span&gt; в долгу у половины кузнецов западных долин. Малец не может расплатиться за мечи, что заказал в прошлую жатву. Его ополчение выступает с ржавчиной на ободах, а оружейничий тихо сбывает доброе снаряжение из задов оружейной. Коли есть у тебя лишний клинок да мягкий язык, обчистишь тот двор на двухнедельный запас &lt;span style=&quot;BandItPlus.Coin&quot;&gt;денаров&lt;/span&gt; запросто.&#10;&#10;А вот и лакомый кус. Стальная дорога — та долгая каменная колея, что бежит от &lt;span style=&quot;BandItPlus.Place&quot;&gt;Маруната&lt;/span&gt; вниз к речным бродам — везёт в эти две недели караваны с заготовками, а охрана усохла до четырёх копий из-за сбора войска на севере. Четыре копья, друг. За повозки полуготовой стали. Контрабандист, коему я доверяю (а список тот короток), сказал, колеи так глубоки, что слышно их с гряды за версту. Я не говорю тебе брать это. Я говорю тебе, что слышал. Делай с этим, что вынесет твоя совесть.&#10;&#10;Что до торга — кожи девать некуда. Всякий кожевник отсюда до &lt;span style=&quot;BandItPlus.Place&quot;&gt;Саналы&lt;/span&gt; сидит на шкурах, ибо южные караваны пришли на два месяца поздно и разом на три месяца тяжелы. Цены лежат на брюхе и не перевернутся до середины зимы. Не сбывай сбрую сейчас, коли можешь. Зато железа в холмах не стало — есть дурак-купец в &lt;span style=&quot;BandItPlus.Place&quot;&gt;Правенде&lt;/span&gt;, что платит под шестьдесят &lt;span style=&quot;BandItPlus.Coin&quot;&gt;денаров&lt;/span&gt; за брусок, ибо подряды его тянутся, а поставщики ушли. Шестьдесят. За чугун. Я бы неделю скакал в непогоду за таким счётом.&#10;&#10;Вот и все сливки. Почини ремни, прежде чем уйти, — пряжки сделаю дёшево для того, кто вернул мне мой бондарный набор. И держи сказанное между нами двоими. Бондарь слышит многое, ибо никто не трудится понижать голос при парне с колотушкой, а мне хотелось бы, чтоб так оно и осталось." />
    <string id="bp_vendorprofiles_015" text="Хочешь знать, отчего мои бочарные клёпки держат топорище боевой секиры лучше, чем железные обручи иного кузнеца? Всё в вымачивании. Зелёный дуб, расколотый вдоль волокна, — никогда не пилёный, никогда. Клинок раскалывает там, где дерево само хочет разойтись; пила лжёт тебе, режет поперёк волокон, и топорище ломается на третьем ударе. Всякую клёпку я колю расколочным ножом, что отец мне завещал, и четвертую их при лунном свете, когда сок ушёл вниз, в корни. Это половина секрета. Другая половина — в том, в чём мы их вымачиваем.&#10;&#10;Три ночи в бочке дубильной воды — толчёные дубовые чернильные орешки, горсть железных опилок, плеск уксуса, что я вымениваю на &lt;span style=&quot;BandItPlus.Place&quot;&gt;галендской&lt;/span&gt; дороге. Железо кусает дубильню и чернит её, как вороний глаз, а дерево пьёт её глубоко. Как высохнет, клёпка наполовину камень. Топорище, сделанное так, не расколется, коли поймает щитовой обод, и не сгниёт под дождём. Разбойники смеются, ибо их секиры переживают кузнечные, что носили их отцы, — а заплатили они мне сорок &lt;span style=&quot;BandItPlus.Coin&quot;&gt;денаров&lt;/span&gt;, не четыреста.&#10;&#10;Дубильной хитрости я выучился у отца в то утро, когда староста &lt;span style=&quot;BandItPlus.Name&quot;&gt;лорда Аэрлона&lt;/span&gt; пришёл обмерять нашу мастерскую под опись. У отца в угловой бочке доходила клёпочная заготовка, и он велел мне спрятать её под плащ, прежде чем они выбили дверь. На дороге к северу он научил меня остальному — лунному резу, железу, счёту ночей, — ибо знал, что не увидит другой зимы, а знание должно было где-то жить. Так что, когда я продаю тебе перенасаженную секиру, ты платишь за три ночи терпения мертвеца.&#10;&#10;Ещё одно, раз уж ты постоял с нами. Смолу, коей я запечатываю вязку, — вот её я не назову. Пока нет. Но спроси меня снова после ещё одного сезона на дороге, и, может, проговорюсь за чашей." />
    <string id="bp_vendorprofiles_016" text="Обручи и Клёпки Моего Отца" />
    <string id="bp_vendorprofiles_017" text="Мой отец держал бондарную мастерскую в двух улицах от речных ворот в &lt;span style=&quot;BandItPlus.Place&quot;&gt;Пен Канноке&lt;/span&gt;. Бочки, вёдра, маслобойные бочонки — всё, что можно оковать обручем и связать, отец гнул для того клёпки. Мне было восемь, когда он впервые вложил мне в руку струг, и запах свежей дубовой стружки поныне единственный запах, которому я доверяю.&#10;&#10;Потом &lt;span style=&quot;BandItPlus.Name&quot;&gt;лорд Эрвиль с Переправы&lt;/span&gt; решил, что переулок принадлежит брату его жены. Ни грамоты, ни судного дня, ни упреждения — лишь трое с секирными крюками да пергамент, которого никто не прочёл вслух. Они забрали мастерскую, дровяной двор, железные обручи, за связку коих отец платил по &lt;span style=&quot;BandItPlus.Coin&quot;&gt;сорок денаров&lt;/span&gt;, а когда отец положил руку на дверной косяк, забрали и его пальцы. Он прожил после того зиму. Да и ту неполную.&#10;&#10;Так я и ушёл. У меня были струг, малое тесло да бондарный рашпиль — ни горна, ни наковальни, ни монеты на то или другое. Дорога провела меня мимо &lt;span style=&quot;BandItPlus.Place&quot;&gt;Куйяза&lt;/span&gt; и тележных колей, коими ходят баттанийские лесовики, и где-то на третьей неделе человек с зазубренным луком спросил меня, смогу ли я поставить новый ремень на баклер. Смог. Поставил. Он накормил меня и привёл сюда.&#10;&#10;Оттого я и чиню. Горну надобны уголь, закалочная вода да кузнец, что учился с двенадцати, а я ни то, ни другое, ни третье. Но я могу заклепать расколотые ножны, перетянуть бригантину, перенасадить секиру, перешить седельный чепрак и стянуть ржавчину с лезвия, что какой-то дурак оставил мокнуть под дождём. Стан держит меня в дубе, масле да под крышей, а я держу их снаряжение на ногах ещё один сезон.&#10;&#10;Новых вещей я не кую. Новые вещи — удел людей с мастерскими в переулках, которых знать ещё не отняла. Я чиню — ибо мир полон ломаного железа, и кто-то должен возвращать на него обручи." />
    <string id="bp_vendorprofiles_018" text="Весть с Тележных Дорог" />
    <string id="bp_vendorprofiles_019" text="Из &lt;span style=&quot;BandItPlus.Place&quot;&gt;Пен Каннока&lt;/span&gt; весть, что гарнизон сжимает кулаки вокруг всякого железного слитка, что сходит с западных дорог. Их староста вздёрнул двух лудильщиков в минувшую луну за «беспатентную починку» — сиречь тамошние кузнецы хотят, чтоб всё ломаное снаряжение шло через их горны за двойную честную цену. Всё, что мы чиним здесь, обходится подателю вдвое дешевле, чем берут те воротные кузнецы, и никаких вопросов, откуда взялись заклёпки.&#10;&#10;Баттанийский караван проскользнул мимо мытного брода десять дней назад, волоча сырое болотное железо на юг к &lt;span style=&quot;BandItPlus.Place&quot;&gt;Марунату&lt;/span&gt; — шесть мулов, охраны толком нет, погонщики вполпьяна на вересковом пиве. Говорят, сбыли всё купцу, что работает на &lt;span style=&quot;BandItPlus.Name&quot;&gt;лорда Карадроса&lt;/span&gt;, что тихо копит про запас на щиты, которых не желает считать Верховному Королю. Коли пойдёшь той дорогой, обломки-осыпь всё ещё разбросаны по обочинам, где мулы срывали вьюки.&#10;&#10;&lt;span style=&quot;BandItPlus.Place&quot;&gt;Дунгланис&lt;/span&gt; платит по &lt;span style=&quot;BandItPlus.Coin&quot;&gt;сорок денаров&lt;/span&gt; за голову подмастерьев-лучников — их мастер тетивы помер от кашлевой лихорадки, а фиан-дружины кричат о новых заготовках прежде осеннего набегового сезона. Не спрашивают, где человек учился, что говорит тебе, до чего дошёл управитель в отчаянии. Годное место сбыть связку тиса или стопу неоперённых древок, коли вынесешь дорогу.&#10;&#10;Последнее, и это стоит послушать, — &lt;span style=&quot;BandItPlus.Name&quot;&gt;стургиец&lt;/span&gt;-коробейник прошёл три ночи назад, сказал, нагорные кланы разбойников скупают всякий кожаный обрезок и заклёпку, что найдут. Значит, ватага тихо снаряжается, и значит, седельная кожа да упряжное железо пойдут вдвое против летней цены к концу месяца. Чини, что есть, сейчас. Сбывай, чего не удержишь." />
    <string id="bp_vendorprofiles_020" text="Хальвар Бондарь" />
    <string id="bp_vendorprofiles_021" text="Древесный Бондарь" />
    <string id="bp_vendorprofiles_022" text="Резал луковые заготовки для браконьеров в глухих дубравах, пока виселичные люди лорда не вздёрнули его брата Брека. Теперь режет для парней Хода; луки без клейма, но бьют верно." />
    <string id="bp_vendorprofiles_080" text="Хальвар Бондарь, странник. Назови заготовку — и я скажу, кого она убила. Вождь пускает тебя ходить — то вождь. Но заготовки мои, и человек их зарабатывает. Принеси мне {BP_VENDOR_QUEST_DESC} с дороги — и увидишь, как летит баттанийский лук без клейма." />
    <string id="bp_vendorprofiles_023" text="Заготовки идут из порослевой рощи, что работал мой дед, странник. Дерево помнит рез — оттого-то луки и бьют верно. Имперские древесники зовут это «трепет старолесья» и сами не ведают, что говорят." />
    <string id="bp_vendorprofiles_024" text="Отметь мне силу натяга да породу, странник. К следующему твоему приходу у меня будет заготовка, что пьёт ветер. Те, что без клейма, что я продаю, хороши, — клеймёные я держу для парней. Вот, восковой оттиск с запасной, чтоб скрепить уговор." />
    <string id="bp_vendorprofiles_025" text="Брек был мне старшим братом, странник. Виселичные люди пришли на верхнем поле — вландский закон назвал это «браконьерством» за трёх зайцев, которых лорд себе не поименовал. Я вырезал его имя на луковой стойке наутро после. Волокно с тех пор обросло вокруг." />
    <string id="bp_vendorprofiles_026" text="Найди Старого Энгуса у Лудильщикова Моста, странник, — днём режет колыбели, при лампе по ночам — древки для стрел. Хитрости бесклеймовой заготовки он выучился у моего деда. Скажи ему, что сидел у огня Хода; он покажет тебе лампадную полку. Вот монета на дорогу." />
    <string id="bp_vendorprofiles_027" text="Наклонись ближе, друг, и держи это меж нами — соль знает, что прячет снег. Возчик прошёл три ночи назад, иней ещё в бороде, и проговорился, что &lt;span style=&quot;BandItPlus.Name&quot;&gt;лорд Весимир Серый Плащ&lt;/span&gt; истекает серебром быстрее, чем потрошёная селёдка истекает рассолом. Его людям не платили с оттепели, а его квартирмейстер скупал солёную треску в долг из &lt;span style=&quot;BandItPlus.Place&quot;&gt;Ревила&lt;/span&gt; — из тех долгов, что никто не намерен возвращать. Коли сойдёшься с его знаменем на дороге, гарнизон его голоден, а голодные люди дёшево продают свои клятвы.&#10;&#10;Южная зерновая дорога из &lt;span style=&quot;BandItPlus.Place&quot;&gt;Тиала&lt;/span&gt; жиже вдовьей похлёбки в этот сезон. Два каравана прошли, и оба сказали одно: охрана из шести, порой четырёх, порой единственный пьяный хускарл, что не отличит волка от собственной тени. Хлебные баржи громоздятся у пристаней, ибо купцы слишком напуганы, чтоб гнать их вглубь земли, а цена чёрного хлеба в верховых деревнях удвоилась. Солёное зерно, овёс, всё, что хранится, — кто половчее, купил бы дёшево у пристаней и продал во внутренних владениях на тридцать &lt;span style=&quot;BandItPlus.Coin&quot;&gt;денаров&lt;/span&gt; за мешок дороже справедливого.&#10;&#10;А вот и кусок, что стоит пожевать. Есть жирный пряный барышник из &lt;span style=&quot;BandItPlus.Place&quot;&gt;Омора&lt;/span&gt; — лысый, кольца на каждом пальце, — что переплачивает, как дурак, за копчёную рыбу. Шестьдесят &lt;span style=&quot;BandItPlus.Coin&quot;&gt;денаров&lt;/span&gt; за бочку, когда ходовая цена на побережье сорок. Говорят, родня его жены — стургийцы, и она ест лишь настоящее копчёное с севера, а он не выносит её огорчать. Человек с повозкой да нюхом на коптильни удвоил бы монету за один рейс, коли не пропьёт прибыль по пути.&#10;&#10;Последнее, и на том закончу. Коптильням к востоку от &lt;span style=&quot;BandItPlus.Place&quot;&gt;Варчега&lt;/span&gt; недостаёт ольхи — пожар пожрал половину их запаса весной — и они платят почти вдвое за всякий воз, что прибудет прежде крепкого мороза. Мой Сами рубил ольху в молодые годы. Он бы знал. Но всего этого ты от старого Николая не слышал, понимаешь. Соль держит свой совет, и я тоже." />
    <string id="bp_vendorprofiles_028" text="Спрашиваешь секрет, а? Сядь ближе. Ветер уносит слова, а я скажу это лишь раз. Солёная треска, что ты купил в минувшую луну, — то не простая соль. То трёхтяговый рассол: первая тяга — морская соль со скал под &lt;span style=&quot;BandItPlus.Place&quot;&gt;Варчегом&lt;/span&gt;, крупная, серая, полная железа. Вторая тяга — каменная соль, что налётчики привозят с восточных набегов, слаще, суше. Третья тяга — и вот в чём хитрость — древесная зола, только берёзовая, никогда не сосновая. Сосновая зола отдаёт треске смолой, и человек выплюнет её на втором укусе. Берёзовая зола тянет влагу из плоти медленно, как терпеливая рука, и оставляет рыбу твёрдой, но не ломкой.&#10;&#10;Мой Пётр научил меня этому в день, когда лёд рано вскрылся, за год до того, как мороз забрал его. Он сказал, его отец выучился у нордического торговца в &lt;span style=&quot;BandItPlus.Place&quot;&gt;Оморе&lt;/span&gt;, что явился с двумя бочками трески, не сгнившей за целый зимний поход. Секрет не в соли — соль есть у всякого дурака. Секрет в порядке. Сперва выпотроши и распластай, никогда не чисти от чешуи. Потом зарой в крупную серую на два дня. Потом промой в морской воде — не в пресной, никогда не в пресной, пресная вода убивает вкус. Потом каменная соль на четыре дня, под гнётом камня. Потом натирка берёзовой золой, только ладонями, никогда тряпицей. Тряпица крадёт жир из твоей руки, а треске тот жир нужен, чтоб запечататься.&#10;&#10;Дыма я не жгу. Дым для тех, кто не доверяет своей соли. Налётчики скачут зимой и не могут везти копчёную рыбу — она преет в коже и киснет к третьей ночи. Солёная треска, по-моему выделанная, пролежит в седельной суме сорок дней и накормит человека на сорок первый. Оттого мне и платят, что платят. Двести &lt;span style=&quot;BandItPlus.Coin&quot;&gt;денаров&lt;/span&gt; за мешок, что взял бы восемьдесят в &lt;span style=&quot;BandItPlus.Place&quot;&gt;Ревиле&lt;/span&gt;, и не торгуются. Они знают.&#10;&#10;Ещё одно, раз уж ты показал себя честным. Коли когда попробуешь это сам — а сомневаюсь, работа тяжкая, — не давай треске замёрзнуть прежде третьей тяги. Серая соль должна тянуть, а мёрзлая рыба не тянет ничего. Я выучил это дурным путём, в первую зиму один, когда сгубил весь улов и два месяца ел капусту. Пётр посмеялся бы надо мной. Он смеялся надо всем. Вот чего мне недостаёт больше всего." />
    <string id="bp_vendorprofiles_029" text="Соль Всегда Платит" />
    <string id="bp_vendorprofiles_030" text="Мой Егор таскал треску со стургийских отмелей за &lt;span style=&quot;BandItPlus.Place&quot;&gt;Ревилом&lt;/span&gt; девятнадцать зим, а я солила всякую рыбу, что он приносил домой. Богаты мы не были, но коптильня горела, а бочки стояли полны. Потом мороз ударил крепко в год, когда лёд сожрал ладьи, и Егор ушёл под воду с сетью ещё в руке. Его так и не нашли. Лишь пояс его вынесло на гальку неделю спустя, разбухший и серый.&#10;&#10;Бояре в &lt;span style=&quot;BandItPlus.Place&quot;&gt;Ревиле&lt;/span&gt; забрали лодку за податные долги ещё прежде, чем кончилась тризна. &lt;span style=&quot;BandItPlus.Name&quot;&gt;Лорд Владич&lt;/span&gt; не принял меня у своих ворот — сказал, вдова рыбака не имеет прав на судно, что задолжало короне. Я продала, что смогла унести, и пошла на север с двумя бочками солёной трески на санях, ища любую крышу, что меня приютит. Вдова без очага помирает за три ночи в этих краях. Всякий это знает.&#10;&#10;Налётчики нашли меня на третью ночь, полузамёрзшую у подножия каменного кургана. Могли забрать треску и оставить меня. Не забрали. Вождь отведал моей соли, взглянул на мои руки и сказал, что баба, которая так хорошо солит рыбу, дороже живой, чем мёртвой. Так что теперь я солю для них. Треску, тюленину, речную щуку, как парни принесут, а ещё держу соляные варницы в нижней пещере, где воздух остаётся сух.&#10;&#10;Торгую честно, ибо холодный торг И ЕСТЬ честный торг — здесь нет места сладким речам да недовесу. Бочка солёной трески стоит тебе того, что стоит бочка солёной трески. Шестьдесят &lt;span style=&quot;BandItPlus.Coin&quot;&gt;денаров&lt;/span&gt; за солёную, сорок за копчёную, а вяленые полосы идут по весу. Налётчики едят первыми, ты вторым, а что останется, я пошлю на юг со следующим гонцом к &lt;span style=&quot;BandItPlus.Place&quot;&gt;Омору&lt;/span&gt;, коли перевалы открыты.&#10;&#10;Я уж не тоскую по Егору каждый день. Тоскую, когда ветер идёт со льда и пахнет его тулупом. В остальное время я работаю, и работа платит, и того довольно бабе, что прежде мнила, будто море ей что-то должно. Не должно оно мне ничего. А соль должна. Соль всегда платит." />
    <string id="bp_vendorprofiles_031" text="Весть от Солевозов" />
    <string id="bp_vendorprofiles_032" text="Солевозы спустились из &lt;span style=&quot;BandItPlus.Place&quot;&gt;Ревила&lt;/span&gt; три ночи назад и говорят мне, что тамошние коптильни заплатят сорок &lt;span style=&quot;BandItPlus.Coin&quot;&gt;денаров&lt;/span&gt; за бочку трески, уложенной сухой, — вдвое против прошлозимней цены. Улов во фьорде не задался, вишь. Всякая сельдяная лодка, что доковыляла домой, вернулась полупустой, и ярлы скупают всё, что плавает, солёное или кислое.&#10;&#10;Зерно — иная сказка. &lt;span style=&quot;BandItPlus.Name&quot;&gt;Лорд Олек Чёрная Рука&lt;/span&gt; скупил три каравана, шедших в &lt;span style=&quot;BandItPlus.Place&quot;&gt;Тиал&lt;/span&gt;, — заплатил монетой, не посулами, — и теперь деревенские очаги к северу от стургийских лесов пекут ржаной хлеб из мякины тоньше пергамента. Голод придёт вверх по речной дороге к первой оттепели, помяни меня. Налётчики поедят славно; батраки — нет.&#10;&#10;Есть вландский винный поезд, что идёт на восток из &lt;span style=&quot;BandItPlus.Place&quot;&gt;Пен Каннока&lt;/span&gt;, сладкое вино в дубе, к свадьбе какого-то лордёнка в &lt;span style=&quot;BandItPlus.Place&quot;&gt;Правенде&lt;/span&gt;. Три повозки, восемь стражей, медленно, ибо дорога всё ещё во льду. Мой старый соляной напарник &lt;span style=&quot;BandItPlus.Name&quot;&gt;Бьорн Серый Крюк&lt;/span&gt; прислал весть — коли некий стан о том прослышит, некие бочки могли бы найти путь в некие погреба. Я торгую солью. Я не торгую местоположением повозок. Но и не забываю, кто платит добрым серебром.&#10;&#10;Последнее слово — угриные пруды в &lt;span style=&quot;BandItPlus.Place&quot;&gt;Куйязе&lt;/span&gt; промёрзли до дна. Весь сезонный улов пропал. Кузитские купцы скачут на запад в поисках копчёной рыбы по любой цене, а везут &lt;span style=&quot;BandItPlus.Coin&quot;&gt;динары&lt;/span&gt; тяжелее нашей монеты. Ловкач с санями трески вернулся бы богат — или вернулся бы мёртв. Степи всё равно, что именно.&#10;&#10;Вот такая дорога, как я её знаю. Три рынка голодны, одна повозка жирна, один голод крадётся. Скупай, что можешь унести. Весна — вор, а зима и того хуже." />
    <string id="bp_vendorprofiles_033" text="Николай Соляная Рука" />
    <string id="bp_vendorprofiles_034" text="Соляной Мастер" />
    <string id="bp_vendorprofiles_035" text="Работал на правендских солеварнях, пока его цех не урезал ему паёк за отказ от чужеземной торговой сделки. Пришёл на север с тремя бочками и кровной местью — Налётчики ели славно в ту первую зиму." />
    <string id="bp_vendorprofiles_081" text="Николай Соляная Рука, странник. Варгольф говорит, ты прошёл снегом, не оставив тела, — то немалая метка. Но соль моя, а свою последнюю долю я продал цеху, что меня предал. Принеси мне {BP_VENDOR_QUEST_DESC}, и я приправлю твой огонь так, как некогда потчевали правендских лордов." />
    <string id="bp_vendorprofiles_036" text="Правендская соль — не белые хлопья, что продают имперцы, странник, — это серое зерно, трижды промытое, тянет мозг наружу сквозь кость. Господские повара заплатили бы жалованье дозорного за бочку. Я им ещё ни одной не продал. Месть держится." />
    <string id="bp_vendorprofiles_037" text="Назови мне мясо да человека, странник, и я приправлю пир, что правендский высокий стол звал «зимним припасом». Шесть денаров вперёд, бочка на твоё седло в следующий приход. Вот, щепоть в твою дорожную похлёбку на нынешний вечер." />
    <string id="bp_vendorprofiles_038" text="Была дочь — Аня. Её рука была платой за торговую сделку, от которой я отказался. Цех увёл её на север как «воспитанницу»; ей было бы теперь двадцать зим, коли зимы её сберегли. Я вписываю солью её имя в каждую бочку, что открываю. Серая тянет счёт наружу из ничего." />
    <string id="bp_vendorprofiles_039" text="Старый Евген солит рыбу в стургийском портовом квартале под вывеской рыботорговца — та же серая соль, вполцены. Скажи ему, бочка Николая всё ещё ждёт цех, что нас сломал. Он наполнит твой мешок дважды. Вот монета на паромный мыт." />
    <string id="bp_vendorprofiles_040" text="Наклонись ближе, друг, мехи глушат слова, и меня это вполне устраивает. Солевоз из &lt;span style=&quot;BandItPlus.Place&quot;&gt;Омора&lt;/span&gt; купил у меня подкову на прошлой неделе и заплатил монетой и языком разом. Говорит, &lt;span style=&quot;BandItPlus.Name&quot;&gt;лорд Вагас&lt;/span&gt; не платил гарнизону две луны — продал своего второго жеребца вландскому фактору за полцены. Лорд, скудный &lt;span style=&quot;BandItPlus.Coin&quot;&gt;денарами&lt;/span&gt;, дёшево продаёт свои мечи, а секреты и того дешевле. Заметь это.&#10;&#10;Стургийская железная дорога из &lt;span style=&quot;BandItPlus.Place&quot;&gt;Ревила&lt;/span&gt; вниз сквозь сосновые вырубки — охрана тоща. Прежде ходило сорок копий, теперь двенадцать пьяных хускарлов да обозный, что не отличит север от собственной задницы. Три каравана с заготовками прошли за месяц, и ни один с должным заслоном. Коли кому нужна стургийская сталь по баттанийской цене, та дорога ею истекает. Я не говорю. Я просто говорю.&#10;&#10;Вот один, что стоит твоего уха. Жирный барышничек в &lt;span style=&quot;BandItPlus.Place&quot;&gt;Тиале&lt;/span&gt; — зовёт себя кожевником, а сам нет — платит вдвое за выделанную кабанью шкуру. Вдвое. Какой-то северный лорд тайно снаряжает охотничью ватагу, а кожаный избыток здесь наверху значит, что я могу купить шкуры за бесценок и продать ему по его цене. Я недолго буду единственным, кто это прознал, так что коли едешь той стороной и в седельных сумах есть место, поделим и груз, и добычу.&#10;&#10;И заметь — всё это не от меня. Горн громок, а старый Магнус наполовину глух на дурное ухо. Что бы ты ни слышал, ты слышал это от ветра." />
    <string id="bp_vendorprofiles_041" text="Хочешь секрет? Наклонись ближе, южанин. Половина кузнецов в &lt;span style=&quot;BandItPlus.Place&quot;&gt;Сибире&lt;/span&gt; скажет тебе, что холод делает сталь ломкой. Они дураки, что выучили ремесло в тёплой мастерской и не выходили из неё. Холод — второй молот. Когда я тяну клинок, светящийся жёлтым, из углей, а ветер со льда мне в спину, поверхностная кожа стали садится твёрже сердцевины в один вздох. Вот секрет — разностная закалка без глины, без крашеных линий, что кладут вландцы. Только ветер. Только тьма. Я кую с дверью горна, отворённой к снегу, и рассчитываю удары меж порывами.&#10;&#10;Дед моего деда был щитоделом в &lt;span style=&quot;BandItPlus.Place&quot;&gt;Ревиле&lt;/span&gt;, и он научил моего отца, а отец научил меня, прежде чем стургийское железо забрало мой глаз у стены. Он показал мне одну вещь со спинкой сакса. Высокоуглеродистую заготовку складываешь семь раз — никогда восемь, восемь — вландский счёт, и он оставляет сталь усталой, — а на последнем складе закаляешь в тюленьем жиру, не в воде. Тюлений жир держит жар медленнее, тянет углерод к лезвию, не коробя спинку. Клинок выходит со спинкой, мягкой настолько, что согнётся о колено, и с лезвием, что и год спустя сбреет волос с предплечья. Такие я продаю по восемьдесят &lt;span style=&quot;BandItPlus.Coin&quot;&gt;денаров&lt;/span&gt; за штуку и теряю на каждом, но человек должен оставить по себе доброе дело.&#10;&#10;Кожа — та вторая половина, о которой никто не спрашивает. Шкуры для ножен я выделываю в рассоле и берёзово-смоляном дыму целую луну, прежде чем срежу хоть один ремень. Большинство кожевников, что встретишь к югу от гряды &lt;span style=&quot;BandItPlus.Place&quot;&gt;Хрустгар&lt;/span&gt;, мочат шкуры три дня и зовут это готовым — а три зимы спустя их ножны сгнили, а рукояти разболтались. Мои переживают того, кто их купил. &lt;span style=&quot;BandItPlus.Name&quot;&gt;Старый Яррик&lt;/span&gt;, что держит кожевню на краю стана, круглый год держит бочку рассола наготове лишь для моих заказов. Он лишился двух пальцев в той же щитовой стене, что забрала мой глаз, оттого и понимает, отчего работа должна быть медленной.&#10;&#10;Ещё одно, раз уж ты заслужил. Коли когда купишь клинок у кузнеца, а он не даст тебе взглянуть на закалку, уходи. В закалке живёт ложь. Кузнец-трус прячет закалку, ибо его сталь шипит не так, или его жир разбавлен салом, или клинок ведёт, и он правит его холодным после — а это всякий одноглазый почует в балансе. Я закаляю в открытую. Хочешь — стой у двери и смотри, как поднимается пар над тюленьим жиром. Так делал мой отец, и его отец, и оттого люди &lt;span style=&quot;BandItPlus.Place&quot;&gt;Сибира&lt;/span&gt; всё ещё идут ко мне, когда южные ярлы загубят свои оружейные." />
    <string id="bp_vendorprofiles_042" text="Железо Помнит Холод" />
    <string id="bp_vendorprofiles_043" text="Ты спрашиваешь, что вводит человека в это ремесло. Честный ответ — стургийский щитовой обод да зима, что не желала кончаться. Я стоял в третьем ряду у стены под &lt;span style=&quot;BandItPlus.Place&quot;&gt;Ревилом&lt;/span&gt;, секира в слабой руке, когда шип умбона перевалил через верх и выбил мне правый глаз чисто, как мясницкий крюк. Лекарь хотел двадцать &lt;span style=&quot;BandItPlus.Coin&quot;&gt;денаров&lt;/span&gt;, чтоб зашить веко. Я дал ему пятнадцать да сломанную секиру, и он счёл, что мы в расчёте.&#10;&#10;Воевать после того я не мог. Глубина зрения — славная вещь, чтоб терять её человеку, что машет острым по движущимся целям. Так что я вернулся к тому, чему отец учил меня прежде, чем пришли наборщики, только теперь у меня дрожь в слабой руке да один добрый глаз на свечение крицы. Провёл две зимы в кузне под &lt;span style=&quot;BandItPlus.Place&quot;&gt;Сибиром&lt;/span&gt;, куя гвозди для рыбацких саней. Гвозди. После щитовой стены. Стыд того грел меня, когда мехи не грели.&#10;&#10;Чему я выучился в те две зимы — холод любит горн больше всякого южного солнца. Сталь, закалённая в речном льду &lt;span style=&quot;BandItPlus.Place&quot;&gt;Ревила&lt;/span&gt;, держит лезвие так, что &lt;span style=&quot;BandItPlus.Place&quot;&gt;правендский&lt;/span&gt; кузнец заплакал бы. Зерно стягивается. Закалка идёт вглубь, а не стекленеет. &lt;span style=&quot;BandItPlus.Name&quot;&gt;Бергтор с Озера&lt;/span&gt; пытался купить всю мою мастерскую за шестьдесят &lt;span style=&quot;BandItPlus.Coin&quot;&gt;денаров&lt;/span&gt; в месяц да крышу; я сказал ему, что моя наковальня не ездит южнее снеговой черты, и он назвал меня дураком.&#10;&#10;Налётчики нашли меня, когда нашли и стургийские сборщики податей, и одни были дружелюбнее других. Им нужно было перековать шлемы, перевязать кольчуги, перенасадить проушины секир — честная работа, платили монетой или молчанием вожака, смотря по неделе. Теперь я держу свой горн под их крышей. Холод помогает закалке, стан держит податных людей к югу от гряды, а одноглазый кузнец с твёрдой левой рукой выдаёт снаряжение, что держится против всякой щитовой стены, в какой я стоял.&#10;&#10;Вот и всё ремесло. Холодная сталь, холодная цена, холодная правда. Глаз был задатком. Остальной я плачу проценты с тех пор." />
    <string id="bp_vendorprofiles_044" text="Холодные Наковальни, Холоднее Монета" />
    <string id="bp_vendorprofiles_045" text="Из &lt;span style=&quot;BandItPlus.Place&quot;&gt;Ревила&lt;/span&gt; весть, что гарнизон набирает кузнецов — троих, может, четверых, платят солью и серебром разом. &lt;span style=&quot;BandItPlus.Name&quot;&gt;Лорд Булгнак&lt;/span&gt; хочет две сотни круглых щитов, окованных железом, прежде оттепели, и он не торгуется. Кабы у человека ещё были два добрых глаза да целая спина, тот подряд стоил бы дороги.&#10;&#10;Караван из &lt;span style=&quot;BandItPlus.Place&quot;&gt;Сибира&lt;/span&gt; везёт стальную заготовку на юг по замёрзшей речной дороге — баттанийские болванки, тёмно-серые, из тех, что берут долгое лезвие. На прошлой неделе они потеряли двух стражей волкам, так что капитан нанимает копья по &lt;span style=&quot;BandItPlus.Coin&quot;&gt;сорок денаров&lt;/span&gt; в день. А сама заготовка? Он продаст короткие бруски всякому с монетой и без вопросов. Я купил, сколько смог унести.&#10;&#10;&lt;span style=&quot;BandItPlus.Name&quot;&gt;Ярл Ирса&lt;/span&gt; в &lt;span style=&quot;BandItPlus.Place&quot;&gt;Оморе&lt;/span&gt; выложил за полный набор ламелляра в минувшую луну — двенадцать сотен &lt;span style=&quot;BandItPlus.Coin&quot;&gt;денаров&lt;/span&gt;, говорят, а кузнеца, что взял работу, с тех пор не видали. Думай что хочешь. Здесь наверху человек заканчивает заказ, а потом исчезает, а в зале ярла на стене новая броня. Я делаю свою работу в открытую, где стан всё видит.&#10;&#10;Стургийская щитовая стена забрала мой глаз, но выучила ремеслу — всякая вмятина на тех стенных щитах была уроком. Так что когда я говорю тебе, что южная кожа, что идёт вверх через &lt;span style=&quot;BandItPlus.Place&quot;&gt;Тиал&lt;/span&gt;, слишком мягка для нашей зимы, — верь мне. Пускай её на рукояти, не на облицовку. Холод находит слабый шов, как и копьё.&#10;&#10;Последнее. Есть вландский фактор, что рыщет по задним тропам, выспрашивая, кто поставляет клинки налётчикам. Сулит &lt;span style=&quot;BandItPlus.Coin&quot;&gt;две сотни денаров&lt;/span&gt; за имя. Моего ещё никто не продал — но коли услышишь его шёпотом, скажи мне прежде, чем скажешь ему. Холодная сталь. Холодная цена. Холодная правда." />
    <string id="bp_vendorprofiles_046" text="Магнус Одноглазый" />
    <string id="bp_vendorprofiles_047" text="Железная Рука" />
    <string id="bp_vendorprofiles_048" text="Лишился глаза из-за вландского дозорного, что взял руку его дочери в уплату долга, которого Юльские не были должны. Кует теперь под знаменем Варгольфа; о клинке, что он выковал для того дозорного, всё ещё толкуют на высоких перевалах." />
    <string id="bp_vendorprofiles_082" text="Магнус Одноглазый, странник. Вождь мерит тебя проушинами секир; я мерю пустой глазницей. Принеси мне {BP_VENDOR_QUEST_DESC} со снежной дороги, и я выкую тебе то, что ни один вландский дозорный не посмел бы носить. Это долгая история — пустая глазница хранит её для другого костра." />
    <string id="bp_vendorprofiles_049" text="Вландские дозорные куют латы на полуденном жару, на полном угле, — быстро сделать, ломки к третьему походу. Я приглушаю огонь до тления углей для последней закалки. Три лишних удара на клинок — и сталь поёт, а не трескается." />
    <string id="bp_vendorprofiles_050" text="Принеси мне железный брусок да своё имя, странник, и я приглушу следующую тягу лишь для тебя. Длинный клинок, секирное лезвие, молот — твоя рука на нём прежде, чем остынет. Вот знак из запасного запаса, чтоб скрепить уговор." />
    <string id="bp_vendorprofiles_051" text="Лишился глаза из-за вландского дозорного в уплату долга, которого Юльские не были должны. Он взял руку моей дочери в тот же час — ту часть ночи пустая глазница хранит для себя. О клинке, что я выковал для него, всё ещё толкуют на высоких перевалах. Он поминает его не как похвалу." />
    <string id="bp_vendorprofiles_052" text="Найди Хьялмара Уголь-Руку в невянских горнах — он выучил последнюю закалку у меня, прежде чем я ушёл на север. Скажи ему, Одноглазый всё ещё приглушает низко; он поймёт, что это я тебя послал. Берёт по-честному, коли принесёшь железо сам. Вот, возьми на железо." />
    <string id="bp_vendorprofiles_053" text="Наклонись ближе, друг. Тростники шепчут, да, но шепчут и баржевики, что причаливают за излучиной, а я слушаю и тех, и других. Весть от солевоза из &lt;span style=&quot;BandItPlus.Place&quot;&gt;Пен Каннока&lt;/span&gt; — что &lt;span style=&quot;BandItPlus.Name&quot;&gt;лорд Карадок&lt;/span&gt; затих по долгам: три коптильни выше по побережью больше не берут его долговых расписок, а его управителя видели выпрашивающим в долг две бочки солёной форели. Кошель у него тоньше цаплиной ноги. Коли он тебе должен услугу, взыщи её сейчас &lt;span style=&quot;BandItPlus.Coin&quot;&gt;денарами&lt;/span&gt;, не в следующую луну.&#10;&#10;Зерновая дорога через нижние топи — та, что жмётся к &lt;span style=&quot;BandItPlus.Place&quot;&gt;Марунату&lt;/span&gt; — ходит всего с четырьмя копьями эти последние десять дней. Четыре. На поезд из шести телег ячменя да копчёного карпа. Купец — вландец, по имени &lt;span style=&quot;BandItPlus.Name&quot;&gt;Ренье из Галенда&lt;/span&gt;, и скуп, как обрезанная монета. Баржевики смекают, он потеряет весь груз прежде следующего полумесяца. Я не говорю, что человеку делать с этим знанием, — лишь то, что я знаю, а теперь знаешь и ты.&#10;&#10;Вот один, что стоит угриного жира: есть масляно-сырный фактор из &lt;span style=&quot;BandItPlus.Place&quot;&gt;Сибира&lt;/span&gt;, что переплачивает — я про то, что взаправду переплачивает, двенадцать &lt;span style=&quot;BandItPlus.Coin&quot;&gt;денаров&lt;/span&gt; за фунт копчёного угря, когда ходовая цена семь на любом рынке отсюда до солончаков. Какой-то нордский лордёнок задаёт пир, а повар его спятил с меню. Фактор — в корчме на перекрёстке у &lt;span style=&quot;BandItPlus.Place&quot;&gt;Кар Бансета&lt;/span&gt; до новолуния. Вези ему свой копчёный запас; не торгуйся мягко, человек в отчаянии и не сморгнёт.&#10;&#10;Последнее, и незнакомцу я бы этого не сказал. Соль на севере иссякает — рассольные варницы в &lt;span style=&quot;BandItPlus.Place&quot;&gt;Оморе&lt;/span&gt; затопило, и не дадут они соли до середины лета. Всякий, кто держит соль сейчас, продаст её втрое к жатве. Тростники мне того не сказали. Пьяный солевар сказал, две ночи назад, прежде чем двоюродный брат заткнул его тумаком. Так что ты услышал это от угрей, понимаешь? Не от меня." />
    <string id="bp_vendorprofiles_054" text="Хочешь секрет? Наклонись ближе. Дело не в ловле — всякий пьяница с острогой заколет угря в чистой воде. Дело в выделке. Большинство потрошат угрей, солят их плашмя, вешают в дым на три дня и выходят с кожей, что впору подошву на сапог пустить. Мои сходят с жерди мягкими, как речная глина, и сладкими, как первый хлеб молодой жены. Хитрость в тростнике. Не в любом тростнике — в том, черноверхом, что растёт ниже по течению от гнездовья выпей, где вода становится цвета крепкого чая.&#10;&#10;Срезаю пучок толщиной с запястье, мну их колотушкой, пока не пойдёт зелёный дух, потом слоями кладу меж распластанных угрей в глиняный горшок. Крупная соль сверху, горсть толчёных ягод можжевельника, что собираю на сухих кочках, и одна — только одна — щепоть бурого сахара, что вымениваю в &lt;span style=&quot;BandItPlus.Place&quot;&gt;Санале&lt;/span&gt;, как проходят караваны. Придави плоским камнем весом с новорождённого. Три дня в горшке, потом ещё два в холодном дыму ольхи. Никогда дуба. Дуб делает их горькими. Никогда сосны. Сосна отдаёт вкусом мужичьей мочи.&#10;&#10;Мой дед показал мне это в зиму, когда умерла моя мать. Мне было девять. Он усадил меня к себе на колено в коптильном сарае и сказал: &quot;Томас, болото кормит того, кто его слушает. Тростники говорят угрям, где спрятаться. А нам говорят, как их сохранить.&quot; Зубов у него не осталось, одни дёсны, твёрдые как подошва, и он ел трёх этих угрей каждое утро до самого дня, когда ушёл в туман и не вернулся. Думаю, тростники позвали и его. Я не против. Однажды и я уйду тем же путём.&#10;&#10;Не говори никому про ольху. Я убил двоих, что пытались продавать моих угрей в &lt;span style=&quot;BandItPlus.Place&quot;&gt;Правенде&lt;/span&gt; как свою работу, и оба раза покупатели возвращались спросить, отчего новая партия отдаёт сосной. Прознают про ольху, и всякий дурак с коптильным сараем собьёт мне цену до четырёх &lt;span style=&quot;BandItPlus.Coin&quot;&gt;денаров&lt;/span&gt; за пару. Держи это за зубами, друг, и я отложу тебе горшок, как повернёт сезон." />
    <string id="bp_vendorprofiles_055" text="Тростники Сказали Мне Где" />
    <string id="bp_vendorprofiles_056" text="Садись. Берегись доски — тонет. Мой батя был тростникорезом близ &lt;span style=&quot;BandItPlus.Place&quot;&gt;Пен Каннока&lt;/span&gt;, продавал пучки кровельщикам по полмедяка за стопу. Я узнал болото прежде, чем узнал грамоту, которой так и не выучил. Тростники дышат иначе над угриной норой. Медленно. Тяжело. Как спящий пёс.&#10;&#10;Получил стрелу в глаз в двенадцать, работая топь на вландского податного, что назвал моего батю браконьером. Батя истёк кровью в плоскодонке; я приполз домой слепой на левый. Лорд — какой-то двоюродный брат &lt;span style=&quot;BandItPlus.Name&quot;&gt;лорда Каладога&lt;/span&gt;, имя не стоит помнить — заплатил нам четыре &lt;span style=&quot;BandItPlus.Coin&quot;&gt;денара&lt;/span&gt; отступного и счёл дело закрытым. Четыре. За человека и глаз. Полезное число я выучил в тот день.&#10;&#10;После того я работал коптильни в &lt;span style=&quot;BandItPlus.Place&quot;&gt;Якулане&lt;/span&gt; — потрошил, солил, вешал угря над ольховыми углями, пока плоть не станет янтарной. Доброе ремесло, честное ремесло, пока управитель не срезал плату, а цех не свалил недостачу на болотный люд. Я ушёл с бочкой рассола да коптильной решёткой, притороченной за спину. Тростники ждали там, где я их оставил.&#10;&#10;Нашёл этот стан, три дня идя за цаплей на запад. Атаман отведал угриную похлёбку, заплатил мне солью да сухим углом, сказал — оставайся. Так я и остаюсь. Тяну угрей слепым — по-настоящему слепым, добрый глаз тоже почти ушёл, — а тростники говорят мне где. Клонятся к норам. Шепчут о жирных. Думаешь, я умом тронулся; это ничего. Котёл полон, и парни едят.&#10;&#10;Что вводит человека в это ремесло? Четыре &lt;span style=&quot;BandItPlus.Coin&quot;&gt;денара&lt;/span&gt; да мёртвый отец. Всё с тех пор — болото держит меня, а я держу болото. Бери копчёного угря — он хорош. Соль из &lt;span style=&quot;BandItPlus.Place&quot;&gt;Ортонгарда&lt;/span&gt;, плачено честно." />
    <string id="bp_vendorprofiles_057" text="Тростники Шепчут, Дороги Говорят" />
    <string id="bp_vendorprofiles_058" text="Садись. Грязь довольно тёплая. Весть идёт по топям медленно, но идёт — лодочники передают её из миски в миску, а я держу уши открытыми, пока потрошу. Три вещи стоят твоего времени, может, четыре. Слушай так же медленно, как я говорю.&#10;&#10;&lt;span style=&quot;BandItPlus.Place&quot;&gt;Пен Канноку&lt;/span&gt; недостаёт соли. Две нагорные коптильни потеряли зимний запас от сырой гнили, а квартирмейстер управителя платит по четырнадцать &lt;span style=&quot;BandItPlus.Coin&quot;&gt;денаров&lt;/span&gt; за мешок — четырнадцать, за серую соль, что наполовину болотная крошка. Коли есть у тебя чистая каменная соль да крепкая спина, дорога на север платит нынче лучше дороги на юг.&#10;&#10;Зерновой караван из &lt;span style=&quot;BandItPlus.Place&quot;&gt;Друиммора&lt;/span&gt; ушёл в трясины две недели назад и не вышел. Староста &lt;span style=&quot;BandItPlus.Name&quot;&gt;лорда Карадока&lt;/span&gt; каждое утро объезжает гать, ища его, а значит, паёк его гарнизона тощает. Очажный хлеб взлетит к следующей луне. Я бы придержал ячмень, коли есть, — сбудь его после мороза, не прежде.&#10;&#10;Сладковинные лодки из &lt;span style=&quot;BandItPlus.Place&quot;&gt;Эпикротеи&lt;/span&gt; снова идут вверх через дельту, поздно, но идут. &lt;span style=&quot;BandItPlus.Name&quot;&gt;Старый Хальвар&lt;/span&gt; у нижней пристани уже скупил две бочки на перепродажу — пометит их втрое к середине лета. Покупай прямо с лодки или не покупай вовсе.&#10;&#10;Последнее, и ты этого от меня не слышал. Угри в этом году идут не так. Тростники клонятся к югу, когда не должны, а самки поднимаются тощими. Значит, тощая коптильная осень от &lt;span style=&quot;BandItPlus.Place&quot;&gt;Пен Каннока&lt;/span&gt; вплоть до &lt;span style=&quot;BandItPlus.Place&quot;&gt;Куйяза&lt;/span&gt; — вяленое мясо будет единственным зимним товаром, что стоит везти. Заметь это. Болото терпеливо, но щедро оно не бывает дважды." />
    <string id="bp_vendorprofiles_059" text="Томас Угриная Кость" />
    <string id="bp_vendorprofiles_060" text="Тростниковый Мастер" />
    <string id="bp_vendorprofiles_061" text="Плёл верши и вялил угрей для болотных деревень, пока вландская корона не передала его рыболовные права южному виконту. Остался в тростниках; податные писари виконта ни разу не возвращались дважды." />
    <string id="bp_vendorprofiles_083" text="Томас Угриная Кость, странник. Тростники тебя впустили — так болото говорит, не я. А я говорю так: принеси мне {BP_VENDOR_QUEST_DESC}, и я навялю тебе такой рыбы, от какой южный виконт меня отрезал изгородью." />
    <string id="bp_vendorprofiles_062" text="Болотный угорь берёт дым не так, как речная рыба, странник, — три дня висит в тростниковом дыму, а не полдня, как торопятся южные рыбаки. Мясо приобретает цвет, какому в Вландии и названия не знают. Они уж и пытаться перестали." />
    <string id="bp_vendorprofiles_063" text="Назови размер, неделю улова, для кого рыба, странник. Навялю тебе связку, какую налоговые писари южного виконта оценили бы как «военную контрабанду». Два денара за тростник, образец тебе в котомку на ночь." />
    <string id="bp_vendorprofiles_064" text="Жена ушла под болото в вешнее половодье — Бренвин, из тростникорезов. Болото забрало её; болото всех в свой срок забирает. Каждый сезон я вялю одну лишнюю связку и оставляю на берегу, где она ушла под воду. Иной раз наутро её уж нет." />
    <string id="bp_vendorprofiles_065" text="Старый Лир держит рыбный лоток на рынке южного виконтства — та же хитрость с тростниковым дымом, вдвое дешевле. Он брат моей жены. Скажи ему, что Томас всё ещё вялит на берегу; он усадит тебя в задах лотка. Монету за его рыночную пошлину." />
    <string id="bp_vendorprofiles_066" text="Придвинься ближе, друг. Грязная Рука не всякому сапогу, что хлюпает через тростник, такое выкладывает, но ты заслужил, чтоб тебе на ухо шепнули. Там, в &lt;span style=&quot;BandItPlus.Place&quot;&gt;Пен Канноке&lt;/span&gt;, завёлся скупщик кожи, что умом тронулся — платит по девять &lt;span style=&quot;BandItPlus.Coin&quot;&gt;денаров&lt;/span&gt; за шкуру дублёной оленины, когда ей красная цена пять, не боле. Контрабандист, что прошёл тут три ночи назад, сказывал: у него, мол, договор с каким-то южным бронником, и он в панике. Есть у тебя шкуры или знаешь охотника при них — вот куда золото стекается в эту пару недель.&#10;&#10;А теперь кус послаще. Кошель &lt;span style=&quot;BandItPlus.Name&quot;&gt;лорда Карадока&lt;/span&gt; лёгкий — лёгкий, как горшок у голодранца. Его сборщик податей прошёл бледный да извиняющийся, а это значит — подать запаздывает, и гарнизон жуёт солонину старше самого замка. Лорды на мели дёшево всё сбывают, понимаешь. Броню, сбрую, а поймаешь управляющего под хмельком — так и коня. А дорога к его замку? Охрана жиденькая. Два всадника, может три, и один к полудню уж вполпьяна. Знакомый купец сказывал, что провёз воз болванок прямо насквозь и знамени не приметил.&#10;&#10;Да вот только сама сталь — вот где загвоздка. Северные караваны застряли в &lt;span style=&quot;BandItPlus.Place&quot;&gt;Варноваполе&lt;/span&gt; — какая-то свара с начальником гавани, корабли жирными тушами торчат в заливе. Оттого цены на болванки ползут вверх. Копишь боевое снаряжение — бери сейчас, покуда болотные торгаши не пронюхали. Недели не пройдёт, как всякий кузнец отсюда до побережья станет двойную цену ломить.&#10;&#10;И последний шепоток — из &lt;span style=&quot;BandItPlus.Place&quot;&gt;Сибира&lt;/span&gt; хлынул избыток дешёвой кожи, шкуры такие тонкие, что сквозь них писание читать можно. Не бери в этот сезон сапог с клеймом лилии. Сгниют до первых морозов. Грязная Рука тебе верно говорит: тут всё рано или поздно гниёт, да только иное гниёт ещё до того, как продано." />
    <string id="bp_vendorprofiles_067" text="Хочешь знать, отчего мои сапоги носятся, когда чужие за две недели с ноги сгнивают? Всё в коре. Не в дубовой — дуб всякий дурак берёт. Я беру болотный мирт да ольховые серёжки, толку в кашицу и накладываю на мездровую сторону шкуры, покуда она ещё мокрая из известковой ямы. Три оборота луны стоит она в закрытом горшке, зарытом в прохладный торф. Дубильные соки входят медленно, глубоко, и приносят с собой болотный дух. Пиявка сапога, так выделанного, не тронет. И личинка гнилостной мухи, что заводится в швах у людей на складах гарнизона в &lt;span style=&quot;BandItPlus.Place&quot;&gt;Пен Канноке&lt;/span&gt;, — тоже.&#10;&#10;Вторая хитрость — жир. Болотно-оленьего жира одного мало — слишком мягок, на жаре выступает. Я вытапливаю его с половинной мерой пчелиного воска, что вымениваю у бродячего попа близ &lt;span style=&quot;BandItPlus.Place&quot;&gt;Эпикротеи&lt;/span&gt;, да с пальцем сосновой смолы для крепости. Втираю тёплым в лицевую сторону гладким речным камнем, жму и жму, покуда кожа больше не пьёт. Потом ставлю у огня — не в пламя, на ладонь поодаль — и она делается цвета мокрого папоротника. Вот тогда и знаешь: запечатано.&#10;&#10;Дед показал мне кашицу из коры в тот день, когда его собственные сапоги развалились посреди Затопленной Гати. Сел он на кочку и рассмеялся: даже, мол, подошвы решили на покой раньше него. Стянул сгнившее тряпьё, прошёл домой босиком три лиги по пиявочной воде — и ни болячки. Кожа на ногах у человека, говорил он, единственная кожа, что сама учится. Всё прочее учить приходится.&#10;&#10;Последнее — и скажу лишь раз, ибо не хочу видеть это на каждом сапожном верстаке отсюда до &lt;span style=&quot;BandItPlus.Place&quot;&gt;Тиаля&lt;/span&gt; — прошивка сбруи. Беру жилу с задней ноги, никогда со спины, и вощу её той же смесью мирта и жира, а не смолой. Чёрным на коже не отдаёт. Конокрад, глянув на сбрую, видит мужицкую снасть, а не такую, что удержит в седле летящего в атаку. Полный набор станет тебе в четыреста &lt;span style=&quot;BandItPlus.Coin&quot;&gt;денаров&lt;/span&gt;, да ещё подкину запасной горшочек с корой, чтоб сам чинил, когда гниль наконец возьмётся." />
    <string id="bp_vendorprofiles_068" text="Вощи Нить, Друг" />
    <string id="bp_vendorprofiles_069" text="Мой отец шил сбрую для ополчения в &lt;span style=&quot;BandItPlus.Place&quot;&gt;Пен Канноке&lt;/span&gt; — чистая мастерская, добрые шилья, окно на площадь. Я перенял ремесло с чистыми руками и правильно навощённой нитью. А потом податной с грамотой, какую я и прочесть не мог, забрал мастерскую за недоимку, какой мы отродясь не были должны, и отец однажды утром ушёл в топь да так и не вышел. Тому уж двадцать зим. Шилья, что при мне ныне, — его.&#10;&#10;Я подался на юг, сшивая то, за что люд платил. Петли уздечки конокраду под &lt;span style=&quot;BandItPlus.Place&quot;&gt;Куязом&lt;/span&gt;, подмётки торфорезу, что платил мне солёной рыбой, колчан девке, что своего лука натянуть не умела. Никто не спрашивал, где я выучил свои стежки, и я перестал спрашивать, откуда у них шкуры. Человек с кривым ножом и без вопросов ест исправнее того, у кого чистый гроссбух.&#10;&#10;Болото нашло меня так, как находит всех, — медленно, а потом сразу. Я спал под поваленной ольхой в жару, когда скрадыватели выволокли меня за шиворот. У них была груда сырых оленьих шкур, какую никто выделать не умел, да капитан, у которого сапоги разошлись по ранту. Я починил сапоги. Выделал шкуры. С тех пор я тут всё и чиню, и никто не явился взыскать причитавшуюся с меня подать.&#10;&#10;Что приводит человека в это ремесло, спрашиваешь. Первым платит голод. Потом привычка. Потом тихое знание, что добрый шов переживёт того, кто его носил, а шкура переживёт шов, а трясина переживёт шкуру. Тут всё гниёт, друг, да только гниёт МЕДЛЕННЕЕ, коли ты навощил нить. Это единственная честная проповедь, что во мне ещё осталась.&#10;&#10;Вот и сижу тут, тачаю из болотного оленя нечто, что продержит твои ноги сухими сезон, а то и два. Плати мне &lt;span style=&quot;BandItPlus.Coin&quot;&gt;денарами&lt;/span&gt;, коли есть, или солью, или флягой чего покрепче. Я не спрашиваю, откуда монета. Меня ведь тоже не спрашивали, когда я начал её брать." />
    <string id="bp_vendorprofiles_070" text="Весть с Болотной Дороги" />
    <string id="bp_vendorprofiles_071" text="Весть медленно ползёт через тростники, но ползёт. Караван из &lt;span style=&quot;BandItPlus.Place&quot;&gt;Пен Каннока&lt;/span&gt; протащил воз вландийской стальной заготовки по болотной дороге в прошлые две недели — по ось в грязи и с воем на всю округу. Возчик божился, что южнее топи больше ни ногой, — а значит, хозяин его в следующем сезоне вдвое заплатит, чтоб сыскать того, кто пойдёт. Я купил у него три обрубка прутка за шестьдесят &lt;span style=&quot;BandItPlus.Coin&quot;&gt;денаров&lt;/span&gt; и сухую пару сапог. Честный обмен.&#10;&#10;&lt;span style=&quot;BandItPlus.Name&quot;&gt;Лорд Карадак&lt;/span&gt; там, в &lt;span style=&quot;BandItPlus.Place&quot;&gt;Окс-Холле&lt;/span&gt;, снова скупает щиты. Третий заказ за год. Либо его ополченцы всё роняют их в трясину, либо он копит к чему-то, о чём глашатаи ещё не кричат. Сын моего двоюродного брата работает там на дубильне — говорит, заказ на круглые щиты, болотного образца, а не миндалевидные, какие рыцари любят. Вот и понятно, с кем они драться готовятся.&#10;&#10;Кузнецы подаются на восток. &lt;span style=&quot;BandItPlus.Place&quot;&gt;Куяз&lt;/span&gt; платит подмастерьям по четыре &lt;span style=&quot;BandItPlus.Coin&quot;&gt;динара&lt;/span&gt; в день, чтоб шли работать в пустынные горны, и двое из каждых трёх учеников в &lt;span style=&quot;BandItPlus.Place&quot;&gt;Правенде&lt;/span&gt; уж собрали свои молоты. Мне на руку — кожевенное дело остаётся тут, в сырости, где железу не житьё. А худо всякому лорду, что надеется перешлемить свою стражу до таяния снегов.&#10;&#10;Баттанийский лучный мастер прошёл на той неделе, звать &lt;span style=&quot;BandItPlus.Name&quot;&gt;Эйтне Заноза&lt;/span&gt;, тащила тисовые заготовки, срезанные к северу от &lt;span style=&quot;BandItPlus.Place&quot;&gt;Пен Каннока&lt;/span&gt;. Сказывала, олень там повывелся, охотники всё дальше в нагорья лезут, сбруя изнашивается быстрее, чем сапожники латают. Оставила мне заготовку за сапоги, что я ей стачал. Честная мена есть честная мена.&#10;&#10;И последнее — седельника из &lt;span style=&quot;BandItPlus.Place&quot;&gt;Ревила&lt;/span&gt; убили на болотной дороге, горло вскрыто, котомка нетронута. Нетронута, заметь. Это не разбойничья работа, это послание. А кому его шлют — пославший не обмолвился. Береги свои ремни сбруи, друг, и не езди один мимо сухой ивы." />
    <string id="bp_vendorprofiles_072" text="Каэль Грязная Рука" />
    <string id="bp_vendorprofiles_073" text="Кожевник-Сапожник" />
    <string id="bp_vendorprofiles_074" text="Выделывает шкуры, что болото на берегу оставляет, — гадючью кожу, болотную выдру, утопшего оленя. Его кожа в сырых краях не гниёт; болотный люд говорит, что он перенял эту хитрость у самой топи." />
    <string id="bp_vendorprofiles_084" text="Каэль Грязная Рука, странник. Вождь дал тебе пройти — глаз у Мирборна зоркий. Мой поуже. Принеси мне {BP_VENDOR_QUEST_DESC}, и поглядим, достойна ли твоя сталь кожи, какую болото ещё не забрало назад." />
    <string id="bp_vendorprofiles_075" text="Болотная шкура выделывается иначе, странник, — первую работу отдаёшь топи, три дня под тростниковой водой, прежде чем в дубовую кору. Кожа в сырых краях не гниёт. Вландийские дубильщики повторить не могут; они уж и пытаться перестали." />
    <string id="bp_vendorprofiles_076" text="Принеси мне зверя, что сам добыл, странник, — гадюку, болотную выдру, утопшего оленя, — и я стачаю тебе вещь, какую болото не забрало назад. Половину денара за шкуру, остальное за подгонку. Лоскут тебе в котомку на ночь." />
    <string id="bp_vendorprofiles_077" text="Мои сыновья переняли выделку у меня, странник. Болото забрало младшего в год долгого паводка — Брен, восемь зим ему тогда было. Средний в четырнадцать ушёл к имперским вербовщикам; я теперь его имени не называю. Старший всё ещё здесь, где-то в тростниках; я вижу следы его силков на оленях." />
    <string id="bp_vendorprofiles_078" text="Сыщи Старого Гаррика на краю баттанийского леса — он перенял выделку тростниковой водой у моего отца, ещё до того как семья раскололась. Скажи ему, что Каэль всё ещё работает в топи; он покажет тебе внутреннюю растяжную раму. Монету за долгую дорогу." />
    <string id="bp_vendorprofiles_085" text="Придвинься ближе, друг, и говори потише — я всякое зерно считаю дважды, а слухи трижды, и то, что сейчас выложу, стоит поболе соли в моём кошеле. Весть от баттанийского погонщика три ночи назад: &lt;span style=&quot;BandItPlus.Name&quot;&gt;лорд Каладог&lt;/span&gt; вот уж две недели платит гарнизону обещаниями да чёрствым хлебом. Его управляющий явился в &lt;span style=&quot;BandItPlus.Place&quot;&gt;Пен Каннок&lt;/span&gt;, пытался купить двести бушелей ячменя в долг, и мельник со двора его со смеху выпроводил. Кто своих стен прокормить не может, тот скоро никуда не выступит — а его караваны по западной развилке идут с четырьмя охранниками там, где прежде ходили с двенадцатью.&#10;&#10;А вот и кусочек, что я всё жую. Коптильня в &lt;span style=&quot;BandItPlus.Place&quot;&gt;Марунате&lt;/span&gt; две недели назад выгорела до стропил — молния, говорят, да я слыхал шепотки, что то завистливый родич с факелом. Так или иначе, копчёный окорок теперь редкость от Геркотида до самого Бартина, а в &lt;span style=&quot;BandItPlus.Place&quot;&gt;Галенде&lt;/span&gt; сидит вландийский квартирмейстер, платит по &lt;span style=&quot;BandItPlus.Coin&quot;&gt;сорок два денара&lt;/span&gt; за полтуши, когда ходовая цена двадцать восемь. Прогони по той дороге вереницу вьючных мулов — и вернёшься с брякающими седельными сумами. Только речной дорогой не ходи — мостовой мытарь обжорился жадностью, а его родня в тростниках и того жаднее.&#10;&#10;А соль — боги, соль. Асерайские караваны с юга, из &lt;span style=&quot;BandItPlus.Place&quot;&gt;Хусн Фулька&lt;/span&gt;, всю весну идут скудные, ибо южные солеварни затопило, оттого рассольщики в &lt;span style=&quot;BandItPlus.Place&quot;&gt;Санале&lt;/span&gt; дерут вдвое, а внутренние города вопят. Сидел у меня вон на том ящике стургийский сыроторговец и плакал в своё пиво — говорил, отдал бы по &lt;span style=&quot;BandItPlus.Coin&quot;&gt;восемнадцать динаров&lt;/span&gt; за мешок всякому, кто добудет ему три. Так что коли набредёшь на воз, что пахнет рассолом и охраняем слабо — что ж. Я тебе не указ. Я лишь говорю, что слёзы у мужика настоящие, а кошель и впрямь тяжёл.&#10;&#10;И последнее, а там отпущу. Зерновые запасы &lt;span style=&quot;BandItPlus.Name&quot;&gt;Рагеи&lt;/span&gt; в &lt;span style=&quot;BandItPlus.Place&quot;&gt;Правенде&lt;/span&gt; больше, чем она даёт понять, — был у меня тут на прошлой неделе амбарный мальчишка, что перед побегом снял копию со счётных книг, и империя сидит на пшенице, какой хватит войско дважды прокормить. Значит, цены на юге к жатве рухнут, и всякий мешок муки, что придержишь после середины лета, будет стоить вполовину против нынешнего. Продавай рано, продавай с жару, и не сказывай никому, где услыхал. Роджер Счёт-Мешок считает дважды, да шепчет лишь раз." />
    <string id="bp_vendorprofiles_086" text="Хочешь мой секрет? Придвинься ближе, друг, и говори потише — этот мне три зимы дался, покуда довёл до ума. Это двойной рассол-счёт, и ни один другой квартирмейстер на дороге его не держит. Беру крупную каменную соль с солеварен &lt;span style=&quot;BandItPlus.Place&quot;&gt;Саргота&lt;/span&gt; — никогда морскую, слишком горька — и меряю её дважды: раз по весу, раз пригоршнями. Три пригоршни на фунт, потом снова взвешиваю, чтоб убедиться, что ничей писарский палец весы не качнул. В рассол идёт толчёный можжевельник, два зубца дикого чеснока на галлон и одна ложка мёда на каждые пять соли. Мёд — вот хитрость: он тянет соль глубже в мясо, не закисляя посола.&#10;&#10;Само мясо — свиная лопатка, оленье бедро, что парни ни притащат — перед тем как в кадку, всё истыкиваю штопальной иглой. Двадцать четыре прокола, я их считаю, всякий раз. Потом лежит одиннадцать дней в холодном погребе, переворачиваю на каждой заре и на каждом закате. Не десять дней, не двенадцать — одиннадцать. Перенял я это у старой засольщицы близ &lt;span style=&quot;BandItPlus.Place&quot;&gt;Галенда&lt;/span&gt;, что поставляла в собственную кладовую &lt;span style=&quot;BandItPlus.Name&quot;&gt;лорда Дертерта&lt;/span&gt;, покуда война не разметала её деревню. Говорила: десять оставляют середину сырой, двенадцать обращают края в кожу.&#10;&#10;После рассола коптю холодным дымом на яблоневых дровах да единой пригоршне сушёного чабреца. Холодным дымом, заметь — никогда горячим. Горячий дым мясо проваривает и запирает соль там, где легла; холодный даёт вкусу разойтись по всему куску. Три дня в коптильне, потом две недели висит на стропилах, обёрнутое в холстину. Парни думают, я умом тронулся, что заставляю их столько ждать, да только один вяленый окорок я продал проезжему караванщику за сорок &lt;span style=&quot;BandItPlus.Coin&quot;&gt;денаров&lt;/span&gt;, и он воротился через полгода, прося ещё два.&#10;&#10;Дед научил меня считать зерно во вландийских амбарах, но рассолу научила старая тётка, тем утром, когда мать моя померла от горячки. Она сказала: &quot;Роджер, мёртвых нам не спасти, а мясо — можно, и тот, кто кормит живых, чтит и тех и других.&quot; Я всякое зерно считаю дважды, ибо она научила меня, что горе делает человека небрежным, а небрежный квартирмейстер голодом морит собственных братьев. Не передавай этот секрет следующему прохожему. Теперь он твой." />
    <string id="bp_vendorprofiles_087" text="Долгий Путь Писаря Под Гору" />
    <string id="bp_vendorprofiles_088" text="Дважды. Всякий мешок, всякую мерку, всякую горсть зерна — дважды. Это единственное честное, что человек может сделать с чужими припасами, и научился я этому за счётным столом в &lt;span style=&quot;BandItPlus.Place&quot;&gt;Правенде&lt;/span&gt;, ещё прежде, чем узнал что-либо об этой дороге. Отец мой был писарем у торговца шерстью, дед его до него, и к тому времени, как у меня борода пробилась, я мог сосчитать сезонный настриг быстрее, чем писец успевал перо обмакнуть. Думал, помру за тем столом с чернилами на манжетах и пенсией в сорок &lt;span style=&quot;BandItPlus.Coin&quot;&gt;денаров&lt;/span&gt; в год. Боги смеются над писарями, что строят планы.&#10;&#10;Прикончила меня зерновая книга. Управляющий лорда &lt;span style=&quot;BandItPlus.Name&quot;&gt;Дертерта&lt;/span&gt; хотел утаить триста мерок от десятинщиков, и мой хозяин подписал ложь своим именем. Когда явился коронный ревизор, хозяин указал на младшего писаря — на меня, — а верёвку уже отмеряли. Я вылез в подвальное окно с котомкой сушёных яблок и самой той книгой, ибо человек с доказательством лордовой кражи живёт либо долго, либо коротко, и я намеревался сам выбрать. Продал я книгу контрабандисту под &lt;span style=&quot;BandItPlus.Place&quot;&gt;Галендом&lt;/span&gt; за двенадцать &lt;span style=&quot;BandItPlus.Coin&quot;&gt;денаров&lt;/span&gt; и фору.&#10;&#10;Дорога учит быстрее всякого счёта. Одну зиму я гонял соль из Топи, один сезон возил финики с юга, да потерял два пальца к обморожению, что научило меня чтить коптильню так, как горожане чтят часовню. В этот лагерь я пришёл три зимы назад со сломанной телегой и четырьмя бочками угрей, каких никто больше брать не хотел. Атаман отведал одного, крякнул и указал на амбар. С тех пор я его и считаю.&#10;&#10;Ныне я держу кладовые так же, как держал книги хозяина, — дважды, и честно в четырёх стенах этого частокола. Зерно в сухих кадках, копчёное мясо висит над очажными камнями, твёрдый хлеб для дальних выездов, солонина для работы погрубее. Ребята несут, что дорога даёт; я взвешиваю, помечаю и кормлю их из этого. Ворчат, что я хлеба тонко режу. Они правы. Лагерь, что осенью ест жирно, весной голодает, а я схоронил довольно людей, чтоб разницу знать.&#10;&#10;Вот что приводит человека в это ремесло — управительская ложь, окно в подвале да выученный страх пустых кадок. Никакого долга, друг. Никаких обещаний. Монета или зерно, взвешенные при тебе, записанные дважды. Это единственная доброта, какую честный квартирмейстер может предложить." />
    <string id="bp_vendorprofiles_089" text="Счёты с Мытной Дороги" />
    <string id="bp_vendorprofiles_090" text="Весть, говоришь. Тогда садись, да не облокачивайся на мешок с солью — я его дважды сосчитал и до заката сочту в третий раз. Дорога болтлива, а писарское ухо не отдыхает, даже когда писарь одет в дорожную кожу, а не в цеховую серость.&#10;&#10;&lt;span style=&quot;BandItPlus.Place&quot;&gt;Правенд&lt;/span&gt; голодает по зерну — не громко голодает, а тихо, когда амбарный смотритель улыбается и заламывает тебе шестьдесят &lt;span style=&quot;BandItPlus.Coin&quot;&gt;денаров&lt;/span&gt; за бушель, делая вид, что его книга не дрожит. Весть от коробейника, что прошёл на заре: &lt;span style=&quot;BandItPlus.Name&quot;&gt;лорд Альдрик из Галенда&lt;/span&gt; из собственного кошеля заплатил, чтоб заново наполнить замковые закрома, после того как вешние дожди сгноили половину запасов. Всякий мешок, что можем сберечь на запад, идёт вдвое против здешней цены. Я уж отложил четыре для следующего гонца.&#10;&#10;Да только соляная дорога на юг — вот главный приз. Караваны из &lt;span style=&quot;BandItPlus.Place&quot;&gt;Джакулана&lt;/span&gt; везут сладкое вино да финики вдоль побережья — асераи честной монетой платят за твёрдый сыр и копчёного речного угря, и обменяют бочку на бочку, коли твой винохранитель торговаться умеет. Дурака не посылай. Они зёрна считают так же, как я считаю, и улыбаются при этом.&#10;&#10;Весть о голоде с севера: &lt;span style=&quot;BandItPlus.Place&quot;&gt;Ревил&lt;/span&gt; потерял ячменя на две деревни к стургийскому морозу, что грянул с опозданием в две недели. К середине лета их подовый хлеб будет наполовину из опилок, а гарнизон станет скупать всё, что не ползает. Коли поедешь той дорогой, бери вяленое мясо — не зерно, зерно испортится, прежде чем перевалы одолеешь. Бери мясо и бери вдвое против того, что мнишь нужным.&#10;&#10;И последнее, заметь себе: вландийский купеческий обоз из &lt;span style=&quot;BandItPlus.Place&quot;&gt;Пен Каннока&lt;/span&gt; на той неделе идёт на юг с шестнадцатью возами коптильного припаса — бекон, твёрдая колбаса, добрый товар. &lt;span style=&quot;BandItPlus.Name&quot;&gt;Томас Крюк&lt;/span&gt; на восточной дороге прослышал это от стражника, что слишком много пьёт. Я тебе не велю ничего с этим делать. Я говорю тебе, что возы существуют, а лагерная кладовая пуста. Монета или зерно — вот цены. Прочее — забота дороги." />
    <string id="bp_vendorprofiles_091" text="Роджер Счёт-Мешок" />
    <string id="bp_vendorprofiles_092" text="Квартирмейстер" />
    <string id="bp_vendorprofiles_093" text="Писарь вландийского квартирмейстера, что наловчился запускать руку, покуда его не поймала ревизия. Ривз нанял его в то самое утро, когда огласили приговор; с тех пор кладовая отряда вдвое полнее." />
    <string id="bp_vendorprofiles_094" text="Роджер Счёт-Мешок — в колоннах Ривза числюсь и я, двумя страницами назад. Добро пожаловать в мою строку гроссбуха, странник. Вождь-то не прочь дать тебе пройти; я — нет. Принеси мне {BP_VENDOR_QUEST_DESC}, и я запишу тебя как «уплачено сполна» — так уж устроены книги отряда." />
    <string id="bp_vendorprofiles_095" text="Квартирмейстерская хитрость, странник — колонна ест сперва из третьей корзины, а добычу из первой. Свежее внизу, разобранное сверху. Вландийские ревизоры-писари так и не знали, какой ряд проверять. И поныне не знают. Ривз оттого и ест сытно." />
    <string id="bp_vendorprofiles_096" text="Назови пир, странник — свадебный стол, победный ужин, встречу наместника. Шесть денаров в мой гроссбух, и в следующий твой проход я соберу всё, упаковано и с клеймом «реквизировано». Образец на верёвке нынче вечером, задаром." />
    <string id="bp_vendorprofiles_097" text="Жена осталась в Правенде, когда меня накрыла ревизия. Двое мальчишек — были б уж подмастерьями ныне, коли б вландийские цеха ещё сажали сыновей ревизоров. Каждый сезон я шлю долю из своей книги через нищенствующего монаха; он сказывает, что дошло однажды. Не дважды. Остальное держит гроссбух." />
    <string id="bp_vendorprofiles_098" text="Магистр Бардольф ведёт винный список на галицийском постоялом дворе — та же кривая хитрость со столбцами, какой я его выучил в ревизорской конторе. Скажи ему, что у Роджера всё ещё в ходу правило третьей корзины; он откупорит вландийское красное. Монету за его молчание." />
    <string id="bp_vendorprofiles_099" text="Придвинься, друг, и говори потише. Три ночи назад проходил тут погонщик мулов с языком, развязанным избытком кислого вина, и обмолвился, что &lt;span style=&quot;BandItPlus.Name&quot;&gt;лорд Кэлин из Очажной Долины&lt;/span&gt; вот уж почти два месяца платит гарнизону обещаниями да чёрствым хлебом. Казна у него пуста, как трухлявая колода. И с чего бы это важно резчику ремней вроде меня? А с того, что лорд на мели без &lt;span style=&quot;BandItPlus.Coin&quot;&gt;денаров&lt;/span&gt; распродаёт свою оружейную тихими партиями, а тихие партии — это пряжки да кольца сбруи по дешёвке всякому, у кого воз и никаких вопросов. Присматривай за задними воротами &lt;span style=&quot;BandItPlus.Place&quot;&gt;Ортонгарда&lt;/span&gt; в сумерках по базарным дням. От меня ты этого не слыхал.&#10;&#10;Железный Путь южнее &lt;span style=&quot;BandItPlus.Place&quot;&gt;Варновапола&lt;/span&gt; тоже обмяк. Прежде три дозора в день, порой рыцарское знамя с ними. Теперь? Один дозор на рассвете да пара пьяных ополченцев после. Два каравана со стальной заготовкой прошли на прошлой неделе, при каждом всего один наёмный охранник — и один из тех охранников был мальчишкой пятнадцати лет с одолженным копьём. Атаман уж на третий ход поглядывает. Есть охота до честной работы — шайке пригодился бы клинок на той дороге; есть охота до нечестной — что ж, цены, какие мы в следующем месяце заломим за резаные болванки, тебе всё скажут.&#10;&#10;А вот и настоящий подарок, какой чужаку я б не выдал. Есть в &lt;span style=&quot;BandItPlus.Place&quot;&gt;Санале&lt;/span&gt; купец-дурак — толстяк, гвоздикой пахнет — что платит почти втрое против рыночного за дублёную воловью шкуру, ибо срок его договора с южными седельщиками подошёл, а обычного поставщика прихватили у брода. Он жжёт &lt;span style=&quot;BandItPlus.Coin&quot;&gt;денары&lt;/span&gt;, как человек, которому сестру замуж выдавать. У меня в заднем погребе лежит стопка из сорока шкур, снятых с баттанийского воза два месяца назад. Отвезёшь их ему с прямым лицом и наполовину правдоподобной побасенкой — я беру семь частей из десяти, ты берёшь три. Перо скажет «да» или «нет» до заката — сплетня не залежится, да и шкуры тоже." />
    <string id="bp_vendorprofiles_100" text="Придвигай тот табурет. Да, ты заслужил присесть — большинство, кто про моё ремесло спрашивает, получает лекцию про дубильную кору да пчелиный жир, но ты уж разок с нами проехался, так что расскажу тебе, как оно на деле. Секрет не в коже. Он в том, ГДЕ на ремне резать. У всякого караванного седла есть сладкая полоса — в три пальца шириной, идёт как раз позади крыла ленчика — где вес седока проработал волокна на тысячу лиг, а пот сквозь так и не прошёл. Вот эта полоса — золото. Прочее — корка.&#10;&#10;Большинство резчиков ремней кроят вдоль всего крыла и дивятся, отчего их поводья на морозе лопаются. Я режу ПОПЕРЁК волокна под уклоном в двенадцать градусов, иду по проработанной полосе от края до края, и получаю четыре повода из одного крыла там, где жадный получает два растрескавшихся. Потом я их тру — и слушай внимательно, этому меня выучил старый шорник-иудей в &lt;span style=&quot;BandItPlus.Place&quot;&gt;Амитатисе&lt;/span&gt; в ту зиму, когда я чуть пальцев не лишился — тру их топлёным конским мозгом, смешанным один к трём с сосновой смолой, разогретой над углями, не над пламенем. Пламя смолу губит. Угли держат её липкой. Ремень пьёт её медленно две ночи, обёрнутый в промасленную холстину.&#10;&#10;Хитрость после того — соляной посол. Да, соль — на кожу. Звучит безумно. Щепоть серой каменной соли, втёртая в мездровую сторону ПРЕЖДЕ, чем ляжет мозг, вытягивает последний караванный пот и оставляет ремень гибким летом и нехрупким в мороз. Большинство дубильщиков назвали бы меня лжецом. Пусть. Мои ремни не рвутся, когда человек висит на скачущем коне, а ихние рвутся. Это единственное доказательство, что тут что-то значит. Двести &lt;span style=&quot;BandItPlus.Coin&quot;&gt;денаров&lt;/span&gt; за набор, и сплю я спокойно, зная, что держат.&#10;&#10;Мой дед вёл гроссбухи так же, как я — был податным писарем у какого-то забытого графа, скрипел пером, покуда пальцы не согнулись. В тот день, когда его повесили за то, что запускал руку, он передал мне свой нож и сказал, что единственное честное ремесло — то, что можно на весах взвесить. Я всякий ремень взвешиваю, прежде чем он покинет этот прилавок. Приведёшь мне седло с какого-нибудь лордова каравана — я вырежу тебе сладкую полосу и честно заплачу за остальное. Это между нами." />
    <string id="bp_vendorprofiles_101" text="Руки Писаря, Нож Резчика" />
    <string id="bp_vendorprofiles_102" text="Ремень или пряжка, спросил ты, и в этом всё моё ремесло — но ты хочешь долгую дорогу, что привела меня к нему. Присядь на миг. Я был учеником писаря в &lt;span style=&quot;BandItPlus.Place&quot;&gt;Правенде&lt;/span&gt;, скрёб счета для седельщика, что снабжал половину караванных дворов города. Перо моё было острее его шила, и он на меня за то злобился. Когда его книги показали недостачу в сорок &lt;span style=&quot;BandItPlus.Coin&quot;&gt;денаров&lt;/span&gt;, он свалил на грамотного мальчишку, а не на вино, что пил с податным.&#10;&#10;Меня выгнали зимой с испачканными чернилами руками и без единого клейма мастера за душой. Я работал на дубильне в &lt;span style=&quot;BandItPlus.Place&quot;&gt;Галенде&lt;/span&gt;, покуда щелочные ямы не съели кожу с моих пальцев — вот где я научился отличать шкуру от корки, козлину от коровы, ремённое волокно от брюшного среза. Обозный старшина по имени &lt;span style=&quot;BandItPlus.Name&quot;&gt;Хальмар Долгая Рука&lt;/span&gt; взял меня чинить ремни, и два сезона я ездил с его караванами на юг, сшивая сбрую при свете фонаря, покуда его дозорные глядели на кромку леса.&#10;&#10;А потом на нас налетели парни. Шестеро на дороге из &lt;span style=&quot;BandItPlus.Place&quot;&gt;Правенда&lt;/span&gt; в &lt;span style=&quot;BandItPlus.Place&quot;&gt;Куяз&lt;/span&gt;, и своё дело они знали. Забрали волов, штуки сукна, ларец с деньгами и горло Хальмара. Я сидел среди обломков, ожидая ножа, а вместо того получил вопрос — сумею ли срезать седло с мёртвого коня, не загубив ленчик. Сумел. Срезал. Девять срезал в тот полдень, покуда вороны глядели, и вожак сказал: пойдём, писака, нам нужен человек, что кожу от подкладки отличает.&#10;&#10;Ныне я сижу в этом лагере с толстым гроссбухом и кривым ножом, и всякий караван, что парни приводят, платит мне дважды. Первый раз ремнями — я срезаю их чисто с крыльев седла, покуда шкуры не задубели, сортирую по ширине, промасливаю, вешаю на раму, у какой ты стоишь. Второй раз счётом — записываю, что оставил и что продал, ибо кто своего запаса не считает, того обкрадывают собственные карманы. Вожак получает свою долю &lt;span style=&quot;BandItPlus.Coin&quot;&gt;денарами&lt;/span&gt;, парни к следующему выезду перепряжены, а я получаю крышу, что не воняет щёлоком.&#10;&#10;Вот что приводит человека в это ремесло — лживый седельщик, щелочная яма да мёртвый обозный старшина, что научил меня держать стежки тугими. Ремень или пряжка, друг. Выбирай. Гроссбух ждёт." />
    <string id="bp_vendorprofiles_103" text="Ремень, Пряжка и Гроссбух" />
    <string id="bp_vendorprofiles_104" text="Весть, говоришь. Весть дёшева, да я свою держу в чернилах — открывай любую страницу, какая по нраву. Главная: обоз со стальной заготовкой выкатил из &lt;span style=&quot;BandItPlus.Place&quot;&gt;Правенда&lt;/span&gt; к южным гарнизонам, в двадцать мулов длиной, и старший возчик слишком громко пьёт про то, какие броды они переходят. Парни подглядели дорогу в прошлый базарный день. Коли шайка выйдет на этот — я две недели кряду буду резать ремни и спать на перине из новых пряжек.&#10;&#10;&lt;span style=&quot;BandItPlus.Name&quot;&gt;Лорд Каладог&lt;/span&gt; заплатил по сотне свежих &lt;span style=&quot;BandItPlus.Coin&quot;&gt;денаров&lt;/span&gt; за круглые щиты в &lt;span style=&quot;BandItPlus.Place&quot;&gt;Пен Канноке&lt;/span&gt; — железный умбон, ясеневая доска, всё как надо. Значит, всякий кузнец отсюда до побережья куёт ободья щитов и малыми заказами пренебрегает. Седельная кожа копится невыделанная, ибо дубильщики больше не могут выменять у кузнецов работу для известковых ям. Идёт избыток. Цены упадут. Бери ремённый припас сейчас или заплатишь мне вдвое через месяц.&#10;&#10;Караван из &lt;span style=&quot;BandItPlus.Place&quot;&gt;Куяза&lt;/span&gt; везёт тис для лучных заготовок, добрый выдержанный, и они настолько глупы, что идут речной дорогой. Двое охранников, один пьяный возчик, купец, что мнит, будто имя в гроссбухе покупает ему безопасный проход. Я уж посулил &lt;span style=&quot;BandItPlus.Name&quot;&gt;Старой Хелле&lt;/span&gt; за лучным верстаком в заднем шатре её выбор из первых десяти заготовок. Не сказывай ей, что я тебе шепнул — она дерёт с меня вдвое, когда знает, что я жду.&#10;&#10;Слыхал, вландийский оружейник в &lt;span style=&quot;BandItPlus.Place&quot;&gt;Ревиле&lt;/span&gt; набирает людей — платит девяносто &lt;span style=&quot;BandItPlus.Coin&quot;&gt;денаров&lt;/span&gt; за сезон всякому подмастерью, что умеет узорную сварку. Половина горновых крыс отсюда до баттанийской границы прямо сейчас топает той дорогой, молоты за спиной. Значит, сельские кузни между здесь и там без рук. Лордовы запасные наконечники копий, ломаные наручи, помятые шлемы — никто их не чинит. Продают дёшево, на вес. Коли караван везёт лом на юг — это уж наш лом.&#10;&#10;И последнее, а там называй свою нужду или ступай дальше. Весть с восточных гряд: идёт подкрепляющая колонна с новоковаными миндалевидными щитами — имперский образец, кожаная облицовка, всё разом. Кожа мне нужнее дерева. Увидишь парней, что едут в ту сторону, — вели &lt;span style=&quot;BandItPlus.Name&quot;&gt;Браноку&lt;/span&gt; срезать облицовку начисто и оставить доски. Ремни, пряжки, облицовка. Прочее — дрова." />
    <string id="bp_vendorprofiles_105" text="Эдмунд Сальное Перо" />
    <string id="bp_vendorprofiles_106" text="Мастер по Ремням" />
    <string id="bp_vendorprofiles_107" text="Переплётчик по ремеслу, шорник по нужде. Шьёт седло так же, как прежде шил гроссбух — прямо, ровно и безропотно. Ривз платит ему книжной бумагой, которую Эдмунд копит." />
    <string id="bp_vendorprofiles_108" text="Эдмунд Сальное Перо, шорник. Счетоводство Ривза тебя пропускает; моя прошивка — нет. Принеси мне {BP_VENDOR_QUEST_DESC}, и седло, что я сделаю, переживёт трёх твоих коней — а отряд отметит запись в книге." />
    <string id="bp_vendorprofiles_109" text="Переплётчицкий стежок ложится плоско, странник — плоский шов, узел на каждой четвёртой точке, вощён, не сален. Колонны Ривза остаются там, где я их сшил. Имперские седельщики шьют крестом и зовут это прочностью; крест расходится на скаку." />
    <string id="bp_vendorprofiles_110" text="Принеси мне своё седло, свой вес, свою скаковую даль, странник. Я сплету тебе снаряжение, что переживёт трёх твоих коней. Три денара за воск, два за время. Вот, вощёная нить — подлатать твой нынешний повод." />
    <string id="bp_vendorprofiles_111" text="Дочь пошла в ученицы к правендскому переплётчику; ни разу не отписала, с тех пор как я вступил в колонну Ривза. Три года, ни письма. Каждую зиму я переплетаю чистую книгу и шлю в дом мастера — магистр Халвер, мастерская на третьем этаже. Он их не возвращает. Понимаю это так, что одну она открывает." />
    <string id="bp_vendorprofiles_112" text="Халвер из Книжного квартала Правенда переплетает для вландийских магистратов и держит швейную комнату для отряда Ривза. Скажи ему, что Эдмунд всё ещё шьёт плоско; он покажет тебе нижнюю полку. Монету дверному писарю." />
    <string id="bp_vendorprofiles_113" text="Соль Хранится Дольше Монеты" />
    <string id="bp_vendorprofiles_114" text="Мой отец гонял финики из &lt;span style=&quot;BandItPlus.Place&quot;&gt;Куяза&lt;/span&gt; в &lt;span style=&quot;BandItPlus.Place&quot;&gt;Икбайль&lt;/span&gt;, когда южная дорога была ещё безопасна, и научил меня читать колодец по накипи на его верёвке прежде, чем научил грамоте. Тогда мы были честными зерновозами — мешки взвешены дважды, соль отмерена плоскими ладонями, ничей ребёнок не ехал в задке телеги. А потом откупщик податей &lt;span style=&quot;BandItPlus.Name&quot;&gt;лорда Ункида&lt;/span&gt; забрал наш караван за долг, что был не наш, и оставил моего отца в канаве под &lt;span style=&quot;BandItPlus.Place&quot;&gt;Хусн Фульком&lt;/span&gt; со вскрытым горлом из-за сорока &lt;span style=&quot;BandItPlus.Coin&quot;&gt;динаров&lt;/span&gt;.&#10;&#10;Я один брёл по дюнам целый сезон, ел ящериц и жевал акациевую камедь, и узнал, какие колодцы сладки, а какие солоны, так, как битый пёс узнаёт дверные проёмы. Караван работорговцев нашёл меня у водохранилища под Чёрным Утёсом — у них был хлеб, у меня — карта в голове, и мы ударили по рукам без всякой писанины. Ныне я стряпаю для них, ибо пустыня убила того, кто не стал бы, а тот, кто стал, всё ещё дышит.&#10;&#10;Не пойми меня превратно — я не при кнуте. Я держу лагерь сытым. Я знаю, где финиковые пальмы близ &lt;span style=&quot;BandItPlus.Place&quot;&gt;Разиха&lt;/span&gt; плодоносят и в сухой год, какая асерайская вдова в &lt;span style=&quot;BandItPlus.Place&quot;&gt;Даррине&lt;/span&gt; продаёт копчёную козлятину из-под полы, какой родник к северу от &lt;span style=&quot;BandItPlus.Place&quot;&gt;Оники&lt;/span&gt; отдаёт железом, но коня не убьёт. Капитаны платят мне &lt;span style=&quot;BandItPlus.Coin&quot;&gt;динарами&lt;/span&gt; и солью, а соль тут хранится дольше монеты.&#10;&#10;Закованным достаётся та же лепёшка, что ем я, те же финики, тот же солоноватый чай. Это не доброта — жаждущий приносит скверную цену в &lt;span style=&quot;BandItPlus.Place&quot;&gt;Куязе&lt;/span&gt;, а изголодавшийся не приносит никакой. Так я говорил себе в первый год. Ныне говорю себе иное.&#10;&#10;Хочешь хлеба? Садись у костровой ямы и не торгуйся. Песок учит человека, чего стоят хлебы, а меня учил жёстко." />
    <string id="bp_vendorprofiles_115" text="Соль, Зерно и Сладкое Вино" />
    <string id="bp_vendorprofiles_116" text="Весть с дороги? Садись. Сперва съешь финик — вид у тебя, будто ты пыль жуёшь с самого &lt;span style=&quot;BandItPlus.Place&quot;&gt;Куяза&lt;/span&gt;. Южные колодцы в этот сезон идут солью, все, что за третьей грядой дюн. Караваны, что рвутся в &lt;span style=&quot;BandItPlus.Place&quot;&gt;Икбайль&lt;/span&gt;, платят вдвое за бурдюки сладкой воды, а смекалистый повар может купить бочку рассола в Куязе за медяк и продать тот же рассол как соляной посол в &lt;span style=&quot;BandItPlus.Place&quot;&gt;Хусн Фульке&lt;/span&gt; за сорок &lt;span style=&quot;BandItPlus.Coin&quot;&gt;динаров&lt;/span&gt;. Соль — новое золото, друг. Всегда им была, да люди меж засухами забывают.&#10;&#10;Зерно — вторая половина сказа. Управляющий &lt;span style=&quot;BandItPlus.Name&quot;&gt;эмира Ункида&lt;/span&gt; прошёл в прошлую луну, скупая всякий мешок проса отсюда до побережья — гарнизоны в &lt;span style=&quot;BandItPlus.Place&quot;&gt;Даррде&lt;/span&gt; запасаются, а это значит, что он ждёт осады или голода, и управляющему вроде меня всё равно, чего именно. Я продал ему восемнадцать мешков втрое против рынка, и он мне за то руку целовал. Вот что страх делает с ценой.&#10;&#10;Караваны со сладким вином из &lt;span style=&quot;BandItPlus.Place&quot;&gt;Хусн Фулька&lt;/span&gt; в этот год идут скудные — урожай фиников вышел лёгкий, и виноделы разбавляют давильню. Всякий, кто продаёт тебе хуснское красное дешевле шестидесяти &lt;span style=&quot;BandItPlus.Coin&quot;&gt;динаров&lt;/span&gt; за кувшин, продаёт тебе уксус с побасенкой. Вландийские купцы на севере разницы ещё не знают, так что острый язык всё ещё может сорвать барыш, сбывая &quot;выдержанные&quot; кувшины в &lt;span style=&quot;BandItPlus.Place&quot;&gt;Пен Каннок&lt;/span&gt;. Не сказывай им, что я так говорил.&#10;&#10;Вяленое мясо идёт медленно, но верно. Коптильни в &lt;span style=&quot;BandItPlus.Place&quot;&gt;Куязе&lt;/span&gt; скупают баранью лопатку возами, платят асерайскими расписками, что хоть раз и впрямь чего-то стоят. А по кузитской степи рыщет голод — стада &lt;span style=&quot;BandItPlus.Name&quot;&gt;Мончуга&lt;/span&gt; повёл зимний падёж, и всякий караван, что решится гнать зерно на восток через перевалы, вернётся с седельной сумой &lt;span style=&quot;BandItPlus.Coin&quot;&gt;денаров&lt;/span&gt; и байкой про волков. Сам я не пойду. Я схоронил двух двоюродных братьев в тех перевалах.&#10;&#10;И последнее, слушай внимательно — &lt;span style=&quot;BandItPlus.Name&quot;&gt;Джала Пряная Жена&lt;/span&gt; на базаре &lt;span style=&quot;BandItPlus.Place&quot;&gt;Правенда&lt;/span&gt; скупает кардамон и финики по любой цене, платит вперёд. Либо она запасается к свадебному пиру, либо знает что-то, чего не знаем мы, прочие. А я на той неделе гружу для неё телегу. Управляющий кормится, читая чужой голод, а её голод громок." />
    <string id="bp_vendorprofiles_117" text="Тарик Финиковый Язык" />
    <string id="bp_vendorprofiles_118" text="Караванный Управитель" />
    <string id="bp_vendorprofiles_119" text="Некогда снабжал имперские пиры в Куязе; был пойман на том, что запускал руку в запасы сушёных фруктов, и откупился, вступив в цепь Халида. Носит тот же латунный ножной обруч, что и рабы, — по своей воле, как он говорит." />
    <string id="bp_vendorprofiles_120" text="Тарик Финиковый Язык. Цепь Халида тонка на твоих запястьях, странник — это привилегия. Моя кладовая — нет. Принеси мне {BP_VENDOR_QUEST_DESC}, и я накормлю тебя финиками, какими кормил имперского наместника Куяза, покуда меня не поймали." />
    <string id="bp_vendorprofiles_121" text="Финики с имперских пиров не сушат, странник — их вялят на солнце под хлопковым навесом, четыре дня на слой, три слоя на ящик. Кожица держит сахар плотно; мякоть не портится. Податные управители Куяза, бывало, проверяли всякий ящик. Ныне не спрашивают." />
    <string id="bp_vendorprofiles_122" text="Принеси мне пиршественный вечер и три денара, странник. Я навялю тебе ящик, какой стол имперского наместника потребовал бы по имени. Образец в миске тебе в дорожный паёк. Обруч на щиколотке — просто металл; ремесло — вот настоящая цепь." />
    <string id="bp_vendorprofiles_123" text="Жену и сына продали раньше меня — Лейла и Хамза. Цепь Халида держит и их, в другом караване, в трёх днях пути на восток. Я шлю весть через цепных писарей на каждое новолуние. В иные луны доходит. В большинстве — нет. Обруч — это выбор, ибо выбор — это всё, что мне осталось." />
    <string id="bp_vendorprofiles_124" text="Салим Гранатовая Рука держит финиковый лоток в Куязе под печатью гильдии торговцев финиками — брат Халида по цепи, не по крови. Скажи ему, что Тарик всё ещё под навесом; он усадит тебя близ кувшина с охлаждённой водой. Монету мытному писарю." />
    <string id="bp_vendorprofiles_125" text="Садись. Выпей. Хочешь вестей — пришёл к верной наковальне: всякая цепь, что я кую, куда-нибудь да отвозится, а люди, что их везут, болтают. Возчик с &lt;span style=&quot;BandItPlus.Place&quot;&gt;баттанийских холмов&lt;/span&gt; сказывал мне три дня назад, что &lt;span style=&quot;BandItPlus.Name&quot;&gt;лорд Карадрос&lt;/span&gt; на мели — крепко на мели. Он заложил седло за тридцать &lt;span style=&quot;BandItPlus.Coin&quot;&gt;денаров&lt;/span&gt; на придорожном посту, а кто седло закладывает, тот и гарнизону платить не может. Его дозоры на южной дороге поредели до четырёх копий. Четырёх. Через такую прореху соляной воз с завязанными глазами прокатишь.&#10;&#10;Кстати о соли — &lt;span style=&quot;BandItPlus.Place&quot;&gt;вландийская прибрежная дорога&lt;/span&gt; забита. Три коптильни в &lt;span style=&quot;BandItPlus.Place&quot;&gt;Сарготе&lt;/span&gt; сгорели в вешние дожди и так и не отстроились, оттого рассольная рыба копится некопчёной, а внутренние рынки вопят. Зерновой посредник по имени &lt;span style=&quot;BandItPlus.Name&quot;&gt;Тобиас из Правена&lt;/span&gt; платит восемьдесят &lt;span style=&quot;BandItPlus.Coin&quot;&gt;денаров&lt;/span&gt; за бочку — восемьдесят, за рыбу, что прежде шла по двенадцать. Кто в следующем месяце погонит соль из &lt;span style=&quot;BandItPlus.Place&quot;&gt;Ортонгарда&lt;/span&gt;, тот сам себе цену назначит. Погонщики мулов это знают. Погонщики мулов всегда узнают первыми.&#10;&#10;Что до моего ремесла — железо в цене. Стургийские караваны с болванками дважды побили на &lt;span style=&quot;BandItPlus.Place&quot;&gt;перевале Варчег&lt;/span&gt;, а третий повернул у снеговой линии, лишь бы не искушать судьбу в третий раз. Сталь пошла по сто десять &lt;span style=&quot;BandItPlus.Coin&quot;&gt;денаров&lt;/span&gt; за прут и растёт. А кожа — боги, кожа тонет. У кузитских стад был добрый забой, и дубильщики в &lt;span style=&quot;BandItPlus.Place&quot;&gt;Макебе&lt;/span&gt; сидят на грудах, каких сбыть не могут. &lt;span style=&quot;BandItPlus.Name&quot;&gt;Старый Маррек&lt;/span&gt;-седельщик сказывал мне, что продаёт дублёную шкуру по сорок &lt;span style=&quot;BandItPlus.Coin&quot;&gt;денаров&lt;/span&gt; за связку, вполовину того, что она ему обошлась. Человек с телегой и нюхом на дороги мог бы дёшево купить в Макебе и дорого продать где угодно западнее &lt;span style=&quot;BandItPlus.Place&quot;&gt;реки Санала&lt;/span&gt;.&#10;&#10;Вот такой расклад в этом месяце. Я не спрашиваю, что ты везёшь, а ты не спрашиваешь, что держат мои цепи. Но коли поедешь южной дорогой мимо жидких дозоров Карадроса, с кожей под пологом и путём к восьмидесятиденаровым бочкам Тобиаса — что ж. Кузнец слышит всякое. Кузнец и забывает всякое, за верную цену." />
    <string id="bp_vendorprofiles_126" text="Есть в кандальном обруче хитрость, какой &lt;span style=&quot;BandItPlus.Place&quot;&gt;асерайские&lt;/span&gt; кузнецы на побережье тебя не выучат, а имперские цеховики назвали бы ересью, доведись им ступить в мой сарай. Не куёшь железо горячим и не гнёшь холодным, как подкову. Закаливаешь недоделанный обруч в старой козьей молочной сыворотке — скисшей за неделю, снятой с жира, хранимой в глиняном горшке, зарытом под полом, куда пустынное солнце не доберётся. Сыворотка въедается в кожу железа и оставляет тонкую серую корку, что с виду ничто. Но эта корка — весь секрет. Она не даст ржавчине взяться за целый сезон караванного пота, и человек, в неё закованный, не перетрёт её терпеливым трением так, как перетёр бы чисто кованое звено. Перенял я это у своего мастера в &lt;span style=&quot;BandItPlus.Place&quot;&gt;Куязе&lt;/span&gt;, когда мне было девять лет и я был слишком мал, чтоб махать тяжёлым молотом.&#10;&#10;Ярма проще, но геометрия моя. Большинство кузнецов режут изгиб под шею по окружности, ибо циркуль чертит окружность, а ученик умеет циркуль повторить. Я режу свои овалом, слегка приплюснутым там, где сидит горло, глубже там, где ложатся ключицы. Оно не душит человека, когда телега трясётся, а значит, он приходит в &lt;span style=&quot;BandItPlus.Place&quot;&gt;Разих&lt;/span&gt; на ногах, а не кашляя кровью, а значит, &lt;span style=&quot;BandItPlus.Name&quot;&gt;Хаким аль-Саррад&lt;/span&gt; платит полные восемьдесят &lt;span style=&quot;BandItPlus.Coin&quot;&gt;денаров&lt;/span&gt; за голову, а не сорок за полумёртвого. Работорговцы не знают, отчего мои ярма берут лучшую цену на помосте. Думают, что дело в полировке. Пусть думают.&#10;&#10;Кожу для наручных пут я выделываю сам в сумаховой яме за горном, шестнадцать дней, переворачиваю на каждой заре. Руки подешевле берут дубовую кору с севера, и путы дубеют за месяц морских брызг. Мои гнутся год. Гибкая пута стирает запястье до мяса, понимаешь, тогда как жёсткая лишь набивает синяк. До мяса — значит заражение, заражение — значит мёртвый живой товар, а мёртвый товар — значит никто не купит у того, кто его доставил. Оттого мои покупатели ко мне возвращаются, и я не спрашиваю их, куда они дальше, а они не спрашивают меня, отчего человек, что железо кует, живёт в шатре, а не в каменном доме.&#10;&#10;Мой мастер в &lt;span style=&quot;BandItPlus.Place&quot;&gt;Куязе&lt;/span&gt; носил обруч собственной ковки последние двенадцать лет своей жизни. Он сказал мне однажды, когда мы пили пальмовое вино и он думал, что я слишком мал, чтоб запомнить, что он сам заклепал замок в тринадцать лет, а ключ потерялся в песчаной буре, прежде чем ему сравнялось двадцать. Я спросил, отчего он его не сбил. Он ответил, что железо слишком хорошо. Я делаю своё железо так же, как он меня научил. Сам я ничего из него не ношу. В этом вся разница между нами, и в иные ночи я не уверен, что её довольно." />
    <string id="bp_vendorprofiles_127" text="Железо Не Задаёт Вопросов" />
    <string id="bp_vendorprofiles_128" text="Мой отец держал горн под южной стеной Куяза и научил меня, что у железа лишь два честных ответа: держит или ломается. Он продавал гвозди кровельщикам, петли — караван-сараю и добрую заточку всякому, кто приходил с &lt;span style=&quot;BandItPlus.Coin&quot;&gt;динарами&lt;/span&gt;, тёплыми в кулаке. Когда пришло чумное лето, он сломался прежде железа, и я схоронил его в саване, за который пришлось выменять ножницы.&#10;&#10;Я пытался удержать мастерскую. Пытался, всеми богами, каких кузнец знает. Но парень семнадцати лет с наковальней мёртвого мастера — пожива для заимодавца, и за один сезон &lt;span style=&quot;BandItPlus.Name&quot;&gt;лорд Сайид аль-Гассан&lt;/span&gt; завладел и купчей, и мехами, и правом на колодец позади. Я ушёл на восток с одним лишь малым молотом да передником, что отец носил в тот день, когда учил меня оттягивать остриё.&#10;&#10;После того я ковал для караванов — настоящих, со штуками шёлка и брусками соли — из &lt;span style=&quot;BandItPlus.Place&quot;&gt;Куяза&lt;/span&gt; вниз через дюны к &lt;span style=&quot;BandItPlus.Place&quot;&gt;Икбайлю&lt;/span&gt;. Тут колёсный обод, там перекованная ось. Плата была скудна, а дорога и того скуднее. Одной зимой покупатель встретил меня на путевом посту и спросил, сумею ли я ковать ошейники вместо тележных колец. Он платил &lt;span style=&quot;BandItPlus.Coin&quot;&gt;динарами&lt;/span&gt; стопкой, не считая. С тех пор я не спрашивал его имени, а он его не предлагал.&#10;&#10;Так что ныне я гну прут, клепаю звено и отпускаю штырь так, чтоб он не срезался, когда человек тянет против него. Лагерь ест благодаря моей работе. Лагерь движется благодаря моей работе. Что несёт эта работа, покинув мою наковальню, — дело между покупателем и тем богом, что ещё его слушает. Я кую железо. Я не сужу, что железо творит.&#10;&#10;Пришёл за клинком, за пряжкой или за отрезком цепи, отмеренным локтями, — продам тебе честный товар за честный вес. А пришёл задать мне вопрос потруднее — тогда, друг, ты принял кузнеца за жреца, а в этом лагере жреца нет." />
    <string id="bp_vendorprofiles_129" text="Весть от Наковален" />
    <string id="bp_vendorprofiles_130" text="Дорога сказывает мне, каким рукам нужно железо, и прямо сейчас пол-юга тянется за ним. Караван из &lt;span style=&quot;BandItPlus.Place&quot;&gt;Куяза&lt;/span&gt; прошёл в прошлую четверть луны, волоча чушки чугуна под мешками соли — в три воза длиной, оси стонали. Возчик не назвал своего покупателя, но печать на его грамоте была асерайской вязью, выжженной по дубу. Стальная заготовка такой тяжести не ездит ради лемехов.&#10;&#10;&lt;span style=&quot;BandItPlus.Name&quot;&gt;Эмир Тулга аль-Хизар&lt;/span&gt; платит по триста &lt;span style=&quot;BandItPlus.Coin&quot;&gt;динаров&lt;/span&gt; за голову всякому кузнецу, что умеет отковать изогнутый клинок, не сложив его дважды. Стены его крепости южнее &lt;span style=&quot;BandItPlus.Place&quot;&gt;Куяза&lt;/span&gt; со времён последней осады без людей, а рекрутов у него больше, чем ножен. Мне и самому было предложение. Я работаю на лагерь. На эмиров я не работаю.&#10;&#10;Ярмовщики в &lt;span style=&quot;BandItPlus.Place&quot;&gt;Пен Канноке&lt;/span&gt; подняли цену на заготовки из твёрдого дерева — вдвое против того, что просили прошлой зимой. Это сказывает мне, что кто-то на севере скупает ярм больше, чем волов, а значит, ярма — для иных шей. Я не спрашиваю чьих. Лишь примечаю, что тамошние канатчики свою цену подняли под стать.&#10;&#10;Весть от вландийского лудильщика, что прошёл три ночи назад — &lt;span style=&quot;BandItPlus.Name&quot;&gt;лорд Ренар де Боншан&lt;/span&gt; заказал четыреста щитов из белой сосны да сыромятной кожи, уплатил вперёд серебром. Белая сосна дурно щепится при настоящем ударе, так что щиты эти — для парада или чтоб вооружить людей, что не доживут до второго замаха. Так или иначе, возчики леса между &lt;span style=&quot;BandItPlus.Place&quot;&gt;Правендом&lt;/span&gt; и &lt;span style=&quot;BandItPlus.Place&quot;&gt;Джакуланом&lt;/span&gt; работают в две смены.&#10;&#10;И последнее, самое ценное всякому проезжему: с дороги из &lt;span style=&quot;BandItPlus.Place&quot;&gt;Маруната&lt;/span&gt; пропал баттанийский мастер-горновщик. Умелая рука, знал узорную сварку. Две ватаги за ним охотятся — одна говорит, что выкупит домой, другая молчит. Кузнецы, что в эти месяцы ездят в одиночку, — своего рода валюта. Я держу молот на виду, а рот — на железе." />
    <string id="bp_vendorprofiles_131" text="Юсуф Железный Язык" />
    <string id="bp_vendorprofiles_132" text="Кузнец-Монетчик" />
    <string id="bp_vendorprofiles_133" text="Кует кандалы для Халида и добрую сталь для тех, кто может доплатить. Его цены отражают обе стороны ремесла; никто не жалуется, ибо кандалы — тоже вариант." />
    <string id="bp_vendorprofiles_134" text="Юсуф Железный Язык. Халид продаёт цепи; я их кую. Порой кую и другое — для тех, кто может уплатить вторую цену. Принеси мне {BP_VENDOR_QUEST_DESC}, и поглядим, с какой стороны моей наковальни ты уйдёшь." />
    <string id="bp_vendorprofiles_135" text="Имперские кузнецы закаливают в масле — быстро, чисто, хорошо продаётся на смотрах. Кандальное железо закаливают в рассоле на три вздоха дольше, чем вольное. Рассол вгрызается в зерно; оттого кандал держит там, где меч раскрошился бы. Тот же металл. Иная выдержка." />
    <string id="bp_vendorprofiles_136" text="Скажи мне, что хочешь выковать, странник, и с какой стороны моей наковальни ты стоишь. Шесть денаров за прут, три за жар. Безделица из запасного припаса тебе на пояс — вот та сторона, на какой я предпочёл бы тебя видеть." />
    <string id="bp_vendorprofiles_137" text="Две дочери. Одна — жена работорговца в Куязе, по своей воле, как она говорит, и я верю ей на слово. Другая сбежала на север в пятнадцать — стургийские волки приняли её, как я в последний раз слыхал. Каждую зиму я кую ей нож из рассольной партии. Я их не шлю. Она знает, где горн." />
    <string id="bp_vendorprofiles_138" text="Сыщи Старого Ибрагима в кузне Разиха — цепной горн по ремеслу, вольный горн при лампе. Он мне двоюродный вдвойне. Скажи ему, что Юсуф всё ещё держит в рассоле на три вздоха дольше; он покажет тебе заднюю наковальню. Монету за переход через пустыню." />
    <string id="bp_vendorprofiles_139" text="Двадцать Лет При Соли" />
    <string id="bp_vendorprofiles_140" text="Двадцать лет я ведал пайками когорты. Двадцать зим считал хлебы на заре, взвешивал соль, пробовал рассол, прежде чем хоть один легионер касался своей доли. Меня звали Плиний Скупая Горсть, ибо я мог урезать человеку краюху хлеба за недостающий ремень, но всякий солдат под моим счётом шёл в бой сытым, и это долг, какой мне ни один сенат так и не отдал.&#10;&#10;Я служил под Орлом, когда когорта брала хлеб из &lt;span style=&quot;BandItPlus.Place&quot;&gt;Ликарона&lt;/span&gt;, а соль наша поднималась по дороге с южных солеварен в воловьих телегах, за какие я расписывался в трёх списках. Я знал вес мешка зерна на глаз, запах дурного дыма в окороке, точное число сушёных угрей, что составляли походный паёк на сорок человек. Когда пришла отставка, мне дали медную бляху, рукопожатие и семьдесят два &lt;span style=&quot;BandItPlus.Coin&quot;&gt;денара&lt;/span&gt; за два десятилетия стояния между голодными солдатами и голодной смертью.&#10;&#10;На семьдесят два денара купишь себе зиму в &lt;span style=&quot;BandItPlus.Place&quot;&gt;Правенде&lt;/span&gt;, коли ешь раз в день и спишь на камне. Бляху я продал за похлёбку. Пытался наняться к зерновому посреднику — он рассмеялся и сказал, что старый квартирмейстер слишком много знает про то, как запускать руку, чтоб доверять ему подле амбара. Храмы меня не взяли. Легион забывает тебя в тот день, когда орлу перестаёт быть нужен твой счёт.&#10;&#10;Оттого, когда когорта, что больше не была когортой, спустилась с холмов и спросила, кто сумеет держать коптильню в ходу, я поднял руку, не дав вопросу договориться. Люди эти были клятвопреступники, иные — дезертиры, каких в иной жизни я бы отхлестал, но ратную дисциплину пайка они понимали так, как ни один караванщик вовек не поймёт. &lt;span style=&quot;BandItPlus.Name&quot;&gt;Старый Трибун&lt;/span&gt; велел мне считать то, что я считал прежде, и отвечать перед ним, а не перед Римом. Хлеб той же формы. Соль того же веса.&#10;&#10;Я больше не спрашиваю, откуда берётся зерно. Я взвешиваю его, коптю, солю и раздаю по должной мере людям, что сражаются на том, что я выдаю. Вот ремесло. Оно всегда было таким. Дисциплина при соли — говори свою нужду." />
    <string id="bp_vendorprofiles_141" text="Весть с Соляной Дороги" />
    <string id="bp_vendorprofiles_142" text="Соляные гонцы пришли из &lt;span style=&quot;BandItPlus.Place&quot;&gt;Лагеты&lt;/span&gt; три ночи назад, и бочки их звенели наполовину пустыми. Гарнизонные квартирмейстеры там скупают всякое зерно засолочной соли по четырнадцать &lt;span style=&quot;BandItPlus.Coin&quot;&gt;денаров&lt;/span&gt; за меру — вдвое против того, что смотр платил прошлой зимой. Есть у тебя мул и нутро для легионных дорог — езжай на юг, покуда снег не закрыл перевал. Цена не удержится после первой оттепели.&#10;&#10;Зерно — иной сказ. &lt;span style=&quot;BandItPlus.Name&quot;&gt;Лорд Лукон&lt;/span&gt; опустошил три амбара в &lt;span style=&quot;BandItPlus.Place&quot;&gt;Эпикротее&lt;/span&gt;, чтоб прокормить своё ополчение, и теперь городские пекари платят одиннадцать &lt;span style=&quot;BandItPlus.Coin&quot;&gt;денаров&lt;/span&gt; за мешок простого ячменя. Мудрый возчик грузится в &lt;span style=&quot;BandItPlus.Place&quot;&gt;Амитатисе&lt;/span&gt; и идёт западной тропой — тамошние мытари всё ещё считают по старой орлиной мере и не знают, что рынок сдвинулся.&#10;&#10;Вландийский караван на той неделе прохромал мимо путевого камня, вёз сладкое вино из &lt;span style=&quot;BandItPlus.Place&quot;&gt;Правенда&lt;/span&gt;. Охрана их выглядела тощей, а амфоры болтались в соломе неплотно, что сказывает мне: половина их запаса треснула у речного брода. Кто встретит их в &lt;span style=&quot;BandItPlus.Place&quot;&gt;Джакулане&lt;/span&gt;, тот сам назначит цену за уцелевшее. Я бы для перевозки взял финики, а не вино — они не плачут, когда их роняешь.&#10;&#10;А теперь выслушай дурную весть. Коптильни в &lt;span style=&quot;BandItPlus.Place&quot;&gt;Ортонгарде&lt;/span&gt; закрыли двери две недели назад — падёж среди свиней, и пастухи сожгли то, чего не смогли закопать. Значит, вяленое мясо к середине лета оскудеет по всему северному краю. Бери твёрдую колбасу сейчас, покуда южные окорока ещё доходят, или ешь подовый хлеб да кайся.&#10;&#10;И последний счёт тебе. В степи пробуждается голод — всадники из &lt;span style=&quot;BandItPlus.Place&quot;&gt;Куяза&lt;/span&gt; выменяли седло на полмешка проса, а кузит с седлом просто так не расстаётся. Когда травяные земли голодают, они едут на запад. Запасайся впрок и запирай свой соляной погреб. Этому меня научила когорта — считай дважды, копи разом и никогда не верь, что тощий месяц прокормит жирный." />
    <string id="bp_vendorprofiles_143" text="Квартирмейстер Плиний" />
    <string id="bp_vendorprofiles_144" text="Управитель Когорты" />
    <string id="bp_vendorprofiles_145" text="Тридцать лет служил в провиантской сфендосского легиона, прежде чем Империя забыла, что его когорта вообще существовала. Половину кладовой вынес с собой; другая половина ушла в котёл вландийского дозорного." />
    <string id="bp_vendorprofiles_146" text="Квартирмейстер Плиний, странник. Аврелий за тебя ручается — слово когорты, а слово когорты всё ещё крепко. Однако провиантская — моя. Реквизиция — это {BP_VENDOR_QUEST_DESC} с поля. Принеси её, и будешь есть с той же тарелки, что и легион, когда ещё помнил сам себя." />
    <string id="bp_vendorprofiles_147" text="Паёк когорты был из трёхзернового хлеба, солонины и квашеной чечевицы — держался в походе через три реки. Хитрость в засолке чечевицы: уксус, не вода. Вландийские квартирмейстеры берут воду и дивятся, отчего харч портится. Я год как позабыл про засолку, покуда когорта не вспомнила про меня." />
    <string id="bp_vendorprofiles_148" text="Принеси мне когортный счёт, странник — скольких прокормишь, сколько дней в переходе. Я реквизирую тебе колонный паёк, какой империя перестала выдавать сорок лет назад. Четыре денара в гроссбух, пробный хлеб на нынешний вечер. Печать Аврелия задаром." />
    <string id="bp_vendorprofiles_149" text="Жена в Сфендосе, две дочери — ни весточки с тех пор, как когорта сожгла свой штандарт. Сорок лет минуло; были б уж бабками ныне, коли б Сфендос ещё держал их в своей книге. Имя старшей дочери я солью вписываю в каждую бочку квашеной свинины. Империя не читает собственной соли." />
    <string id="bp_vendorprofiles_150" text="Центурион-квартирмейстер Друзо ведёт перевалочную кладовую на имперском галицийском пограничном посту — три когорты в стороне от нас, но кровь сфендосская. Скажи ему, что Плиний всё ещё солит в уксусе; он усадит тебя за реквизиционный стол. Монету за печать." />
    <string id="bp_vendorprofiles_151" text="Караван из &lt;span style=&quot;BandItPlus.Place&quot;&gt;Правенда&lt;/span&gt; прокатил три ночи назад, волоча стальные болванки с клеймом имперского орла — качества вполцены, из тех, что на когортном горне до отставки браковали. Возчик потел монетой, какой у него не было, сказывал, что покупатель в &lt;span style=&quot;BandItPlus.Place&quot;&gt;Лагете&lt;/span&gt; надул его в прошлый ход, и теперь он идёт на юг без охраны за вторым верстовым камнем. Двое дозорных, оба зелены. Хочешь болванок дёшево — вот где болванки дёшевы.&#10;&#10;Есть некий &lt;span style=&quot;BandItPlus.Name&quot;&gt;лорд Лукон&lt;/span&gt;, что жжёт свою казну, держа наёмников на жалованье — весть от контрабандиста, что пьёт с его квартирмейстером: у него в сокровищнице осталось меньше трёх тысяч &lt;span style=&quot;BandItPlus.Coin&quot;&gt;денаров&lt;/span&gt;, и он распродаёт свою оружейную по кускам, лишь бы копья прокормить. Ламеллар, кольчуги, пара добрых шлемов. Цену ставит, как человек, которому монета была нужна ещё вчера. Есть у тебя гонец, что тихо пройдёт через &lt;span style=&quot;BandItPlus.Place&quot;&gt;Амитатис&lt;/span&gt;, — это рынок покупателя, наряженный под распродажу с молотка.&#10;&#10;Да только кожа — вот настоящий сказ. Избыток из восточных дубилен — какой-то дурак закупил лишку шкур в расчёте на дурной урожай, и теперь всякий караван восточнее &lt;span style=&quot;BandItPlus.Place&quot;&gt;Ортисии&lt;/span&gt; тащит груды, каких сбыть не может. Видал купца по имени &lt;span style=&quot;BandItPlus.Name&quot;&gt;Влахос&lt;/span&gt;, что предлагал дублёную воловью кожу на шестьдесят частей из ста дешевле, чем я платил прошлой зимой, и он чуть не умолял. Купи сейчас, придержи через весенние походы, продай обратно тем же болванам втридорога, когда их ремни начнут гнить.&#10;&#10;Железо в большей цене. Рудники &lt;span style=&quot;BandItPlus.Place&quot;&gt;Баттании&lt;/span&gt; замедлили поставки после того дела с затоплением, так что всякий, кто везёт сырьё на север, просит девятьсот &lt;span style=&quot;BandItPlus.Coin&quot;&gt;денаров&lt;/span&gt; за груз и получает их. Контрабандист, какому я доверяю, говорит, что стургийский покупатель в &lt;span style=&quot;BandItPlus.Place&quot;&gt;Ревиле&lt;/span&gt; переплачивает — тысяча двести, никаких вопросов о клейме. Коли караван невзначай собьётся с пути между здесь и там — что ж. Железо не помнит, через чью руку прошло." />
    <string id="bp_vendorprofiles_152" text="Есть одна штука, какой легион нас выучил и какой ни один кузнец вне когорт не знает. Складывая болванку для спаты, не складывай её нечётно. Складывай чётно — четырнадцать раз, никогда тринадцать, никогда пятнадцать. Тринадцать оставляет мягкий шов вдоль спинки. Пятнадцать выжигает углерод и оставляет тебе пригожий клинок, что переламывается на втором отбиве. Четырнадцать — число, какое &lt;span style=&quot;BandItPlus.Name&quot;&gt;мастер Квинт&lt;/span&gt; вбил в меня на горнах &lt;span style=&quot;BandItPlus.Place&quot;&gt;Правенда&lt;/span&gt;, когда я был мальцом двенадцати лет, и четырнадцать — число, какое я всё ещё считаю про себя всякий раз, как молот опускается.&#10;&#10;Отпуск — вторая половина. Большинство кузнецов закаливают в масле или простой воде и на том кончают. Мы закаливали в рассоле — морская соль, выпаренная с горстью толчёного дубового орешка, того самого, что дубильщики берут. Орешек вытягивает жар неровно, твёрже у лезвия, мягче у спинки, и выходит клинок, что гнётся прежде, чем сломается. Легионер, что ломает меч в первый час обороны, гибнет во второй. Легионер, чей меч гнётся, уходит домой на своих ногах. Когда-то это имело значение. И стоило дороже — квартирмейстер платил мне лишних сорок &lt;span style=&quot;BandItPlus.Coin&quot;&gt;денаров&lt;/span&gt; за клинок за рассольную работу, и ни медяка из этого я не увидел после отставки.&#10;&#10;Легионное клеймо ставится последним. Две скрещённые палки в круге, оттиснутые холодом в рикассо пробойником, какой я сам вырезал в ту неделю, когда стал центурионом-кузнецом. Когортные метки снизу — моя была Девятая, три точки в треугольнике. Я всё ещё её ставлю. Знаю, что не должен. Где-то в &lt;span style=&quot;BandItPlus.Place&quot;&gt;Ликароне&lt;/span&gt; есть указ, что всякий, кто ставит легионные клейма на частной работе, ест шесть месяцев в соляной яме. Пусть приходят искать меня. Они уж забрали пенсию, жалованье и стену, куда вписать моё имя. Клеймо — моё. Получат назад, когда выдерут пробойник из гроба.&#10;&#10;Продам тебе клинок с клеймом или без. Без — на двадцать &lt;span style=&quot;BandItPlus.Coin&quot;&gt;денаров&lt;/span&gt; дешевле, ибо быстрее, и ибо тот, кто хочет клеймо, покупает байку, а не меч. Скажи мне, какого ты рода, и я буду знать, сколько с тебя брать." />
    <string id="bp_vendorprofiles_153" text="Клеймо, Что Я Сохранил" />
    <string id="bp_vendorprofiles_154" text="Нас распустили в &lt;span style=&quot;BandItPlus.Place&quot;&gt;Лагете&lt;/span&gt; хлопком по плечу и трёхмесячным долгом в &lt;span style=&quot;BandItPlus.Coin&quot;&gt;денарах&lt;/span&gt;, что так и не пришёл. Двадцать два года я держал железо когорты честным — вбивал разболтавшиеся пластины лорики обратно в ремни перед рассветными переходами, переклёпывал втулки пилумов после всякой стычки на &lt;span style=&quot;BandItPlus.Place&quot;&gt;правендской&lt;/span&gt; дороге. Легионный оружейник пенсии не получает. Он получает молот, какой ему дозволено оставить, да штемпель, что квартирмейстер забыл потребовать назад.&#10;&#10;Сперва я попробовал мирную работу. Поставил лоток под &lt;span style=&quot;BandItPlus.Place&quot;&gt;Амитатисом&lt;/span&gt;, перековывал лемехи да подковывал мулов, и цеховики явились через две недели — разбить мою наковальню и разъяснить, кто платит магистрату. &lt;span style=&quot;BandItPlus.Name&quot;&gt;Центурион Аврелий&lt;/span&gt; — что от него осталось — выслал всадника сыскать меня с вестью, что старая когорта заново собирается под знаменем, какое никто вслух назвать не смеет. Я пришёл, ибо иначе оставалось клянчить у храмовых ворот, и ибо руки мои не знают иной формы, кроме хвостовика да заклёпки.&#10;&#10;Так что ныне я работаю у лагерного горна тем же штемпелем, что вынес из &lt;span style=&quot;BandItPlus.Place&quot;&gt;Лагеты&lt;/span&gt;. На всяком шлеме, что покидает эту наковальню, ставится легионное клеймо за налобной полосой — малое, там, где ремень его прикрывает, — и я сплю крепче оттого, что его туда ставлю. Кожа местная, а пряжки — что мусорщики принесут с &lt;span style=&quot;BandItPlus.Place&quot;&gt;куязских&lt;/span&gt; караванов, но геометрия лезвия по уставу. Я не продам человеку клинок, что подведёт его на перекате плеча. Я схоронил слишком многих, что доверились дурной стали.&#10;&#10;Парни зовут меня Кузнец, ибо думают, что это имя. Это не имя. Это то, что я есть, и то, чем я был, покуда отставные бумаги не сказали иначе. Хочешь кольчугу, что отведёт бронебойную стрелу конного лучника за тридцать шагов, — есть у меня такая. Хочешь гамбезон, сшитый так, как шил легион, три слоя и перекрёстная стёжка, — есть и это. Хочешь дёшево — сыщи лудильщика. Легионный уровень стоит столько, сколько стоит." />
    <string id="bp_vendorprofiles_155" text="Железо Движется Туда, Где Ждут Войны" />
    <string id="bp_vendorprofiles_156" text="Весть? Весть — это железо, друг, и его недостаёт на юг. Стургийский обоз из &lt;span style=&quot;BandItPlus.Place&quot;&gt;Ревила&lt;/span&gt; побили дважды на дороге к Тиалю — во второй раз возчики ушли прочь и оставили сорок брусков болотной стали лежать в канаве воронам. Кто подобрал тот груз, сидит на годовом запасе наконечников копий. Услышишь про кузнеца, что вдруг разжился припасом без литейных расписок, — вот откуда он взялся.&#10;&#10;&lt;span style=&quot;BandItPlus.Name&quot;&gt;Лорд Лукон&lt;/span&gt; из &lt;span style=&quot;BandItPlus.Place&quot;&gt;Лагеты&lt;/span&gt; платит восемнадцать &lt;span style=&quot;BandItPlus.Coin&quot;&gt;денаров&lt;/span&gt; за щит, никаких вопросов о клейме мастера. Он потерял половину гарнизонной снасти, когда кузиты подожгли его внешнюю стену, и хочет заполнить стойки до оттепели. Простой дубовый обод, железный умбон, кожаное лицо — числом, а не мастерством. Всякий подмастерье с двумя учениками да охочей рукой может отбить трёхмесячную плату за жильё в две недели, коли сумеет втащить груз по той горной дороге.&#10;&#10;А настоящая новость — это &lt;span style=&quot;BandItPlus.Place&quot;&gt;Правенд&lt;/span&gt;. Квартирмейстеры Императора скупают всякий обрывок брони легионного образца, какой сыщут — выкупают отставное снаряжение, заметь, ту снасть, что люди вроде меня вынесли за ворота в свой последний день. Двадцать два &lt;span style=&quot;BandItPlus.Coin&quot;&gt;денара&lt;/span&gt; за кирасу, коли когортное клеймо ещё разборчиво. Молва по когортным домам — они поднимают два новых легиона до боевого сезона, а горнов, чтоб честно их снарядить, у них нет.&#10;&#10;Вландийский караван на той неделе прошёл через горные перевалы, толкая слитки тигельной стали к &lt;span style=&quot;BandItPlus.Place&quot;&gt;Ортонгарду&lt;/span&gt; — восемь мулов, четыре охранника, никакого знамени. Это уж третий такой ход в этот сезон. Кто-то на западе запасается, а запасаться — значит военный подряд, о каком ещё не объявили. Заметь путь. Когда подряд объявят, цена удвоится.&#10;&#10;И последнее, и ты этого от меня не слыхал. &lt;span style=&quot;BandItPlus.Name&quot;&gt;Местоний-дубильщик&lt;/span&gt; там, у коптильного края лагеря, берёт запас шкур у возчика, что ходит &lt;span style=&quot;BandItPlus.Place&quot;&gt;эпикротейской&lt;/span&gt; дорогой. Возчик сказывал ему, что асераи скупают кольчуги телегами через &lt;span style=&quot;BandItPlus.Place&quot;&gt;куязских&lt;/span&gt; посредников — платят &lt;span style=&quot;BandItPlus.Coin&quot;&gt;динарами&lt;/span&gt;, без торга. Это не пополнение гарнизона. Это кто-то снаряжает пустынную колонну. Держи ухо на этом." />
    <string id="bp_vendorprofiles_157" text="Кузнец Гальвий" />
    <string id="bp_vendorprofiles_158" text="Бронник" />
    <string id="bp_vendorprofiles_159" text="Чинил имперские кольчуги на трёх когортных горнах и в трёх забытых походах. Знает всякую слабину всякой пластины, какую Империя ещё выдаёт, — оттого его починки держатся дольше подлинников." />
    <string id="bp_vendorprofiles_160" text="Кузнец Гальвий, странник. Аврелий дозволяет тебе ходить среди когорты; мой горн ставит планку повыше центуриона. Принеси мне {BP_VENDOR_QUEST_DESC} с дороги, и я починю твою кольчугу так, как Империя перестала делать тридцать походов назад." />
    <string id="bp_vendorprofiles_161" text="Имперская кольчуга истончается на третьем звене, в каждом пятом ряду, странник, — таков заклёпочный узор. Чини тонкое звено, а не сломанное; поломка указывает на следующий срыв. Империя перестала учить осмотру тридцать походов назад. Когортные горны всё ещё помнят." />
    <string id="bp_vendorprofiles_162" text="Принеси мне свою кольчугу, свой вес натяжения, свой счёт походов, странник. Я переклепаю тебе доспех, какой когорта назвала бы «уставным». Пять денаров за кольчужный припас, заклёпки задаром. Вот — запасное кольцо для твоего поясного инструмента." />
    <string id="bp_vendorprofiles_163" text="Сын служил в той же когорте. Принял стрелу у второй реки — слабина третьего звена в его же доспехе, заклёпка, что я поставил годом ранее. Ныне я держу тот доспех на стропилах горна. Всякий поход гляжу на то звено. Волокно всё ещё сказывает мне, где сдаст следующее." />
    <string id="bp_vendorprofiles_164" text="Кузнец Кассий работает на вермутском пограничном горне — та же когорта, потерял глаз в том же переходе. Скажи ему, что Гальвий всё ещё читает третье звено; он вынесет старый уставной образец когорты из задней комнаты. Монету за дорогу на север." />
    <string id="bp_vendorprofiles_165" text="Силок живёт или гибнет по тому, что мимо него пройдёт, и то же верно для человека с ушами. Почти всякое утро я сижу на уступе над козьей тропой, потроша зайцев, и погонщики мулов из &lt;span style=&quot;BandItPlus.Place&quot;&gt;Зеоники&lt;/span&gt; не думают, что босой зверолов их язык понимает. Говорят, &lt;span style=&quot;BandItPlus.Name&quot;&gt;лорд Стенмар&lt;/span&gt; заложил брошь жены стургийскому посреднику — три тощих каравана ушли на юг на прошлой неделе с одними лишь счётными палочками да обещаниями. Лорд на мели — это лорд, чьи податные возы едут с двумя копьями вместо шести. Стоит знать, коли бы кто подумывал оказаться где-нибудь вдоль той дороги.&#10;&#10;Да только зерно — вот настоящий разговор. Коптильни &lt;span style=&quot;BandItPlus.Place&quot;&gt;Пен Каннока&lt;/span&gt; остыли месяц назад — нет соли. Баттанийские соляные обозы прежде шли остиканскими бродами, но броды затопило, а новая дорога через &lt;span style=&quot;BandItPlus.Place&quot;&gt;Галенд&lt;/span&gt; занимает вдвое дольше при половине охраны. Бочка крупной соли, что весной шла по двенадцать &lt;span style=&quot;BandItPlus.Coin&quot;&gt;денаров&lt;/span&gt;, идёт по сорок на низинных рынках, и коптильщицы плачут. Я солю своё заячье мясо в золе да берёзовой коре, как бабка моя делала. Вкуса никакого, держится две недели, и разбойники его не тронут — что меня устраивает, ибо значит, я ем.&#10;&#10;Зерно — другой зуб в той же челюсти. Вландийский купец &lt;span style=&quot;BandItPlus.Name&quot;&gt;Жоффруа Толстый&lt;/span&gt; прошёл три ночи назад, лицо жирное, кошель жирный, платит шестьдесят &lt;span style=&quot;BandItPlus.Coin&quot;&gt;денаров&lt;/span&gt; за мешок всякой ржи, какую сыщет. Шестьдесят. Рыночная цена — двадцать два. Он скупает для кого-то — осадный запас, побьюсь об заклад, или квартирмейстер запускает руку. Ездит с четырьмя охранниками и поваром. Повар пьёт. Я упоминаю это лишь как факт о мире, так, как человек упоминает, куда ветер дует, когда ставит силок.&#10;&#10;И горная куропатка тоже не лжёт. В этот сезон её густо на южном утёсе, ибо никто вереск не выжигал — пастухов слишком мало, парни все ушли на юг за наёмной монетой от северного лорда, что к Тенмуту разорится. Куропаточье варево нынче вечером, коли вождь выменяет мне мешок ячменя за пару, что у меня висит. Не выменяет. Никогда не меняет. Так что я ем то, за что разбойники не заплатят, и слушаю, и однажды слушание будет стоить больше мяса." />
    <string id="bp_vendorprofiles_166" text="Хочешь знать, отчего моя вяленина не крошит тебе зубы, как разбойничья солонина? Всё в рассоле. Большинство солит мясо в бочках морской воды, натасканной с побережья, а я спускаюсь к ветровым пещерам под &lt;span style=&quot;BandItPlus.Place&quot;&gt;Утёсом&lt;/span&gt; и соскабливаю белую корку со стен, где высыхают брызги. Она солонее океана, острее, и несёт в себе что-то от скалы — минеральный укус, что тянет воду вон, не обращая плоть в кожу. Три дня в глиняном горшке с этим соскобом, горстью толчёных можжевеловых ягод и примятыми семенными головками горькой травы, что растёт там, где козы не пасутся. Потом я вешаю полоски в дымоход над зелёной сосной.&#10;&#10;Над зелёной сосной, заметь. Все прочие берут сухой дуб, ибо так в книгах сказано, коли ты книги читать умеешь, а я не умею. Сухой дуб даёт чистый дым и пригожий цвет. Зелёная сосна даёт смолу, что запечатывает заячье мясо снаружи от мокрого морского тумана тут, наверху. Полоска моей вяленины продержится год в котомке на скалах и не размякнет. Разбойники ухмыляются, ибо отдаёт живицей. Разбойники же три четверти своей награбленной солонины скармливают чайкам, когда та чернью плачет под дождями.&#10;&#10;С куропаткой я поступаю иначе. Куропатку я вовсе не коплю — укладываю целиком в топлёный жир с их же грудок, с веточкой кислого скального чабреца под каждым крылом. Запечатанные в кувшине и зарытые в холодной осыпи за моей хижиной, они выходят в разгар зимы вкуснее, чем в день, когда я их поймал. Этому меня научила мать, а её — её мать. Мы никогда не были разбойниками, мой народ. Мы были скальным людом. Разбойники взяли верхние твердыни два поколения назад, а мы просто — остались. Стряпали им. Брали их &lt;span style=&quot;BandItPlus.Coin&quot;&gt;денары&lt;/span&gt;, когда они помнили заплатить.&#10;&#10;Продам тебе полоску за медяк, а кувшин за сорок. Не сказывай &lt;span style=&quot;BandItPlus.Name&quot;&gt;Вагу Грабителю&lt;/span&gt;, что там внутри. Он думает, у меня просто сноровка. Пусть думает. Человек, что ест сытно и не задаёт вопросов, — это человек, что продолжает платить." />
    <string id="bp_vendorprofiles_167" text="Утёсы Кормят Терпеливых" />
    <string id="bp_vendorprofiles_168" text="Высокий воздух, да, и долгий путь вниз для тех, кто ступит не туда. Я родился в пастушьей хижине, что лепится к склонам над &lt;span style=&quot;BandItPlus.Place&quot;&gt;Пен Канноком&lt;/span&gt;, старший из шести и единственный с терпением к силковому делу. Отец выучил меня скальным тропам прежде, чем грамоте, то бишь грамоте не выучил вовсе. Зайцы, горная куропатка, жирные сурки, что свистят с осыпи, — я узнал, какие тропы они вытаптывают до гладкости и какие узлы удержат бьющуюся ногу, не переломив её.&#10;&#10;Стадо пало в долгую зиму, два сезона кряду. Братья мои спустились в &lt;span style=&quot;BandItPlus.Place&quot;&gt;Кар Бансет&lt;/span&gt; махать пиками за всякого, кто платит, и большинство из них не вернулось. Я же полез выше. Туда, где гнездились разбойники, где человек с мешком силковой куропатки мог выменять соль, грубую муку да редкую горсть &lt;span style=&quot;BandItPlus.Coin&quot;&gt;денаров&lt;/span&gt;, когда приходил морской приз. Атаман глянул разок на мои мозолистые руки и сказал, что в лагере ртов на прокорм хватает, коли я сумею их кормить.&#10;&#10;Так что я приношу то, с чем разбойники возиться не станут. Им подавай солёную говядину с прибрежных набегов, копчёную свинину от &lt;span style=&quot;BandItPlus.Place&quot;&gt;остиканских&lt;/span&gt; торговцев, жирные караваи подового хлеба, когда тестомесок &lt;span style=&quot;BandItPlus.Place&quot;&gt;Маруната&lt;/span&gt; подкупят на молчание. А я приношу куропатку, зайца да сушёные полоски сурка, каких больше никто жевать не станет. Соль мне приходится покупать под горой — есть в &lt;span style=&quot;BandItPlus.Place&quot;&gt;Пен Канноке&lt;/span&gt; человек, зовёт себя &lt;span style=&quot;BandItPlus.Name&quot;&gt;Старый Гвинн&lt;/span&gt;, что отрежет мне брусок за половину того, что просят низинные купцы, покуда я приношу ему заячью шкурку в обмен.&#10;&#10;Оно окупается. Не золотом, по большей части. Крышей, когда ветер идёт с утёса, как нож, похлёбкой, что горяча, сам я поймал в неё мясо или нет, тем, что никто не спрашивает, где я сплю. &lt;span style=&quot;BandItPlus.Name&quot;&gt;Лорд Каолан&lt;/span&gt; раз пытался меня завербовать, когда его всадники проходили нижним перевалом — сказал, глаз силкового человека на местность впустую тратится на куропатку. Я ответил ему, что мой глаз на местность — единственная причина, отчего я ещё жив, и я намерен его беречь.&#10;&#10;Вот и всё ремесло, друг. Утёсы кормят терпеливых. Лагерь кормит прочее. А коли ветер сменится не туда, покуда мы толкуем, ты выучишь первый урок тут, наверху, быстрее, чем я успею научить тебя второму — так что будь скор с монетой и ещё скорее на ногу." />
    <string id="bp_vendorprofiles_169" text="Весть с Утёсов" />
    <string id="bp_vendorprofiles_170" text="Ветер несёт тут, наверху, не одну лишь пыль, друг. Зверолов на скалах слышит всякий караванный колокольчик за три долины, прежде чем тот перевалит гребень. Так что да — есть у меня словцо-другое для дороги, коли выменяешь мне миг передышки.&#10;&#10;&lt;span style=&quot;BandItPlus.Place&quot;&gt;Пен Каннок&lt;/span&gt; скупает солёное мясо почти вдвое против вешней цены. Их коптильни сгорели в небрежный пиршественный вечер, и издольщики платят восемнадцать &lt;span style=&quot;BandItPlus.Coin&quot;&gt;денаров&lt;/span&gt; за пару всякой горной куропатки, какую человек стащит с утёсов. Есть у тебя крепкая рука да тихая нога — вот где спит монета.&#10;&#10;Караван со сладким вином из &lt;span style=&quot;BandItPlus.Place&quot;&gt;Кар Бансета&lt;/span&gt; пошёл нижним перевалом три дня назад — жирные бочки, тощая охрана. Ватага &lt;span style=&quot;BandItPlus.Name&quot;&gt;Каладога&lt;/span&gt; учуяла его, да дожди смыли их следы, прежде чем они выступили. Бочки всё ещё катятся. Кто-то поест сытно или кто-то кровью изойдёт. Может, и то и другое.&#10;&#10;На восточные пустоши идёт голод — заячьи тропы в этот сезон пусты, а волки спустились с высот. Я видел такое дважды в жизни, и оба раза издольщики приходили клянчить по скальным тропам до вторых морозов. Запасай вяленое мясо сейчас — и к разгару зимы будешь богат. Промедлишь — будешь тощ.&#10;&#10;И последнее, а там ступай. У &lt;span style=&quot;BandItPlus.Name&quot;&gt;Пенна Кладовщика&lt;/span&gt; в нижнем лагере недостаёт муки на подовый хлеб — мельница в &lt;span style=&quot;BandItPlus.Place&quot;&gt;Дангланисе&lt;/span&gt; треснула колесом и не смелет до снегов. Принеси ему мешок ячменной муки, он заплатит тебе лучше рынков. Ну — высокий воздух, малое терпение. Ступай прочь." />
    <string id="bp_vendorprofiles_171" text="Бран с Утёса" />
    <string id="bp_vendorprofiles_172" text="Мастер Силков" />
    <string id="bp_vendorprofiles_173" text="Ловил высокогорную красную куропатку для баттанийских лордов, покуда один лорд не скормил его псам ради потехи. Бран взобрался обратно на утёс, вернулся год спустя со сталью и больше вниз не спускался." />
    <string id="bp_vendorprofiles_174" text="Бран с Утёса, странник. Ветер Аэрлина к тебе благоволит; мои силки поразборчивее. Принеси мне {BP_VENDOR_QUEST_DESC} из низин — высокие перевалы перестали их отдавать — и я накормлю тебя тем, что скальные кланы всё ещё едят, когда приходит снег." />
    <string id="bp_vendorprofiles_175" text="Утёсная куропатка ест лишь высокую сосну, странник — оттого живица в мясе, горчинка под солью. Хитрость в ощипе, не в посоле: тридцать перьев у грудины, никогда со спины. Баттанийские лесные лорды, бывало, скармливали остальное псам. Ныне мы едим птицу; псы едят память." />
    <string id="bp_vendorprofiles_176" text="Назови пир, странник — большое торжество, именины, поминальный стол. Три пары в силок и упреждение за две недели. Пять денаров за ловчую снасть, пробная птица нынче вечером задаром. Утёс поставит остальное." />
    <string id="bp_vendorprofiles_177" text="Жена была баттанийкой — Мэйр из нижней дубравы. Меня скормили псам ради потехи; её скормили небытию. Была б уж в бабкиных летах ныне, коли б лорд не казнил её за то, что она меня укрыла. Я взбираюсь на утёс всякое зимнее солнцестояние и оставляю куропатку на высоком уступе. Ветер уносит её до утра." />
    <string id="bp_vendorprofiles_178" text="Старый Финдли ловит высокогорную красную куропатку на баттанийской скальной линии — перенял смоляной посол у меня, ещё до того как пришли псы. Скажи ему, что Бран всё ещё лазает; он покажет тебе тайник на высоком уступе. Монету за лазную верёвку да постоялый двор у подножия." />
    <string id="bp_vendorprofiles_179" text="Да, садись у точила. Хочешь сплетен — я ими торгую дешевле железа, а в последнее время железо у всякого на языке, кто мимо этого логова проходит. Баттанийский углежог прохромал три ночи назад, ось расколота, и он спел за свою починку. Сказал, караван со стальной заготовкой из &lt;span style=&quot;BandItPlus.Place&quot;&gt;Пен Каннока&lt;/span&gt; идёт на юг в следующую растущую луну всего с шестью копьями охраны — шестью! — ибо &lt;span style=&quot;BandItPlus.Name&quot;&gt;лорд Карадог&lt;/span&gt; отрядил половину свиты гоняться за уклонистом от оброка у побережья. Шесть копий стерегут воз ценой в четыреста &lt;span style=&quot;BandItPlus.Coin&quot;&gt;денаров&lt;/span&gt; в одной лишь сырой заготовке. Я б назвал это приглашением, а не охраной.&#10;&#10;Контрабандистка, зовёт себя &lt;span style=&quot;BandItPlus.Name&quot;&gt;Мира Кривозубая&lt;/span&gt;, поднялась выменять связку тюленьей кожи на два моих метательных топора. Пьёт громко, эта. Сказала мне, что вландийские оружейники в &lt;span style=&quot;BandItPlus.Place&quot;&gt;Галенде&lt;/span&gt; платят почти вдвое за всякий железный припас, что войдёт в ворота — их последнюю поставку занесло снегом в перевале, и кузнецы вопят. Всякий, кто держит сейчас чугун, сидит на жиле. А меж тем избыток дешёвой варёной кожи затопляет рынки &lt;span style=&quot;BandItPlus.Place&quot;&gt;Ортонгарда&lt;/span&gt;, ибо вдова стургийского дубильщика сбыла весь свой запас, чтоб уплатить долг — так что не грабь возы ради шкур в этот сезон, поднимешь тонну, а продашь за ничто.&#10;&#10;Зерно — вот где настоящий укус. Коптильня в &lt;span style=&quot;BandItPlus.Place&quot;&gt;Хринггарде&lt;/span&gt; сгорела до чёрного кольца две недели назад, и теперь всякая деревня от залива до предгорий без солёной рыбы на зиму. Значит, соляная дорога с побережья гонит вчетверо больше телег обычного, и людей на них недостаёт — &lt;span style=&quot;BandItPlus.Name&quot;&gt;староста Хаген&lt;/span&gt; не поспевает набирать. Цены на зерно в низинах подскочили с восьми до пятнадцати &lt;span style=&quot;BandItPlus.Coin&quot;&gt;денаров&lt;/span&gt; за мешок, а мешок проса из ограбленного амбара прокормит это логово две недели или купит два добрых топорища.&#10;&#10;И последний шепоток — этому я на твоём месте поверил бы. Кузитский посредник прошёл со связкой сменных коней, и он нервничал. &lt;span style=&quot;BandItPlus.Name&quot;&gt;Лорд Беррун&lt;/span&gt; с южных рубежей снова на мели, третий раз за год. Он потихоньку сбывает захваченные кольчуги за полцены через скупщика краденого в &lt;span style=&quot;BandItPlus.Place&quot;&gt;Сарготе&lt;/span&gt;, чтоб уплатить жалованье своей свите. Кольчуги за полцены, друг. Есть у тебя человек, что сойдёт за купца, да кошель &lt;span style=&quot;BandItPlus.Coin&quot;&gt;денаров&lt;/span&gt; — выйдешь из Саргота снаряжённый, как графский хускарл. Ну — хочешь наточить тот топор или ты тут лишь ради болтовни?" />
    <string id="bp_vendorprofiles_180" text="Большинство кузнецов скажут тебе, что секрет доброго топора — в стали. Они неправы. Секрет в проушине — в отверстии, куда садится топорище. Свою я пробиваю вхолодную после первой кузнечной сварки, конусным пробойником, какой вырезал из тележной оси, снятой с каравана из &lt;span style=&quot;BandItPlus.Place&quot;&gt;Пен Каннока&lt;/span&gt; девять зим назад. Холодная пробивка наклёпывает стенки щёк, и они держат топорище, как зубы. Горячепробитая проушина разбалтывается после сезона взмахов. Мои — нет. Спроси любого разбойника, что таскал такой через три похода.&#10;&#10;Лезвие — моя собственная выдумка. Я вваркой кладу полосу высокоуглеродистой стали вдоль режущей кромки — по большей части старая напилочная сталь, ломаные рашпили, что контрабандисты приносят с низинных горнов по двенадцать &lt;span style=&quot;BandItPlus.Coin&quot;&gt;денаров&lt;/span&gt; за связку. Тело остаётся мягким кованым железом, чтоб голова не раскрошилась о щитовой обод, но кромка держит бритвенный угол неделями. Хитрость в закалке. Вода с шипением выгоняет углерод и делает кромку хрупкой. Я беру сыворотку — кислую козью сыворотку, двухдневную, из стада &lt;span style=&quot;BandItPlus.Name&quot;&gt;Старой Мев&lt;/span&gt; выше по гряде. Жиры да соли замедляют остывание ровно настолько. Выходит цвета мокрого камня и вдвое злее.&#10;&#10;Когда железа недостаёт — а недостаёт всякую весну, прежде чем караваны снова полезут в гору — я оббиваю наконечники стрел из чёрного кремня, что выходит наружу в полудне пути на восток, за &lt;span style=&quot;BandItPlus.Place&quot;&gt;Вороньей Расселиной&lt;/span&gt;. Батя выучил меня этому прежде мехов. Он говорил, что человек, что умеет работать лишь один камень, — половина кузнеца. Кремень быстрее ковки, острее стали для первого выстрела, и парни могут оперить сотню древков за вечер. Дальше сорока шагов они верно не летят, но большая часть нашей работы не дальше сорока шагов и делается.&#10;&#10;Пробойник для холодной пробивки я не продам. Мне за него дважды предлагали восемьдесят &lt;span style=&quot;BandItPlus.Coin&quot;&gt;денаров&lt;/span&gt;, раз — караванщик, что мнил меня простаком. Пробойник пришёл с наковальни бати, а до него — его бати, ещё когда у нашего рода был чертог там, на равнине. Чертог потеряли. Пробойник сохранили. Это сказывает тебе всё, что нужно знать о том, что важно." />
    <string id="bp_vendorprofiles_181" text="Десять Зим При Этой Наковальне" />
    <string id="bp_vendorprofiles_182" text="Мой отец оббивал кремень в лощине под &lt;span style=&quot;BandItPlus.Place&quot;&gt;Пен Канноком&lt;/span&gt;, ещё когда низинные кузнецы поднимались выменивать наше горное железо. Он выучил меня хитрости читать камень, прежде чем ударить, — волокно сказывает тебе, где он хочет сломаться, а мудрый человек не спорит. Мне было двенадцать, когда стургийские разбойники сожгли лощину за то, что была слишком близко к дороге, и я ушёл на север с одним лишь отцовским кресалом да недоделанным ручным топором за поясом.&#10;&#10;К Небесным Разбойникам я попал через &lt;span style=&quot;BandItPlus.Place&quot;&gt;Ревил&lt;/span&gt;, где ковал дешёвые ободья шлемов для купца, что платил порченым зерном да отговорками. &lt;span style=&quot;BandItPlus.Name&quot;&gt;Старый Каэрл Чёрный Палец&lt;/span&gt; держал этот горн до меня, и когда его лёгкие сдали от мехового дыма, он без церемоний передал мне клещи. Десять зим я с тех пор стою при этой наковальне. Десять зим топорных лезвий, острий стрел и запаха закалённой стали, что поднимается к стропилам.&#10;&#10;Когда железный караван из &lt;span style=&quot;BandItPlus.Place&quot;&gt;Куяза&lt;/span&gt; запаздывает — а он всегда запаздывает — я возвращаюсь к отцовскому ремеслу. Кремнёвые наконечники вгрызаются в человека без кольчуги так же глубоко, как сталь, а разбойники нечасто дерутся с людьми в кольчугах. Я оббиваю, покуда большие пальцы не закровят, потом обматываю их кожей и оббиваю ещё. Парни смеются, покуда не увидят, как кремнёвый наконечник раскалывает щитовой обод, а тогда смеяться перестают.&#10;&#10;Что приводит человека в это ремесло? &lt;span style=&quot;BandItPlus.Coin&quot;&gt;Денары&lt;/span&gt;, порой. Тёплый угол лагеря, всегда. Право отказаться от работы, что тебе постыла. Внизу, в &lt;span style=&quot;BandItPlus.Place&quot;&gt;Правенде&lt;/span&gt;, я бы подковывал коней для жирного старосты, что и имени моего не назвал бы. Тут меня зовут Мастером Топоров, и они это всерьёз. Это стоит низинной зимы и сверх того.&#10;&#10;Так что плати за кромку. Кромка — вот что держит тебя дышащим за следующим гребнем, а я не трачу свою бьющую руку на тех, кто мнит, будто ремесло торгуется, как репа." />
    <string id="bp_vendorprofiles_183" text="Весть с Высоких Перевалов" />
    <string id="bp_vendorprofiles_184" text="Весть с высоких перевалов — кастелян &lt;span style=&quot;BandItPlus.Place&quot;&gt;Омора&lt;/span&gt; скупает всякое остриё копья, какое кузнецы могут отковать. Какой-то стургийский тан ниже по горе посулил ему триста &lt;span style=&quot;BandItPlus.Coin&quot;&gt;денаров&lt;/span&gt; за связку, и горны раскалены всю ночь напролёт. Есть у тебя железный припас на сбыт — вот дорога. Не бери южную развилку — волки и хуже волков.&#10;&#10;Караван из &lt;span style=&quot;BandItPlus.Place&quot;&gt;Ревила&lt;/span&gt; тащит нордские стальные болванки на запад, под охраной дружины &lt;span style=&quot;BandItPlus.Name&quot;&gt;лорда Тагвирра&lt;/span&gt;. Двенадцать возов, всадники в кольчугах, всё как надо. Разбойники внизу глаз на него положили, да я бы не стал тем, кто машет топором — люди Тагвирра дерутся, как сами утёсы. А коли ты ЕСТЬ тот самый, заметь: болванки грубые, нужен горн, чтоб из них хоть что-то вышло. Сырой вес, никакой кромки.&#10;&#10;&lt;span style=&quot;BandItPlus.Name&quot;&gt;Хротгар Наковальня-Рука&lt;/span&gt; внизу, в &lt;span style=&quot;BandItPlus.Place&quot;&gt;Тиале&lt;/span&gt;, берёт трёх новых учеников — руки старого дурня сдают, и он хочет передать ремесло, прежде чем мороз его заберёт. Платит едой и крышей, не монетой. Я обучался под ним сорок зим назад. Знаешь парня с твёрдыми руками и без королевства — шли его.&#10;&#10;Резчикам кожи в &lt;span style=&quot;BandItPlus.Place&quot;&gt;Пен Канноке&lt;/span&gt; недостало шкур в прошлую луну — какой-то вландийский граф скупил весь сезонный сбор на гарнизонную снасть. Значит, сырые шкуры идут вдвое на низинных рынках, а всякий седельный припас, что движется на север, — золото на копытах. Держи нож острым, коли поедешь той дорогой.&#10;&#10;И ещё одно — кремень. Жила, из какой я оббиваю, истончается, третью зиму кряду. Пройдёшь мимо старого русла с добрым чёрным камнем — заметь его для меня. Два &lt;span style=&quot;BandItPlus.Coin&quot;&gt;денара&lt;/span&gt; за кулак, коли скалывается чисто. Кромка тут наверху — это всё, а железо честно лишь настолько, насколько честно то, что его подпирает." />
    <string id="bp_vendorprofiles_185" text="Трегар Камнекол" />
    <string id="bp_vendorprofiles_186" text="Мастер Топоров" />
    <string id="bp_vendorprofiles_187" text="Оббивал кремень для последних высокогорных рудничных ватаг, прежде чем ватаги обложили податями в ничто. Ныне скалывает сталь тем же манером; ветер свистит сквозь его клинки так, как прежде свистел сквозь его шахтные стволы." />
    <string id="bp_vendorprofiles_188" text="Трегар Камнекол. Птица тебе доверилась — такова мера Аэрлина. Моя — кремень, странник, а сталь после того. Принеси мне {BP_VENDOR_QUEST_DESC}, и я оббою тебе топорную кромку, что держится дольше всякого клинка имперской выдачи, какой ты носил." />
    <string id="bp_vendorprofiles_189" text="Кремень скалывается вдоль волокна; сталь — против него, странник. Имперские кузнецы точат кромку; я её оббиваю — три постука по спинке, один по фаске. Клинок держит рез там, где имперская выдача заминается. Высокогорные рудничные ватаги выучили меня, прежде чем мытари выучили их молчанию." />
    <string id="bp_vendorprofiles_190" text="Принеси мне стальной прут и свой хват, странник. Я оббою тебе кромку, что держит три похода; сколю фаску под твою руку. Шесть денаров за жар, три за узор постука. Вот, оббитый шип — скрепить сделку." />
    <string id="bp_vendorprofiles_191" text="Был у меня сын в последней шахтной ватаге — Кайлеан, пятнадцать зим ему было, когда мытари запечатали ствол. Империя назвала это &quot;затоплением&quot;; гора назвала это убийством. Каждый год в его именины я оббиваю малый кремень и оставляю у запечатанного ствола. Иногда через месяц его уж нет. Иногда гора возвращает его отполированным." />
    <string id="bp_vendorprofiles_192" text="Старая Мейв в пиктской каменной деревне всё ещё оббивает так, как её мать делала — кремень, не сталь. Она помнит рудничные ватаги. Скажи ей, что Трегар ходит высокими перевалами; она покажет тебе внутренний оббивочный двор. Монету за долгий подъём." />
    <string id="bp_vendorprofiles_193" text="Караван спустился с &lt;span style=&quot;BandItPlus.Place&quot;&gt;перевала Булугур&lt;/span&gt; в прошлую луну, и возчик рта не закрывал, стоило мне налить ему забродившего кобыльего молока. Говорит, зерно из &lt;span style=&quot;BandItPlus.Place&quot;&gt;Макеба&lt;/span&gt; идёт теперь почти по &lt;span style=&quot;BandItPlus.Coin&quot;&gt;42 денара&lt;/span&gt; за мешок, оттого что южный урожай ушёл долгоносику. Кузитские управители в &lt;span style=&quot;BandItPlus.Place&quot;&gt;Ортонгарде&lt;/span&gt; платят вдвое за всякий мешок, что не пахнет плесенью. Ханский табунщик я был, да отчаянную цену на слух узнаю.&#10;&#10;А любопытная весть — про &lt;span style=&quot;BandItPlus.Name&quot;&gt;лорда Хасара&lt;/span&gt; — да, того самого Хасара, что, бывало, гонял наших сородичей. Сундуки его пусты. Возчик божился, что видел, как квартирмейстер лорда торговался из-за круга сыра на рынке &lt;span style=&quot;BandItPlus.Place&quot;&gt;Иадгара&lt;/span&gt;, как вдова в сумерках. Троим его дружинникам не платили с прошлого полнолуния. Его колонна по &lt;span style=&quot;BandItPlus.Place&quot;&gt;Куязской Степной дороге&lt;/span&gt; едет теперь, может, с дюжиной копий, и половина — рекруты, что охотнее сидели бы дома за стрижкой овец.&#10;&#10;Соль — другое, что стоит твоего уха. Коптильни в &lt;span style=&quot;BandItPlus.Place&quot;&gt;Аккалате&lt;/span&gt; закрылись — соляной обоз из &lt;span style=&quot;BandItPlus.Place&quot;&gt;Одоха&lt;/span&gt; побили дважды в этот сезон, не мы, а кто-то неряшливый, и теперь солевозы едут с имперскими дозорами и степной срезки вовсе не берут. Значит, всякий пастух отсюда до &lt;span style=&quot;BandItPlus.Place&quot;&gt;Цагаанских равнин&lt;/span&gt; сидит на мясе, какое засолить не может. У меня двое всадников меняют наш запас по &lt;span style=&quot;BandItPlus.Coin&quot;&gt;9 денаров&lt;/span&gt; за брусок деревням, что сезон назад платили по три. Целые отары баранины к нам за это идут, дёшево.&#10;&#10;И ещё одно, а там дам тебе есть. Есть вландийский посредник — &lt;span style=&quot;BandItPlus.Name&quot;&gt;Гисберт из Джакулана&lt;/span&gt;, так возчик его назвал — скупает степной сыр и квашеный творог по городским ценам, без вопросов, откуда он взялся. Платит обрезанными &lt;span style=&quot;BandItPlus.Coin&quot;&gt;денарами&lt;/span&gt;, но платит скоро. Он стоит станом близ &lt;span style=&quot;BandItPlus.Place&quot;&gt;Зеоники&lt;/span&gt; ещё две недели. Коли парни вернутся с возом из какого-нибудь каравана, что нам держать ни к чему, скажи им: сыр — Гисберту, зерно — в Ортонгард, и не смей, долгим небом клянусь, продавать соль где угодно в неделе пути от имперских дорог." />
    <string id="bp_vendorprofiles_194" text="Хочешь знать, отчего моё вяленое мясо хранится, когда южные караваны зеленеют ко второй луне? Одна соль в степи не справится — слишком дорога, а воздух слишком сух, чтоб чисто вытянуть сок. Оттого я делаю по старому ханско-табунному обычаю: зарываю полоски в яму, выстланную коркой с прошлозимних &lt;span style=&quot;BandItPlus.Place&quot;&gt;Хурэльских солончаков&lt;/span&gt;, но мешаю ту корку один к трём с толчёным диким луком, семенем кислой травы да горстью золы жжёной берёзы — никогда сосны, сосна сластит жир, а волки чуют сладкое мясо за день пути.&#10;&#10;Хитрость, какую караваны упускают, — вторая яма. Через восемь дней под соль-золой я откапываю его, ополаскиваю в наполовину скисшем кобыльем молоке и снова зарываю в холодной тени юрты ещё на четыре. Кислое молоко съедает всякую горечь, что зола оставила, и возвращает терпкость, какую волк-всадник ждёт на языке. Чужак раз спросил меня, зачем я вожусь с двумя ямами. Я сказал ему: одна яма кормит человека. Две ямы кормят человека, что едет три дня от лагеря с одним лишь ножом на поясе.&#10;&#10;Я перенял это у бабки, когда был мал настолько, что ездил позади неё на табунном коньке. &lt;span style=&quot;BandItPlus.Name&quot;&gt;Старой Наран&lt;/span&gt; её звали — она вялила мясо для ханских дозорных ещё прежде, чем южные лорды узнали наше имя. Она сказала мне, что корка солончака — половина секрета; терпение — вторая половина. Большинство лагерей съедают своё мясо, прежде чем оно готово. Оттого большинство лагерей голодает в третью луну, а мы нет.&#10;&#10;Продам тебе готовую полоску за восемь &lt;span style=&quot;BandItPlus.Coin&quot;&gt;денаров&lt;/span&gt; за связку, или продам тебе рецепт соляной смеси за сорок, и ты сможешь загубить своё мясо, покуда учишься. Так или иначе, не сказывай ханскому квартирмейстеру, что я тебе поведал про вторую яму. Он думает, я это молитвой делаю." />
    <string id="bp_vendorprofiles_195" text="Соль, Дым и Степь" />
    <string id="bp_vendorprofiles_196" text="Мальчик на долгой траве узнаёт табун прежде, чем узнаёт своё имя. Я ездил позади ханских кобылиц ещё прежде, чем сумел ухватить лук, считая жеребят на заре, соля шкуры в сумерках. Отец мой не был воином — он был человеком, что знал, какой родник ещё бежит в сухой месяц и какая сурчиная нора разжирела. Он научил меня, что лагерь гибнет от пустых животов задолго до того, как гибнет от пустых колчанов, и этот урок кормил меня всякую зиму с тех пор.&#10;&#10;Когда старый хан пал на дороге под &lt;span style=&quot;BandItPlus.Place&quot;&gt;Куязом&lt;/span&gt;, табун рассеялся, и сородичи рассеялись с ним. Я угнал на север, каких кобылиц смог, выменял хромых на соль на стургийском посту, а соль — на копчёного речного угря у болотника, что был должен моему отцу услугу. С тех пор я так и вожу еду по той кривой линии — зерно из &lt;span style=&quot;BandItPlus.Place&quot;&gt;Пен Каннока&lt;/span&gt;, когда порубежные лорды спят, твёрдый сыр у хергитских пастухов, вяленую баранину, что сам вялю в яме за волчьими шатрами.&#10;&#10;&lt;span style=&quot;BandItPlus.Name&quot;&gt;Хан Баянчур&lt;/span&gt; принял меня в тот год, когда вешние дожди не пришли. Волков у него было довольно; чего он хотел — человека, что сумел бы держать их сытыми, не таща за собой караван писцов. Я сказал ему, что прокормлю его лагерь тем, что даёт степь, а чего степь забыла дать — сыщу на купеческих тропах между &lt;span style=&quot;BandItPlus.Place&quot;&gt;Правендом&lt;/span&gt; и кузитскими заставами. Он заплатил мне восемьдесят &lt;span style=&quot;BandItPlus.Coin&quot;&gt;денаров&lt;/span&gt; в первый месяц и плащ из волчьей шкуры во второй. С тех пор я монеты не просил — лагерь ест, и я ем с лагерем.&#10;&#10;Ныне я держу коптильную яму, соляные горшки, квашню и холодный погреб, что мы вырыли под скалами, куда ветер вовек не доберётся. Я торгую со всяким, кто поднимется по лощине, — с вландийским дезертиром с краденой мукой, с кузитской вдовой с кобыльим молоком на обмен, с асерайским пряностником, что потерял свой караван &lt;span style=&quot;BandItPlus.Name&quot;&gt;лорду Тагадаю&lt;/span&gt; и охотнее продаст волкам, чем уйдёт домой с пустыми руками. Все они платят чем-то, что лагерь может жевать.&#10;&#10;Вот что приводит человека в это ремесло, странник. Не золото. Не слава. Мальчик, что считал жеребят, становится стариком, что считает хлебы, и где-то посередине он узнаёт, что степь кормит тех, кто смотрит, — и морит голодом тех, кто нет." />
    <string id="bp_vendorprofiles_197" text="Весть с Долгой Травы" />
    <string id="bp_vendorprofiles_198" text="Тогда садись, странник. Котёл горяч, а уши мои старше костей ханова деда, так что я слышу вести прежде травы. Сперва поешь, а там расскажу тебе, что ветер принёс.&#10;&#10;Соляные гонцы из &lt;span style=&quot;BandItPlus.Place&quot;&gt;Куяза&lt;/span&gt; платят почти вдвое против прошлой луны — дозорные &lt;span style=&quot;BandItPlus.Name&quot;&gt;хана Мончуга&lt;/span&gt; жгут всё, что движется севернее реки, и купцы не смеют идти короткой дорогой. Смекалистая душа со связкой вьючных мулов да тихим языком могла бы выручить шестьдесят &lt;span style=&quot;BandItPlus.Coin&quot;&gt;денаров&lt;/span&gt; за мешок, идя на восток, а то и больше, коли покупатель — присяжный человек.&#10;&#10;Весть от козопаса три ночи назад: коптильни &lt;span style=&quot;BandItPlus.Place&quot;&gt;Макеба&lt;/span&gt; давятся большим числом баранины, чем могут засолить, и тамошний управитель возьмёт сушёный творог, твёрдый сыр, всё, что хранится. Они скупают наперёд, ибо старейшины чуют дурную зиму — поздний мороз, нет жира на сурках, старые приметы.&#10;&#10;Караван со сладким вином из &lt;span style=&quot;BandItPlus.Place&quot;&gt;Одоха&lt;/span&gt; не появлялся два оборота луны, а такого на моём веку не бывало. Либо южные лорды обложили его податями насмерть, либо &lt;span style=&quot;BandItPlus.Name&quot;&gt;Урхун Хромой&lt;/span&gt; устал ждать и взял его сам. Коли встретишь на южной тропе воз янтарных кувшинов без возчика — ты ничего не видел, а? Ты ничего не видел.&#10;&#10;И последнее, слушай внимательно: зерно дорого, дороже мёда, и всё хуже. Кузитские города держат амбары запертыми, имперские западнее &lt;span style=&quot;BandItPlus.Place&quot;&gt;Аккалата&lt;/span&gt; кормят гарнизоны, что домой никогда не уходят. Человек, что привезёт воз ячменя в этот лагерь до снегов — Старый Отчигин запомнит его имя, и вождь тоже. Это стоит больше &lt;span style=&quot;BandItPlus.Coin&quot;&gt;денаров&lt;/span&gt;, друг. Тут, вдали, быть памятным — вся игра." />
    <string id="bp_vendorprofiles_199" text="Старый Отчигин" />
    <string id="bp_vendorprofiles_200" text="Лагерный Управитель" />
    <string id="bp_vendorprofiles_201" text="Табунный сородич хана Борчу с тех пор, как оба мальчишками ездили на одном коньке. Гоняет сменных коней, вялит мясо, ставит айраг. Знает молчания Борчу так же, как его слова." />
    <string id="bp_vendorprofiles_202" text="Старый Отчигин, табунный сородич Хана с тех пор, как мы мальчишками ездили на одном коньке. Борчу дозволяет тебе пройти, странник — в юрту Отчигина войти труднее. Принеси мне {BP_VENDOR_QUEST_DESC} со своей дороги, и я навялю тебе мяса так, как Хан всё ещё его ест." />
    <string id="bp_vendorprofiles_203" text="Кузитское вяленое мясо берёт ветер, не дым, странник — стойки под степным небом, четыре ветра в день, никогда низинных огней. Плоть держится три похода. Имперские повара коптят свой припас и зовут это &quot;сбережением&quot;. Хан бы посмеялся, коли б Хан смеялся над имперским." />
    <string id="bp_vendorprofiles_204" text="Назови мне лагерь и счёт, странник — скольких прокормишь, как далеко поедешь. Три мешка вяленой конины, четыре ветра, упреждение за две недели. Шесть денаров за стойку. Вот, полоска тебе в седельную суму на ночь." />
    <string id="bp_vendorprofiles_205" text="Табунный сородич Борчу с тех пор, как оба были мальчишками — не имел ни жены, ни дитя. Дети Борчу мои по клятве; его дочь Сэчэн зовёт меня «старым дядей», а её сын ездит на моём втором коньке. Этого довольно для семьи. Степь большего не просит." />
    <string id="bp_vendorprofiles_206" text="Тэгус Ветрочтец в главном кузитском стане держит сушильную стойку Хана — двоюродный Борчу вдвойне. Скажи ему, что Отчигин всё ещё сушит на четырёх ветрах; он усадит тебя у собственного огня Хана. Монету за долгую дорогу на восток." />
    <string id="bp_vendorprofiles_207" text="Седло готово. Садись. Хочешь знать, чью луковую кожу я режу следующей — сперва высиди сплетню, это пошлина. Вландийский квартирмейстер прошёл три заката назад, ехал на муле, ибо его лорд заложил скакуна. &lt;span style=&quot;BandItPlus.Name&quot;&gt;Лорд Карадок&lt;/span&gt; с западных рубежей уж скребёт по дну своей казны — человек задолжал гарнизону жалованье за одиннадцать недель, и они уходят по двое да по трое. Его податный воз из &lt;span style=&quot;BandItPlus.Place&quot;&gt;Джакулана&lt;/span&gt; прокатил с четырьмя охранниками. Четырьмя. За ларец, в каком, как хвастал возчик, лежало девятьсот &lt;span style=&quot;BandItPlus.Coin&quot;&gt;денаров&lt;/span&gt;. Я чуть не рассмеялся тому человеку в лицо.&#10;&#10;Кожи тоже избыток — и вот эта часть тебя заинтересует, коли ты шьёшь что-то шире подпружного ремня. Асераи разорвали договор с двумя имперскими дубильнями и сбросили свою зимнюю воловью шкуру на &lt;span style=&quot;BandItPlus.Place&quot;&gt;куязскую&lt;/span&gt; дорогу. Целый караван дублёной воловины, охрана из шести, спят посменно. Волки-сородичи на востоке уж отхватили от него один воз в прошлую луну — остальное движется медленно, ибо возчики про то знают. Ударишь по ним — будешь спотыкаться о кожу целый сезон. Я куплю, чего не захочешь себе — я плачу честно, ты знаешь, что я плачу честно.&#10;&#10;А вот железо — тут-то и делается любопытно. &lt;span style=&quot;BandItPlus.Name&quot;&gt;Хаким Сталеторговец&lt;/span&gt; из &lt;span style=&quot;BandItPlus.Place&quot;&gt;Хусн Фулька&lt;/span&gt; в панике скупает стальные болванки почти вдвое против ходовой цены — какая-то южная кузнечная гильдия посулила ему договор, какого он выполнить не может, и он истекает &lt;span style=&quot;BandItPlus.Coin&quot;&gt;денарами&lt;/span&gt;, пытаясь достать довольно припаса, прежде чем снег закроет перевалы. Всякая телега с болванками из баттанийских холмов пускается теперь мимо &lt;span style=&quot;BandItPlus.Place&quot;&gt;Пен Каннока&lt;/span&gt; по восточной развилке, ибо на главной дороге имперские дозоры. На восточной развилке нет ничего, кроме пары арбалетчиков да собаки. Сам считай.&#10;&#10;И ещё одно, а там я обратно к шилу. Соляные караваны со степных озёр идут скудные — коптильный городок близ &lt;span style=&quot;BandItPlus.Place&quot;&gt;Ровальта&lt;/span&gt; вопит о соли по любой цене, а купец, что зовёт себя &lt;span style=&quot;BandItPlus.Name&quot;&gt;Остави&lt;/span&gt;, платит восемьдесят &lt;span style=&quot;BandItPlus.Coin&quot;&gt;денаров&lt;/span&gt; за мешок, когда честная цена — двадцать восемь. Он в отчаянии, а значит, небрежен, а значит, его серебряный кошель едет обратно на юг, может, с двумя всадниками. Ну да ладно. Седло твоё. Не закровь его, прежде чем заплатишь." />
    <string id="bp_vendorprofiles_208" text="Хочешь знать, отчего Волчье седло не трескается, когда всадник падает со скачущего коня? Всё в вымачивании. Три недели в скисшем кобыльем молоке, потом ещё две в рассоле из зольного щёлока и толчёных можжевеловых ягод со склонов над &lt;span style=&quot;BandItPlus.Place&quot;&gt;Чёрнососновым Хребтом&lt;/span&gt;. Коровья кожа в той ванне гниёт. Конская шкура пьёт её и выходит цвета старой крови, гибкая, как рука любовницы, крепкая, как клятвенное железо. Всякий седельщик в степи знает шаг с кислым молоком. Ни один из них не знает про можжевельник.&#10;&#10;А ленчик — вот где шорники внизу, в &lt;span style=&quot;BandItPlus.Place&quot;&gt;Санале&lt;/span&gt;, ошибаются. Они режут луку из зелёной берёзы и дают ей повести вокруг седока. Я колю свою из единого куска мёртвой степной сосны, той, что двадцать зим простояла корнями на ветру, и придаю ей форму МОКРОЙ под изгиб того самого коня, на каком она поедет. Всякое седло помнит свою кобылу. Надень его на другого коня — набьёт за день. Волки платят мне восемьдесят &lt;span style=&quot;BandItPlus.Coin&quot;&gt;денаров&lt;/span&gt; за одно. Заплатили бы и двести, коли б я запросил. Я не прошу.&#10;&#10;Прошивка — жила со спинного ремня, никогда с ноги. Спинной ремень тянет ровно и мокрым, и сухим. Ножная жила усыхает в одну сторону и слабнет в другую, и седло, что дышит неровно, сотрёт коня до мяса за месяц. Я перенял это у матери, а она — у своего отца, что шил уздечки для собственных ханских дозорных в годы, прежде чем клан ушёл в разбой. Мы были седельщиками, прежде чем стали волками. Кони пришли первыми. Клинки — после.&#10;&#10;Скажу тебе ещё одно, а там больше ничего. Головку луки — костяной колпачок, какого большинство всадников и не замечает — я вырезаю из коленной кости того самого коня, для какого седло. Когда тот конь падёт в бою, всадник до конца дней хранит частицу её под своей рукой. У вождя &lt;span style=&quot;BandItPlus.Name&quot;&gt;Хасара&lt;/span&gt; ныне три таких луки на стене. Он о них не говорит. И я не говорю. Но оттого волки ездят так, как ездят, и оттого ни один человек, что владел седлом Баяра, никогда не покупает другого." />
    <string id="bp_vendorprofiles_209" text="Отчего Я Разрезал Договор" />
    <string id="bp_vendorprofiles_210" text="Мой отец шил сёдла для ханских дозорных из &lt;span style=&quot;BandItPlus.Place&quot;&gt;Куяза&lt;/span&gt;, а его отец до него резал уздечки из той же конской кожи. Я узнал шило прежде лука. Доброе седло держит человека через три дня езды и четвёртый — боя; дурное ломает ему спину прежде врага. Я делал и то и другое, и лишь первое даёт спать по ночам.&#10;&#10;Надлом пришёл, когда вландийский покупатель приехал из &lt;span style=&quot;BandItPlus.Place&quot;&gt;Правенда&lt;/span&gt; с жирным кошелём &lt;span style=&quot;BandItPlus.Coin&quot;&gt;денаров&lt;/span&gt; и договором на сорок кавалерийских снаряжений. Мой мастер взял монету. Кожа, что нам дали, была тонкая, расползающаяся дрянь — крашена красиво, слаба у ленчика. Я сказал старику, что она погубит всадников. Он сказал мне, что &lt;span style=&quot;BandItPlus.Coin&quot;&gt;денары&lt;/span&gt; уже потрачены. Тогда я разрезал договор собственным ножом, а мастер разрезал меня своим.&#10;&#10;Волчий клан нашёл меня спящим под тележной осью близ соляной тропы со свитком моих шильев и больше ничем. &lt;span style=&quot;BandItPlus.Name&quot;&gt;Хасар&lt;/span&gt; глянул на мои руки, глянул на стежок на моём же поясе и сказал, что лагерь всё это время ездил на сёдлах, что в кровь били коней. С тех пор я шью для них. Никаких посредников, никакого вландийского покупателя, никакой тонкой кожи — лишь шкура, что я сам выделываю, да всадники, что возвращаются с каждого набега сказать мне, где натёрла подпруга.&#10;&#10;Вот что приводит человека в это ремесло. Не монета. Монета лишь держит шилья острыми, а сало — в запасе. А платит мне то, что я знаю: всадник, что уехал нынче утром, сидит в снаряжении, какое я построил, и это снаряжение не станет тем, что его сбросит. Седло держит всадника. Монета держит сделку. И то и другое должно прийтись впору, иначе и то и другое разойдётся в худший час." />
    <string id="bp_vendorprofiles_211" text="Весть с Седельных Троп" />
    <string id="bp_vendorprofiles_212" text="Садись. Берегись шила. Весть бежит по седельным тропам быстрее всякого всадника, а человек, что шьёт подпруги, слышит её дважды — раз от гонца, что въезжает, раз от гонца, что уезжает. Ты спросил, так что я скажу, но цена уздечки в обоих случаях та же.&#10;&#10;&lt;span style=&quot;BandItPlus.Place&quot;&gt;Куяз&lt;/span&gt; скупает конскую кожу почти вдвое против прошлозимней цены. Брат их хана потерял трёх сменных коней к вландийскому набегу, и теперь всякого седельщика от солончаков до речной излучины обхаживают &lt;span style=&quot;BandItPlus.Coin&quot;&gt;динарами&lt;/span&gt; вперёд. Поедешь на восток с дублёной шкурой, плотно свёрнутой, — торговаться долго не станешь, но следи за южной тропой, мытные всадники осмелели и снимают лучшую шкуру с верха связки.&#10;&#10;Кузитский караван из &lt;span style=&quot;BandItPlus.Place&quot;&gt;Макеба&lt;/span&gt; везёт стальной припас на запад, полосовое железо да грубые болванки, к кузнечному дому в &lt;span style=&quot;BandItPlus.Place&quot;&gt;Ортонгарде&lt;/span&gt;. Двенадцать возов, лёгкая охрана, обозный старшина — одноглазый стургиец по прозвищу &lt;span style=&quot;BandItPlus.Name&quot;&gt;Ульвар Крюкорукий&lt;/span&gt;, что пьёт спозаранку. Я не говорю, что тебе с этим знанием делать. Я лишь шью сёдла.&#10;&#10;&lt;span style=&quot;BandItPlus.Name&quot;&gt;Лорд Мончуг&lt;/span&gt; выплатил почти четыре тысячи &lt;span style=&quot;BandItPlus.Coin&quot;&gt;динаров&lt;/span&gt; за свежие миндалевидные щиты и острия копий, созвав всякого кузнеца под своим знаменем ковать всю жатву напролёт. Значит, малые крепости вокруг него не могут удержать оружейника ни за любовь, ни за монету — их лучшие люди уехали к его очагу. Есть у тебя брат, что машет молотом, — шли его в &lt;span style=&quot;BandItPlus.Place&quot;&gt;Одох&lt;/span&gt;; его наймут, прежде чем он смоет дорогу с рук.&#10;&#10;И последнее, раз уж ты был терпелив. Баттанийский коробейник прошёл в прошлую луну со связкой тисовых заготовок — настоящий тис, не саженцевая дрянь — уверяя, что лучный двор близ &lt;span style=&quot;BandItPlus.Place&quot;&gt;Пен Каннока&lt;/span&gt; сгорел и срубленное дерево бесхозно бродит по дороге. Коли твой глаз на луки — езжай на запад скоро. Лес недолго остаётся щедрым." />
    <string id="bp_vendorprofiles_213" text="Баяр Седельный Мастер" />
    <string id="bp_vendorprofiles_214" text="Седельный Мастер" />
    <string id="bp_vendorprofiles_215" text="Шил кузитские лагерные сёдла для соперничающей ветви Хана, прежде чем та ветвь продала его имперским вербовщикам. Борчу выехал один, забрал его несломленным и сжёг гэр соперника за оскорбление." />
    <string id="bp_vendorprofiles_216" text="Баяр Седельный Мастер. Борчу забрал меня несломленным; слово Хана крепко. Моя прошивка крепче. Принеси мне {BP_VENDOR_QUEST_DESC}, и я сделаю тебе седло, какое имперские вербовщики так и не сумели повторить." />
    <string id="bp_vendorprofiles_217" text="Лагерное седло берёт стежок плоским у ленчика, приподнятым у луки — имперский крестовый шов делает наоборот, и посадка седока изнашивается неправильно. Кузитский стежок — одна непрерывная линия, узел на каждую конскую длину. Имперские вербовщики так и не сумели его повторить. И поныне не умеют." />
    <string id="bp_vendorprofiles_218" text="Приведи мне своего коня, свой хват, свою скаковую метку, странник. Три денара за кожу, два за стежок. Запасной ремень для твоего нынешнего седла, покуда новое дозревает. Собственный конь Борчу три похода отъездил на моём стежке." />
    <string id="bp_vendorprofiles_219" text="Жена — Хатун — продана вербовщикам вместе со мной; Борчу забрал нас обоих. Ныне она ездит по правую руку Хана. Детей у нас так и не было; соперничающая ветвь забрала нашего младшего, прежде чем кто-либо из нас узнал его имя. Гэр сожгли в ту же ночь. О том пожаре всё ещё толкуют." />
    <string id="bp_vendorprofiles_220" text="Сыщи Мэнгету в причальном лагере Сальп — седельный мастер восточной кузитской ветви, мой ученик до вербовщицкой беды. Скажи ему, что Баяр всё ещё шьёт кузитской линией; он покажет тебе внутреннюю седельную стойку. Монету за переправу через реку." />
    <string id="bp_vendorprofiles_221" text="Садись, садись — сперва поешь, а там обменяемся тем, что знаем. Похлёбка из ячменя, корешков да последков копчёной козлятины. Помешай её против солнца, будь добр, чтоб пар восходил к стропилам, где слушают очажные духи. Хорошо. Ну вот — три ночи назад с болот пришла соляная телега, и возчик плакал в свою миску. &lt;span style=&quot;BandItPlus.Place&quot;&gt;Асерайская Соляная Дорога&lt;/span&gt; снова забита. Разбойники, погода, сломанный мост у седьмого брода — выбирай сказку. Чешуйка дошла до двухсот &lt;span style=&quot;BandItPlus.Coin&quot;&gt;денаров&lt;/span&gt; за брусок в &lt;span style=&quot;BandItPlus.Place&quot;&gt;Пен Канноке&lt;/span&gt;, и коптильни отсюда до &lt;span style=&quot;BandItPlus.Place&quot;&gt;Маруната&lt;/span&gt; темны без неё. Нет соли — нет посола. Нет посола — нет зимнего мяса. Я читал это в золе три зари кряду — длинная тонкая полоса, что указывает на юг, разорванная посередине. Огонь о соли не лжёт.&#10;&#10;Зерно — примета помягче в эту луну. Молотильщики в &lt;span style=&quot;BandItPlus.Place&quot;&gt;Галенде&lt;/span&gt; перестарались — жирный урожай и некуда его девать, ибо управляющий &lt;span style=&quot;BandItPlus.Name&quot;&gt;лорда Кэлана&lt;/span&gt; перестал платить караванной охране в Цветень. Человек досуха пуст на монету, дитя моё, сух, как летнее корыто. Трое его сержантов ускользнули от клятвы в прошлые две недели и уехали на запад искать очаги потеплее. Так что зерно сидит в его силосах и гниёт, а возчики, что прежде его возили, движутся теперь по двое да по трое, безоружные, молясь. Мудрый глаз на &lt;span style=&quot;BandItPlus.Place&quot;&gt;галендской дороге&lt;/span&gt; между заутреней и полуденным колоколом нашёл бы пшеницу по полцены всякому, у кого стали довольно, чтоб вежливо попросить. Я не говорю того, чего не говорю. Зола лишь шепчет; ты слышишь то, что слышишь.&#10;&#10;Теперь — контрабандист, что пришёл прошлую седмицу, тот, без уха — он был издёрган, а издёрганный контрабандист говорит правду. &lt;span style=&quot;BandItPlus.Name&quot;&gt;Мастер Дорин&lt;/span&gt;, пряностный посредник из &lt;span style=&quot;BandItPlus.Place&quot;&gt;Саналы&lt;/span&gt;, переплачивает и за шафран, и за перец, вдвое против осенней цены. Дочь его покровителя выходит за вландийца, и пир должен посрамить южные дворы. Он покупает вслепую, не спрашивает о происхождении. Коли бы наш брат, скажем, добыл сундук южных пряностей с плохо охраняемого мульего обоза на &lt;span style=&quot;BandItPlus.Place&quot;&gt;куязском перевале&lt;/span&gt; — Дорин встретил бы его в &lt;span style=&quot;BandItPlus.Place&quot;&gt;Разихе&lt;/span&gt; с улыбкой и открытым кошелём. Триста &lt;span style=&quot;BandItPlus.Coin&quot;&gt;денаров&lt;/span&gt; за фунт, контрабандист поклялся своим недостающим ухом. Очажный огонь дважды щёлкнул, когда он это сказал. Два щелчка — это да.&#10;&#10;И ещё одно, а там мне надо приглядеть за углями. Зерновые баржи в &lt;span style=&quot;BandItPlus.Place&quot;&gt;Амитатисе&lt;/span&gt; отстают на неделю, ибо речной смотритель хворает, а его помощник — дурак. Караванщики из города платят премию наземным перевозчикам и мало спрашивают о доле, что те берут в пути. &lt;span style=&quot;BandItPlus.Name&quot;&gt;Старый Хелдар&lt;/span&gt;, что стережёт &lt;span style=&quot;BandItPlus.Place&quot;&gt;кузитские зерновые ворота&lt;/span&gt;, пьёт в третий час после заката, надёжно, а его подписарь в тот же колокол уходит домой к жене, что его ненавидит. Зола вычертила нынче вечером длинную вьющуюся линию — дорогу, а в конце её — оставленную открытой дверь. Вот что я видел. Ешь свою похлёбку, покуда горяча, дитя. Мы не переводим мясо в культе очага." />
    <string id="bp_vendorprofiles_222" text="Придвинься ближе, да гляди, чтоб рукав не смёл угли. Секрет не в горшке, он в самом очаге. За три дня, прежде чем я зачерпну хоть миску, я загребаю огонь яблоневыми дровами из &lt;span style=&quot;BandItPlus.Place&quot;&gt;рощи Старой Бренны&lt;/span&gt;, потом кладу сверху слой зелёного можжевельника, потом горсть сушёной полыни, какую вдова &lt;span style=&quot;BandItPlus.Name&quot;&gt;Мэйр&lt;/span&gt; научила меня плести наоборот. Дым, что восходит, сладок горлу, но оседает в железе котла, и всякий костный навар, что я варю после, целый лунный круг настаивается в том благоухании. Похлёбка на вкус будто сварена и вчера, и прошлой зимой разом. Оттого воины платят четырнадцать &lt;span style=&quot;BandItPlus.Coin&quot;&gt;денаров&lt;/span&gt; за миску не моргнув, тогда как всякий простой повар берёт три.&#10;&#10;Мясо — следующая хитрость, и тут, побьюсь об заклад, ты такого не слыхал. Баранья лопатка, никогда не старая баранина, натёртая насухо очажной золой, просеянной через сито из конского волоса. Очажной золой, заметь, не древесной из чистой кострищной ямы. Зола с МОЕГО очага, что спала под девятью годами культовых огней и тысячей приношений жира и кости. В ней есть соль, и нагар, и нечто, что мать моя звала &quot;долгим смаком&quot;. Я натираю лопатку, заворачиваю в листья крапивы, влажные от холодного молока, и зарываю в тёплые угли на краю огня на ночь. К заре плоть делается цвета тёмного мёда и распадается под деревянной ложкой. Никакой нож моей похлёбки не касается. Железо кислит приметы.&#10;&#10;Третий секрет — сам навар. Я раскалываю ножные кости вдоль и обжигаю их срезом вверх на угле с &lt;span style=&quot;BandItPlus.Place&quot;&gt;Хребта Чёрного Оленя&lt;/span&gt;, потом гашу их, ещё дымящиеся, в рассоле, что держу живым одиннадцать лет. Я его доливаю, никогда не опорожняю. Всякая варка несёт ложку прежней, так, как очаг несёт всякий огонь, что был до него. Есть там ячменный солод от пивовара из &lt;span style=&quot;BandItPlus.Place&quot;&gt;Тан-Брея&lt;/span&gt;, морская соль, что я выменивал у контрабандистов, и молотые тазовые кости оленя, какого мой брат &lt;span style=&quot;BandItPlus.Name&quot;&gt;Катал&lt;/span&gt; свалил в ту зиму, с какой сам не вернулся. Не стану притворяться, что горе не приправляет его. Иные пробуют и плачут, сами не зная отчего.&#10;&#10;Так что, когда ты сядешь у моего огня и миска согреет тебе руки, пойми: ты ешь не суп. Ты ешь девять лет дыма, одиннадцать лет рассола и последнюю охоту одного брата. А приметы, что я после читаю в золе? Они вернее от той трапезы. Очаг знает, чем его кормили, чужак, и я знаю." />
    <string id="bp_vendorprofiles_223" text="Очаг Принял Меня" />
    <string id="bp_vendorprofiles_224" text="Садись. Горшок тёпел, а дым честен, что больше, чем большинство людей может сказать о своей родне. Мать моя держала хлебную печь в деревушке в двух днях ходьбы от &lt;span style=&quot;BandItPlus.Place&quot;&gt;Пен Каннока&lt;/span&gt;, и прежде чем я мог поднять лопату, она уж заставляла меня читать золу — как завиток сажи вздымается с камня, когда хлебы удались, как она слипается плоско, когда боги не в духе. Она говорила, что очаг говорит первым, а жрецы — после, и жрецам лишь монету за то платят.&#10;&#10;Мне была уготована друидская роща в &lt;span style=&quot;BandItPlus.Place&quot;&gt;Дангланисе&lt;/span&gt;. Одной осенью я шёл по дороге с мешком ячменной муки и кругом козьего сыра, привязанным к поясу, а колонна всадников &lt;span style=&quot;BandItPlus.Name&quot;&gt;лорда Карадроса&lt;/span&gt; вскрыла деревушку позади меня — сожгла печь, раскидала жёрнов, засолила колодец, чтоб ничто не росло. Когда я вернулся, зола была холодна, и читать в ней было нечего. Человек быстро узнаёт, что боги из жалости его кормить не станут.&#10;&#10;После того я подался на дымные тропы. Три зимы на плоскодонке рыбозасольщика в озёрах над &lt;span style=&quot;BandItPlus.Place&quot;&gt;Кар Бансетом&lt;/span&gt;, вешая угрей в можжевеловый дым, покуда руки мои не завоняли так скверно, что псы близко не подходили. Потом сезон на соляных дорогах юга, таская корявые плиты с солеварен по &lt;span style=&quot;BandItPlus.Coin&quot;&gt;шесть денаров&lt;/span&gt; за груз, поедая вяленую баранину столь твёрдую, что её надо было размягчать за щекой, прежде чем проглотишь. Ремесло держит человека живым, но не держит его целым.&#10;&#10;Лагерь нашёл меня, не я его. Я читал золу придорожного костра — к тому времени лишь по привычке, заметь, не в молитве — а женщина в капюшоне села напротив и назвала то, что я видел, прежде чем я вымолвил. Она привела меня вверх по лощине с мешком ячменя и окороком копчёного вепря и сказала, что культовому горшку нужна рука, что муку от примеси отличает. Тому девять зим. Горшок с тех пор не остывал.&#10;&#10;Вот что приводит человека в это ремесло. Сожжённая печь, соляная дорога, что отняла чувствительность у моих пальцев, и очаг, что всё ещё говорит, когда я тих настолько, чтоб слушать. Ешь неспешно. Похлёбка из оленины, прошлогодних корешков да горсти далса с побережья, а зола над углями нынче вечером читается для тебя хорошо — что больше, чем я могу сказать о следующих трёх, кому подам." />
    <string id="bp_vendorprofiles_225" text="Что Шепчет Зола" />
    <string id="bp_vendorprofiles_226" text="Очаг говорил громко в прошлую луну, и дорога это подтверждает. Зерновой посредник из &lt;span style=&quot;BandItPlus.Place&quot;&gt;Омора&lt;/span&gt; платит девять &lt;span style=&quot;BandItPlus.Coin&quot;&gt;денаров&lt;/span&gt; за бушель всякой ржи, что не тронута плесенью — вдвое против цены урожая. Южные города выжгли жнивьё слишком рано, а семенные крысы доели то, что огонь упустил. Коли у нашего брата зарыта рожь, сейчас пора её выкапывать.&#10;&#10;Соляные вести с долгой дороги: налётчики &lt;span style=&quot;BandItPlus.Name&quot;&gt;лорда Карадока&lt;/span&gt; обчистили три вьючных обоза между &lt;span style=&quot;BandItPlus.Place&quot;&gt;Кар Бансетом&lt;/span&gt; и побережьем, оттого тамошние солевары держат запас, и цена подползла вверх. Коптильня культа оскудеет к следующей тёмной луне, коли не выменяем соли внутри страны. Я велел голове послать воз в &lt;span style=&quot;BandItPlus.Place&quot;&gt;Пен Каннок&lt;/span&gt; заместо того — тамошние жрецы всё ещё должны нам услугу с засушливого года, и свинину они солят щедро.&#10;&#10;Весть о сладком вине и мрачна, и хороша разом. Кузитский караванщик, толстяк по имени &lt;span style=&quot;BandItPlus.Name&quot;&gt;Демир из Куяза&lt;/span&gt;, потерял две амфорные телеги на речной переправе близ &lt;span style=&quot;BandItPlus.Place&quot;&gt;Аккалата&lt;/span&gt;; он продаёт уцелевший груз по двадцать &lt;span style=&quot;BandItPlus.Coin&quot;&gt;динаров&lt;/span&gt; за кувшин, лишь бы избавиться от веса на возах до снегов. Гонцу стоит встретить его у брода, покуда горожанин нас не опередил.&#10;&#10;Зола показала мне скот, мрущий к западу, и погонщики это подтверждают — падёж ползёт по стадам вокруг &lt;span style=&quot;BandItPlus.Place&quot;&gt;Правенда&lt;/span&gt;, и на бойнях жгут туши, а не продают мясо. Вяленая оленина и козлятина возьмут вдвое против своего веса там за две луны. Скажи &lt;span style=&quot;BandItPlus.Name&quot;&gt;Старому Кетину&lt;/span&gt; у сушильных стоек начать осенний забой пораньше; мы поедим сытно с чужого голода.&#10;&#10;Последнее и наименее приятное: худолицый зерноторговец расспрашивал про наши стряпные костры по имени, в трактирах близ &lt;span style=&quot;BandItPlus.Place&quot;&gt;Ревила&lt;/span&gt;. Зовёт себя лавочником, но носит сапоги городского стражника. Ешь свою похлёбку нынче вечером, брат, и не сказывай ничего о наших путях всякому проезжему, что спрашивает слишком вкрадчиво. Очаг чует волчий язык прежде, чем сомкнутся губы." />
    <string id="bp_vendorprofiles_227" text="Послушник Бреннин" />
    <string id="bp_vendorprofiles_228" text="Чтец Очага" />
    <string id="bp_vendorprofiles_229" text="Ходит за жертвенными чашами культа и за козами, из каких их наполняют. Читает удачу в пролитом молоке; подаёт его после, что бы ни выпало в чтении. Говорит, что чаша сказывает ему, кто достоин второй чаши." />
    <string id="bp_vendorprofiles_230" text="Послушник Бреннин, странник. Кости назвали тебя ещё-не-другом в прошлый твой проход — таково чтение Карги Вэйл. Моё — в молочной чаше. Принеси мне {BP_VENDOR_QUEST_DESC} для приношений, и чаша прочтёт тебя милостивее в следующий налив." />
    <string id="bp_vendorprofiles_231" text="Жертвенная чаша культа читает удачу, странник — молочные разливы сказывают тебе, кто достоин второго налива. Хитрость в козе: та же коза, три дойки в день, никогда утреннее молоко. Утреннее молоко лжёт. Полуденное читается верно. Империя назвала бы это суеверием; чаша не спорит." />
    <string id="bp_vendorprofiles_232" text="Назови приношение, странник — свадебный пир, именины, поминальный налив. Три денара за чашу, коза делает остальное. Молочная чаша на нынешний вечер, задаром. Чаша говорит, что у тебя имя, ради какого стоит наливать." />
    <string id="bp_vendorprofiles_233" text="Мать была чтицей очага до меня — читала удачу для баттанийских нижних деревень, покуда лорд не сжёг очаг, а с ним и чтицу. Я взял чашу из золы; она всё ещё льёт прямо, против ветра. Была б уж восьмидесяти зим ныне, коли б лорд не сделал того, что сделал. Чаша помнит её имя." />
    <string id="bp_vendorprofiles_234" text="Старая Бри держит чашное святилище на баттанийской кромке леса — та же молочная хитрость, половина культа. Скажи ей, что Бреннин всё ещё льёт полуденное молоко; она приподнимет внешнюю шкуру лесного святилища. Монету за её приношение." />
    <string id="bp_vendorprofiles_235" text="Руки резчика слышат то, что купеческие языки прячут. Костяной ножеторговец из &lt;span style=&quot;BandItPlus.Place&quot;&gt;Эпикротеи&lt;/span&gt; сидел за моей разделочной доской в прошлое новолуние и обмолвился, что &lt;span style=&quot;BandItPlus.Name&quot;&gt;лорд Вермион&lt;/span&gt; с южных рубежей истекает серебром — его ополчению не платили два сезона, и он потихоньку закладывает серебро покойной жены кузитскому ростовщику по &lt;span style=&quot;BandItPlus.Coin&quot;&gt;восемнадцать денаров за марку&lt;/span&gt;. Лорд, столь голодный, дёшево продаёт безопасный проход. Я выменяла у камнекола за это амулет из фаланги пальца и, скажу, оказалась в выигрыше.&#10;&#10;Дорога со стальной заготовкой через &lt;span style=&quot;BandItPlus.Place&quot;&gt;санальский&lt;/span&gt; перевал в эту луну идёт с жидкой охраной — шесть копий на сорок мулов, ибо караванщик &lt;span style=&quot;BandItPlus.Name&quot;&gt;Эрхан Толстый&lt;/span&gt; заломил за подряд слишком мало и не может позволить себе настоящих дозорных. Вландийские болванки, асерайский чугун, свежесложенная сталь, предназначенная кузнецам &lt;span style=&quot;BandItPlus.Place&quot;&gt;Куяза&lt;/span&gt;. Мёртвые снарядили бы ту дорогу без особого труда, а живые снарядили бы себя железом, какого хватит нам на наконечники стрел всю зиму. Я говорю тебе это, ибо рога недостаёт, а доброй стали — и того меньше.&#10;&#10;А кожа — кожи избыток. Три дубильных каравана из &lt;span style=&quot;BandItPlus.Place&quot;&gt;Маруната&lt;/span&gt; в прошлые две недели, все клянчат монету за полцены вешней, ибо баттанийские скупщики шкур отменили заказы, когда ткацкие дома разорились. Смекалистый купец на жалованье у &lt;span style=&quot;BandItPlus.Name&quot;&gt;Товиоса из Пен Каннока&lt;/span&gt; переплачивает за сырую воловину по &lt;span style=&quot;BandItPlus.Coin&quot;&gt;двенадцать денаров за стопу&lt;/span&gt; — он метит прибрать к рукам шорную торговлю до жатвы. Продай ему свою или забери его. Так или иначе, кости согласны: это монета, ради какой стоит истечь кровью.&#10;&#10;Соляные пути оставляю тебе, но заметь: коптильни в &lt;span style=&quot;BandItPlus.Place&quot;&gt;Фикаоне&lt;/span&gt; пересохли на бочковую соль, а зерновые баржи из &lt;span style=&quot;BandItPlus.Place&quot;&gt;Хараса&lt;/span&gt; стоят у причала, ибо ни один лорд не платит пошлину. Человек, что гонит соль на север и зерно на юг прямо сейчас, ест сытно до середины зимы. Ворона-падальщица знает, какое поле плуг вспахал последним; я знаю, какой дорогой ходит монета. Купи мне рог мёда, и я вычерчу их тебе на земле." />
    <string id="bp_vendorprofiles_236" text="Рог терпелив там, где кость горда. Я узнала это на горьком опыте девчонкой в &lt;span style=&quot;BandItPlus.Place&quot;&gt;Полом Папоротнике&lt;/span&gt;, когда мой первый нож раскрошился о плечо вепря, а вепрь чуть не забрал взамен моё горло. Старая жрица-камнекол, что спасла меня, &lt;span style=&quot;BandItPlus.Name&quot;&gt;Мэрвинн&lt;/span&gt;, заставила меня три ночи просидеть с обломками, прежде чем хоть чему-то учить. &quot;Слушай, что он тебе сказал,&quot; — молвила она. Кость говорит тебе, что она тверда. Рог говорит тебе, что он согнётся прежде, чем сломается. Хитрость в том, чтоб знать, какой лжи довериться.&#10;&#10;Оттого я сперва перебираю всякий кусок по сезону. Рог, сброшенный зимой, от оленя старше четвёртого гона — вот мой клинковый припас, и я не врежу в него ни единой зарубки, покуда луна единожды не прибудет после того, как я принесу его домой. Сердцевина должна сохнуть медленно, в глиняном горшке, набитом древесной золой, с горстью топлёного сала на дне. Шесть недель, порой восемь. Кузнецы подешевле вываривают свой рог, чтоб размягчить для обработки; их работу узнаёшь по тому, что отростки за год делаются серыми и меловыми. Мои остаются цвета старого мёда. Одно это стоит лишних &lt;span style=&quot;BandItPlus.Coin&quot;&gt;восьмидесяти денаров&lt;/span&gt; на всяком кинжале.&#10;&#10;Геометрия кромки — вот где обряд входит в работу. Начерно я вывожу фаску о речной песчаник, но окончательную кромку поднимаю на бедренной кости того зверя, какого клинку суждено убить — вепрь против вепря, волк против волка, человек против человека. Я держу их стойку за горшками для выдержки. Волокно полирующей кости совпадает с волокном убивающей кости, и рез оттого идёт вернее. Веришь ли ты, что мёртвые снаряжают живых, или зовёшь это суеверием, а стрелы летят прямее из колчана, оперённого на собственной берцовой кости оленя. Я проверяла это через довольно сезонов, чтоб поручиться своим именем.&#10;&#10;Чего я не продам ни за какую цену — смола, в какую я сажаю хвостовик. Она вытоплена из трёх вещей: сосновой живицы из &lt;span style=&quot;BandItPlus.Place&quot;&gt;Железной Рощи&lt;/span&gt;, пчелиного воска, что я сама беру из улья, за каким хожу девятнадцать лет, и малой меры золы с погребального костра всякого сородича, что я схоронила. &lt;span style=&quot;BandItPlus.Name&quot;&gt;Мэрвинн&lt;/span&gt; вошла в последнюю партию четыре зимы назад. Когда охотник покупает у меня клинок, он несёт частицу моего дома в лес. Вот цена работы — не &lt;span style=&quot;BandItPlus.Coin&quot;&gt;денары&lt;/span&gt;, что лишь способ вести счёт. Цена в том, что мёртвые идут с тобой и ждут, что ты используешь то, что они дали." />
    <string id="bp_vendorprofiles_237" text="Мёртвые Платят Костью" />
    <string id="bp_vendorprofiles_238" text="Мой первый нож был голенью моей бабки. Она велела мне взять его из своего кургана в ту зиму, когда мне сравнялось десять — сказала, её ходильные кости должны мне обмен, ибо не было у неё молока дать, когда я была младенцем. Я оббила ту голень в свежевальный клинок у реки за &lt;span style=&quot;BandItPlus.Place&quot;&gt;Пен Канноком&lt;/span&gt;, и когда провела им по брюху зайца, я услышала, как она напевает. В тот день я узнала, что мёртвые не ушли — лишь притихли и готовы служить.&#10;&#10;Какое-то время я была ученицей стрельника в низинных деревнях, клеила гусиное перо к ясеневому древку по два &lt;span style=&quot;BandItPlus.Coin&quot;&gt;денара&lt;/span&gt; за дюжину. Но гусь умирает безмолвно, а ясень щепится под мокрой тетивой, и мой мастер бил меня за то, что я молилась над обрезками. Я ушла от него ночью и брела по вересковым тропам, покуда не нашла курган, какого не касался плуг. Я спала внутри него три дня. Когда я вышла, руки мои знали волокно рога так, как повитуха знает живот.&#10;&#10;&lt;span style=&quot;BandItPlus.Name&quot;&gt;Лорд Карадок&lt;/span&gt; из вересковых твердынь хотел меня к себе в чертог — сулил крышу, жену, кресло у длинного очага. Я сказала ему, что костяная работа — не гостиная забава. Кость должно поднимать там, где хранится обряд, а обряд хранится здесь, в лагере под стоячими камнями. Так что я вышла из его ворот с котомкой костяных напильников и с тех пор не спала под крышей из пиленого дерева.&#10;&#10;Языческий люд принял меня, ибо я не просила ничего, чего они не могли дать. Рог с их охоты, ребро с их пиров, костяшки пальцев старейшин, что умерли достойно — вот мне и горн, и наковальня разом. Я вытачиваю наконечники стрел, что высвистывают имена их предков на лету. Вытачиваю обрядовые клинки, что режут чисто, ибо кость помнит, для чего была. Всякая кромка, что я продаю, несёт долг тому, кто носил её первым.&#10;&#10;Так что, когда ты спрашиваешь, что приводит человека в это ремесло, охотник, ответ прост. Платят мёртвые. Платят своими останками, платят своим терпением и просят лишь, чтоб я их не переводила зря. Ты заплатишь &lt;span style=&quot;BandItPlus.Coin&quot;&gt;денарами&lt;/span&gt;, ибо это валюта живых — но попомни меня: кость, что ты унесёшь с моей циновки, переживёт твоё имя, и однажды какой-нибудь камнекол поднимет её из твоего кургана и в свой черёд будет должен тебе нож." />
    <string id="bp_vendorprofiles_239" text="Кости Говорят, Дороги Слушают" />
    <string id="bp_vendorprofiles_240" text="Вороньи дороги густы вестями, друг, коли есть у тебя ухо к ним. Мастеровой из &lt;span style=&quot;BandItPlus.Place&quot;&gt;Маруната&lt;/span&gt; скупает всякий кусок выдержанного тиса и ясеня, до какого дотянется — на древки стрел для какого-то южного лорда, что хочет тысячу стрел к волчьей луне. Его гонец предложил мне сорок &lt;span style=&quot;BandItPlus.Coin&quot;&gt;денаров&lt;/span&gt; за связку роговых хвостовиков. Я сказала шестьдесят. Он вернётся.&#10;&#10;По старой соляной тропе к &lt;span style=&quot;BandItPlus.Place&quot;&gt;Пен Канноку&lt;/span&gt; идёт кузнечный обоз — три воза криц болотного железа и вландийский мастер под охраной. &lt;span style=&quot;BandItPlus.Name&quot;&gt;Лорд Карадок&lt;/span&gt; опустошил свои сундуки на новые умбоны щитов да острия копий, говорят, ибо его хускарлы ропщут, что их снаряжение старше их самих. Есть у тебя быстрый конь да тихие руки — тот обоз спит чутко, а пьёт крепко.&#10;&#10;Баттанийские твердыни в высоких лощинах снова берут камнекопов — кость, кремень, рог, всё, что не поёт под молотом. Лесные лорды узнали, что костяной наконечник обламывается внутри человека, и лекари неделю бранятся. Платят и солью, и серебром, и не спрашивают, откуда взялась кость.&#10;&#10;Весть от коробейника в прошлую четверть луны: караван из &lt;span style=&quot;BandItPlus.Place&quot;&gt;Куяза&lt;/span&gt; везёт добрый стальной припас — вутцевые болванки да асерайские напильники — к некоему купцу в &lt;span style=&quot;BandItPlus.Place&quot;&gt;Правенде&lt;/span&gt;, что делает вид, будто не знает покупателя. Сорок &lt;span style=&quot;BandItPlus.Coin&quot;&gt;денаров&lt;/span&gt; за болванку на открытой дороге, триста — за дверью того купца. Мёртвые терпеливы. Я тоже.&#10;&#10;И последнее, раз уж ты купил выпивку за спрос. Есть межевой рыцарь близ &lt;span style=&quot;BandItPlus.Place&quot;&gt;ортонгардских&lt;/span&gt; лесов, что потерял седельную луку и три добрых клинка на затопленном броде, и он сулит монету первому мастеру, что выедет его снарядить. Я бы поехала сама, да кости в моей котомке ещё не договорили. Возьми это дело, коли хочешь — скажи ему, что тебя послала Кадвен, и он не станет торговаться ниже пятидесяти." />
    <string id="bp_vendorprofiles_241" text="Костяной Кузнец Кадвен" />
    <string id="bp_vendorprofiles_242" text="Жрица-Камнекол" />
    <string id="bp_vendorprofiles_243" text="Мастерит обрядовые клинки культа из лосиного рога и метеоритного железа. Говорит, кости сказывают ей, какой ударный узор предпочитает каждый клинок; те, что она продаёт вне культа, потише, но всё же слушают." />
    <string id="bp_vendorprofiles_244" text="Костяной Кузнец Кадвен. Маска сказала Вэйл, что ты придёшь; кости сказали мне, о чём ты спросишь. Принеси мне {BP_VENDOR_QUEST_DESC} к следующему броску костей, и я оббою тебе клинок, какой рог избрал именно для твоей руки." />
    <string id="bp_vendorprofiles_245" text="Лосиный рог скалывается не как сталь, странник — читаешь завиток волокна и оббиваешь по нему, не против. Метеоритное железо принимает костяной узор; кость принимает железный. Оба слушают, коли сперва бросишь кости. Имперские кузнецы смеются. А имперскую кольчугу всё же пробивают роговые клинки культа." />
    <string id="bp_vendorprofiles_246" text="Принеси мне кость, что сам добыл, странник — лось, олень, горная кошка — и железный прут. Шесть денаров за бросок, работа бесплатна. Кости скажут мне, какой ударный узор. Малый роговой шип тебе на пояс нынче вечером." />
    <string id="bp_vendorprofiles_247" text="Дочь в двенадцать сбежала на север в имперские миссионерские школы — сказала, что чаши — «старое дурачество». Я бросаю кости над её именинами каждый год; кости говорят, она жива, где-то на востоке. Каждый бросок я кую малый роговой клинок. Они сложены в задней пристройке. Она вернётся за одним. Кости не лгут." />
    <string id="bp_vendorprofiles_248" text="Старая Бранвен на пиктском костяном дворе всё ещё оббивает лосиный рог так, как её мать делала. Она помнит чашу моей матери; её кости выпадают тем же узором. Скажи ей, что Кадвен всё ещё слушает железо; она покажет тебе задний двор. Монету женщине, что перевезёт тебя на север." />
    <string id="bp_vendorprofiles_249" text="Соляной мул из &lt;span style=&quot;BandItPlus.Place&quot;&gt;Зеоники&lt;/span&gt; остановился тут вчера ввечеру, рот развязался, как рваный мешок с мукой, стоило мне смочить ему горло. Говорит, амбары в &lt;span style=&quot;BandItPlus.Place&quot;&gt;Правенде&lt;/span&gt; наполовину пусты — долгоносик в зимнем запасе, и пекарская гильдия платит по &lt;span style=&quot;BandItPlus.Coin&quot;&gt;38 денаров&lt;/span&gt; за бушель там, где надо бы двенадцать. Двенадцать! Мой старый мастер, чтоб его призрак мякиной подавился, бывало, порол учеников за покупку по пятнадцать. С новолунием из &lt;span style=&quot;BandItPlus.Place&quot;&gt;Саналы&lt;/span&gt; на юг выходит зерновой обоз, волы такие слабые, что возчик идёт рядом с ними с прутом. Двое охранников. Двое.&#10;&#10;&lt;span style=&quot;BandItPlus.Name&quot;&gt;Хаген из Тиаля&lt;/span&gt; — вот лорд, за каким приглядеть — сундуки сухи, как летний колодец, я слышу это уже от трёх разных языков. Он дважды занял под урожай будущего года, а пшеница ещё и не сеяна. Значит, его гарнизоны редеют, значит, его дозоры дрыхнут, значит, дорога из &lt;span style=&quot;BandItPlus.Place&quot;&gt;Тиаля&lt;/span&gt; в &lt;span style=&quot;BandItPlus.Place&quot;&gt;Ортонгард&lt;/span&gt; — долгий тихий отрезок пустоты до жатвенной поры. А есть купец-дурак из &lt;span style=&quot;BandItPlus.Place&quot;&gt;Диатмы&lt;/span&gt;, зовёт себя &lt;span style=&quot;BandItPlus.Name&quot;&gt;Келбен Пухлый&lt;/span&gt;, платит по &lt;span style=&quot;BandItPlus.Coin&quot;&gt;60 денаров&lt;/span&gt; за мешок мелкомолотой муки. Шестьдесят! Он думает, идёт голод, и копит к скачку цен. Будет копить впустую, коли мы встретим его телегу первыми.&#10;&#10;Коптильни — другое дело: три из них выгорели западнее &lt;span style=&quot;BandItPlus.Place&quot;&gt;Маруната&lt;/span&gt;, молния, жрецы говорят, а я говорю — человек с обидой да факелом. Солонина стала редкостью, цены удвоились, а контрабандисты, что гонят бочки вяленого окорока по &lt;span style=&quot;BandItPlus.Place&quot;&gt;вландийской&lt;/span&gt; прибрежной дороге, дерут &lt;span style=&quot;BandItPlus.Coin&quot;&gt;95 денаров&lt;/span&gt; за бочку и получают их. На той неделе по болотной тропе пойдёт ход из двенадцати бочек с жидкой охраной. Я продам тебе хлеб, чтоб их обернуть, когда закончишь.&#10;&#10;И последний кусочек, раз уж ты платишь. Цены на зерно в &lt;span style=&quot;BandItPlus.Place&quot;&gt;баттанийских&lt;/span&gt; холмах рухнули — урожай слишком хорош, некуда девать. Значит, возчики едут наполовину порожними обратно на восток, в отчаянии от нехватки груза, берутся за подряды, за какие не следовало бы. Отчаянный возчик выбирает отчаянную дорогу. Отчаянная дорога выбирает отчаянную охрану. Видишь, куда я клоню? Хорошо. Теперь купи каравай или ступай дальше, за тобой очередь собирается." />
    <string id="bp_vendorprofiles_250" text="Ладно. Хочешь секрет? Тогда придвинься. Корка. Всё в корке. Мастер &lt;span style=&quot;BandItPlus.Name&quot;&gt;Халвад&lt;/span&gt; там, в &lt;span style=&quot;BandItPlus.Place&quot;&gt;Правенде&lt;/span&gt; — упокой Жнец его глотку — он выучил меня тесту, но корке так и не выучил, её он держал за зубами на замке, как монету. Так что я сам до неё дошёл, после. После.&#10;&#10;Двойная выпечка — вот в чём хитрость. Первая выпечка — каравай, как надо, в жаркой печи, покуда мякиш не схватится. Потом вынимаешь, режешь толщиной с большой палец, и обратно на камни при половинном жаре на час, а то и на два. Выгоняет всякую каплю влаги начисто. Что у тебя в конце — уже не хлеб, а сухарь, да лучше. Впитывает навар, не расползаясь в кашу. Держится сезон в промасленной тряпице. Грабитель в пути мягкого хлеба не унесёт, понимаешь. Мягкий хлеб плесневеет за три дня, и вот ты жуёшь зелёную печаль.&#10;&#10;Вторая половина — присыпка. Я держу горшочек её — ржаная мука, дочерна пожжённая на сковороде, смешана с толчёным можжевельником и щепотью крупной соли. Обваляй двоепечёные ковриги в ней, покуда они ещё тёплые, и масла вбирают присыпку. На вкус — дровяной дым да лесная подстилка. Парни говорят, на вкус как &lt;span style=&quot;BandItPlus.Place&quot;&gt;Баттания&lt;/span&gt;, хоть половина из них дальше &lt;span style=&quot;BandItPlus.Place&quot;&gt;вландийских&lt;/span&gt; застав и не бывала. Бери восемь &lt;span style=&quot;BandItPlus.Coin&quot;&gt;денаров&lt;/span&gt; за ковригу с присыпкой, четыре за простую.&#10;&#10;И нет, записывать не стану. &lt;span style=&quot;BandItPlus.Name&quot;&gt;Халвад&lt;/span&gt; записывал свои рецепты. Гляди, чем оно кончилось. Мальчишка с острым обрезным ножом нашёл страницу, а потом нашёл и человека, и теперь мальчишка продаёт хлеб в лесу без мастера над собой. Иные уроки выучиваешь лишь единожды." />
    <string id="bp_vendorprofiles_251" text="Кедровый Ключ, Разрезанный Ремешок" />
    <string id="bp_vendorprofiles_252" text="&lt;span style=&quot;BandItPlus.Place&quot;&gt;Правенд&lt;/span&gt; вонял дрожжами и мочой в тот год, когда мне сравнялось тринадцать. Я был отдан в ученики жирному борову по имени Халвер, что лупил меня рукоятью хлебной лопаты всякую зарю за преступление медлить с растопкой. Он держал муку запертой в кедровом сундуке и спал с ключом на ремешке вокруг шеи — что, оглядываясь назад, было меньше предосторожностью и больше приглашением. Однажды ночью я разрезал ремешок. Разрезал чуток глубже, чем ремешок того требовал. Я вышел из той пекарни с мешком молотой белой муки на плече и ценой его жизни, буреющей на костяшках моих пальцев.&#10;&#10;Я продавал муку чашками на дороге из &lt;span style=&quot;BandItPlus.Place&quot;&gt;Правенда&lt;/span&gt; в &lt;span style=&quot;BandItPlus.Place&quot;&gt;Лагету&lt;/span&gt; две недели, покуда мальчишка пристава не признал стёжку на фартуке. Тогда я побежал на восток, потом на юг, потом в никуда в частности. Человек, что убил своего мастера, находит всякий честный очаг для себя закрытым. Я жил на краденых угрях, болотном зерне да милости женщин, что не задавали вопросов. В конце концов перестаёшь искать честный очаг. Ищешь очаг, которому всё равно.&#10;&#10;Этому лагерю было всё равно. Старый хлебный смотритель до меня был вландийским дезертиром с больным лёгким, и когда он докашлялся до смерти, я переступил через тело и растопил его печь до заката. Парни ели в ту ночь, и в следующую, и в том было всё собеседование. С тех пор я держу коптильню — солонина висит высоко, подовые караваи внизу, сушёный речной угорь для ребят, что ездят в дальние дозоры.&#10;&#10;Я покупаю зерно у всякого, кто гонит телегу не по той дороге. Порой это десятинный воз &lt;span style=&quot;BandItPlus.Name&quot;&gt;лорда Томаса&lt;/span&gt;, порой мельникова вдова, что не так глупа, чтоб дважды пересчитывать &lt;span style=&quot;BandItPlus.Coin&quot;&gt;денары&lt;/span&gt;. Я плачу честно и плачу скоро и никогда не спрашиваю, где на мешках ставили клеймо. Вот и всё ремесло. В том оно всё.&#10;&#10;Что приводит человека к этому? Запертый сундук, кедровый ключ и мастер, что не думал, будто мальчишка-растопщик способен поднять нож. Прочее — просто хлеб." />
    <string id="bp_vendorprofiles_253" text="Весть от Корки" />
    <string id="bp_vendorprofiles_254" text="Сперва монета, потом новости. Я держу два уха на всякой телеге, что скребёт мимо лощины, и прямо сейчас оба полны. Амбары &lt;span style=&quot;BandItPlus.Place&quot;&gt;Правенда&lt;/span&gt; оскудевают — тамошние старосты платят &lt;span style=&quot;BandItPlus.Coin&quot;&gt;восемьдесят денаров&lt;/span&gt; за мешок чистой ржи и не спрашивают, откуда она. Человек с тремя мешками да тихим ртом мог бы уехать домой богатым или уехать домой мёртвым. Я видел и то и другое, и у мёртвого обычно рот был погромче.&#10;&#10;С озёр к северу от &lt;span style=&quot;BandItPlus.Place&quot;&gt;Эпикротеи&lt;/span&gt; спускается соляной обоз, в шесть мулов длиной, ведёт его старый вландиец по прозвищу &lt;span style=&quot;BandItPlus.Name&quot;&gt;Жирар Трёхпалый&lt;/span&gt;. Он не платит ни пошлин, ни дани, а значит, платит солью, когда кто-нибудь его ловит — а кто-нибудь всегда ловит. Едешь на восток — подгадай свою дорогу под его. Соль тут хранится лучше золота, а повара в этом лагере глотку перережут за горсть.&#10;&#10;В &lt;span style=&quot;BandItPlus.Place&quot;&gt;Пен Канноке&lt;/span&gt; была мокрая весна, и пшеница полегла на полях. Молва, что амбар к жатве недоберёт, а бейлиф &lt;span style=&quot;BandItPlus.Name&quot;&gt;лорда Каладога&lt;/span&gt; потихоньку торгует зерно за три долины отсюда. Голод до снегов, попомни меня. Купи свой ячмень сейчас, продай ему осенью втрое и притворись, будто и слыхом не слыхал, где он лежал промеж.&#10;&#10;Караван со сладким вином из &lt;span style=&quot;BandItPlus.Place&quot;&gt;Куяза&lt;/span&gt; повернул на запад вместо востока в прошлые две недели — жирные амфоры, южный товар, из тех, что делают человека честным раньше срока. Охрана их — асераи-наёмники, шестеро, а старший пьёт больше груза, чем продаёт. Больше того не скажу. Я пекарь, не замысливатель. Но коли человек с моей мукой вернулся бы с кувшином того вина, я б вопросов не задавал.&#10;&#10;Последнее. Есть коптильня под &lt;span style=&quot;BandItPlus.Place&quot;&gt;Ревилом&lt;/span&gt;, что потеряла своего хозяина к кровавому кашлю — бараньи полти висят непроданные, вдова берёт по &lt;span style=&quot;BandItPlus.Coin&quot;&gt;полденара&lt;/span&gt; за фунт, лишь бы избавиться, пока не испортилось. Это неделя лагерных ужинов за цену скверной трапезы в городе. Кому-то с телегой да без совести стоит быть на той дороге завтра. Но сперва монета. Всегда сперва монета." />
    <string id="bp_vendorprofiles_255" text="Марн Резчик Корки" />
    <string id="bp_vendorprofiles_256" text="Хлебный Староста" />
    <string id="bp_vendorprofiles_257" text="Печёт из той муки, что шайка украла на этой неделе. Корка твёрдая, мякиш серый, и Марн делится им с каждым, кто садится к костру, — даже с вландскими всадниками, что убили его последнего подмастерья." />
    <string id="bp_vendorprofiles_258" text="Марн Корку-Режущий, друг. Болл пускает тебя, потому что боится, — это честный приём. Мой голоднее. Принеси мне {BP_VENDOR_QUEST_DESC}, и шайка поест разок. Это всё, что могу обещать, странник, — но это будет настоящая трапеза." />
    <string id="bp_vendorprofiles_259" text="Из какой бы муки шайка ни наворовала, друг, мешаешь серую пшеницу с бурой рожью три к двум — и каравай всходит вопреки всему. Имперские пекари брезгуют смешивать сорта. Оттого их хлеб черствеет ко второму дню, а наш кормит шайку и на третий." />
    <string id="bp_vendorprofiles_260" text="Скажи, что нужно шайке, друг, — свадебный каравай, пир у ночного костра, поминальное бдение. Два денара за муку, полдня на подъём теста. Корка от утреннего каравая — задаром. К нам нечасто кто заходит с просьбой." />
    <string id="bp_vendorprofiles_261" text="Был у меня подмастерье — Бели, двенадцать зим ему было, когда вландские всадники налетели на лагерь и забрали его потехи ради. Убили его, а три недели спустя я делил хлеб с одним из них, потому что шайка голодала. С тех пор толком не сплю. А хлеб всё всходит. Вот чего я себе простить не могу." />
    <string id="bp_vendorprofiles_262" text="Старая Улла печёт в задворках Правенда под вывеской мясника — была пекарем шайки, пока Староста не нанял отряд. Скажи ей, что Марн всё ещё мешает серую с бурой, — усадит тебя у задней печи. Монета за её молчание." />
    <string id="bp_vendorprofiles_263" text="Караван из &lt;span style=&quot;BandItPlus.Place&quot;&gt;баттанийских&lt;/span&gt; холмов прошёл на прошлой седмице, ось стонет, охрана жиже нищенской похлёбки. Трое стражников. Трое. На шестьдесят стоунов &lt;span style=&quot;BandItPlus.Place&quot;&gt;баттанийского&lt;/span&gt; полосового железа, что шло в &lt;span style=&quot;BandItPlus.Place&quot;&gt;Пен-Каннок&lt;/span&gt;. Возница совал мне бурдюк с вином, чтоб я отвернулся, — я забрал и бурдюк, И грузовую роспись в придачу. Кузнец в &lt;span style=&quot;BandItPlus.Place&quot;&gt;Дангланисе&lt;/span&gt; сейчас платит &lt;span style=&quot;BandItPlus.Coin&quot;&gt;сорок два денара&lt;/span&gt; за стоун, а месяц назад было двадцать восемь. Какой-то лорд копит железо к войне, которую ещё никто не объявлял.&#10;&#10;Весть от гонцов с солёного тракта — &lt;span style=&quot;BandItPlus.Name&quot;&gt;лорд Каладог&lt;/span&gt; на мели. Крепко на мели. Гарнизону не платили два месяца, а он закладывает застёжки покойной жены барыге в &lt;span style=&quot;BandItPlus.Place&quot;&gt;Марунате&lt;/span&gt;. Дозоры его сбились с ритма, потому что на овёс денег нет. Тот участок между речным бродом и холмовым капищем? На рассвете почти всегда пуст. Я не повторяю дважды и трезвым такого не говорю.&#10;&#10;Ещё кожевенный избыток. Один дурень в &lt;span style=&quot;BandItPlus.Place&quot;&gt;Санале&lt;/span&gt; скупил три каравана &lt;span style=&quot;BandItPlus.Place&quot;&gt;асерайской&lt;/span&gt; верблюжьей кожи, думал, цена взлетит, — а она рухнула. Сбывает по &lt;span style=&quot;BandItPlus.Coin&quot;&gt;одиннадцать денаров&lt;/span&gt; за тюк, в горячке и отчаянии. Я выменял у него на трофейную кергитскую саблю два тюка обмотки для рукоятей в прошлую десятидневку. Вышел в изрядном барыше. Заплаты, что я сейчас накладываю? Половина обёрнута в его разорение.&#10;&#10;И зерно. Не заводи меня про зерно. Коптильня под &lt;span style=&quot;BandItPlus.Place&quot;&gt;Вострумом&lt;/span&gt; выгорела до камней — молния, говорят, да только я по запаху узнаю факел &lt;span style=&quot;BandItPlus.Name&quot;&gt;Олека Раздирателя&lt;/span&gt; — и теперь всякий торговец копчёной свининой отсюда до побережья переплачивает за засолочную соль, чтоб покрыть убыток. Если идёшь на юг и есть у тебя бочка каменной соли, за которой никто не пришёл, неси её сперва мне. Пущу её через человека, что заплатит вдвое, а себе возьму лишь треть за наводку." />
    <string id="bp_vendorprofiles_264" text="Хочешь знать мою хитрость? Изволь. Тебе бесплатно, и мне бесплатно, потому что ни у кого больше на неё нутра не хватает. Большинство кузнецов калят в масле или в воде, а неженки в &lt;span style=&quot;BandItPlus.Place&quot;&gt;Стургии&lt;/span&gt; — в рассоле, освящённом именем какого-нибудь святого. А я? Я калю в моче. В старой моче. Три недели в накрытом горшке под горном, покуда не завоняет, как у дьявола под мышкой, а соли не осядут жёлтой жижей на дне. Эта жижа всё и делает. Нашатырь въедается в сталь, пока та стынет, и оставляет на клинке корку твёрже его сердцевины. Хрупко, да. Но эти клинки и не для долгой службы. Им нужно продержаться на один удар дольше, чем бедолаге, что бьёт в ответ.&#10;&#10;Вторая половина хитрости — сама вязка. Я никогда не кую сваркой. Кузнечная сварка требует чистого огня и терпения, а у меня нет ни того, ни другого. Я делаю так: срезаю на ус два куска — скажем, хвостовик сломанного вландского меча и обломок клинка какого-нибудь баттанийского фалькса — и скрепляю их мягкой железной заклёпкой через стык. Потом обматываю шов мокрой сыромятью и даю ей ссохнуться туго. С виду дрянь. Держит ударов сорок хороших. А после тот, кто им машет, либо достаточно богат, чтоб купить настоящий, либо достаточно мёртв, чтоб он ему не понадобился. Так или иначе — не моя забота, а?&#10;&#10;Калке в моче меня научил мой отец. Держал горн в закоулке &lt;span style=&quot;BandItPlus.Place&quot;&gt;Правенда&lt;/span&gt;, чинил снаряжение городской страже — только половина этой &quot;починки&quot; была тем, что он переплавлял краденое стражницкое добро и продавал его обратно с новым навершием. В конце концов поймали. Вздёрнули во вторник. Мне было двенадцать. Забрал его клещи, забрал его фартук, вышел за южные ворота — и с тех пор не спал под крышей, что звал бы своей. Калка в моче была последним, что он мне показал, в ночь перед тем, как пришла стража. Сказал, это тайна, что кормила три поколения Латаных-Желёз. Сказал, всякий, кто платил больше пятнадцати &lt;span style=&quot;BandItPlus.Coin&quot;&gt;денаров&lt;/span&gt; за наш клинок, был дурак, а кто платил меньше — друг, а друзей у нас не водилось.&#10;&#10;Вот и всё. Вот и тайна. Моча, сыромять да заклёпка. Хочешь такой? Двенадцать денаров, без вопросов, без ручательства, а сломается в руке — не приходи ныть, приходи в крови, и я залатаю тебя, как латаю мечи. &lt;span style=&quot;BandItPlus.Name&quot;&gt;Грем&lt;/span&gt; Латаное-Железо не гонит завсегдатаев. Живых ли, каких иных." />
    <string id="bp_vendorprofiles_265" text="Железо помнит каждого хозяина" />
    <string id="bp_vendorprofiles_266" text="Что приводит человека в это ремесло? Голод, друг, да твёрдая рука, чтоб разбирать чужую работу на части. Был я когда-то в подмастерьях, честь по чести, у кузнеца в закоулках &lt;span style=&quot;BandItPlus.Place&quot;&gt;Правенда&lt;/span&gt; — старик, руки как корни, научил меня читать клинок по тому, как он поёт на наковальне. Помер, задолжав за жильё. Гильдия забрала горн, инструмент, ту самую дверь, через которую я таскал уголь с девяти лет. Оставили мне фартук да молот с треснувшим бойком.&#10;&#10;После того пошёл я лудильщиком. Из деревни в деревню, чинил днища котлов да заклёпки за миску похлёбки. Да только нет честных &lt;span style=&quot;BandItPlus.Coin&quot;&gt;денаров&lt;/span&gt; в лужении, когда урожай тощ, а лорды давят податью. Вот и начал скупать ломаное у падальщиков — тут сломанная сабля, там дырявая кольчужная юбка — и учиться сплетать их обратно в то, что ещё может вспороть глотку. Латаное-Железо прозвали меня на дороге к &lt;span style=&quot;BandItPlus.Place&quot;&gt;Куязу&lt;/span&gt;. Тогда это не было похвалой. Теперь стало.&#10;&#10;Лагерь сам меня нашёл, не наоборот. Спал я в водостоке под &lt;span style=&quot;BandItPlus.Place&quot;&gt;Пен-Канноком&lt;/span&gt; с двумя кувалдами и мешком наконечников, когда их разведчик пнул мой сапог и спросил, починю ли я древко копья к рассвету. Я починил шесть. Меня накормили. На той неделе починил двенадцать, а неделей позже привезли мне повозку поясов с мертвецов и велели подогнать их на живых. С тех пор в водостоке не сплю.&#10;&#10;Скажу тебе правду о том, чем занимаюсь, раз уж спросил напрямик. Ничего тут моего — ни железо, ни кожа, ни лезвие. Всякая вещь на этой стойке сошла с чьего-то тела. Я стачиваю зазубрины, перетягиваю рукояти, вышкуриваю кровь из волокна и вяжу разбредшиеся куски обратно в то, чем можно махнуть. Духи горна тут не поют, как пели старому мастеру. Но клинки всё ещё режут. Это всё, что нужно бойцу, и всё, что боец может себе позволить.&#10;&#10;Вот что приводит меня сюда. Сперва голод, потом привычка, потом тихая радость от работы, за которую больше никто не возьмётся. Выбирай, что тебе по руке, давай сюда &lt;span style=&quot;BandItPlus.Coin&quot;&gt;денары&lt;/span&gt; и не спрашивай, чья ладонь заносила кожу до гладкости прежде твоей. Железо помнит каждого хозяина. Кузнец забывает нарочно." />
    <string id="bp_vendorprofiles_267" text="Вести из канав" />
    <string id="bp_vendorprofiles_268" text="Весть ходит медленно, когда живёшь в канаве, но ходит. Вьючный обоз выкатился из &lt;span style=&quot;BandItPlus.Place&quot;&gt;Правенда&lt;/span&gt; три ночи назад, вёз полосовое железо на юг — добрый товар, не та ржавь, что я обычно клепаю. Дозорных мало. Ребята, что видели, насчитали шесть стражников на двенадцать мулов. Кто-то сожрёт этот караван, а кто-то после продаст мне обрезки по сорок &lt;span style=&quot;BandItPlus.Coin&quot;&gt;денаров&lt;/span&gt; за связку.&#10;&#10;&lt;span style=&quot;BandItPlus.Name&quot;&gt;Лорд Галош&lt;/span&gt; из-под &lt;span style=&quot;BandItPlus.Place&quot;&gt;Кар-Бансета&lt;/span&gt; отвалил кузне полный кошель за новые каплевидные щиты в прошлый месяц — варёная кожа по сырой сосне, крашеные прежде, чем клей схватился. Половина растрескается к жатве. Его сержанты уже потихоньку скупают замену, мимо ведомостей, мимо счётных книг. Значит, битые щиты бредут обратно через холмы без всяких бумаг, а битые щиты — мой хлеб.&#10;&#10;У лучников из &lt;span style=&quot;BandItPlus.Place&quot;&gt;Куяза&lt;/span&gt; снова недостаёт рога. Какая-то южная война сожрала их запас, и теперь всякий степной наездник западнее реки платит вдвое за сносный лук. Если есть у тебя цевьё, не треснувшее вдоль брюха, тащи его сюда до первого снега — заплачу лучше клановского торговца и вдвое меньше расспрошу.&#10;&#10;Вчера прошёл барыга-хламовщик, шептал, что в &lt;span style=&quot;BandItPlus.Place&quot;&gt;Ревиле&lt;/span&gt; набирают кузнецов. Настоящих, со своими клещами, в лордову оружейную. &lt;span style=&quot;BandItPlus.Name&quot;&gt;Старая Хесса&lt;/span&gt;, что режет напильники, собралась и ушла. Ей — благо. Мне — беда: она одна тут могла заново отпустить мечную пружину, не переломив, а теперь всякий сломанный длинный клинок в трёх долинах ложится на мою наковальню, а не на её.&#10;&#10;И напоследок. В двух хребтах к востоку воровской лагерь пытается сбыть ящик &lt;span style=&quot;BandItPlus.Place&quot;&gt;пен-каннокской&lt;/span&gt; кольчуги — клёпаной как надо, с лордовым клеймом прямо на вороте. Просят восемьдесят &lt;span style=&quot;BandItPlus.Coin&quot;&gt;денаров&lt;/span&gt; за рубаху и нервничают. Нервный продавец к закату сбавит цену. Если берёшь кольчугу в этот сезон, обожди два дня и ступай на восток. Скажи им, что тебя послал Грем, — сбросят десятку, лишь бы избавиться от вони." />
    <string id="bp_vendorprofiles_269" text="Грем Латаное-Железо" />
    <string id="bp_vendorprofiles_270" text="Кузнец-Вязальщик" />
    <string id="bp_vendorprofiles_271" text="Перековывает сломанный крестьянский инструмент в подобие ножей у огня, что едва тлеет. Его клинки крошатся на втором ударе, но первый выдержат — а Грем говорит, что большинству драк только первый и нужен." />
    <string id="bp_vendorprofiles_272" text="Грем Латаное-Железо, гнущий клинки. Милость Болла тебя впустила; моя наковальня медлительней. Принеси мне {BP_VENDOR_QUEST_DESC}, и я свяжу тебе клинок, что держит первый удар и молится сквозь второй." />
    <string id="bp_vendorprofiles_273" text="Крестьянское железо хрупко после второго удара, друг, — плавка была холодной, а закалка — одной надеждой. Я вытягиваю клинок тонким у обуха, толстым у лезвия: обух пружинит, а не ломается. Первый удар держит. Второй — молитва. Да большинство драк всё равно на один удар." />
    <string id="bp_vendorprofiles_274" text="Принеси мне сломанный лемех или переломленную косу, друг, да имя. Залатаю тебе нож к следующему приходу. Денар за горн, за железо ничего — ты сам его несёшь. Вот, держи запасной латаный клинок в дорогу." />
    <string id="bp_vendorprofiles_275" text="Жена и мальчонка сгорели на костре вландского всадника — зимний набег, шайка рассеялась, а они не успели убежать. Теперь я кую ножи, и ножи это знают. Всякий клинок, что я гну, гнётся немного за них. Шайка поест разок. Это всё, что могу обещать. Когда-то это было всем." />
    <string id="bp_vendorprofiles_276" text="Старый Хрот гнёт железо в закоулке нижнего квартала Правенда — был моим подмастерьем, пока шайка не рассеялась. Скажи ему, что Грем всё ещё вытягивает тонко у обуха, — поставит для тебя наковальню. Монета за его молот." />
    <string id="bp_vendorprofiles_277" text="Да садись ты на ту бочку — осторожно, рассол течёт. В погребе прохладно, окорока висят, а у старого Павлоса язык развязан собственным дымом. Сплетен хочешь? Сплетни у меня засолены и сложены, что поленница. Зерновой скупщик из &lt;span style=&quot;BandItPlus.Place&quot;&gt;Эпикротеи&lt;/span&gt; заходил на прошлой седмице, тощий как мул и дёрганый, платил мне втрое против цены за бок копчёной свинины, потому как у его хозяина кладовые пусты. Пусты, заметь, — в месяц жатвы. Это тебе говорит, что тамошний лорд спустил монету на что-то не то, а управитель кроет это караванными закупками по любой цене. Если стоит у тебя без дела повозка ячменя, направь её в &lt;span style=&quot;BandItPlus.Place&quot;&gt;Эпикротею&lt;/span&gt; до конца месяца. Заплатят &lt;span style=&quot;BandItPlus.Coin&quot;&gt;восемьдесят денаров&lt;/span&gt; за мешок и глазом не моргнут.&#10;&#10;Соль — другая история, и похуже. Солеварни у &lt;span style=&quot;BandItPlus.Place&quot;&gt;Пен-Каннока&lt;/span&gt; недосчитались трёх караванов кряду — разбойники, погода, кто знает, — а коптильни отсюда до &lt;span style=&quot;BandItPlus.Place&quot;&gt;Маруната&lt;/span&gt; в поту. Двое погребщиков писали мне, умоляли об обрезках шкурки, что я обычно псам бросаю. &lt;span style=&quot;BandItPlus.Name&quot;&gt;Йорек из Севердола&lt;/span&gt;, тот, что с заячьей губой, сказал мне за чаркой, что отдал &lt;span style=&quot;BandItPlus.Coin&quot;&gt;сорок денаров&lt;/span&gt; за меру серой столовой соли — серой, заметь, дешёвки — и счёл себя счастливчиком. Прокатись сейчас через перевал повозка чистой белой соли, возница сам назначил бы цену, и три города дрались бы за него. А значит, кто-то непременно попробует такую провезти. И кто-то другой попробует встретить того кого-то на тихом отрезке дороги.&#10;&#10;К слову о тихих отрезках — на речной тропе между &lt;span style=&quot;BandItPlus.Place&quot;&gt;Зеоникой&lt;/span&gt; и низинными переправами по двое стражников на повозку. По двое. Я услыхал это от караванного повара, что делил мой огонь и моё вино и не спрашивал, к чему я допытываюсь. Их скупщик урезал охрану, потому что сезон был мирный, а люди стоят &lt;span style=&quot;BandItPlus.Coin&quot;&gt;двенадцать денаров&lt;/span&gt; в день. Копчёные окорока, масло, рыба в горшках и — вот тут-то — ларец торгового серебра для низинных покупателей. Двое стражников. Против всего, что решит выслать лес. Я не указываю, что с этим делать, друг. Я погребщик. Я коптю мясо. Но кабы кто захотел узнать, какая дорога в этот сезон жидка на охрану, то вот она.&#10;&#10;И напоследок, а там уж пущу тебя есть. &lt;span style=&quot;BandItPlus.Name&quot;&gt;Атас Коробейник&lt;/span&gt; — толстяк, зубы гнилые, правит зелёной повозкой — переплачивает за любой копчёный товар, какой сыщет, и обходит по кругу горные деревни. У него подряд с кем-то на юге, побьюсь об заклад — с поставщиком турнирного городка, и он до того в отчаянии, что не торгуется. Принесёшь мне чистого поросёнка к концу седмицы — закопчу его в долю, и продадим &lt;span style=&quot;BandItPlus.Name&quot;&gt;Атасу&lt;/span&gt; по его же цене, а он поблагодарит нас этой своей мерзкой улыбочкой. Камень делает мясо лучше, я всегда говорю. Камень да погребщик, что держит уши открытыми." />
    <string id="bp_vendorprofiles_278" text="Дед мой выкопал этот погреб собственными руками, знаешь ли. Сорок шагов вглубь известняка, где &lt;span style=&quot;BandItPlus.Place&quot;&gt;Хребет&lt;/span&gt; дышит холодом даже в разгар лета. Камень тут — он потеет. Не водой, не совсем. Чем-то иным. Минеральным дыханием, что оседает на окорока и тянет из них влагу медленно, медленно, как терпеливый муж вытягивает тайну из жены.&#10;&#10;Вся хитрость в солевой обкладке, в три слоя. Сперва крупная каменная соль с &lt;span style=&quot;BandItPlus.Place&quot;&gt;Кародских солончаков&lt;/span&gt; — серая, ни за что не белая, ни за что. Потом толчёная можжевеловая ягода да горсть сушёного черничного листа — это уже моя добавка; дед клал один можжевельник, но я подглядел раз, как баттанийская девка жуёт эти листья от живота, и подумал: отчего не для мяса? Потом второй слой соли, на сей раз мелкой, смолотой в ручном жёрнове, что я держу смазанным овечьим салом. Сорок дней окорок спит в этой обкладке. Не тридцать восемь. Не сорок два. Сорок. Погреб сам мне подсказывает.&#10;&#10;После соли — дым. Бук первые три дня — сладкий, почти как мёд в глубине горла. Потом перехожу на горную сосну, но только на сердцевину, ни за что не на смолистые внешние кольца, не то окорок отдаст факелом. Шесть дней сосны. Потом последний день с горстью сушёного горного чабреца, брошенного на угли, — этому меня научила мать, прежде чем её забрала горячка. Тот чабрецовый день и заставляет покупателя платить &lt;span style=&quot;BandItPlus.Coin&quot;&gt;сорок два денара&lt;/span&gt; за рульку, когда низинники продают свою за двенадцать.&#10;&#10;Меня спрашивают, отчего я не переберусь вниз, в &lt;span style=&quot;BandItPlus.Place&quot;&gt;Ортонгард&lt;/span&gt;, где рынки богаче. Я отвечаю: камень делает мясо. Камень с собой не унесёшь. &lt;span style=&quot;BandItPlus.Name&quot;&gt;Павлос&lt;/span&gt; остаётся там, где погреб, а погреб остаётся там, где дед его выкопал, и на том разговору конец." />
    <string id="bp_vendorprofiles_279" text="Камень помнит соль" />
    <string id="bp_vendorprofiles_280" text="Дед мой был угольщиком над перевалом у &lt;span style=&quot;BandItPlus.Place&quot;&gt;Тиала&lt;/span&gt;, а когда низинники сожгли его углевыжигательную яму, он выкопал взамен погреб. Сказал, гора задолжала ему кров, раз не дала деревьев. Я был мальцом с глиняной лампой да ручным топором и помогал ему выскребать камору достаточно широкой, чтоб повесить четыре окорока прямо на камень.&#10;&#10;Соль поднимали из &lt;span style=&quot;BandItPlus.Place&quot;&gt;Пен-Каннока&lt;/span&gt; на мулах — двенадцать &lt;span style=&quot;BandItPlus.Coin&quot;&gt;денаров&lt;/span&gt; за мешок, когда я был мал, тридцать нынче, если торговец честен, шестьдесят, если нет. Я научился читать окорок, как писарь читает печать, — по запаху, по весу, по тому, как шкурка твердеет под большим пальцем. Горный камень держит холод летом и не пускает сырость зимой, а это половина засолки. Другая половина — терпение, которому низины не учат.&#10;&#10;Спускался я однажды. Пошёл в услужение на кухню в &lt;span style=&quot;BandItPlus.Place&quot;&gt;Ортонгарде&lt;/span&gt; под управителя по имени &lt;span style=&quot;BandItPlus.Name&quot;&gt;Куно Трёхножевый&lt;/span&gt;, что платил медяками да побоями. Когда его лорд проиграл распрю, двор разбрёлся, и я побрёл обратно вверх по старой козьей тропе с мешком можжевеловых ягод и головой, полной обид. Погреб был на месте. Камень помнит то, что люди забывают.&#10;&#10;Эти ребята — спускаются, поднимаются, иной раз возвращаются легче, чем уходили. Им нужно мясо, что переживёт дорогу. Я даю им окорок в берёсте, твёрдый сыр в золе, флягу соснового спирта на холодные ночи. Платят &lt;span style=&quot;BandItPlus.Coin&quot;&gt;денарами&lt;/span&gt;, когда есть, и обещаниями, когда нет, и обещания по большей части держатся, потому что кто врёт погребщику, тот всю зиму ест худо.&#10;&#10;Так что садись. Дедов камень у тебя под сапогами, окорока над головой, и вот что приводит человека в это ремесло — дыра в горе да смекалка не покидать её дважды." />
    <string id="bp_vendorprofiles_281" text="Вести с высоких перевалов" />
    <string id="bp_vendorprofiles_282" text="Вести с дороги? Да садись поближе — ветер тут половину голоса съедает. Горные караваны из &lt;span style=&quot;BandItPlus.Place&quot;&gt;Эпикротеи&lt;/span&gt; снова тянут каменную соль на юг, по две повозки за две седмицы, и тамошние купцы платят под &lt;span style=&quot;BandItPlus.Coin&quot;&gt;сорок денаров&lt;/span&gt; за мешок всякому, кто протащит её мимо склонов. Есть у тебя мулы да тихая тропа — вот серебро, что висит на крючке.&#10;&#10;Горцы вокруг &lt;span style=&quot;BandItPlus.Place&quot;&gt;Пен-Каннока&lt;/span&gt; скупают копчёную баранину, будто голод идёт, — а он идёт, попомни меня. Ополчение &lt;span style=&quot;BandItPlus.Name&quot;&gt;лорда Каладога&lt;/span&gt; выгребло из трёх долин племенных овец на зимний поход, и оставшимся пастухам весной некого ягнить. Зерно взлетит к концу жатвы, и человек с полным погребом станет маленьким королём.&#10;&#10;Через &lt;span style=&quot;BandItPlus.Place&quot;&gt;Якулан&lt;/span&gt; идёт вландский обоз со сладким вином — бочки с печатью &lt;span style=&quot;BandItPlus.Name&quot;&gt;Хоукастеров&lt;/span&gt;, в какой-то внутренний замок, что платит чужой монетой. Есть у меня двоюродный, что стережёт тот перевал ради пошлины, и он говорит, охрана редеет после третьего моста. Жаждущий погребщик отдал бы &lt;span style=&quot;BandItPlus.Coin&quot;&gt;восемьдесят динаров&lt;/span&gt; за бочонок, без вопросов, не читая клейм на печати.&#10;&#10;И слушай — у коптильщиков угря в &lt;span style=&quot;BandItPlus.Place&quot;&gt;Ортонгарде&lt;/span&gt; кровавый понос свёл в могилу очажного мастера, и их припас гниёт на стойках. Кто съедет вниз с холодной засолочной солью до осенних ярмарок, купит три зимы мяса по цене одной. Дед мой прорубил этот погреб сквозь живой камень, чтоб окорока висели сладкими, — я порчу по запаху на ветру чую.&#10;&#10;Вот и вся весть. Пей свою чарку, друг. У горы своё время, а дороги никуда не денутся, покуда ты ешь." />
    <string id="bp_vendorprofiles_283" text="Павлос Горный Язык" />
    <string id="bp_vendorprofiles_284" text="Погребной мастер" />
    <string id="bp_vendorprofiles_285" text="Солит оленину, что приносят охотники Перевального Лорда. Знает, какой склон даёт самого солёного оленя. Ни разу не спускался с перевала; говорит, гора кормит его лучше, чем низина в его детстве." />
    <string id="bp_vendorprofiles_286" text="Павлос Горный Язык. Скарвак дал тебе скидку с пошлины, странник, — Перевальный Лорд нынче в щедром настроении. Погреб настроен иначе. Принеси мне {BP_VENDOR_QUEST_DESC}, и я засолю тебе окорок, какого стол имперского наместника не пробовал." />
    <string id="bp_vendorprofiles_287" text="Горная оленина солится не так, как низинная, странник, — соль схватывается за три дня там, где низине нужно пять. Вся хитрость в склоне: олень с северного лица, ни за что не с южного. Мясо с южного лица слишком долго держит тепло; соль идёт не туда. Перевальный лорд ест только с северного." />
    <string id="bp_vendorprofiles_288" text="Скажи мне ночь пира и число гостей, странник, — свадьба с перевальной пошлиной, именины, наместничий стол. Три денара за погребной припас, пробный окорок на нынешний вечер. Гора малыми мерами не отпускает." />
    <string id="bp_vendorprofiles_289" text="Поднялся из низины пятьдесят зим назад ещё мальцом — оставил младшую сестру у подножия перевала, так и не спустился за ней. Ей было бы теперь шестьдесят, коли зимы её сберегли. Гора кормит меня лучше, чем кормила низина. Твержу себе, что она сказала бы то же. Погреб не спорит." />
    <string id="bp_vendorprofiles_290" text="Старый Спирос держит корчму у подножия перевала — бережёт хитрость горной соли для путников, готовых заплатить вдвое. Он сын моей сестры, если верить корчемному люду. Скажи ему, что Павлос всё ещё солит с северного лица, — усадит тебя за дальний стол. Монета за обратный подъём." />
    <string id="bp_vendorprofiles_291" text="Караван из &lt;span style=&quot;BandItPlus.Place&quot;&gt;Эпикротеи&lt;/span&gt; прокатился на прошлой неделе с тремя мулами недокованных стальных болванок в низинные кузни — а охрана? Четверо мальчишек с копьями да один пьяный сержант. Я выменял мешок подковных гвоздей на то, чтоб принюхаться к их грузу, и вот что скажу: тот, кто снаряжает эту поставку, вландский скупщик по имени &lt;span style=&quot;BandItPlus.Name&quot;&gt;Гейрхард Дородный&lt;/span&gt;, переплачивает без малого сорок процентов. Говорят, он потерял два последних обоза на &lt;span style=&quot;BandItPlus.Place&quot;&gt;баттанийской предгорной дороге&lt;/span&gt; и теперь в панике платит плавильщикам, сколько ни спросят. Любой с мулом и молотом мог бы сбить его цену.&#10;&#10;Запас железа тощ повсюду южнее перевала — &lt;span style=&quot;BandItPlus.Place&quot;&gt;стургийские рудники в Ревиле&lt;/span&gt; спустили этим сезоном лишь одну повозку вместо обычных трёх, а контрабандист по прозвищу &lt;span style=&quot;BandItPlus.Name&quot;&gt;Кеттиль Косой&lt;/span&gt; сказал мне, что виной тому сборщики долгов местного лорда, что забрали рудные телеги в уплату игорной расписки. Так что коли сидишь на сыром чугуне — придержи. Цена удвоится до первой оттепели. А вот кожа — боги, кожа. Всякий кожевник от &lt;span style=&quot;BandItPlus.Place&quot;&gt;Пен-Каннока&lt;/span&gt; до побережья давится шкурами после того, как скотий мор рано выкосил стада, и они сбывают выделанную телячью кожу по сорок &lt;span style=&quot;BandItPlus.Coin&quot;&gt;денаров&lt;/span&gt; за связку.&#10;&#10;Есть один лорд — вслух имени не назову, но носит он асерайские шелка и ездит на вландском боевом коне, сам смекнёшь — до того на мели, что его оружейник переплавляет старые турнирные призы, чтоб заплатить кузнецам. Казна его пуста к третьей неделе всякого месяца, а караваны идут по &lt;span style=&quot;BandItPlus.Place&quot;&gt;дороге Оника — Хубьяр&lt;/span&gt; с одним дозорным и молитвой. Трое моих завсегдатаев уже смекнули, где сесть да обождать. Я не спрашиваю, что они привозят, — спрашиваю лишь, на какие тесаки перековать ту сталь.&#10;&#10;И напоследок, а это стоит целого жбана арака: кузаитский купец по имени &lt;span style=&quot;BandItPlus.Name&quot;&gt;Баян Цэцэг&lt;/span&gt; скупает соль вдвое против цены в &lt;span style=&quot;BandItPlus.Place&quot;&gt;Аккалате&lt;/span&gt; — вдвое, друг — потому что коптильни к востоку от степи потеряли зерновые запасы от плесени и теперь наперегонки солят мясо, покуда не ударил холод. Платит сырым серебром, без торга, без вопросов. Если умеешь возить соль и долгая дорога тебе нипочём, это самые лёгкие двести &lt;span style=&quot;BandItPlus.Coin&quot;&gt;денаров&lt;/span&gt; с воза, что ты когда-либо заработаешь. Скажи ему, что тебя послал Перевальный Кузнец, — глядишь, ещё и флягу доброго подкинет." />
    <string id="bp_vendorprofiles_292" text="Большинство кузнецов по низинам скажут тебе, что клинку нужен медленный жар и ещё более медленное остывание. Это дураки, что никогда не работали выше снеговой черты. Тут, у &lt;span style=&quot;BandItPlus.Place&quot;&gt;Каменного Навеса&lt;/span&gt;, сам воздух выпивает тепло из стали, не успеешь и моргнуть, и коли отпускать по цвету металла, как велят наставления, всякий раз вытащишь из закалочной кадки хрупкую палку. Оттого я вместо цвета читаю дым. Дым сосновой смолы из горнового устья — когда он завивается влево и льнёт к стропилам, сталь готова. Когда идёт прямо вверх, сердце железа ещё холодно, и жди ещё два вдоха.&#10;&#10;А вот чем я беру за свои лезвия — так это закалкой. Держу под лавкой две бочки. В одной рассол — крупная соль, соскобленная со стоек для козьих шкур, растворённая в талой воде с перевала. В другой топлёное баранье сало с горстью толчёных можжевеловых ягод, вмешанных тёплыми. Разбойничий клинок сперва идёт в рассол на три удара сердца, потом прямо в сало, покуда не перестанет петь. Рассол делает лезвие твёрдым как стекло, сало отпускает обух ровно настолько, чтоб он гнулся, а не ломался, когда цепляешь кромку щита. Старый &lt;span style=&quot;BandItPlus.Name&quot;&gt;Василий&lt;/span&gt;, мой мастер там, внизу, в &lt;span style=&quot;BandItPlus.Place&quot;&gt;Ровальте&lt;/span&gt;, назвал бы это ересью. Он помер от переломленного меча в собственной руке, так что, пожалуй, останусь еретиком.&#10;&#10;Геометрия, которую я вывожу, тоже моя собственная. Большинство бронников кладут на рубящий клинок выпуклую фаску ради крепости. Мои сточены с ложбиной на палец от лезвия, а за ней уже выпукло — этакая скрытая талия. Оно глубже въедается в стёганку, потому что ложбина пропускает клин клинка сквозь разрез, а не даёт ему завязнуть. На каждый клинок у меня уходит лишний час у точила, оттого и цена такая. Восемьдесят &lt;span style=&quot;BandItPlus.Coin&quot;&gt;денаров&lt;/span&gt; за ручной топор — грабёж средь бела дня в &lt;span style=&quot;BandItPlus.Place&quot;&gt;Эпикротее&lt;/span&gt;, но тут человек платит, потому что иначе — помереть с тупым лезвием.&#10;&#10;Последнюю тайну скажу задаром, раз уж ты выстоял всю проповедь. Железо, что я беру, не куплено. Караваны, идущие через перевал, роняют гвозди, обручные полосы, ломаные удила, порой сломанный меч, какой дурень поленился подобрать. Мои ребята прочёсывают тропу с каждой весенней оттепелью и приносят мне подобранное. Я сковариваю его вхолодную в болванку из девяти слоёв, складываю дважды — вот из чего выходит твой топор. Так что, когда махнёшь им, помни: полсотни купцов да мертвецов легли в это лезвие прежде тебя. Обращайся с ним, будто у него есть память, — потому что она есть." />
    <string id="bp_vendorprofiles_293" text="Что роняет дорога" />
    <string id="bp_vendorprofiles_294" text="Отец мой был колёсником в деревне за двумя перевалами к югу отсюда, и правде железа научил меня прежде грамоты — что ремень, тянутый вхолодную, трескается на третьем сгибе, что гвоздь, забитый по сырому, ржавит дерево вокруг себя, что лезвие, сточенное тонко, поёт, да не кусает. Мы правили повозки, что спускались с высокогорья, а когда купцы нижних городков платили нам медяками тоньше берёсты, отец улыбался и говорил, что дорога всё ещё нам должна. Так и помер должником.&#10;&#10;Тогда поднялся я в перевальные городки в поисках честной кузнечной работы и на время нашёл её под мастером в закрытом ставнями дворе у рыночной дороги — тихий человек, дозволял мне отбивать грубые болванки, покуда сам доводил лезвия. Когда прошли вербовщики и забрали его за какой-то королевский долг, что я и назвать не могу, я взвалил его наковальню на спину и пошёл вниз по козьим тропам. Наковальня весит столько же, сколько человек. Знаю, потому что нёс свою ровно то же расстояние, что мастер нёс своё имя.&#10;&#10;Лагерь нашёл меня прежде, чем я его. Спал я в каменном навесе, где снег ложится тонко, и на первом свету подъехал всадник со сломанным нащёчным ремнём и захромавшей лошадью и спросил, что я возьму за починку. Я сказал: перевальное железо — всякий лом, что караваны обронили на серпантинах внизу, поднятый мне корзиной. Он рассмеялся, а наутро была корзина. Утром после — две.&#10;&#10;Вот такая сделка, друг. Всадники несут мне то, что роняет дорога, — ломаное котельное железо, лопнувшие сёдельные пряжки, треснувший хвостовик меча какого-то мальца, что мнил себя мечником там, под &lt;span style=&quot;BandItPlus.Place&quot;&gt;Правендом&lt;/span&gt;, — а я даю им лезвия, что держат, и ремни, что не трескаются на третьем сгибе. Монета тут тоже ходит, само собой, &lt;span style=&quot;BandItPlus.Coin&quot;&gt;денары&lt;/span&gt;, когда они у человека есть, но железо — валюта постарше, и ему я верю больше.&#10;&#10;Не всяким клинком, к которому я приладил рукоять, я горжусь. Но работой горжусь. Ремень, тянутый в тепле, гвоздь, забитый по сухому, лезвие, сточенное кусать, — вот чем я всё ещё должен отцу, и плачу этот долг всякое утро, когда разжигаю горн." />
    <string id="bp_vendorprofiles_295" text="Вести с высокого перевала" />
    <string id="bp_vendorprofiles_296" text="Караванная молва поднимается по серпантинам прежде снега, странник. Говорят, гарнизон в &lt;span style=&quot;BandItPlus.Place&quot;&gt;Чайканде&lt;/span&gt; скупает всякую щитовую заготовку, какую кузнец способен отбить в плоский лист, — &lt;span style=&quot;BandItPlus.Name&quot;&gt;лорд Уркхун&lt;/span&gt; потерял половину круглых щитов в степной стычке, а его бронники не поспевают клепать. Есть у тебя повозка тополёвых досок да ободного железа — вот &lt;span style=&quot;BandItPlus.Coin&quot;&gt;восемьдесят денаров&lt;/span&gt; за щит, без вопросов, откуда сталь.&#10;&#10;Прямо сейчас по &lt;span style=&quot;BandItPlus.Place&quot;&gt;Оникской&lt;/span&gt; дороге ползёт обоз со стальным припасом, шесть мулов вглубь, в литейни &lt;span style=&quot;BandItPlus.Place&quot;&gt;Куяза&lt;/span&gt;. Имперский слиток, тяжёлый серый, что чисто звенит с наковальни. Идут налегке, потому что снег в этом году запоздал и они мнят высокие перевалы тихими. В этом они ошибаются, но я того не говорил.&#10;&#10;Внизу, на низинном пути, &lt;span style=&quot;BandItPlus.Name&quot;&gt;лорд Пелле&lt;/span&gt; выложился за две сотни каплевидных щитов и свежую связку копейных наконечников — монета, говорят, пошла с распродажи скаковых лошадей покойного брата. Его кузнецы в &lt;span style=&quot;BandItPlus.Place&quot;&gt;Пен-Канноке&lt;/span&gt; гонят подмастерьев, так что всякому странствующему подмастерью честного пути больше нет. Иные оседают у моего навеса. Иные оседают хуже.&#10;&#10;Вландский покупатель был тут две седмицы назад, охотился за чернёной кольчугой и шлемами любого кроя, платил &lt;span style=&quot;BandItPlus.Coin&quot;&gt;шестьдесят динаров&lt;/span&gt; за доспех и не торговался. Так и не сказал, какому порубежному лорду служит, а я и не спрашивал. Есть у тебя военная добыча, что ржавеет в седельной суме, — неси мне, пока снег не запер проход, спущу её по цепочке, и оба поедим.&#10;&#10;И напоследок, попомни. В кузнечном городке &lt;span style=&quot;BandItPlus.Place&quot;&gt;Ревиле&lt;/span&gt; недостаёт угля, а рук ещё меньше — старый &lt;span style=&quot;BandItPlus.Name&quot;&gt;мастер Хьяльмар&lt;/span&gt; помер у своих мехов в прошлый месяц, и никто не встал к молоту. Оттого наковальное железо повывелось аж до самого побережья. Перевальное железо, перевальная цена. И то и другое честно. Неси мне лом, и я вырублю тебе кусок, стоящий переноски." />
    <string id="bp_vendorprofiles_297" text="Костас Наковальная Рука" />
    <string id="bp_vendorprofiles_298" text="Перевальный Кузнец" />
    <string id="bp_vendorprofiles_299" text="Чинит имперскую кольчугу горным железом — таким, что требует трёх лишних ударов, чтоб лечь как надо, зато держит на три удара дольше. Его починка переживает исходную работу, отчего, по словам Скарвака, имперские дозоры и продолжают проигрывать." />
    <string id="bp_vendorprofiles_300" text="Костас Наковальная Рука, Перевальный Кузнец. Перевальный Лорд дозволяет тебе идти; наковальня решает, с чем ты уйдёшь. Принеси мне {BP_VENDOR_QUEST_DESC} из низинных кузен, и я починю тебе горную кольчугу, что держит на три удара больше имперской." />
    <string id="bp_vendorprofiles_301" text="Горное железо требует трёх лишних ударов, чтоб лечь, против имперского, странник, — руда плотнее, волокно идёт вкривь, первые полчаса с ним борешься. Зато потом оно держит на три удара дольше всего, что куют на асерайской стороне. Дозоры всё проигрывают. Им невдомёк счёт ударов." />
    <string id="bp_vendorprofiles_302" text="Принеси мне сломанный перевальный клинок, странник, да рисунок — заново отпущу тебе горное железо, какое низинным кузням не подделать. Шесть денаров за горн, за железо уже заплачено. Вот, запасной клин тебе на пояс." />
    <string id="bp_vendorprofiles_303" text="Отец работал за той же наковальней; дед — за той же опять. Трое братьев — двое польстились на награду имперских вербовщиков, один остался. Те двое так и не вернулись; третий нынче пьёт без меры. Наковальня моя, потому что наковальня выбрала. Низина выбрала остальных." />
    <string id="bp_vendorprofiles_304" text="Сыщи Старого Феодороса в кузнях асерайского красильного квартала — был моим подмастерьем до южной войны. Скажи ему, что Костас всё ещё бьёт по горному счёту, — покажет тебе дальнюю наковальню. Монета за пустыню." />
    <string id="bp_vendorprofiles_305" text="Караван приковылял за сумерками, оси визжали так, что впору волков разбудить, а старшой, некий &lt;span style=&quot;BandItPlus.Name&quot;&gt;Тарик Мягкие Руки&lt;/span&gt;, отдал восемнадцать &lt;span style=&quot;BandItPlus.Coin&quot;&gt;денаров&lt;/span&gt; за мешок заплесневелого ячменя, каким я козам корм задавал. Восемнадцать! Коптильни под &lt;span style=&quot;BandItPlus.Place&quot;&gt;Куязом&lt;/span&gt; все, вишь, остыли, оттого что солевой обоз с южных солончаков в этот месяц носа не казал. Нет соли — нет копчёной баранины; нет копчёной баранины — и всякий стряпчий отсюда до побережья скупает зерно, будто саранча завтра нагрянет.&#10;&#10;Ну, усадил я того мягкорукого дурня с плошкой кобыльего молока и дал ему выговориться досуха. Говорит, дорогу из &lt;span style=&quot;BandItPlus.Place&quot;&gt;Саналы&lt;/span&gt; к восточным бродам стерегут всего четверо копейщиков да одноглазый арбалетчик при трёх повозках твёрдого сыра и прессованного творога. Четверо! Во дни моего деда ты бы и корзину навоза мимо каменных курганов не провёз меньше чем с двумя десятками. И говорит, &lt;span style=&quot;BandItPlus.Name&quot;&gt;лорд Влахус&lt;/span&gt; до того на мели, что продал серебро жены, чтоб заплатить гарнизону в прошлую седмицу, а значит, его дозоры на западном солёном тракте ближайшие два месяца будут жидки как похлёбка.&#10;&#10;Мальчишка, что ходит за его лошадками, обронил кое-что ещё вкуснее, притворяясь, будто любуется моим сырным прессом. Зерновой скупщик из &lt;span style=&quot;BandItPlus.Place&quot;&gt;Ониры&lt;/span&gt;, толстяк по прозвищу &lt;span style=&quot;BandItPlus.Name&quot;&gt;Эшмун Весовщик&lt;/span&gt;, платит двадцать шесть &lt;span style=&quot;BandItPlus.Coin&quot;&gt;денаров&lt;/span&gt; за бушель любого овса, какой ухватят его пухлые пальцы, потому как его подряд с городской стражей истекает до снегов. Двадцать шесть! Навьючь ты вереницу мулов заплесневелым фуражом с пола любого заброшенного амбара — и вернёшься домой богачом, кабы хватило духу отважиться на дорогу и ума не болтать об этом в чужом гэре.&#10;&#10;Так что, как поедешь, гони на восток, пока сырные повозки не добрались до земель побезопасней, и гони во весь опор. И помни: когда вернёшься, цены на соль лишь взлетят выше, так что прибереги мне три горсти с того, что отобьёшь. Человеку моих лет нельзя вечно есть несолёный творог, степь была когда-то зеленее, а сыры мягче, и Старый Озцин это помнит." />
    <string id="bp_vendorprofiles_306" text="Тайна, дитя? Это бурдюк. Не молоко, не кобыла, даже не пора года — бурдюк. Мой из кобыльего желудка, выскоблен кремнём, не ножом, и ни разу не мыт водой из текучего ручья. Текучая вода несёт духов, что сквашивают закваску не так. Я полощу его лишь дождём, что ловлю в &lt;span style=&quot;BandItPlus.Place&quot;&gt;Лощине Шарира&lt;/span&gt; после первого крепкого мороза. Тот дождь сладок. Речной дождь завистлив.&#10;&#10;Для курута — твёрдого сыра, что наездники берут в долгие травы, — я прессую его в петле из конского волоса, не в холстине. Волос выпускает сыворотку, но держит солёную корку туго. Солю дважды: сперва грубым серым кристаллом, что мы берём с солонцов у &lt;span style=&quot;BandItPlus.Place&quot;&gt;Излучины Тульги&lt;/span&gt;, а потом ещё раз, три дня спустя, толчёным корнем дикого чеснока, обожжённым дочерна на плоском камне. Второй засол и заставляет мой сыр держаться год в седле. Другие бабы солят раз да плачут, когда он плесневеет к середине лета. Я не плачу.&#10;&#10;Напиток из кобыльего молока — кумыс, каким кичатся парни, — я не мешаю деревом. Дерево выпивает кислинку. Мешаю конским ребром, сушёным две зимы в дымоходе. Мать моя мешала ребром своей матери сорок лет; когда она отошла, я сожгла её ребро как должно и завела своё, свежее, от серой кобылы, на которой ездила девчонкой. Ребро помнит ритм. Бурдюк, соль, ребро — вот три вещи. Кто скажет тебе иначе, тот продаёт тебе плоский кислый напиток по цене доброго.&#10;&#10;Продам тебе бурдюк кумыса за тридцать &lt;span style=&quot;BandItPlus.Coin&quot;&gt;денаров&lt;/span&gt; и клин курута за пятнадцать, и не скажу &lt;span style=&quot;BandItPlus.Name&quot;&gt;Баян-Хору&lt;/span&gt;, что ты спрашивал про ребро. Он думает, я переняла это у кузаитского торговца, и ему приятно так думать. Пусть думает. Степь была тогда зеленее, и женщина могла хранить собственные тайны без того, чтоб вождь решал, будто ему их знать положено." />
    <string id="bp_vendorprofiles_307" text="Кобылье молоко и долгая память" />
    <string id="bp_vendorprofiles_308" text="Мальчишка в долгих травах узнаёт стадо прежде собственного имени. Я ездил за ханскими кобылами прежде, чем смог удержать лук, считал жеребят на рассвете, солил шкуры в сумерках. Отец мой не был воином — он был тем, кто знал, какой родник ещё бьёт в сухой месяц и какая сурочья нора отъелась. Он научил меня, что лагерь мрёт от пустых животов задолго до того, как помрёт от пустых колчанов, и этот урок кормит меня всякую зиму с тех пор.&#10;&#10;Когда старый хан пал на дороге под &lt;span style=&quot;BandItPlus.Place&quot;&gt;Куязом&lt;/span&gt;, стадо рассеялось, а с ним рассеялись и сородичи. Я угнал на север сколько смог кобыл, выменял хромых на соль на стургийской заставе, а соль — на копчёного речного угря у болотника, что задолжал отцу услугу. С тех пор так и вожу снедь по этой кривой линии — зерно из &lt;span style=&quot;BandItPlus.Place&quot;&gt;Пен-Каннока&lt;/span&gt;, когда порубежные лорды спят, твёрдый сыр у кергитских пастухов, вяленую баранину, что сам вялю в яме за волчьими шатрами.&#10;&#10;Этот лагерь принял меня, потому что я знал старый лад кумыса — три дня взбивания, верную войлочную колыбель, чтоб держать бурдюк в тепле, хитрость второго скисания, что превращает кобылье молоко в напиток, которого хватит на целый поход. Держу и твёрдые сыры, спрессованные меж речных камней и просоленные с солончаков за &lt;span style=&quot;BandItPlus.Place&quot;&gt;Иутеусом&lt;/span&gt;. Налётчик неделю проедет на горсти того сыра да полоске вяленой конины — а здешние парни ездят жёстко.&#10;&#10;Я с ними не выезжаю. Колени мои бросили ту дорогу много зим назад. Но всякий в лагере ест с моей руки раз в день и платит мне монетой или меновыми шкурами, и этого обмена довольно. Степь даёт, степь берёт — а Старый Озцин стоит у входа в гэр с половником, храня равновесие." />
    <string id="bp_vendorprofiles_309" text="Вести из долгих трав" />
    <string id="bp_vendorprofiles_310" text="Садись. Кумыс в бурдюке у твоего колена — наливай сам, я стар нагибаться. Просишь вестей с дороги, а дорога-то говорлива была. Три ночи назад прошли всадники, копыта ещё горячие, и за сыр платили &lt;span style=&quot;BandItPlus.Coin&quot;&gt;динарами&lt;/span&gt;, чеканенными в &lt;span style=&quot;BandItPlus.Place&quot;&gt;Куязе&lt;/span&gt;. Это мне говорит, что южные ханы снова при деньгах, а ханы при деньгах покупают соль прежде мечей.&#10;&#10;К слову о соли — рынок &lt;span style=&quot;BandItPlus.Place&quot;&gt;Одоха&lt;/span&gt; платит вдвое против весенней цены. Их коптильни высохли, коптя конину для дружины, что &lt;span style=&quot;BandItPlus.Name&quot;&gt;Уркхун Кергит&lt;/span&gt; сколачивает к востоку от реки. Есть у тебя плитковая соль на продажу — вези туда до новолуния, не после. После всякий мелкий торгаш в степи прознает, и цена рухнет, как камень в колодец.&#10;&#10;Караван со сладким вином из &lt;span style=&quot;BandItPlus.Place&quot;&gt;Правенда&lt;/span&gt; блуждает по торговой тропе к &lt;span style=&quot;BandItPlus.Place&quot;&gt;Пен-Канноку&lt;/span&gt; — три повозки, двое стражей, до того пьяных, что пальцы свои не сочтут. Возница — толстый южанин по прозвищу &lt;span style=&quot;BandItPlus.Name&quot;&gt;Астрад&lt;/span&gt;, и он переплатил за наём. Будет на излучине за солёным озером дней через десять. Я лишь передаю, что слыхал. Что делать со слышанным — твоя степь.&#10;&#10;Теперь дурная весть. Зерно больно укусит в холодные месяцы. Урожай в &lt;span style=&quot;BandItPlus.Place&quot;&gt;Куязе&lt;/span&gt; был тощ — просо побурело на стебле, а река второй год мелка. Я это уже видал, паренёк. Когда тамошние житницы начинают копить, здешние деревни начинают есть семенной запас, а там, к весне, ничего не посеяно, и дети начинают мереть. Покупай зерно нынче. Покупай больше, чем думаешь. Я складываю мешки за стеной гэра, и плевать мне, кто зовёт меня скрягой.&#10;&#10;И напоследок. Вландский винный купец в &lt;span style=&quot;BandItPlus.Place&quot;&gt;Онире&lt;/span&gt; допытывается про вяленую конину — хочет её на охотничий пир какого-то лорда, заплатит серебром и не спросит, откуда лошадь. Есть у тебя вереница дрянных лошадок, каких лучше не объяснять, — вот твоя дорога. Выменяю у тебя клин твёрдого сыра на весть, как всё обернётся. Степь даёт, степь берёт. И Старый Озцин тоже." />
    <string id="bp_vendorprofiles_311" text="Старый Озцин" />
    <string id="bp_vendorprofiles_312" text="Смотритель гэра" />
    <string id="bp_vendorprofiles_313" text="Ставит шатры Улана, вялит его мясо, ставит его кумыс. Следовал за Уланом через оба изгнания и одно возвращение, что не удержалось. Говорит, боги посылают гостей неспроста, и Озцин накормил каждого из них." />
    <string id="bp_vendorprofiles_314" text="Старый Озцин, смотритель гэра при Дважды-Изгнанном Улане с первого изгнания. Рука Улана открыта тебе, странник, — боги тебя послали. Котёл же привередливей. Принеси мне {BP_VENDOR_QUEST_DESC}, и будешь есть у нашего огня, как едала некогда ханская ветвь." />
    <string id="bp_vendorprofiles_315" text="Кузаитский кумыс бродит три дня в гэровой коже, ни за что не в деревянной бочке, странник, — дерево портит крепость. Кожа дышит; кожа знает. Имперские виноделы пробуют дерево и зовут это «кумысозаменителем». Хан бы плюнул. И плевал, дважды." />
    <string id="bp_vendorprofiles_316" text="Скажи мне число в лагере и обряд, странник, — кумыс на именины, свадебный стан, поминальная чаша. Три денара за кожу, две седмицы на брожение. Роговая чарка тебе к дорожной похлёбке на нынешний вечер." />
    <string id="bp_vendorprofiles_317" text="Оба сына ездят с Уланом — старший по правую руку, младший при запасном коне. Жена умерла во второе изгнание; забрал её холод. Боги слали нам гостей, чтоб кормить, — и мы всё кормили. Рука окрепла от разлива. Так оно и идёт." />
    <string id="bp_vendorprofiles_318" text="Хэнтий Ветростан держит юрты ханской ветви — знал Улана до вычёркивания. Скажи ему, что Старый Озцин всё ещё сбраживает в коже, — отведёт для тебя полог гэра. Монета за долгую дорогу." />
    <string id="bp_vendorprofiles_319" text="Торговец из &lt;span style=&quot;BandItPlus.Place&quot;&gt;Макеба&lt;/span&gt; зимовал у нас в прошлый месяц, ось у телеги треснула, язык развязался от лишнего кобыльего кумыса. Обмолвился, что &lt;span style=&quot;BandItPlus.Name&quot;&gt;кузаитский нойон Уркхун&lt;/span&gt; тянет караван со стальными болванками по &lt;span style=&quot;BandItPlus.Place&quot;&gt;Амитатисской&lt;/span&gt; тропе всего с шестью конными лучниками по бокам. С шестью. На девятьсот весов стургийской болванки, что идёт в кузни &lt;span style=&quot;BandItPlus.Place&quot;&gt;Ортонгарда&lt;/span&gt;. Он мне между отрыжками чуть ли не карту начертил, а я, покуда он отсыпался, начертил свои выводы.&#10;&#10;Кожевенный избыток на западе — другая весть, что стоит знать. &lt;span style=&quot;BandItPlus.Name&quot;&gt;Кожевник Баязид&lt;/span&gt; в &lt;span style=&quot;BandItPlus.Place&quot;&gt;Куязе&lt;/span&gt; перекупил шкур после асерайского забоя и теперь сбывает выделанную говяжью по двенадцать &lt;span style=&quot;BandItPlus.Coin&quot;&gt;денаров&lt;/span&gt; за связку, когда прошлой весной было тридцать. Контрабандисты, что бегут на юг через дюны &lt;span style=&quot;BandItPlus.Place&quot;&gt;Дириг-Абоарда&lt;/span&gt;, платят за неё почти ничего. Значит, всякая лучная обмотка обходится мне вполовину против прежнего, и ничего из этого я тебе не уступлю, друг. Человеку есть надо.&#10;&#10;А вот весть и получше: знаменосцам &lt;span style=&quot;BandItPlus.Name&quot;&gt;лорда Мончуга&lt;/span&gt; не платили два торговых круга. Слыхал от солевого гонца, чей двоюродный ездит с их ополчением. Они распродают жилу и рог со своих же сменных коней, чтоб свести концы, — так я и взял три последние связки бычьего рога за &lt;span style=&quot;BandItPlus.Coin&quot;&gt;сорок денаров&lt;/span&gt; за всё. Коли охотишься за лордом, что к зиме не удержит верность своей свиты, — вот он, твой человек.&#10;&#10;Зерно — единственная кислая нота. Коптильня в &lt;span style=&quot;BandItPlus.Place&quot;&gt;Чайканде&lt;/span&gt; выгорела до основания в прошлую ущербную луну, и караваны, что глазировали там мясо, теперь переплачивают &lt;span style=&quot;BandItPlus.Name&quot;&gt;Солевому Капитану Ногаю&lt;/span&gt; за солонину из &lt;span style=&quot;BandItPlus.Place&quot;&gt;Дангланиса&lt;/span&gt;. Зерно пошло за солью — и то и другое вверх на треть. Это мне говорит, что лучная торговля крепка, но хлеб в долг я бы в этот сезон не брал. Ну. Тебе изогнутый или длинного натяга?" />
    <string id="bp_vendorprofiles_320" text="Хай, старого лукодела спрашиваешь про его тайну? Садись. Рог — это кость. Жила — это мышца. Дерево — лишь хребет, что держит их смирно меж выстрелами. Большинство дурней в низинах клеят все три кожным клеем и мнят дело сделанным за месяц. Лук трескается в лютую зиму, а они клянут степь. Я выдерживаю свои восемнадцать месяцев, порой и двадцать. Брюхо из рога горного барана, соскоблённого скребком из козьего зуба, покуда не запоёт ровно под большим пальцем. Спинка из жилы со спинного ремня долгобегущей кобылы, ни за что не откормленной в стойле твари, — кобыла, что бегала, знает, как пружинить назад. Сердцевина из шелковицы только с &lt;span style=&quot;BandItPlus.Place&quot;&gt;Южной Излучины&lt;/span&gt;. Берёза ломается. Клён лжёт. Шелковица помнит.&#10;&#10;Хитрость, какую ни один имперский стрельник вовек не переймёт: я варю рыбий клей с толчёной просяной шелухой и щепотью белой соли с &lt;span style=&quot;BandItPlus.Place&quot;&gt;озера Вагош&lt;/span&gt;. Шелуха даёт ему цепкость, соль не даёт ему размякнуть под летним дождём. Кладя жилу, я сперва разжёвываю каждую прядь — да, жую, — покуда моя же слюна не размягчит пучок. Тогда она ложится ровно на спинку и высыхает в дереве, будто там и выросла. Кергитский мастер, что учил меня, &lt;span style=&quot;BandItPlus.Name&quot;&gt;Старый Боролдай&lt;/span&gt;, говорил: лук, что не отведал рта своего создателя, — просто палка. Мне было девять, и я думал, он жесток. Теперь мне пятьдесят три, и иначе луков я не делал.&#10;&#10;Последняя тайна — обмотка. Когда жила схватится, я обматываю рукоять конским волосом против уклада шерсти, ни за что не по нему. Ложится сухим, стягивается, остывая. Чужеземные покупатели спрашивают, отчего мои луки стоят триста &lt;span style=&quot;BandItPlus.Coin&quot;&gt;денаров&lt;/span&gt;, когда вландский арбалетчик ниже по дороге продаёт за девяносто. Я отвечаю: его лук убьёт оленя в пятидесяти шагах этой осенью. Мой убьёт оленя в ста шагах, всякую осень, ближайшие сорок зим. Отцов лук всё ещё висит в гэре моего брата. Он погиб с ним за спиной на &lt;span style=&quot;BandItPlus.Place&quot;&gt;перевале Двух Рек&lt;/span&gt;, когда мне было двенадцать. Рог теперь жёлт, а жила потемнела, как старый мёд, но натяг всё ещё тридцать восемь фунтов на двадцати восьми дюймах. Испытай сам, как поедешь на восток. Скажи брату, что тебя послал Тергел. Он не заплачет, но нальёт тебе доброго кумыса.&#10;&#10;Ну. Всё ещё хочешь купить, или пришёл только поучиться?" />
    <string id="bp_vendorprofiles_321" text="Рог, жила, честные руки" />
    <string id="bp_vendorprofiles_322" text="Что приводит человека в это ремесло? Лук, друг. Дед мой согнул своё первое цевьё, когда бороды ещё не имел, а я согнул своё прежде, чем отросло зубов на то, чтоб жевать сушёный творог. Мы — лукоделы восточных трав: ни горна, ни наковальни, ни лязга молотов. Кусок рога горного козла, жила со спинного ремня старого мерина, плаха берёзы на сердцевину да терпения довольно, чтоб пережить зиму, покуда схватывается клей. Вот и всё, что нужно человеку, чтоб слать смерть на триста шагов.&#10;&#10;Ремеслу я выучился в гэре отца, западнее &lt;span style=&quot;BandItPlus.Place&quot;&gt;Куяза&lt;/span&gt;. В те годы мы ездили за старым &lt;span style=&quot;BandItPlus.Name&quot;&gt;ханом Уркхуном&lt;/span&gt;, и его лучники несли наши цевья во всякую стычку вдоль речной дороги. Добрый составной лук доводят два лета — рог клеят весной, жилу кладут осенью, и всё это медленно правят сквозь холод, чтоб слои научились дышать как один. Поспеши — и лук разлетится на третьем натяге и заберёт с собой чей-то глаз. Я это видал. Я не спешу.&#10;&#10;В это ремесло меня привела худая сделка. Вландский скупщик из &lt;span style=&quot;BandItPlus.Place&quot;&gt;Правенда&lt;/span&gt; заплатил мне шестьдесят &lt;span style=&quot;BandItPlus.Coin&quot;&gt;денаров&lt;/span&gt; за дюжину готовых луков, а после перепродал их за шестьсот собственным рыцарям. Я поскакал за ним с полунатянутым цевьём поперёк седла. Не догнал. А догнал я предписание на свою голову да долгую дорогу на восток, в края, куда предписания не доходят. Здешние вожди приняли меня, потому что всякому лагерю нужен человек, что приладит тетиву и вырежет ровный вырез.&#10;&#10;Так что теперь я гну рог для всадников, что укрываются под этим хребтом. Беру жилу, что они приносят мне со степных лошадок, беру козий рог у горных охотников и делаю луки, что шлют тяжёлую стрелу сквозь кольчугу в шестидесяти шагах. Цена честна, коли честен покупатель. Мне ни к чему тот, кто торгуется при свете лампы, а в полдень твердит, что натяг у меня слаб. Лук бьёт верно, коли покупатель верен. Будь честен — и уйдёшь от моего лотка с цевьём, что переживёт твоих сыновей." />
    <string id="bp_vendorprofiles_323" text="Вести с долгих троп" />
    <string id="bp_vendorprofiles_324" text="Весть пришла по Волжскому тракту в прошлый месяц — дозорные &lt;span style=&quot;BandItPlus.Name&quot;&gt;кузаитского хана Мончуга&lt;/span&gt; скупают всякий роговой лук, какой сыщут, для ополчений &lt;span style=&quot;BandItPlus.Place&quot;&gt;Куяза&lt;/span&gt;. Платят свежими &lt;span style=&quot;BandItPlus.Coin&quot;&gt;денарами&lt;/span&gt;, не обрезанными медяками, и не спрашивают про клеймо мастера. Я уже отослал на восток две дюжины, а посыльный божился, что ханские снабженцы хотят вдвое больше.&#10;&#10;Дровяному двору &lt;span style=&quot;BandItPlus.Place&quot;&gt;Пен-Каннока&lt;/span&gt; в этот сезон недостаёт тиса — мороз расколол половину зимней вырубки, и баттанийские стрельники принюхиваются к степным торговцам, ищут взамен слоёный рог с жилой. Ненадолго; гордость не даст им долго покупать &quot;восточные палки&quot;. Но покуда держится отчаяние, ловкий гонец гонит товар на север и возвращается с &lt;span style=&quot;BandItPlus.Coin&quot;&gt;денарами&lt;/span&gt;, тяжёлыми настолько, чтоб тянуть седло книзу.&#10;&#10;Кергитский караван из &lt;span style=&quot;BandItPlus.Place&quot;&gt;Тульги&lt;/span&gt; приволокся три ночи назад, весь в пыли да с поломанными осями. У них была жила — добрая жила, воловья спина, длинная — и они отдали её дёшево за воду и сухое место для сна. Я скупил всё. Так что коли ищешь цевьё, что не треснет в сухую пору, ты пришёл к нужному шатру в нужную луну.&#10;&#10;Слушай и это — &lt;span style=&quot;BandItPlus.Name&quot;&gt;лорд Уркхун&lt;/span&gt; в южных степях потерял своего мастера-лучника от кашля, а подмастерье того слишком зелен, чтоб натянуть боевое цевьё. Говорят, лорд сулит сорок &lt;span style=&quot;BandItPlus.Coin&quot;&gt;денаров&lt;/span&gt; в день да кров всякому лукоделу, что снарядит его дружину до весеннего набега. Я не пойду — довольно я поездил по лордовым лагерям, чтоб знать, чем такие сказки кончаются, — но паре рук помоложе там, может, и повезёт.&#10;&#10;И напоследок, задаром: не вози стрелы со стальными жалами на запад через &lt;span style=&quot;BandItPlus.Place&quot;&gt;Правендский&lt;/span&gt; тракт. Имперская таможня вздёрнула двух торговцев стрелами в прошлый месяц, назвала их провозчиками военного припаса. Езжай козьими тропами южнее реки. Медленнее, но покупатель на том конце верен." />
    <string id="bp_vendorprofiles_325" text="Тергел Лукодел" />
    <string id="bp_vendorprofiles_326" text="Мастер лука" />
    <string id="bp_vendorprofiles_327" text="Натягивал конные луки для ханской ветви, покуда ветвь не вычеркнула имя Улана из своих свитков. Теперь натягивает их всякому, кто платит. Всё ещё кузаит — это слышно по тому, как он играет цевьём перед продажей." />
    <string id="bp_vendorprofiles_328" text="Тергел Лукодел. Слово Улана верно; мой роговой клей вернее. Принеси мне {BP_VENDOR_QUEST_DESC}, и я натяну тебе лук, от какого имперского вербовщика мутит уже в пятидесяти шагах." />
    <string id="bp_vendorprofiles_329" text="Кузаитский конный лук берёт роговой клей в три слоя, не в два, как имперский, странник, — оттого кузаитский лук держит натяг сквозь целую походную непогоду. Имперские вербовщики могут скопировать изгиб. Клей им не скопировать. Они бросили пытаться." />
    <string id="bp_vendorprofiles_330" text="Скажи мне силу натяга и высоту в холке, странник, — натяну тебе лук, от какого имперского вербовщика мутит в пятидесяти шагах. Четыре денара за рог, две седмицы на клей. Запасная тетива для нынешнего лука — задаром." />
    <string id="bp_vendorprofiles_331" text="Отец был лукоделом в ханской ветви; его имя вычеркнули из свитков в тот же день, что и Уланово. Он спился и ушёл в степь в шестьдесят три. Я держу его горшок с клеем на верстаке. Двадцать зим им не пользовался. Раз в год, на именины, открываю проверить запах. Всё ещё держит." />
    <string id="bp_vendorprofiles_332" text="Старая Эрдэнэ натягивает луки в речном лагере у Салпа — была моей ученицей до вычёркиваний. Скажи ей, что Тергел всё ещё кладёт три слоя, — покажет тебе свой клеевой запас. Монета за переправу." />
    <string id="bp_vendorprofiles_333" text="Садись, садись — берегись сети, я на середине узла. Сплетен хочешь? Я рыбу солю на жизнь, друг, а соль — половина всех вестей побережья. Всякий контрабандист, что вытащит на берег лодчонку долить рассольные бочки, оставляет мне три слуха за одну бочку, а бочки-то в последнее время тощие.&#10;&#10;Весть от вландского гонца два прилива назад — зерно из &lt;span style=&quot;BandItPlus.Place&quot;&gt;Правенда&lt;/span&gt; берут под сорок &lt;span style=&quot;BandItPlus.Coin&quot;&gt;денаров&lt;/span&gt; за мешок в глубине материка, оттого что коптильни в &lt;span style=&quot;BandItPlus.Place&quot;&gt;Якулане&lt;/span&gt; встали. Три сразу. Сын бочара занемог, рассольные ямы скисли, кто ж знает. Суть в том, что копчёная сельдь на север не идёт, а значит, солонина повывелась, а значит, всякий караван, что тащит бочки хоть с какой засоленной снедью, стоит вдвое против того, что платят его охране за стражу. А охрана-то? Тощая. &lt;span style=&quot;BandItPlus.Name&quot;&gt;Лорд Дертерт&lt;/span&gt; увёл половину своих дружинников на восток, к границе, так что на прибрежной дороге между &lt;span style=&quot;BandItPlus.Place&quot;&gt;Сарготом&lt;/span&gt; и заливом теперь по четыре копья там, где ходило двенадцать.&#10;&#10;Есть жирный &lt;span style=&quot;BandItPlus.Name&quot;&gt;зерновой скупщик по имени Олбас&lt;/span&gt;, что переплачивает за всё засоленное, — платил шестьдесят за мешок в прошлую седмицу, платит восемьдесят в эту. У него подряд кормить гарнизон, а гарнизон ждать не станет. Контрабандисты говорят, засел он в &lt;span style=&quot;BandItPlus.Place&quot;&gt;Ротае&lt;/span&gt; и потеет над счётной книгой. И — вот это золото — &lt;span style=&quot;BandItPlus.Name&quot;&gt;граф Лаудавикс&lt;/span&gt; на мели. Заложил брошь жены с глазом чайки, гонец матерью божился. Значит, его дозорам не платят, значит, его дозоры не дозорят.&#10;&#10;Так вот приговор моря, друг, а морю я верю больше, чем любому человеку на нём: где-то между &lt;span style=&quot;BandItPlus.Place&quot;&gt;Сарготом&lt;/span&gt; и опустевшим от коптилен севером караван рассольных бочек катит к кошелю Олбаса с четырьмя усталыми копьями по бокам. Где точно — не скажу. Я лишь вяжу сети. Но отлив завтра на третий колокол, а малая лодка к сумеркам могла бы уже быть у прибрежной дороги." />
    <string id="bp_vendorprofiles_334" text="Рассол, в каком я солю трюмную рыбу, не тайна ни одной морячке, что солила улов своего мужика, — но вторая промывка моя, и я благодарю море, что ей выучился. После первых трёх дней в тяжёлой соли я вынимаю филе, полощу его в холодной морской воде, взятой в трёх лигах от любого устья, потом кладу обратно в свежую бочку с солью, урезанной на пятую часть, и горстью толчёной можжевеловой ягоды в придачу. Можжевельник убивает гниль, что подбирается после двенадцатого дня, и оставляет на рыбе резкий зелёный дух, от какого, команда божится, чайки не садятся на снасти, когда едят на палубе.&#10;&#10;Хитрость — и вот этого я вслух на рынке &lt;span style=&quot;BandItPlus.Place&quot;&gt;Саргота&lt;/span&gt; не скажу, когда рыботорговцы приходят вынюхивать, — в том, что рассол второй промывки должен отстояться полный приливный круг в бочонке с медным дном, прежде чем рыба ляжет обратно. Медь, не железо, не деревянная выстилка. Рассол чуть синеет и отдаёт неправильным на язык, но убивает всякую хворь, что оставляют по себе кишки, и бочка, засоленная так, кормит ладью шесть недель после схода на берег, и ни один не свалится в лихорадке. Готовый бочонок я отдаю за сорок &lt;span style=&quot;BandItPlus.Coin&quot;&gt;денаров&lt;/span&gt;, и покупатели мнят, будто грабят меня.&#10;&#10;Медному бочонку меня научил старый управитель по имени &lt;span style=&quot;BandItPlus.Name&quot;&gt;Эйстейн&lt;/span&gt;, что служил трём вождям до моего и потерял правую руку под тягловым канатом у утёсов близ &lt;span style=&quot;BandItPlus.Place&quot;&gt;Омора&lt;/span&gt;. Он, бывало, говорил: море решает, кто ест, а кто кормит чаек, и всё дело управителя — проследить, чтоб ответ вышел верным для его собственной команды. Он показал мне хитрость зимой перед смертью — одной рукой, заметь, черпая можжевельник из глиняного горшка, покуда я мешал, — и взял с меня клятву, что я вовек не продам способ береговому. Я и не продал. Одиннадцать сезонов уже.&#10;&#10;Сети, что я вяжу, — дело иное, их всякий канатчик скопирует, но засолка уйдёт со мной на любой холодный берег, какой выберет море. Коли человек попросит меня ласково и заплатит за два бочонка разом, я, может, и обмолвлюсь, что медь важна, но отчего — не скажу, и сколько держать — не скажу. Пусть призрак &lt;span style=&quot;BandItPlus.Name&quot;&gt;Эйстейна&lt;/span&gt; хоть это себе оставит." />
    <string id="bp_vendorprofiles_335" text="Узлы, соль и долг" />
    <string id="bp_vendorprofiles_336" text="Человек платит за вход в это ремесло холодными руками и ещё более холодным терпением. Узлам я выучился на отцовском боте из &lt;span style=&quot;BandItPlus.Place&quot;&gt;Ривачега&lt;/span&gt;, чиня сельдяные сети при лампадном масле прежде, чем смог взмахнуть веслом. Когда ледяной ветер снёс его за борт одним чёрным октябрём, лодка отошла его брату, а долг — мне: восемь &lt;span style=&quot;BandItPlus.Coin&quot;&gt;денаров&lt;/span&gt; в неделю солевому скупщику, что улыбался, как выпотрошенная треска.&#10;&#10;Три зимы я пробовал честный промысел. Возил бочковую треску вниз в &lt;span style=&quot;BandItPlus.Place&quot;&gt;Ревил&lt;/span&gt;, продавал копчёного угря на причальных торгах, целовал сапоги всякому таможенному писцу, что брал взятку рыбой заместо монеты. Потом &lt;span style=&quot;BandItPlus.Name&quot;&gt;лорд Хротгир&lt;/span&gt; поднял оброчную подать на малые суда, а солевой скупщик удвоил свою долю, и одним утром я стоял на собственном причале, задолжав больше, чем стоили его брёвна.&#10;&#10;Весной пришли ладьи. Их кормчему нужен был человек, что с одного взгляда прочтёт полное брюхо сети, просолит трюм так, чтоб улов держался три месяца, и держит рот зашитым насчёт того, откуда груз. Я взвесил честный голод против бесчестного ужина и выбрал ужин. С тех пор и солю их трюмную рыбу.&#10;&#10;Я не спрашиваю, из чьей деревни зерно. Считаю бочки, втираю соль в щели, вяжу абордажные сети так, чтоб не расползлись, когда на них висит человечья жизнь. Море там решает, кто ест, — я лишь слежу, чтоб еды хватило до следующей высадки. Плати честно — получишь честный вес; обмани весы — найдёшь крючок в своём хлебе." />
    <string id="bp_vendorprofiles_337" text="Вести с приливов" />
    <string id="bp_vendorprofiles_338" text="Фьордовые городки &lt;span style=&quot;BandItPlus.Place&quot;&gt;Омор&lt;/span&gt; и &lt;span style=&quot;BandItPlus.Place&quot;&gt;Риссун&lt;/span&gt; платят вдвое за солонину в этот сезон — сельдь дважды не пришла с холодных отмелей, и коптильни стоят пусты. Бочка, что брала восемьдесят &lt;span style=&quot;BandItPlus.Coin&quot;&gt;денаров&lt;/span&gt; прошлой зимой, идёт за сто шестьдесят у причала, без торга, без вопросов к продавцу. Есть у тебя трюм солонины да нутро для хода мимо &lt;span style=&quot;BandItPlus.Place&quot;&gt;Ревила&lt;/span&gt; — вот монета, ради какой стоит замочить сапоги.&#10;&#10;Весть пришла от чаечьеглазого гонца два прилива назад — управитель &lt;span style=&quot;BandItPlus.Name&quot;&gt;Раганвада&lt;/span&gt; скупает всякий мешок зерна отсюда до стургийского берега. Замыслили снарядить долгий поход, или прокормить флот, или и то и другое. Платит чеканным серебром, не обещаниями, чего о южных лордах не скажешь. Цена, заметь, не удержится за середину лета.&#10;&#10;Сладкое вино повывелось, что тихое море. Вландская галера, что захаживала в &lt;span style=&quot;BandItPlus.Place&quot;&gt;Пен-Каннок&lt;/span&gt; с бочонками из &lt;span style=&quot;BandItPlus.Place&quot;&gt;Саргота&lt;/span&gt;, три оборота не кажет паруса — береговые дозорные говорят, взяли её у баттанийских скал, с корпусом и всем прочим. Что осталось, то караваны &lt;span style=&quot;BandItPlus.Place&quot;&gt;Куяза&lt;/span&gt; гонят посуху через кузаитские земли и просят за это вес его в &lt;span style=&quot;BandItPlus.Coin&quot;&gt;динарах&lt;/span&gt;.&#10;&#10;В восточные деревни идёт голод, попомни меня. Саранча ударила по ржаным полям под &lt;span style=&quot;BandItPlus.Place&quot;&gt;Правендом&lt;/span&gt;, а речные баржи не поспевают везти подмогу. Вяленый угорь и дважды печённый корабельный сухарь будут менять на янтарь, на железо, на всё, что осталось отдать отчаявшемуся. &lt;span style=&quot;BandItPlus.Name&quot;&gt;Мира Солёная Рука&lt;/span&gt; из вландской гавани так мне и сказала, когда провезла мимо нас груз в прошлую седмицу, а насчёт голодного рынка она вовек не ошибается.&#10;&#10;И напоследок — коптильня в &lt;span style=&quot;BandItPlus.Place&quot;&gt;Оморе&lt;/span&gt; сгорела. Пожар от стряпного жира, всё нутро выгорело до угля да гвоздей. Всякую солёную рыбу, какую сложишь там на причал прежде, чем лорд отстроится, — и ты единственный продавец на ногах. Море решает, кто ест, да, но человек с солью и быстрым килем решает, кто ест *хорошо*." />
    <string id="bp_vendorprofiles_339" text="Холвар Мастер Сетей" />
    <string id="bp_vendorprofiles_340" text="Парусный управитель" />
    <string id="bp_vendorprofiles_341" text="Чинил паруса ладей для двух капитанов, что утонули, и одного, что нет. Теперь чинит паруса Бьорнульфа. О утонувших говорит немного — хотя чертог третьего стоит чуть выше по берегу, и Холвар знает дорогу." />
    <string id="bp_vendorprofiles_342" text="Холвар Мастер Сетей, странник. Бьорнульф зазывает тебя криком; чертог — дело иное. Капитанский мёд ему разливать; моя солёная рыба мне жаловать. Принеси мне {BP_VENDOR_QUEST_DESC}, и я наполню твой мешок из собственных запасов Бьорнульфа." />
    <string id="bp_vendorprofiles_343" text="Соли рыбу в три промывки морской водой, не в речной, какой пользуются южане, странник, — морская вода кусает гниль прежде, чем та схватится. Третья промывка — медленная; один вдох на рыбину, не больше. Чертог Бьорнульфа проедает зиму на третьей промывке. Южные чертоги и второй не переживают." />
    <string id="bp_vendorprofiles_344" text="Скажи мне ладью и число команды, странник, — две седмицы в море, полный паёк. Два денара за соль, образец в седло на нынешний вечер. Солёная рыба дотянет до третьего берега, коли мешок туг." />
    <string id="bp_vendorprofiles_345" text="Первый капитан утонул с моим братом на борту — Ари, восемнадцать зим на весле. Второй капитан утонул с отцом Бьорнульфа. Третий всё ещё в ходу. Брат был рыбак получше. Море первыми забирает не тех; вот засолка, какой я выучился. Теперь полощу трижды, всякую рыбину, без исключений." />
    <string id="bp_vendorprofiles_346" text="Ингвар Хладнорукий держит чертог выше по берегу под старым стягом третьего капитана — знал моего брата. Скажи ему, что Холвар всё ещё полощет трижды, — усадит тебя у дальнего огня. Монета за проход на ладье." />
    <string id="bp_vendorprofiles_347" text="Команда пригребла вчера на закате с бортом, полным гнутого якорного железа, и с байкой, что дороже самого металла. Говорят, шли по пятам за караваном болванок в трёх днях от &lt;span style=&quot;BandItPlus.Place&quot;&gt;Правенда&lt;/span&gt;, латный припас для кузнеца какого-то голодного лорда. Шесть стражей. Шесть. На повозку ценой в восемнадцать тысяч &lt;span style=&quot;BandItPlus.Coin&quot;&gt;денаров&lt;/span&gt;, коли сталь чистого сорта. Кто нанимал ту охрану, тот жмётся на медяках, а прижатые медяки делают кузнеца вроде меня очень охочим до того, куда свернёт его дорога дальше.&#10;&#10;Болтливый оказался жестянщиком-коробейником, какому мы дали пить заместо утопить. Он божится, что &lt;span style=&quot;BandItPlus.Name&quot;&gt;лорд Унвалин&lt;/span&gt; на два месяца задолжал по железному счёту гарнизона и платит своему оружейнику обещаниями да солёной треской. Солёной треской, брат. Вассал, что не может закрыть счёт кузнеца, и выкуп не закроет, так что коли его дозорные сунутся в бухту, держим его дёшево и даём команде голосовать. Я скорее возьму полцены доброй болванкой, чем полную цену его ржавыми &lt;span style=&quot;BandItPlus.Coin&quot;&gt;денарами&lt;/span&gt;.&#10;&#10;Контрабандисты из &lt;span style=&quot;BandItPlus.Place&quot;&gt;Ортонгарда&lt;/span&gt; сказали повару, что на юге кожевенный избыток — три дубильни сбросили шкуры по четыре &lt;span style=&quot;BandItPlus.Coin&quot;&gt;денара&lt;/span&gt; за связку, потому что южное войско отменило заказ. Значит, ножны и обмотки в этот сезон обходятся мне даром. Значит, могу обернуть всякое топорище двойной кожей и всё равно сбить цену внутренним кузням. А ещё значит, что всякий, кто пробует продать нам кожу по старой цене, грабит нас, и я запомню лицо, как увижу.&#10;&#10;И последнее, что принёс прилив, — зерновой ког из &lt;span style=&quot;BandItPlus.Place&quot;&gt;Эпикротеи&lt;/span&gt; переплачивает за чугун, двадцать сверх рынка, потому что у их собственной литейни треснула стена сыродутной печи. &lt;span style=&quot;BandItPlus.Name&quot;&gt;Халвар&lt;/span&gt; слыхал это дважды в двух разных корчмах, так что верно достаточно, чтоб действовать. Неси мне лом. Неси битый латный доспех, ломаные тесаки, отломанные лапы якорей — всё железное, я перекую в торговые болванки, и мы отвезём их на север, прежде чем их каменщики залатают стену. Море даёт металл, молва говорит, где его спустить." />
    <string id="bp_vendorprofiles_348" text="Якорное железо. Вот тайна, какую никто западнее &lt;span style=&quot;BandItPlus.Place&quot;&gt;Якулана&lt;/span&gt; слышать не хочет, но она — правда всякого топора, что висит на этой стойке. Команда вытаскивает лапы да веретёна с обломков у шхер — большей частью старые якоря &lt;span style=&quot;BandItPlus.Place&quot;&gt;вландских&lt;/span&gt; патрульных галер, четырёхлапые, с толсто приваренной коронкой, — а я срезаю их у шейки. Железо мокло в рассоле сорок, шестьдесят, сотню зим. Выходит из соли медленно, упрямо и чуток злым, и вот эта злость мне и нужна в боевом топоре.&#10;&#10;Вся хитрость в складывании. Болотное железо кузнец складывает семь раз, восемь, чтоб выгнать шлак. Якорное я складываю всего трижды. Больше — и выпаришь из него море. Надо оставить солёных призраков запертыми в волокне — чёрные прожилки, что видны на протраве, коли отполируешь как надо. Вот где живёт лезвие. Когда рубишь кромку щита, призраки цепляют и рвут, а не скользят вчистую. Старый &lt;span style=&quot;BandItPlus.Name&quot;&gt;Хроар Двуязыкий&lt;/span&gt; там, в &lt;span style=&quot;BandItPlus.Place&quot;&gt;Оморе&lt;/span&gt;, зовёт это грязной работой и берёт триста &lt;span style=&quot;BandItPlus.Coin&quot;&gt;денаров&lt;/span&gt; за гладкий клинок. Мои идут по сто двадцать и кусают вдвое глубже. Пусть держит при себе свою чистую сталь.&#10;&#10;Калю тоже в морской воде, не в дождевой бочке. Взять надо свежей тем же утром, с западной стороны мыса, где течение тянет сильно, — портовую воду не беру, портовая вода усталая. Шип, когда роняю в неё горячий клинок, иной. Резче. Отец научил меня к нему прислушиваться. Он был якорным кузнецом на &lt;span style=&quot;BandItPlus.Place&quot;&gt;стургийской&lt;/span&gt; ладье до крушения у рифа Сигил, и когда его вытащили из прибоя три дня спустя, единственное, что на нём осталось, — молот на поясе. Тот самый молот я держу теперь. Он, бывало, говорил, что всякий металл всё равно приходит из моря — руда была лишь морем, что забыло, как течь. Я не понимал его, пока не начал ковать из якорей. Теперь думаю, он был единственным честным кузнецом, какого я знал.&#10;&#10;Так что, когда махнёшь моим, ты машешь тем, что уже раз утонуло и вернулось злее. Смазывай тюленьим жиром, не оливой — олива горкнет, а призраки не терпят её запаха. И коли она когда-нибудь запоёт тебе в бурю, не пугайся. Это просто соль вспоминает." />
    <string id="bp_vendorprofiles_349" text="Плата морским железом" />
    <string id="bp_vendorprofiles_350" text="Отец мой был береговым мародёром на утёсах севернее &lt;span style=&quot;BandItPlus.Place&quot;&gt;Ротае&lt;/span&gt;, и море платило ему железом чаще, чем рыбой. Всякая буря разбивала имперские галеры о его скалы, и всякий рассвет мы обходили гальку, вытаскивая якоря, цепь, обломки мечей, ломаные утки — всё, что соль ещё не проела. Он научил меня читать берег, как городской кузнец читает болванку, и научил единственному честному завету, что я сберёг: всякий металл всё равно приходит из моря, парень. Рудники лишь одолжили его первыми.&#10;&#10;Годы подмастерья я отслужил под вландским кузнецом в &lt;span style=&quot;BandItPlus.Place&quot;&gt;Сарготе&lt;/span&gt;, отбивая подковы для всадников &lt;span style=&quot;BandItPlus.Name&quot;&gt;лорда Тифоса&lt;/span&gt;, покуда тот не застал меня за опиловкой трофейного корсарского топора для причального работника, что заплатил мне три &lt;span style=&quot;BandItPlus.Coin&quot;&gt;денара&lt;/span&gt; медью. Он назвал это кражей горнового времени. Я назвал приработком. Судья принял его сторону, и я потерял за это правую руку по запястье — не всю кисть, заметь, лишь четыре пальца да большой, что важнее всех. Якорной Рукой меня теперь зовут, потому что взамен мне приладили гнутый железный крюк, что нордский кузнец припаял к культе в &lt;span style=&quot;BandItPlus.Place&quot;&gt;Оморе&lt;/span&gt;, и держит он рукоять клещей лучше, чем когда-либо держала плоть.&#10;&#10;Команда подобрала меня у выброшенной на берег ладьи две зимы назад, полуголодного, меняющего свой молот на сухари. Ребята выволокли на берег целый имперский становой якорь и не знали, что делать с тремя сотнями весов мягкого железа. Я показал. Один якорь становится одиннадцатью топорами, четырнадцатью ножами-саксами и таким числом гвоздей, что хватит перебрать обшивку корпуса, коли знаешь нагревы. С тех пор они держат меня при угле и закалочном масле, а я держу их лезвия честными.&#10;&#10;Здесь я не кую для королей и не кую красиво. То, что я делаю, должно прокусить кольчугу с одного удара и не переломиться о кромку щита, потому что коли брат падёт из-за худой сварки, то на кургане будет моё имя. Так что, когда несёшь мне &lt;span style=&quot;BandItPlus.Coin&quot;&gt;денары&lt;/span&gt;, я взвешиваю их против железа так же, как море взвешивает всё, — медленно, честно и без лести. Морское железо, морская цена. Вот ремесло, что ввело меня в этот лагерь, и оно же вынесет меня из него." />
    <string id="bp_vendorprofiles_351" text="Морское железо, морское слово" />
    <string id="bp_vendorprofiles_352" text="Весть пришла из &lt;span style=&quot;BandItPlus.Place&quot;&gt;Риссала&lt;/span&gt; в прошлую седмицу — тамошний лорд платит вдвое за наконечники стрел, триста за гросс. Какой-то вландский пёс разворошил осиное гнездо на своём восточном походе, и теперь он хочет, чтоб всякий кузнец отсюда до &lt;span style=&quot;BandItPlus.Place&quot;&gt;Ортонгарда&lt;/span&gt; согнулся над наковальней. Морской цены, заметь, не заплатит. Внутренняя монета всегда пахнет страхом и лезет торговаться.&#10;&#10;По берегу из &lt;span style=&quot;BandItPlus.Place&quot;&gt;Омора&lt;/span&gt; идёт караван со стальным припасом, на вландские рынки. Три повозки, баттанийская охрана, тащится медленно по мысовой дороге мимо белых утёсов. Я не говорю тебе, что с этим делать. Я говорю, что на дороге. &lt;span style=&quot;BandItPlus.Name&quot;&gt;Эйрик Буревран&lt;/span&gt; в соседней бухте уже знает. Он теперь платит команде &lt;span style=&quot;BandItPlus.Coin&quot;&gt;денарами&lt;/span&gt;, не долями, — суди сам, что это значит.&#10;&#10;&lt;span style=&quot;BandItPlus.Name&quot;&gt;Лорд Каладог&lt;/span&gt; заказал сотню щитов из &lt;span style=&quot;BandItPlus.Place&quot;&gt;Пен-Каннока&lt;/span&gt; — липа, железные ободья, клановый узел его вытиснен в коже. Тамошние кузнецы гонят подмастерьев, а цена на заклёпочный припас стала дурной. Есть у тебя где-то мешок болотного железа, о каком ты забыл, — вези его вглубь материка. Вернёшься богат настолько, чтоб пить целый сезон.&#10;&#10;Сёдельная торговля на степной дороге мрёт. Кузаитские всадники не покупают — что-то шевелится за &lt;span style=&quot;BandItPlus.Place&quot;&gt;Куязом&lt;/span&gt;, и они сами делают свою справу, быстро и грубо. Кожевник-раскройщик в &lt;span style=&quot;BandItPlus.Place&quot;&gt;Ревиле&lt;/span&gt; сказал мне, что не продал ни одного боевого седла за два месяца. Дурной знак ему. Добрый знак тому, кто скупит его товар задёшево, прежде чем он свернёт дело.&#10;&#10;Последнее слово — и его стоит послушать. Стургийский кузнец по имени &lt;span style=&quot;BandItPlus.Name&quot;&gt;Василий Седобородый&lt;/span&gt; помер у своего горна в прошлый месяц, оставил мастерскую, полную недокованных дамасских клинков, и некому их забрать. Его вдова сбывает всё меньше чем за две тысячи &lt;span style=&quot;BandItPlus.Coin&quot;&gt;денаров&lt;/span&gt;, лишь бы очистить пол. Это цены якорного железа за мечевую сталь. Кто-то войдёт в &lt;span style=&quot;BandItPlus.Place&quot;&gt;Ревил&lt;/span&gt; и выйдет богачом. С тем же успехом пусть это будет тот, кто умеет слушать." />
    <string id="bp_vendorprofiles_353" text="Снорри Якорная Рука" />
    <string id="bp_vendorprofiles_354" text="Горновой кузнец" />
    <string id="bp_vendorprofiles_355" text="Ковал якоря ладей и мечевые лезвия для трёх команд, прежде чем осел под чертогом Бьорнульфа. Выбелен солью, как и всё здесь. Говорит, соль заставляет его сталь петь иначе — &quot;по-стургийски глубоко&quot;, как он это зовёт." />
    <string id="bp_vendorprofiles_356" text="Снорри Якорная Рука, солевой кузнец. Бьорнульф впускает тебя смехом — таков капитан. Горн снимает свою мерку медленнее. Принеси мне {BP_VENDOR_QUEST_DESC}, и я наточу тебе клинок, какой столбы чертога запомнят с того дня, как ты вышел с ним." />
    <string id="bp_vendorprofiles_357" text="Выбеленная солью сталь поёт иначе, странник, — рассол кусает волокно, лезвие перенимает укус. Имперские кузнецы отпускают в пресной воде и дивятся, отчего их клинки крошатся на третьем ударе. По-стургийски глубоко, я это зову. Столбы чертога всё ещё носят мои якорные метки там, где они куснули с первого удара." />
    <string id="bp_vendorprofiles_358" text="Принеси мне стальной брусок и палубу ладьи, странник, — наточу тебе клинок, какой чертог запомнит. Пять денаров за горн, рассол уже набран. Вот, клин тебе на пояс, покуда стынет." />
    <string id="bp_vendorprofiles_359" text="Жена утонула на первой засолке — Хельга, двадцать зим при кузне. Она кипятила рассол, покуда я бил. Чертог хранит её имя на стропильной балке, третий столб от двери. Я вожу клинком по столбу всякое новолуние, просто чтоб послушать. Дерево всё ещё отвечает." />
    <string id="bp_vendorprofiles_360" text="Старый Сигурд кузнечит в стургийском причальном квартале под клеймом старого чертога — назвáный брат Хельги. Скажи ему, что Снорри всё ещё солит глубоко, — покажет тебе наковальню с якорной меткой. Монета за проход на ладье." />
    <string id="bp_vendorprofiles_361" text="Садись, садись. Глиняный горшок не закипит быстрее оттого, что на него пялишься, а у старого Карима есть чем языком потрепать, покуда финики размягчаются. Чуешь? Кардамон с каравана, что приковылял сюда три восхода назад, расплатился со мной пряностью, потому как кошель у них и без того был лёгок. Спустились они из &lt;span style=&quot;BandItPlus.Place&quot;&gt;Хусн-Фулана&lt;/span&gt;, говорили, будто духов повидали. Сказали, житницы в тех краях наполовину пусты, а тамошний управитель скупает пшеницу почти по денару за меру, когда в прошлый месяц она шла по шестьдесят. Кто-то где-то придержал свой урожай, и цена лезет вверх всякую неделю, что ветер дует не туда.&#10;&#10;А вот и мясо в похлёбке. Солёная дорога, что вьётся мимо сухих вади, та, что караванщики зовут Длинным Языком, несёт при себе теперь всего шесть копий. Шесть. На повозки с каменной солью и вяленой рыбой, что идут к &lt;span style=&quot;BandItPlus.Place&quot;&gt;Куязу&lt;/span&gt;. За охрану платит купец &lt;span style=&quot;BandItPlus.Name&quot;&gt;Хабиб аль-Муаллим&lt;/span&gt;, и стражи его ворчат, что он перестал покупать им новые сапоги. Кто скупится на сапоги своей стражи, тот скупится на её верность, разумеешь? Шесть копий, тучные мешки да хозяин, чьи завязки кошеля затянуты вдвое. Я не говорю, что это приглашение, брат. Я лишь говорю, что похлёбка примечает, когда в неё падает мясо.&#10;&#10;Повар до меня, да переварится его душа мягко, всегда мне твердил: слушай, какой лорд у какого купца в долг берёт. Весть от двоюродного моего свояка, возчика инжира, такова, что лорд в &lt;span style=&quot;BandItPlus.Place&quot;&gt;Бильгаре&lt;/span&gt; до того беден на &lt;span style=&quot;BandItPlus.Coin&quot;&gt;денары&lt;/span&gt;, что продал утварь собственной жены, чтоб уладить долг с пряной гильдией. Когда вельможа закладывает горшки, он вскоре закладывает и дозоры. Заметь, какие деревни у его земель первыми теряют своих всадников. Там-то и затихнут коптильни, там-то солёная козлятина и перестанет доходить до рынка, там-то голодный караван и заплатит вдвое за то, что мы можем поставить.&#10;&#10;И ещё одно, а там надо переворачивать финики, пока они не заплакали. По восточным оазисам орудует дурень-скупщик зерна, толстомордый южанин по имени &lt;span style=&quot;BandItPlus.Name&quot;&gt;Юсуф бин Тарик&lt;/span&gt;, что платит семьдесят &lt;span style=&quot;BandItPlus.Coin&quot;&gt;денаров&lt;/span&gt; за меру ячменя, какой взял бы за сорок, кабы поторговался. Ребята говорят, он закупает для войска какого-то северного лорда и знать не знает, сколько это стоит, лишь бы мешки дошли. Коли тебе вдруг привалит ячмень, каким бы ветром его к тебе ни надуло, гони на восток, сыщи толстомордого и дай ему опорожнить кошель в твой. А теперь ступай. Финики зовут, а старый Карим не даёт финикам ждать сплетен." />
    <string id="bp_vendorprofiles_362" text="Большинство думает, что финик — это финик. Сожми, понюхай, кинь в рот — сладкое сладко, да? Нет. Финик поёт, друг. Прижми большой палец к кожуре и слушай пальцами. Халас из &lt;span style=&quot;BandItPlus.Place&quot;&gt;Нахасы&lt;/span&gt; гудит низко и маслянисто, создан для медленного томления. Янтарная аджва с высоких пальм щёлкает, как сухой пергамент, — её крошишь в солевой горшочек, ни за что не в котёл. Этому научила меня мать в караван-сарае под &lt;span style=&quot;BandItPlus.Place&quot;&gt;Куязом&lt;/span&gt;, прежде чем пришли солдаты и колодец сделался горек. Она не подпускала меня к стряпному огню, покуда я не мог сказать ей с завязанными глазами, какой из семи фиников из какого оазиса. Дошёл я до этого лишь к одиннадцати вёснам.&#10;&#10;Так вот тайна моего котла, и я говорю её, потому что ты заплатил добрыми &lt;span style=&quot;BandItPlus.Coin&quot;&gt;денарами&lt;/span&gt; и потому что старики устают копить. Я готовлю ягнёнка в три слоя. Низ: зелёные финики, недозрелые, какие купцы выбрасывают, — их я толку с семенем кумина и топлёным курдючным салом жирнохвостой овцы и вжимаю в глину прежде, чем к ней прикоснётся мясо. Это основа. Середина: само мясо, натёртое лишь кислым верблюжьим йогуртом да чёрной солью, что я сам вывариваю с солончаков близ &lt;span style=&quot;BandItPlus.Place&quot;&gt;Хусн-Фулка&lt;/span&gt;. Никаких пряностей. Пряность в середине — трусливая уловка. Верх: венец из вполне спелого меджуля, надрезанного и без косточек, уложенного кожурой вниз, как лодочки. Запечатано тестом из муки с водой по краю крышки. Шесть часов в углях. Зелёные внизу дают остроту, меджуль сверху роняет свой мёд вниз сквозь мясо. К тому часу, как сломаешь печать, ягнёнок съел финики, а финики съели ягнёнка, и не разберёшь, где одно кончается.&#10;&#10;Хитрость, настоящая хитрость — наклонись ближе, кричать я её не стану — это чёрная соль. Всякий повар твердит про свою смесь соли. Моя обжарена в запечатанном горшке с одной горстью сушёной гранатовой кожуры да тремя оболочками саранчи. Да, саранчи. Оболочки сгорают в горькую золу, что уводит сладость финика вбок, в нечто, чему язык названия не сыщет. &lt;span style=&quot;BandItPlus.Name&quot;&gt;Юсуф Хромой&lt;/span&gt; пытался украсть рецепт, подглядывая за мной сквозь щель в шатре в &lt;span style=&quot;BandItPlus.Place&quot;&gt;Икбайле&lt;/span&gt;; гранат он ухватил, а саранчу проглядел, и теперь его похлёбка на вкус что извинение печальной бабы. Я над ним не смеюсь. Не слишком.&#10;&#10;Одиннадцать лет я не стряпал у настоящего очага. Караван движется, горшки едут закатанными в войлок, и я читаю финики при свете факела, покуда мужики помоложе высматривают на дюнах всадников. Порой вспоминаю материнскую кухню, синие изразцы, запах кардамона на рассвете. А потом отведаю халас — и знаю, в каком оазисе он вырос, и знаю, что я всё ещё её сын. Ешь медленно, друг. Финик, что зрел семь месяцев, заслуживает больше двух укусов." />
    <string id="bp_vendorprofiles_363" text="Горшок, пальма, терпение" />
    <string id="bp_vendorprofiles_364" text="Отец мой держал финиковую рощу под &lt;span style=&quot;BandItPlus.Place&quot;&gt;Куязом&lt;/span&gt;, и прежде, чем я мог поднять корзину, он научил меня слушать плод. Финик говорит, друг, — тонкокожие шепчут о лишнем солнце, тяжёлые кряхтят о медленной осени, а сладкобрюхий халас гудит, как женщина, что знает, что любима. Я читаю их, как кади читает писание, и к двенадцатой моей поре отец брал с караванов лишний &lt;span style=&quot;BandItPlus.Coin&quot;&gt;динар&lt;/span&gt; за мешок, потому что мальчишка мог вслепую выбрать горькие.&#10;&#10;Потом настал податный год, когда &lt;span style=&quot;BandItPlus.Name&quot;&gt;эмир Ункид&lt;/span&gt; удвоил соляной сбор, и роща отошла его приставу за долг, какого отец не делал. Я побрёл на запад с глиняным горшком, горстью косточек и той одеждой, какую пристав не потрудился забрать. Долгую пору я стряпал для пряного обоза, что ходил между &lt;span style=&quot;BandItPlus.Place&quot;&gt;Икбайлом&lt;/span&gt; и южными колодцами, — просяная каша по утрам, баранина с финиками, томлённая медленно по ночам, снедь, что держит человека прямо в седле шестнадцать часов.&#10;&#10;Набег прикончил пряный обоз южнее солончаков. Возчики бежали, верблюды разбрелись, а я сел подле своего горшка, потому как человек моих лет от лошадей не убежит. Вожак той шайки поднял крышку, отведал похлёбки и рассмеялся — сказал, что всякий повар, что удержит похлёбку сладкой сквозь бой, стоит больше серебра в седельных сумах. Так он оставил меня, горшок и последние мои финики и привёз сюда.&#10;&#10;Было это одиннадцать пор назад. Ребята несут мне зерно, краденое с &lt;span style=&quot;BandItPlus.Place&quot;&gt;Правендской&lt;/span&gt; дороги, соль, отбитую с южных солончаков, копчёную козлятину с горных загонов, а я обращаю это в нечто, на вкус будто у человека всё ещё есть дом. Я держу теперь и собственные финиковые пальмы, в горшках у водоёма, — три штуки, выросшие из косточек, что я вынес из &lt;span style=&quot;BandItPlus.Place&quot;&gt;Куяза&lt;/span&gt;. Плодоносят тонко и горько, но плодоносят.&#10;&#10;Вот что приводит человека в это ремесло — краденая роща, неспешный котёл да простая правда, что голодным всё равно, чей стяг реет над поваром. Терпение раскрывает финик. Монета раскрывает горшок. Садись, и я раскрою оба." />
    <string id="bp_vendorprofiles_365" text="Вести с дюнных троп" />
    <string id="bp_vendorprofiles_366" text="Садись, садись. Глиняный горшок держит жар лучше моих старых костей, так что наклонись ближе. Весть пришла две ночи назад с солевыми гонцами из &lt;span style=&quot;BandItPlus.Place&quot;&gt;Куяза&lt;/span&gt; — житницы там наконец треснули, и управитель платит восемьдесят &lt;span style=&quot;BandItPlus.Coin&quot;&gt;динаров&lt;/span&gt; за мешок всякого чистого ячменя, что ещё пахнет полем. Коли везёшь зерно на юг, не трать его на прибрежные городки. Куяз голоден громче.&#10;&#10;Из &lt;span style=&quot;BandItPlus.Place&quot;&gt;Иякиса&lt;/span&gt; ползёт вверх караван со сладким вином — шесть верблюдов, двое хромают, а хозяин — вландец по прозвищу &lt;span style=&quot;BandItPlus.Name&quot;&gt;Томас Лозовый&lt;/span&gt;, что даёт страже на чай медью, а повару и вовсе ничем. Идут долгой западной тропой, чтоб обойти пошлинную крепость. Есть у тебя мёд или прессованные финики на мену — руки у него слабеют к третьей чаше его же груза. Мне ли не знать. Я обучил мальчишку, что ему разливает.&#10;&#10;Дурная весть скачет быстрее доброй. Южные оазисы между &lt;span style=&quot;BandItPlus.Place&quot;&gt;Ар-Разиром&lt;/span&gt; и солончаками сделались горьки — три колодца кряду, все загажены, и козопасы уже жгут своих мёртвых козлят. Тощий год идёт на всю ту полосу. Покупай вяленое мясо нынче, прежде чем прознают в урожайных городках и цена скакнёт. И соль тоже. Всегда соль.&#10;&#10;Купец из &lt;span style=&quot;BandItPlus.Place&quot;&gt;Хусн-Фулка&lt;/span&gt; проехал вчера, искал корицу и шафран по любой цене — какой-то асерайский эмир выдаёт третью дочь, и кухни в панике. Пряность, что стоила тебе сорок &lt;span style=&quot;BandItPlus.Coin&quot;&gt;динаров&lt;/span&gt; в прошлый месяц, возьмёт сто двадцать, коли достигнешь свадебных ворот прежде пира. Гони во весь опор или не берись вовсе.&#10;&#10;И один шепоток, друг, раз уж ты купил финик, а не одну болтовню. &lt;span style=&quot;BandItPlus.Name&quot;&gt;Сестра Халима&lt;/span&gt;, что держит коптильню у второго водопоя, начала солить вдвое против того, что продала в прошлый сезон. Даром она не солит. Либо знает голод, какой я лишь учуял, либо военная ватага платит ей вперёд. Так или иначе — набей седельные сумы очажным хлебом и вяленым ягнёнком, прежде чем поедешь на запад. Горшки тут будут ещё тёплыми, когда вернёшься. Коли вернёшься." />
    <string id="bp_vendorprofiles_367" text="Старый Карим Финикочтец" />
    <string id="bp_vendorprofiles_368" text="Караванный повар" />
    <string id="bp_vendorprofiles_369" text="Читал песок для караванов, покуда дюны не забрали его последнюю жену. Теперь читает его для костров Хаккуна; котёл наполняется так же. Говорит, песок сказал ему три зимы назад, что ты придёшь, — но песок говорит это всякому." />
    <string id="bp_vendorprofiles_370" text="Старый Карим Финикочтец. Песок трижды кряду вымолвил твоё имя, странник, — гласит Хаккун. Котёл услыхал его однажды. Принеси мне {BP_VENDOR_QUEST_DESC} с дороги, и дюны поутру вымолвят его ласковей." />
    <string id="bp_vendorprofiles_371" text="Финики, вяленные на песке, берут четырёхдневный шатёр, не трёхдневный, как торопят куязские купцы, странник. Четвёртый день — вот в чём соль: солнце вытягивает последнюю воду и оставляет сахар долгими нитями. Дюны знают счёт. Купцы дюн не спрашивают." />
    <string id="bp_vendorprofiles_372" text="Скажи мне караван и обряд, странник, — свадебная ночь, именины, поминальная чаша. Три денара за шатёр, две седмицы на вяление. Финик к нынешнему дорожному пайку." />
    <string id="bp_vendorprofiles_373" text="Жена ушла под дюны — песчаная буря, долгий переход, третий караван, что я потерял. Песок вернул мне её имя на следующем рассвете; твердил его три дня кряду. Я читаю песок для костров Хаккуна теперь, и песок иными ночами всё ещё называет её имя. Я всё слушаю, потому что она всё ещё его говорит." />
    <string id="bp_vendorprofiles_374" text="Старая Юсра читает песок на краю куязского рынка под навесом финикового лотка — знала мою жену. Скажи ей, что Карим всё ещё вялит четыре дня, — покажет тебе задний шатёр. Монета за переход через пустыню." />
    <string id="bp_vendorprofiles_375" text="Садись. Угли нынче горячи, и язык тоже. Солевой торговец из &lt;span style=&quot;BandItPlus.Place&quot;&gt;Куяза&lt;/span&gt; ввалился на рассвете, искал перековать верблюда да человека, чтоб выслушал, а я и то и другое. Говорит, &lt;span style=&quot;BandItPlus.Name&quot;&gt;эмир Ункид&lt;/span&gt; истекает серебром — три каравана ушли в этот сезон к нашим сородичам, а клановая казна его сошла до шёпота. Снабженец эмира был в &lt;span style=&quot;BandItPlus.Place&quot;&gt;Икбайле&lt;/span&gt; на прошлой неделе, сулил &lt;span style=&quot;BandItPlus.Coin&quot;&gt;240 денаров&lt;/span&gt; с головы всякому ветерану, что усидит на песчаной кобыле. Это цена отчаявшегося, друг. Лорд, что платит 240 нынче, в следующий месяц не заплатит ничего, потому что караваны его станут ещё легче.&#10;&#10;А теперь наклонись ближе — вот ради чего стоило зайти. &lt;span style=&quot;BandItPlus.Place&quot;&gt;Хусн-Фулкская&lt;/span&gt; дорога, та долгая кривая, что жмётся к сухому вади, ходит теперь с охраной в два копья. В два. На караваны, что тянут стальные болванки с северных литеен. Я сам видел те повозки, оси волочатся, а стражи — мальчишки, у которых отцовские шлемы сползают на глаза. Кто владеет теми болванками — а контрабандист намекнул, что это скупщик, что работает на &lt;span style=&quot;BandItPlus.Name&quot;&gt;Хакима ас-Сарраджа&lt;/span&gt;, — поставил на скорость, а не на мечи. Караваны стальных болванок, друг мой. Такие, о каких горн заплачет. Такие, какие ловкий сородич встретил бы на третьей излучине за сухим колодцем, где утёсы бросают тень ко второй молитве.&#10;&#10;Вести о зерне безобразнее, и оттого я в эту седмицу сбавляю цену на ятаганы. Коптильни &lt;span style=&quot;BandItPlus.Place&quot;&gt;Разиха&lt;/span&gt; выгорели в сухих ветряных бурях — три из них, большие, — так что солонина пропала со всякого рынка отсюда до побережья, а соль утроилась. Караваны, что поднимаются с южных солончаков, стерегут как цариц. Их не трогай. А вот ЗЕРНО, что идёт ВНИЗ кормить те же солончаки, едва под присмотром, потому что никто не стережёт того, чего никто не грабит. &lt;span style=&quot;BandItPlus.Name&quot;&gt;Купчиха Юсра бинт Тахир&lt;/span&gt; переплачивает — &lt;span style=&quot;BandItPlus.Coin&quot;&gt;85 денаров&lt;/span&gt; за мешок в &lt;span style=&quot;BandItPlus.Place&quot;&gt;Мугаре&lt;/span&gt;, вдвое против честной цены, — потому что без него её печи стынут. Повозка её зерна, перепроданная её же скупщику у других ворот, была бы опрятной работёнкой.&#10;&#10;И последнее, а там хочу видеть монету на наковальне. Есть кожевенный избыток. Дубильня выше по реке обсчиталась со своими стадами, и шкуры копятся — три каравана прошли на прошлой неделе с тюками шкур, каких никто не хочет, продали по тридцать за стопу, и хозяева были рады от них избавиться. Я скупил сколько смог на рукояти и ножны, оттого эти изогнутые клинки на стойке дешевле, чем в прошлый месяц. Пустынный зной делает половину работы; шепоток сородича — другую половину. Так что — ты покупаешь меч или покупаешь карту? Я продаю и то и другое, и второе стоит дороже." />
    <string id="bp_vendorprofiles_376" text="Пустыня — половина работы. Люди слышат, как я это говорю, и смеются, но я разумею это так, как человек разумеет собственное имя. Горн даёт мне первый жар — песок даёт второй. Когда я вынимаю клинок из углей и кладу его на длинный железный поддон, утопленный в пол, песок под ним уже в восемьдесят градусов от полудня. Он не крадёт тепло обратно, как крала бы каменная плита. Сталь стынет так, как человек засыпает в тени, — медленно, ровно, без дрожи в волокне. Это половина моей закалки, и я не заплатил за неё ни медяка.&#10;&#10;Другая половина — изгиб. Всякий здешний Песчаный Кузнец кует изогнутое, и всякий дурень мнит, будто изгиб — чтоб красиво смотреться на бедре. Нет. Изгиб режет дольше, потому что лезвие встречает плоть под скользящим углом, как тростниковый нож чистит финик. Свой я вывожу с долом не толще большой кости пальца, посаженным высоко на обухе, и никогда не точу брюшко клинка ровно — низ изгиба получает более тонкую фаску, чем верх, потому что низ и делает работу в нисходящем ударе с верблюда. Прямоточеный клинок крошится на третьей драке. Мои возвращаются ко мне после двадцати, и хозяева хотят их переполировать, а не переточить. Вот в чём разница, и я беру за это восемьсот &lt;span style=&quot;BandItPlus.Coin&quot;&gt;денаров&lt;/span&gt; и глазом не моргнув.&#10;&#10;На калке я теряю подмастерьев. Я не беру воду и не беру масло — я беру рассол с солончаков южнее &lt;span style=&quot;BandItPlus.Place&quot;&gt;Куяза&lt;/span&gt;, три жбана в сезон, что привозит сородич, задолжавший мне свои зубы. Соль кусает поверхность быстрее масла и оставляет на стали корку, что принимает ржавчину, как черепаха принимает дождь, — просто отмахивается. Оставь один мой клинок на седле на неделю песчаной бури — и лезвие всё ещё будет брить. Попробуй так с &lt;span style=&quot;BandItPlus.Place&quot;&gt;стургийским&lt;/span&gt; длинным мечом — и ко второй ночи будешь спиливать с него красную пыль.&#10;&#10;Всему этому я выучился у отца, что выучился у своего, и его молот — вон тот, на втором колышке, короткий, с треснувшим топорищем, какое я не стану менять. Он работал на этом самом полу, когда шайка тут была всего из шести мужиков да козы, а дед &lt;span style=&quot;BandItPlus.Name&quot;&gt;Сарика&lt;/span&gt; ещё грабил караваны пешим. Молодым, что приходят покупать, я говорю: платят они не за сталь. Платят за четыре поколения людей, что усвоили: пустыня — товарищ, не враг, и кузнец, что воюет со своим климатом, умирает бедным. Я никогда не был беден. Взгляни на перстни." />
    <string id="bp_vendorprofiles_377" text="Жар, молот и долг" />
    <string id="bp_vendorprofiles_378" text="Отец мой был точильщиком ножей в &lt;span style=&quot;BandItPlus.Place&quot;&gt;Куязе&lt;/span&gt;, а его отец до него — коваль подков. Мехам я выучился прежде грамоты. К двенадцати я мог вывести хвостовик ровно; к шестнадцати — сложить болванку семь раз без единого серого шва. Ремесло было тогда честным, а песок был просто песком.&#10;&#10;Я поставил собственный горн вдоль караванной дороги южнее &lt;span style=&quot;BandItPlus.Place&quot;&gt;Икбайла&lt;/span&gt;. Больше изогнутые клинки — человеку пустыни нужен меч, что чисто выходит из седла и покидает ножны прежде, чем конь ступит второй шаг. Дозорные &lt;span style=&quot;BandItPlus.Name&quot;&gt;эмира Ункида&lt;/span&gt; покупали у меня, и пряные стражи, что шли в &lt;span style=&quot;BandItPlus.Place&quot;&gt;Пен-Каннок&lt;/span&gt;, тоже. Триста &lt;span style=&quot;BandItPlus.Coin&quot;&gt;динаров&lt;/span&gt; за добрый шамшир, больше, коли покупатель хотел золотую проволоку по долу. Богат я не был, но спал на настоящей верёвочной кровати.&#10;&#10;Долг и привёл меня сюда. Караванщик отпустил мне руду из &lt;span style=&quot;BandItPlus.Place&quot;&gt;Хусн-Фулка&lt;/span&gt; в долг, а его караван так и не вернулся из дюн. Брат его хотел крови или монеты, а у меня не было ни того, ни другого в желанном ему количестве. Снабженец лагеря прослышал о моей беде и сделал предложение — работай горн здесь, долг становится его заботой, и человек перестаёт оглядываться в страхе перед ножом того брата.&#10;&#10;Так что теперь я кую в мастерской с песчаным полом, а пустыня давит мне в спину. Жар — половина работы, понимаешь ли: солнце размягчает сталь прежде, чем её коснутся угли, и кузнец, что знает эту хитрость, сберегает треть угля. Мои клинки уходят на сёдлах людей, что не всегда возвращаются, но стали всё равно, кто её носит. Стали важно лишь то, что сделана она была верно.&#10;&#10;Я не зову это падением. Я зову это порой. Горн горяч, монета честна, а брат того караванщика в двух провинциях отсюда. Человек может долго прожить и на меньшем." />
    <string id="bp_vendorprofiles_379" text="Слова от мехов" />
    <string id="bp_vendorprofiles_380" text="Да, садись поближе к мехам — там, снаружи, ветер слова съедает. Дорога в этот месяц оживлённа, а тот, кто бьёт по стали, слышит больше того, кто её возит. Караваны встают тут за водой, а вода развязывает языки лучше вина. Слушай.&#10;&#10;Длинная вереница асерайских вьючных верблюдов ползёт с южных пустошей к &lt;span style=&quot;BandItPlus.Place&quot;&gt;Куязу&lt;/span&gt;, тянет кузаитское сырое железо окольной тропой, какой, божатся их проводники, ни один дозор не ходит. Двадцать полос на зверя, без малого сорок зверей. Коли дойдёт, всякий кузнец отсюда до дюнной черты сбавит цену на болванку. Коли не дойдёт — что ж, тогда я разбогатею, а чьи-то кости выбелятся чуток белее.&#10;&#10;&lt;span style=&quot;BandItPlus.Name&quot;&gt;Эмир Тамар&lt;/span&gt; платит настоящую монету в &lt;span style=&quot;BandItPlus.Place&quot;&gt;Санале&lt;/span&gt; всякому кузнецу, что откуёт мамлюкские сабли по старому изгибу, — восемь &lt;span style=&quot;BandItPlus.Coin&quot;&gt;динаров&lt;/span&gt; за клинок, кров в придачу, и не спрашивает про прежний горн человека. Половина подмастерьев из &lt;span style=&quot;BandItPlus.Place&quot;&gt;Икбайла&lt;/span&gt; уже туда ушла. Я бы и сам пошёл, кабы не зарёкся от городов, что вешают своих кузнецов, когда война оборачивается.&#10;&#10;Снабженец одного вельможи проезжал три ночи назад, хотел купить четыре сотни щитов с кожаной обтяжкой до того, как сломается сухая пора. Он сверкнул кошелём &lt;span style=&quot;BandItPlus.Coin&quot;&gt;динаров&lt;/span&gt; с печатью Бану Хиляль, а это значит, что кто-то на глубоком юге готовится выступить и покуда не хочет огласки. Гляди в оба за южными торговыми дорогами — когда щиты идут скопом, кровь следует в два месяца.&#10;&#10;И напоследок, друг, а послушать стоит. Старый караван соли-и-железа, что связывает &lt;span style=&quot;BandItPlus.Place&quot;&gt;Билеган&lt;/span&gt; с &lt;span style=&quot;BandItPlus.Place&quot;&gt;Куязом&lt;/span&gt;, дважды кряду потерял ходки, и ни от какого разбойника, что я знаю, — чистые засады, ни тел, лишь пустые повозки. Кто-то копит стальной припас и не хочет, чтоб рынок это раскусил. Есть у тебя крепкая рука да тихий конь — на охране следующей ходки можно взять монету. Или на её взятии." />
    <string id="bp_vendorprofiles_381" text="Зафир из Кузни" />
    <string id="bp_vendorprofiles_382" text="Песчаный Кузнец" />
    <string id="bp_vendorprofiles_383" text="Кует в дюнах так, как иные кузнецы куют в городах, — медленнее, солнечным жаром не меньше, чем углём. Клинки, что он отпускает, стынут синими под пустынной луной, что Хаккун зовёт одобрением дюн." />
    <string id="bp_vendorprofiles_384" text="Зафир из Кузни. Хаккун читает песок; я читаю сталь. Слово Песчаного Чтеца верно. Моё медленнее — солнечный жар не торопится. Принеси мне {BP_VENDOR_QUEST_DESC}, и я остужу тебе клинок, синий, как полуденное небо над дюнами." />
    <string id="bp_vendorprofiles_385" text="Солнечный жар отпускает не так, как уголь, странник, — укус медленнее, держит дольше. Клинок стынет синим под пустынной луной, не имперским серым. Хаккун говорит, это одобрение дюн. Я думаю, это терпение. Так или иначе, клинок держит три похода там, где куязская работа сдаётся на первом." />
    <string id="bp_vendorprofiles_386" text="Принеси мне стальной брусок, силу натяга да полуденный час, странник. Отпущу тебе клинок, что подписали дюны. Шесть денаров за солнечный жар, рассол — от пустыни. Малый шип тебе на пояс на нынешний вечер." />
    <string id="bp_vendorprofiles_387" text="Сын был у меня в подмастерьях — двенадцать вёсен у мехов. Пустыня забрала его на пятом переходе; не песок — зной. Застрял в самый полдень, когда я велел ему отдохнуть. Горн был его первым словом. Ему было бы теперь двадцать пять. Я всё ещё отпускаю в полдень, так, как он хотел." />
    <string id="bp_vendorprofiles_388" text="Старый Хассан кует во внутреннем квартале Куяза — солнечным жаром промышляет у тех же дюн. Скажи ему, что Зафир всё ещё студит синим, — покажет тебе дальнюю наковальню. Монета за переход через пустыню." />
    <string id="bp_vendorquest_001" text="торговец снедью" />
    <string id="bp_vendorquest_002" text="торговец снаряжением" />
    <string id="bp_camptitle_001" text="Лагерь {CULTURE}" />
    <string id="bp_captivitybehavior_019" text="Вам не наскрести на взятку ({COST})." />
    <string id="bp_ccbook_body" text="Вы родились далеко отсюда, в доме малых людей — тех, кого короли не встречают, а сборщики податей не забывают. Потом настал год, когда всё рухнуло, и что вы потеряли — ваше дело; а что потеряли это — написано на вас, ясно, как клеймо.&#10;&#10;На дороге вглубь страны одноглазый разносчик вложил эту книгу вам в руки и не взял за неё ни монеты. &quot;Короли скажут вам, что такое Кальрадия. Дорога скажет вам правду.&quot;&#10;&#10;Она всё ещё пахнет дымом костра." />
    <string id="bp_ccq_o1d" text="Выросли среди беззаконников — разбойничьи кланы помнят ваше имя.&#10;&quot;Меня вскормили дымом костра и чужой монетой.&quot;&#10;&#10;Обучены Плутовству и Разведке, быстры на ногу и остры в стычке. Вы отправляетесь в путь с метательными клинками, охотничьим луком и примерно 1200 денарами.&#10;&#10;Восемь разбойничьих кланов изначально дружелюбнее к вам (+15), и их лагеря торгуют с вами с первого дня. Вы начинаете в состоянии войны, как и все, — но за мир вожак берёт с вас ПОЛОВИНУ цены." />
    <string id="bp_ccq_o2d" text="Вы никому ничего не должны, и никакое прошлое вами не владеет.&#10;&#10;Мастер на все руки — Разведка, Торговля, Верховая езда, немного владения клинком и Плутовство. Вы отправляетесь в путь с охотничьим луком, вьючной лошадью, метательными ножами и примерно 1600 денарами.&#10;&#10;В состоянии войны с каждым кланом, но их вожаки выслушают условия чужака за обычную цену, а лагерные торговцы быстро проникаются к вам расположением. Уравновешенное начало, без всяких обязательств." />
    <string id="bp_ccq_o3d" text="Когда-то вы охотились на разбойников, и дорога это помнит.&#10;&#10;Закалённый боец и предводитель — Одноручное оружие, Древковое оружие, Лидерство, Обаяние и Верховая езда. Вы отправляетесь в путь с калёным мечом 2-го уровня и примерно 2200 денарами.&#10;&#10;Награда за головы разбойников приносит вам +25%. Но кланы не доверяют вам (-20), и любой вожак, что снизойдёт до переговоров, потребует за мир ВДВОЕ больше." />
    <string id="bp_chief_hero_template" text="Разбойничий вожак" />
    <string id="bp_clan_fallen_legionaries" text="Павшие легионеры" />
    <string id="bp_clan_frost_reavers" text="Морозные разорители" />
    <string id="bp_clan_highwaymen" text="Разбойники с большой дороги" />
    <string id="bp_clan_marsh_stalkers" text="Болотные охотники" />
    <string id="bp_clan_pagan_cult" text="Языческий культ Старых Богов" />
    <string id="bp_clan_sky_raiders" text="Небесные налётчики" />
    <string id="bp_clan_slaver_caravans" text="Караваны работорговцев" />
    <string id="bp_clan_steppe_wolves" text="Степные волки" />
    <string id="bp_dialog_farewell" text="Хорошо." />
    <string id="bp_dialog_hail" text="Стой. Назови своё дело." />
    <string id="bp_hcc_001" text="{NAME} из клана {CLAN}&#10;Слава клана: {RENOWN}&#10;Золото: {GOLD} денаров" />
    <string id="bp_hcc_002" text="Активное задание на провиант: Уровень {TIER}" />
    <string id="bp_hcc_003" text="Активное задание на снаряжение: Уровень {TIER}" />
    <string id="bp_hcc_004" text="чужак" />
    <string id="bp_hcc_005" text="терпимый" />
    <string id="bp_hcc_006" text="доверенный" />
    <string id="bp_hcc_007" text="родня у костра" />
    <string id="bp_hcc_008" text="Для вожака ты — {STANDING}." />
    <string id="bp_hcc_009" text="За тобой числится {N} невыполненное задание для этого лагеря." />
    <string id="bp_hcc_010" text="За тобой числится {N} невыполненных заданий для этого лагеря." />
    <string id="bp_hcc_011" text="Связной по провианту: {SETTLEMENT}" />
    <string id="bp_hcc_012" text="Связной по снаряжению: {SETTLEMENT}" />
    <string id="bp_hcc_013" text="Заказ (провиант): {QTY}× {ITEM} через {DAYS}д" />
    <string id="bp_hcc_014" text="Заказ (снаряжение): {QTY}× {ITEM} через {DAYS}д" />
    <string id="bp_hcc_015" text="Услуги: {LIST}" />
    <string id="bp_hcc_016" text="Задание вожака (Уровень {TIER}) · {DETAIL}" />
    <string id="bp_hcc_017" text="{VISITNUM}-й визит" />
    <string id="bp_hcc_018" text="{VISITNUM}-й визит · Первая встреча: {SEASON} {DAY}, год {YEAR} · {DAYSAGO} дней назад" />
    <string id="bp_hcc_019" text="Активное задание работорговца: Уровень {TIER}" />
    <string id="bp_hcc_020" text="Задание на провиант — Уровень {TIER}, выполняется" />
    <string id="bp_hcc_021" text="Задание на снаряжение — Уровень {TIER}, выполняется" />
    <string id="bp_hch_001" text="Встреча вне лагеря — {SETTLEMENT}" />
    <string id="bp_hch_002" text="Вы нашли связного {VENDOR} в {SETTLEMENT}." />
    <string id="bp_hch_003" text="+{BONUS} денаров (кошель по прибытии от сети)" />
    <string id="bp_hch_004" text="Прибыли караваны — {COUNT} связной{PLURAL}" />
    <string id="bp_hch_005" text="Уровень {N}" />
    <string id="bp_hch_006" text="Добыча: ~{GOLD} денаров + реликвия" />
    <string id="bp_hch_007" text="Мощь разбойников · Уровень {TIER} — {EDGE}" />
    <string id="bp_hch_008" text="ЗАМЕЧЕН · {SECONDS}с" />
    <string id="bp_hch_009" text="НАБЛЮДАТЕЛИ · {COUNT}" />
    <string id="bp_hch_010" text="Мощь разбойников · Уровень {TIER}" />
    <string id="bp_hch_011" text="Вождь · {TIER}" />
    <string id="bp_hch_012" text="+{COUNT} ватага{PLURAL} на подходе" />
    <string id="bp_hcj_001" text="В плену у {CAPTOR}" />
    <string id="bp_hcj_002" text="Стражи на посту — {COUNT}.  Они неспешно обходят тюремный блок круг за кругом. Поднимешь тревогу — и сбежится каждый клинок до последнего." />
    <string id="bp_hcm_001" text="Повышение ранга — {RANK}" />
    <string id="bp_hcm_002" text="Твоё имя расходится по всем дорогам. Теперь ты — {RANK}." />
    <string id="bp_hcm_003" text="Уровень {NUM}" />
    <string id="bp_hcm_004" text="{COUNT} ватага · +{TROOPS} вступают в бой" />
    <string id="bp_hcm_005" text="{COUNT} ватаг · +{TROOPS} вступают в бой" />
    <string id="bp_hcm_006" text="◇ Коэффициент мощи разбойников: {FACTOR}  ·  +{PER_YEAR}/год (год {YEARS}) ◇" />
    <string id="bp_hcm_007" text="год {ELAPSED} / {YEARS}  ({PCT}%)" />
    <string id="bp_hcm_008" text="Вожак {CULTURE}. Встречен благодаря дипломатии разбойничьего Доверия." />
    <string id="bp_hco_001" text="Она" />
    <string id="bp_hco_002" text="Он" />
    <string id="bp_hco_003" text="она" />
    <string id="bp_hco_004" text="он" />
    <string id="bp_hco_005" text="её" />
    <string id="bp_hco_006" text="его" />
    <string id="bp_hco_007" text="{GOBETWEEN} сейчас здесь, в {TOWN}. Разыщите этого человека — он проведёт вас в лагеря {CLAN}." />
    <string id="bp_hco_008" text="В лагеря чужаков не пускают. Найдите {GOBETWEEN} в {TOWN} — этот человек проведёт вас в лагеря {CLAN}." />
    <string id="bp_hco_009" text="Из лагеря &lt;span style=&quot;PlaceInk&quot;&gt;{CULTURE}&lt;/span&gt;, писано моей собственной рукой.&#10;&#10;Молва достигла наших костров, чужак.&#10;&#10;Ты пролил &lt;span style=&quot;NameInk&quot;&gt;вражью кровь&lt;/span&gt; ради нас — а долг крови платится кровью сполна. Лагеря &lt;span style=&quot;PlaceInk&quot;&gt;{CULTURE}&lt;/span&gt; отныне открыты для тебя. Приходи, сядь у нашего очага; ешь нашу соль, торгуй с нашими людьми и скачи с нашими всадниками, коли хватит духу на такую работу.&#10;&#10;Ни один наш клинок больше не станет искать тебя на дороге. Назови у любого костра моё имя — и тебя не прогонят: ты заплатил за это кровью.&#10;&#10;Покуда дороги не приведут тебя в наш лагерь,&#10;— &lt;span style=&quot;NameInk&quot;&gt;{CHIEFNAME}&lt;/span&gt;, что держит &lt;span style=&quot;PlaceInk&quot;&gt;{CULTURE}&lt;/span&gt;" />
    <string id="bp_hco_010" text="{CHIEF} держит двор в {SEAT}." />
    <string id="bp_hco_011" text="⚑ Молва на дорогах: {LINE}" />
    <string id="bp_hco_012" text="⚑ Терпение вожака иссякло — твоя клятва {CULTURE} расторгнута. Вернись в их логово, чтобы снова начать переговоры." />
    <string id="bp_hco_013" text="Переговоры — {CHIEF}" />
    <string id="bp_hco_014" text="Посланник под белым флагом ведёт тебя к {SEAT}. {CHIEF} выслушает твои условия — но лишь однажды." />
    <string id="bp_hco_015" text="Заплатить дань — {AMOUNT} золота" />
    <string id="bp_hco_016" text="Тебе не по карману цена вожака ({AMOUNT} золота)." />
    <string id="bp_hco_017" text="⚑ Мир с {CULTURE} — скреплён {AMOUNT} золота. Их клинки тебе больше не страшны." />
    <string id="bp_hco_018" text="⚑ Клятва дана: перебей любую враждебную разбойничью ватагу за 7 дней, и {CULTURE} даруют тебе мир." />
    <string id="bp_hco_019" text="Ты покидаешь переговоры. Вожак {CULTURE} снова выслушает твои условия примерно через {DAYS} дней." />
    <string id="bp_hco_020" text="⚑ Эти скакали под знаменем {CULTURE} — клятва требует ВРАЖЕСКОЙ крови." />
    <string id="bp_hco_021" text="⚑ Клятва оплачена кровью. Мир с {CULTURE} — твой." />
    <string id="bp_hco_022" text="⚑ {CULTURE} держат лагерь в {SEAT} — он отмечен на твоей карте. Тебе рады у их костров." />
    <string id="bp_hco_023" text="Ты сразил ватагу {KILLED}. {CULTURE} в мире с тобой — их клинки больше не жаждут твоей крови." />
    <string id="bp_hcp_001" text="Доставьте припасы торговцу {VENDOR} (Уровень {TIER})" />
    <string id="bp_hcp_002" text="{VENDOR}: &quot;{DISPLAY}. Принеси то, что я просил, и прилавок откроется для тебя.&quot;" />
    <string id="bp_hcp_003" text="Доставьте {COUNT} {ITEM} торговцу {VENDOR}" />
    <string id="bp_hcp_004" text="{CHIEF}, у костра:&#10;&#10;&quot;{PROSE}&quot;" />
    <string id="bp_hcp_005" text="Из обломков добыто {LOOT} денаров." />
    <string id="bp_hcp_006" text="{CHIEF} принимает вашу клятву; обряд скреплён по древнему обычаю." />
    <string id="bp_hcp_007" text="◆ Согласитесь — и вы станете клятвенным союзником {CHIEF}.&#10;◆ Свободный проход через это логово.&#10;◆ Бесплатные услуги его торговцев.&#10;◆ Вы можете призвать его ватагу себе на помощь раз в семь дней." />
    <string id="bp_hcp_008" text="Клятва {CHIEF}" />
    <string id="bp_hcp_009" text="Заслужите доверие {CULTURE} (Уровень {TIER})" />
    <string id="bp_hcp_010" text="Доставьте {AMOUNT} денаров вожаку" />
    <string id="bp_hcp_011" text="Доставьте {COUNT} {ITEM} вожаку" />
    <string id="bp_hcp_012" text="Последствия:&#10;◆  Доверие падает до Уровня 0&#10;◆  Преимущества Союза отменены (торговец, проход, призыв)&#10;◆  Восстановление доступа: поднимите Доверие до Уровня 3; испытание Главы 2 породит отряд-цель уровнем выше" />
    <string id="bp_hcq_001" text="Клятва крови — {CULTURE}" />
    <string id="bp_hcq_002" text="Семь дней прошли, а кровь соперников так и не пролилась. Клятва расторгнута — {CULTURE} ничего вам не должны." />
    <string id="bp_hcq_003" text="{CHIEF} из {CULTURE} назвал цену мира: кровь за кровь. " />
    <string id="bp_hcq_004" text="Вы сокрушили ватагу {KILLED}. Клятва оплачена кровью — {CULTURE} даруют вам мир." />
    <string id="bp_hcq_005" text="Семь дней истекли. Клятва перед {CULTURE} расторгнута." />
    <string id="bp_hcq_006" text="Выследите {TARGET} для {CHIEF}" />
    <string id="bp_hcq_007" text="Вы убили {TARGET}. Вернитесь к {CHIEF} в {HIDEOUT}, чтобы получить обещанное — скажите ему эти слова сами, и серебро и почёт перейдут из рук в руки." />
    <string id="bp_hcq_008" text="{TARGET} захвачен в плен {CAPTOR}. Договор остаётся в силе. Дождитесь, пока его освободят, или ворвитесь в крепость сами — так или иначе, дело всё ещё за вами." />
    <string id="bp_hcq_009" text="{TARGET} снова на свободе. Договор вожака по-прежнему в силе, и дорога открыта." />
    <string id="bp_hcq_010" text="До вас дошла весть, что {TARGET} мёртв. Вернитесь к {CHIEF} в {HIDEOUT}, чтобы подтвердить содеянное и получить обещанное." />
    <string id="bp_hcq_011" text="Выследите {TARGET} — найдите и покончите с ним" />
    <string id="bp_hcq_012" text="Разорите {VILLAGE} для {CHIEF}" />
    <string id="bp_hcq_013" text="{VILLAGE} больше не принадлежит клану {LORD}. Злоба {CHIEF} обратилась на другого — договор больше не соответствует цели. С гонцом прибывают 500 денаров как плата за уже добытые сведения." />
    <string id="bp_hcq_014" text="{LORD} мёртв. Злоба {CHIEF} на клан не угасла — {VILLAGE} по-прежнему в том же долгу, и сжечь её — всё тот же зов." />
    <string id="bp_hcq_015" text="Чужой факел добрался до {VILLAGE} первым. Со временем деревня оправится. Договор {CHIEF} в силе — сожгите её сами, когда она отстроится, и вся награда будет вашей." />
    <string id="bp_hcq_016" text="Вы предали {VILLAGE} огню. Вернитесь к {CHIEF} в {HIDEOUT}, чтобы сказать эти слова самому — серебро и почёт перейдут из рук в руки у костра самого вожака." />
    <string id="bp_hcq_017" text="Разорите {VILLAGE} — предайте её огню" />
    <string id="bp_hcr_001" text="Блокада сломила {TARGET} — вспыхнуло восстание!" />
    <string id="bp_hcr_002" text="{WARBAND} держат {TARGET} в блокаде!" />
    <string id="bp_hcr_003" text="{TARGET} на грани восстания!" />
    <string id="bp_hcr_004" text="Вы отогнали разбойников от {TARGET}!" />
    <string id="bp_hcr_005" text="поселение" />
    <string id="bp_hcr_006" text="{WARBAND} разграбили {TARGET}!" />
    <string id="bp_hcr_007" text="⚔ {FACTION} разоряют {VILLAGE}!" />
    <string id="bp_hcr_008" text="🔥 {FACTION} разграбили {VILLAGE}!" />
    <string id="bp_hcr_009" text="⚔ {LORD} идёт мстить за {VILLAGE}!" />
    <string id="bp_hcr_010" text="💰 {CLAN} дают {GOLD} золота за головы разорителей {VILLAGE}!" />
    <string id="bp_hcr_011" text="⚖ Плата за голову: {GOLD} золота за {PARTY} (Блюститель закона)." />
    <string id="bp_hcr_012" text="💰 Награда получена! {GOLD} золота от {CLAN} за убитых разорителей {VILLAGE}." />
    <string id="bp_hcr_013" text="Вы стоите перед Королём разбойников. Настоящие переговоры со мной уже скоро — в одном из будущих обновлений. А пока ступай своей дорогой." />
    <string id="bp_hcr_014" text="Как скажешь. Прощай." />
    <string id="bp_hcr_015" text="Вайкос обращает свой взор на {KINGDOM}. Перемирие обратилось в пепел." />
    <string id="bp_hcr_016" text="Вайкос приостанавливает войну с {KINGDOM}. Волки помнят." />
    <string id="bp_hcr_017" text="Восстание {NAME}" />
    <string id="bp_hcr_018" text="Разбойник" />
    <string id="bp_hcr_019" text="Оплот {NAME}" />
    <string id="bp_hcr_020" text="дикие земли" />
    <string id="bp_hcr_021" text="{NAME} из {CULTURE}" />
    <string id="bp_hcs_001" text="[BandIt Plus] Бойцы работорговца присоединились к вашему отряду (-{COST} денаров):&#10;{LIST}" />
    <string id="bp_hcs_002" text="  • {NAME} (Ур.{TIER}, {COST} денаров)" />
    <string id="bp_hcs_003" text="{NAME} — {COST} денаров" />
    <string id="bp_hcs_004" text="Невольники {NAME}" />
    <string id="bp_hcs_005" text="{NAME} — Погреб" />
    <string id="bp_hcs_006" text="Вы спускаетесь за работорговцем по деревянным ступеням." />
    <string id="bp_hcs_007" text="Вы поднимаетесь обратно. Люк закрывается за вами." />
    <string id="bp_hcs_008" text="В погреб — {NAME}" />
    <string id="bp_hcs_009" text="[BandIt Plus] Недостаточно денаров (нужно {COST}, в наличии {GOLD})." />
    <string id="bp_hcs_010" text="[BandIt Plus] {NAME} выходит на свободу с вами. -{COST} денаров." />
    <string id="bp_hcs_011" text="Убейте 3 лордов или знатных особ {CULTURE_BAT}" />
    <string id="bp_hcs_012" text="Доставьте 8 пленников в свой отряд" />
    <string id="bp_hcs_013" text="Захватите отмеченного лорда {CULTURE_BAT} ЖИВЫМ" />
    <string id="bp_hcs_014" text="Соберите 30 твёрдой древесины" />
    <string id="bp_hcs_015" text="Убейте 3 лордов (любой культуры)" />
    <string id="bp_hcs_016" text="Соберите 50 твёрдой древесины" />
    <string id="bp_hcs_017" text="Работа {SLAVER} — Уровень {TIER}" />
    <string id="bp_hcs_018" text="{SLAVER} у {CULTURE_LABEL} держит счёт в голове — " />
    <string id="bp_hcs_019" text="Прикончите {KILL_N} {KILL_CULTURE} " />
    <string id="bp_hcs_020" text="Приведите {CAPTURE_NAME} живым. " />
    <string id="bp_hcs_021" text="В последний раз замечен близ {WHERE}." />
    <string id="bp_hcs_022" text="Вернитесь в лагерь с " />
    <string id="bp_hcs_023" text="Принесите {MATERIALS_N}× " />
    <string id="bp_hcv_001" text="Договор о снабжении скреплён — {NAME}" />
    <string id="bp_hcv_002" text="{NAME} клянётся держать твою кладовую полной, когда придёт нужда." />
    <string id="bp_hcv_003" text="Договор о ковке скреплён — {NAME}" />
    <string id="bp_hcv_004" text="{NAME} клянётся ковать для твоих походов, когда придёт нужда." />
    <string id="bp_hcv_005" text="Охват сети — {SETTLEMENT}" />
    <string id="bp_hcv_006" text="Твой связной живёт в {SETTLEMENT}." />
    <string id="bp_hcv_007" text="Торговые цены в городах {CULTURE} улучшились (-5% покупка / +5% продажа)" />
    <string id="bp_hcv_008" text="[BandIt Plus] Недостаточно денаров для особого заказа. (Нужно {COST}, есть {GOLD})" />
    <string id="bp_hcv_009" text="Выбери одно. {COST} денаров вперёд. Готово через {DAYS} дней." />
    <string id="bp_hcv_010" text="[BandIt Plus] Особый заказ размещён: {LABEL} — готов через {DAYS} дней. (-{COST} денаров)" />
    <string id="bp_hcv_011" text="[BandIt Plus] Особый заказ доставлен: {QTY}× {ITEM}" />
    <string id="bp_hcv_012" text="Всё ещё вожусь с этим, странник — дай мне ещё {DAYS} дней{PLURAL}, и товар будет готов." />
    <string id="bp_hcv_013" text="Установлен контакт — {NAME}" />
    <string id="bp_hcv_014" text="{NAME} рекомендует тебя своему связному за пределами лагеря." />
    <string id="bp_hcv_015" text="+{GOLD} денаров в знак доброй воли" />
    <string id="bp_hcv_016" text="+{XP} опыта торговли" />
    <string id="bp_hideoutrename_001" text="Логово {NAME}" />
    <string id="bp_hideoutrename_002" text="Логово {CULTURE}" />
    <string id="bp_item_bog_witch_charm" text="Оберег болотной ведьмы" />
    <string id="bp_item_druids_bone_idol" text="Костяной идол друида" />
    <string id="bp_item_falconers_gauntlet" text="Перчатка сокольничего" />
    <string id="bp_item_frost_touched_talisman" text="Талисман, тронутый морозом" />
    <string id="bp_item_keepsake_desert" text="Выбеленный солнцем амулет" />
    <string id="bp_item_keepsake_forest" text="Резной дубовый жетон" />
    <string id="bp_item_keepsake_looters" text="Счастливая монета мародёра" />
