    <string id="bp_alliance_warband_name" text="Ватага {CHIEF}" />
    <string id="bp_bribe_response" text="Приятно иметь с тобой дело." />
    <string id="bp_dialog_chief_notable_hail" text="Ты приглянулся мне, странник. Говори." />
