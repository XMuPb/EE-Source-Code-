    <string id="bp_item_keepsake_sea" text="Моржовый клык морского разбойника" />
    <string id="bp_item_keepsake_steppe" text="Степной оберег из конского волоса" />
    <string id="bp_item_slavers_iron_key" text="Железный ключ работорговца" />
    <string id="bp_item_stolen_signet_ring" text="Краденый перстень-печатка" />
    <string id="bp_item_tarnished_imperial_sigil" text="Потускневшая имперская печать" />
    <string id="bp_item_wolf_tooth_necklace" text="Ожерелье из волчьих зубов" />
    <string id="bp_jailbreaklauncher_001" text="Камера" />
    <string id="bp_jailbreaklauncher_002" text="Дверь камеры" />
    <string id="bp_jailbreakmissioncontroller_030" text="Пойман!" />
    <string id="bp_jailbreakmissioncontroller_031" text="Разбойники подняли тревогу и загнали тебя обратно в яму." />
