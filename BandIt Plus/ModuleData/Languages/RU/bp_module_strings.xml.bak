    <string id="bp_jailbreakmissioncontroller_039" text="Сундуки:  {LOOTED} / {TOTAL}       Ключ:  {KEY}" />
    <string id="bp_mod_loaded" text="BandIt Plus загружен — 8 новых разбойничьих кланов активны." />
