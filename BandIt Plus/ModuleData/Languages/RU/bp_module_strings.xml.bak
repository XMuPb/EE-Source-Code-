    <string id="bp_aistatusmissionview_009" text="Лесные разбойники" />
    <string id="bp_aistatusmissionview_010" text="Пустынные налётчики" />
    <string id="bp_aistatusmissionview_011" text="Морские разбойники" />
    <string id="bp_aistatusmissionview_012" text="Степные всадники" />
    <string id="bp_aistatusmissionview_013" text="Северные грабители" />
    <string id="bp_aistatusmissionview_014" text="Болотные охотники" />
    <string id="bp_aistatusmissionview_015" text="Дорожные разбойники" />
    <string id="bp_aistatusmissionview_016" text="Караваны работорговцев" />
    <string id="bp_aistatusmissionview_017" text="Павший легион" />
    <string id="bp_aistatusmissionview_018" text="Небесные налётчики" />
    <string id="bp_aistatusmissionview_019" text="Степные волки" />
    <string id="bp_aistatusmissionview_020" text="Языческий культ" />
    <string id="bp_aistatusmissionview_021" text="Разбойничья ватага" />
    <string id="bp_aistatusmissionview_022" text="ХРУПКИЕ — бегут при ~50% боевого духа" />
    <string id="bp_aistatusmissionview_023" text="ЗАКАЛЁННЫЕ — бегут при ~25% боевого духа" />
    <string id="bp_aistatusmissionview_024" text="ВЕТЕРАНЫ — держатся при 15% боевого духа" />
    <string id="bp_aistatusmissionview_025" text="ЭЛИТА — держат строй" />
    <string id="bp_aistatusmissionview_026" text="ЛЕГЕНДАРНЫЕ — бьются насмерть" />
    <string id="bp_aistatusmissionview_027" text="ЗЕЛЕНЬ" />
    <string id="bp_aistatusmissionview_028" text="НАЛЁТ" />
    <string id="bp_aistatusmissionview_029" text="ВЕТ" />
    <string id="bp_aistatusmissionview_030" text="ЭЛИТА" />
    <string id="bp_aistatusmissionview_031" text="ЛЕГЕНДА" />
    <string id="bp_aistatusmissionview_032" text="Зелёный новобранец" />
    <string id="bp_aistatusmissionview_033" text="Налётчик" />
    <string id="bp_aistatusmissionview_034" text="Ветеран" />
    <string id="bp_aistatusmissionview_035" text="Элита" />
    <string id="bp_aistatusmissionview_036" text="Легендарный" />
    <string id="bp_aistatusmissionview_037" text="Неизвестный настрой" />
    <string id="bp_aistatusmissionview_038" text="Бойцы не обнаружены" />
    <string id="bp_aistatusmissionview_039" text="Конная ударная сила" />
    <string id="bp_aistatusmissionview_040" text="Тактика дистанционного обстрела" />
    <string id="bp_aistatusmissionview_041" text="Тактика тяжёлой пехоты" />
    <string id="bp_aistatusmissionview_042" text="Тактика смешанных сил" />
    <string id="bp_aistatusmissionview_043" text="Нет конных разведчиков" />
    <string id="bp_aistatusmissionview_044" text="Нет поддержки стрелков" />
    <string id="bp_aistatusmissionview_045" text="Только стрелки — нет линии ближнего боя" />
    <string id="bp_aistatusmissionview_046" text="Сбалансированный состав отряда" />
    <string id="bp_aistatusmissionview_047" text="Загнанные фанатики — отступают" />
    <string id="bp_aistatusmissionview_048" text="Грабители спасают шкуры — отступают" />
    <string id="bp_aistatusmissionview_049" text="Уступают в силе — выходят из боя" />
    <string id="bp_aistatusmissionview_050" text="Фанатики — уверенно наседают" />
    <string id="bp_aistatusmissionview_051" text="Осмелевшие — будут наседать" />
    <string id="bp_aistatusmissionview_052" text="Уверенные — агрессивный натиск" />
    <string id="bp_aistatusmissionview_053" text="Фанатики — бьются насмерть" />
    <string id="bp_aistatusmissionview_054" text="Налётчики, жаждущие славы" />
    <string id="bp_aistatusmissionview_055" text="Обычная разбойничья агрессия" />
    <string id="bp_aistatusvm_001" text="В БОЮ" />
    <string id="bp_aistatusvm_002" text="ВЫКЛ." />
    <string id="bp_alliancebehavior_001" text="Договор нарушен" />
    <string id="bp_alliancebehavior_002" text="Вождь молча отворачивается от тебя." />
    <string id="bp_alliancebehavior_003" text="Ты поднял оружие против ватаги." />
    <string id="bp_alliancebehavior_004" text="Твоё знамя теперь реет рядом с их врагами." />
    <string id="bp_alliancebehavior_005" text="Вождь пал." />
    <string id="bp_alliancebehavior_006" text="Понимаю" />
    <string id="bp_allianceprosemoulds_001" text="&quot;Ты сидишь в моём логове без приглашения, чужак, но твоё имя дошло до меня с торговых трактов. Я — {CHIEF_NAME}, и эти леса целое поколение пожирали таких, как ты, вместе с грамотами на вашу поимку.&#10;&#10;Двадцать пять дней. Вот всё, что у тебя есть, чтобы доказать: живым ты для меня ценнее, чем мёртвым. Принеси мне весть об убийстве — о шайке тех, кто наживается на той же имперской монете, что назначила цену за наши головы. Наводка будет следом; мои разведчики уже приметили одну.&#10;&#10;После этого поговорим снова. Побежишь — и убедишься, что за своими логовами я слежу зорко.&quot;" />
    <string id="bp_allianceprosemoulds_002" text="&quot;Мои разведчики следят за {PARTY_NAME} — {ARTICLE} {CULTURE} {KIND}, что промышляет на торговых трактах близ {AREA}. Они ещё не знают, что уже мертвы.&#10;&#10;Принеси мне их знамя, или клинок их главаря, или что сумеешь дотащить. Бей их в одиночку — мои люди будут смотреть и считать убитых, а считают они лишь то, что видят.&#10;&#10;Лес укроет тебя на подходе. А дальше — либо твоё умение, либо твои кости.&quot;" />
    <string id="bp_allianceprosemoulds_003" text="&quot;Смена цели. Теперь {PARTY_NAME} — {ARTICLE} {CULTURE} {KIND} близ {AREA}. Прежняя добыча ускользнула от моих дозорных или ушла туда, где я им не доверяю. Лес не держит зла на тех, кто уходит, — но новая цель вполне сгодится.&quot;" />
    <string id="bp_allianceprosemoulds_004" text="&quot;Ты вернулся. Многие не возвращаются.&#10;&#10;Мои гонцы принесли весть раньше тебя — {CULTURE} шайка разбита, главарь мёртв, знамя взято. Я поспорил с одной из своих, что ты не вернёшься; нынче вечером она на денар беднее.&#10;&#10;Приходи в {HIDEOUT}, когда сядет солнце. Теперь, когда ты доказал, что тебе можно доверить клинок, нам есть что обсудить.&quot;" />
    <string id="bp_allianceprosemoulds_005" text="&quot;Долог был твой подъём, чужак, чтобы найти меня. Немногие берут последний гребень, не сломав ногу и не растеряв храбрость. Я — {CHIEF_NAME}, и этот гранит принадлежит мне.&#10;&#10;Двадцать пять дней. Вот верёвка, что я тебе бросаю. Втащи по ней добычу — шайку, чью гибель почувствуют низины. Мои разведчики укажут цель; ты получишь имя и дорогу прежде, чем отойдёшь от моего костра.&#10;&#10;Подведёшь меня — и спуск окажется тяжелее подъёма. Предашь — и второго перевала тебе не увидеть.&quot;" />
    <string id="bp_allianceprosemoulds_006" text="&quot;Мои дозорные спустились с высоких уступов с именем. {PARTY_NAME} — {ARTICLE} {CULTURE} {KIND}, что идёт по низине близ {AREA}, разжирев от лёгкой дороги там, внизу.&#10;&#10;Перехвати их на открытом месте, где склон играет тебе на руку. Взбираются они вяло и быстро выдыхаются; час пути по рваной местности — и их колонна растянется, как бусины на нити. Снеси голову — хвост сам сложится.&#10;&#10;Принеси доказательство, что я смогу подержать в руке. Гранит помнит то, что на нём высекают.&quot;" />
    <string id="bp_allianceprosemoulds_007" text="&quot;Новая цель — старый след остыл ниже снеговой черты. Теперь {PARTY_NAME}, {ARTICLE} {CULTURE} {KIND}, что промышляет на дорогах близ {AREA}. Тот же спуск, но кровь в конце его — иная.&quot;" />
    <string id="bp_allianceprosemoulds_008" text="&quot;Ты снова поднялся на гору. Этого мне довольно.&#10;&#10;Весть достигла гребня раньше тебя — {ARTICLE} {CULTURE} колонна разбита на низинной дороге, главарь пал, уцелевшие разбежались к любому городу, что ещё откроет им ворота. Чистая работа, судя по всему. Чище, чем я на тебя ставил.&#10;&#10;Приходи в {HIDEOUT}, пока не угас свет. Ветер здесь, наверху, злеет после сумерек, а я не стану выкрикивать условия через чёрный гребень. Нам с тобой ещё размечать следующий отрезок подъёма.&quot;" />
    <string id="bp_allianceprosemoulds_009" text="&quot;Ты въезжаешь в мой лагерь без знамени, чужак. Дерзко. Я — {CHIEF_NAME}, а равнины надолго запоминают лица.&#10;&#10;Двадцать пять дней. Столько раз обернётся небо, прежде чем я потеряю терпение. Принеси мне убийство — шайку, что истекает кровью ради той же монеты, что травит нас. Мои дозорные уже выбрали одну. Наводка будет следом.&#10;&#10;Скачи что есть силы. Скачи один. Горизонт широк, и на каждой его черте у меня есть люди. Нарушишь слово — узнаешь, как далеко умеет гнаться степняк.&quot;" />
    <string id="bp_allianceprosemoulds_010" text="&quot;Мои всадники пересекли их след в двух днях пути к востоку. {PARTY_NAME} — {ARTICLE} {CULTURE} {KIND}, что ползёт по открытой земле близ {AREA}. Медленные. Грузные. Лёгкая добыча для того, кто знает ветер.&#10;&#10;Настигни их прежде, чем они дойдут до стен. Здесь коня не спрячешь, так что они увидят тебя издали. Неважно. Пока они выстроят линию, ты уже пройдёшь насквозь.&#10;&#10;Возьми добычу в одиночку. Мои дозорные будут на гребне, считать. Они не считают того, чего не видели своими глазами.&quot;" />
    <string id="bp_allianceprosemoulds_011" text="&quot;Новый след. Теперь {PARTY_NAME} — {ARTICLE} {CULTURE} {KIND}, что пересекает равнину близ {AREA}. Прежняя добыча ускакала за горизонт, прочь из моей досягаемости. Ветер не носит обид. Скачи.&quot;" />
    <string id="bp_allianceprosemoulds_012" text="&quot;Ты вернулся через равнину. Хорошо.&#10;&#10;Всадник принёс весть раньше тебя — {ARTICLE} {CULTURE} шайка рассеяна, главарь ничком в траве, кони уведены. Мои дозорные говорят, ты прошёл сквозь них чисто. Такую работу степь уважает.&#10;&#10;Скачи в {HIDEOUT}, пока небо не обернулось снова. Сядь у моего костра. Между нами ещё немало земли, и я предпочту говорить о ней там, где ветер не донесёт наши голоса до чужих ушей.&quot;" />
    <string id="bp_allianceprosemoulds_013" text="&quot;Соль и буря, ты вошёл в мой оплот и остался дышать. Я — {CHIEF_NAME}, и моя команда принесла клятвы на этой палубе ещё до того, как тебя отняли от груди.&#10;&#10;Двадцать пять дней, не больше. Море не знает пощады, и я тоже. Принеси мне убийство — шайку, чья кровь оплатит пошлину за всё, что твоя порода стоила моей. Мои дозорные укажут добычу следом, и ты выйдешь в море ей навстречу.&#10;&#10;Нарушишь клятву — и не сыщешь берега достаточно далёкого. Сдержишь — и отопьёшь из рога капитана драккара.&quot;" />
    <string id="bp_allianceprosemoulds_014" text="&quot;Мои дозорные приметили {PARTY_NAME} с мысов — {ARTICLE} {CULTURE} {KIND}, что ползёт вдоль берега близ {AREA}. Жирные, медлительные и далёкие от любого прилива, что мог бы их спасти.&#10;&#10;Возьми их чисто. Принеси мне рваный стяг, перстень капитана — что-нибудь, чего ещё не обглодали чайки. Ступай один — моя команда смотрит со скал, а клятва без свидетелей — вовсе не клятва.&#10;&#10;Ветер пока с тобой. А как сойдётся сталь, лишь твоя рука решит, вернёшься ты домой или пойдёшь на корм крабам.&quot;" />
    <string id="bp_allianceprosemoulds_015" text="&quot;Новая добыча. Теперь {PARTY_NAME} — {ARTICLE} {CULTURE} {KIND}, что промышляет вдоль берега близ {AREA}. Прежняя цель ушла с приливом, а море забирает то, что берёт. Эта сгодится, и мои дозорные за неё ручаются.&quot;" />
    <string id="bp_allianceprosemoulds_016" text="&quot;Ты вернулся, просоленный и живой. Немногим это удаётся.&#10;&#10;Весть долетела раньше тебя — {CULTURE} шайка разбита на отмели, главарь ничком, стяг сорван твоей собственной рукой. Один из моих гребцов спорил против тебя. Теперь неделю ему вычерпывать трюмную воду.&#10;&#10;Приходи в {HIDEOUT}, когда сменится прилив. В зале ждёт мёд, и клятвы ещё не принесены, а капитану, что сдержал слово, положен капитанский приём.&quot;" />
    <string id="bp_allianceprosemoulds_017" text="&quot;Ты входишь в мою тень без зова, чужак, а песок ещё не занёс твоих следов. Я — {CHIEF_NAME}, и здесь имя — это долг, который взыскивает пустыня.&#10;&#10;Двадцать пять дней. Солнце отсчитает их, считаешь ты сам или нет. Принеси мне одну шайку мёртвой, прежде чем счёт иссякнет, — цель мои дозорные назовут тебе следом. Никаких оправданий; их зной тоже забирает.&#10;&#10;Пей, потом скачи. Предашь меня — и есть колодцы, до которых ты не успеешь дойти.&quot;" />
    <string id="bp_allianceprosemoulds_018" text="&quot;Мои всадники шли по пыли. {PARTY_NAME} — {ARTICLE} {CULTURE} {KIND}, что ползёт по пустошам близ {AREA} и поит коней у тех же оазисов, что и мы.&#10;&#10;Скачи налегке. Бей, когда солнце низко и их дозорные щурятся на запад. Принеси мне клинок, пряжку — что угодно, что я смогу подержать; мои люди считают убитых глазами, а остальное поглощает песок.&#10;&#10;Путь долог, а воды мало. Продумай дорогу, или пустыня довершит дело раньше тебя.&quot;" />
    <string id="bp_allianceprosemoulds_019" text="&quot;Новый след. Теперь {PARTY_NAME} — {ARTICLE} {CULTURE} {KIND}, что поит коней близ {AREA}. Прежняя добыча ушла за барханы, куда мои всадники не пойдут, и песок уже забыл о ней.&quot;" />
    <string id="bp_allianceprosemoulds_020" text="&quot;Ты вернулся прежде, чем опустели бурдюки. Немногим это удаётся.&#10;&#10;Пыль дошла до меня раньше тебя — {CULTURE} шайка разбита в чистом поле, стервятники уже ведут счёт. Один из моих всадников говорил, что зной прикончит тебя раньше любого клинка. Нынче вечером он должен мне бурдюк финикового вина.&#10;&#10;Скачи в {HIDEOUT}, пока солнце снова не поднялось. Теперь, когда песок знает твоё имя, нам есть о чём условиться, и я предпочту говорить об этом в тени, а не под полуденным солнцем.&quot;" />
    <string id="bp_allianceprosemoulds_021" text="&quot;Садись, садись... не нависай так над стариком. Я — {CHIEF_NAME}, и я пережил трёх вождей храбрее себя. Оттого и дышу до сих пор.&#10;&#10;Двадцать пять дней — вот всё, что я могу тебе дать. Не больше. Мы тут голодаем, а они — те, что в железных рубахах, большие ватаги с настоящими знамёнами, — рвут нас на части, едва почуют слабину. Принеси мне одну шайку мёртвой, всего одну, и те, что над нами, поищут себе иной забавы.&#10;&#10;Разведчики скоро шепнут тебе имя. Прошу... не подведи старого, сжавшегося в комок дурака. Ещё одного дурного сезона нам не пережить.&quot;" />
    <string id="bp_allianceprosemoulds_022" text="&quot;Мои ребята вернулись, дрожа, но с вестью. {PARTY_NAME} — {ARTICLE} {CULTURE} {KIND} — стоит близ {AREA}. Они не знают, что мы вообще есть, и это единственное благословение, что нам осталось.&#10;&#10;Бей их быстро. Не дай им обернуться и толком нас разглядеть, иначе они запомнят, откуда дым, и обрушат на наши головы что похуже. С тем, что придёт следом, нам не совладать, понимаешь? Просто не совладать.&#10;&#10;Бери что унесёшь. Оставь тела там, где вороны найдут их первыми. Спеши назад, пока они... пока они не заметили, что мы тут вообще были.&quot;" />
    <string id="bp_allianceprosemoulds_023" text="&quot;Нет, нет, забудь о прежней — ушла, потеряна, мои разведчики так далеко не пойдут. Новая цель: {PARTY_NAME}, {ARTICLE} {CULTURE} {KIND}, что бредёт мимо {AREA}. Прошу, возьми эту поскорее, пока они не забрели туда, откуда нам не уследить.&quot;" />
    <string id="bp_allianceprosemoulds_024" text="&quot;Ты вернулся. Кости моих отцов, ты и вправду вернулся...&#10;&#10;Весть дошла до нас раньше тебя — {CULTURE} шайка вспорота, главарь остыл. Нынче вечером молодняк ест благодаря тебе. Иные из них с неделю толком не ели — понимаешь, что это значит для старика вроде меня?&#10;&#10;Приходи в {HIDEOUT}, как сможешь. Собьёмся в кучу у настоящего огня, и я расскажу тебе то немногое, что мы знаем о хищниках покрупнее, что над нами. Может — может — переживём ещё одну зиму. Не мешкай в дороге. Они всегда следят.&quot;" />
    <string id="bp_allianceprosemoulds_025" text="&quot;Ты стоишь в моём чертоге, а я ещё не решил, желанно ли здесь твоё дыхание. Я — {CHIEF_NAME}. Лёд не спешит. И я тоже.&#10;&#10;Двадцать пять дней. Вот срок, что я тебе даю. За это время ты принесёшь мне убийство — взятое знамя, усмирённого главаря. Мои дозорные засвидетельствуют деяние прежде, чем с твоих губ сорвётся хоть слово.&#10;&#10;Думай медленно, прежде чем ответить. У холода долгая память, и у меня тоже. Отвернёшься от этого договора — и убедишься, что снег знает всякую дорогу, по которой ты пойдёшь.&quot;" />
    <string id="bp_allianceprosemoulds_026" text="&quot;Мои разведчики семь ночей следили за белыми дорогами. Они нашли {PARTY_NAME} — {ARTICLE} {CULTURE} {KIND}, что медленно движется близ {AREA}, и дыхание их поднимается в стуже, как сигнальный дым.&#10;&#10;Выступай. Разбери их на части не спеша. В спешке нет доблести; лёд преподаёт этот урок всякому, кто торопится. Мои люди будут смотреть с опушки, и считают они лишь то, что видели их собственные глаза.&#10;&#10;Принеси знак капитана. Мороз сохранит его не хуже всякой клятвы.&quot;" />
    <string id="bp_allianceprosemoulds_027" text="&quot;Новая цель. Теперь {PARTY_NAME} — {ARTICLE} {CULTURE} {KIND}, что идёт близ {AREA}. Прежняя добыча ускользнула за пределы досягаемости моих дозорных, а за тем, что не удержал лёд, я не гонюсь. Эта ответит за обеих.&quot;" />
    <string id="bp_allianceprosemoulds_028" text="&quot;Ты вернулся. Ни холод не удержал тебя, ни они.&#10;&#10;Весть достигла моего чертога раньше твоих сапог — {CULTURE} шайка разбита на открытой дороге, главарь уложен в снег, знамя сорвано. Мои гонцы говорили об этом неспешно, как у нас заведено, и я слушал, не перебивая.&#10;&#10;Приходи в {HIDEOUT}, когда осядут сумерки и дыхание снова обратится в иней. Есть о чём поговорить, и разговор этот из тех, что просит огня между нами. Ступай осторожно в пути. Лёд помнит каждый шаг.&quot;" />
    <string id="bp_allianceprosemoulds_029" text="&quot;Ты прошёл через моё болото и остался жив. Немногим это удаётся. Я — {CHIEF_NAME}. Я видел, как ты шёл.&#10;&#10;Двадцать пять дней. Вот длина твоей верёвки. Принеси мне убийство — шайку, что ходит там, где не должно. Мои разведчики укажут одну. Ты пойдёшь. Ты вернёшься — или нет.&#10;&#10;Не лги мне в этом месте. Трясина слышит. Тростник слышит. Я слышу. Говори, когда с тобой говорят. Двигайся, когда велено. Следующими словами от меня будут имя и дорога.&quot;" />
    <string id="bp_allianceprosemoulds_030" text="&quot;{PARTY_NAME}. {ARTICLE} {CULTURE} {KIND}. Медленно движется близ {AREA}.&#10;&#10;Мои дозорные два дня лежали в тростнике. Считали сапоги. Считали клинки. Знают, где бреши. А {KIND} и не знает, что его считают.&#10;&#10;Возьми их тихо или возьми с шумом — трясине всё равно. Но возьми. В одиночку. Мои глаза увидят, что дело сделано, или не увидят, а платят лишь за увиденное. Иди низиной на подходе. На большой дороге кони. Ступай.&quot;" />
    <string id="bp_allianceprosemoulds_031" text="&quot;Новая цель. {PARTY_NAME}. {ARTICLE} {CULTURE} {KIND}. Близ {AREA}. Прежняя ускользнула из тростника — ушла туда, куда мои дозорные не пойдут. Эта — нет. Ступай.&quot;" />
    <string id="bp_allianceprosemoulds_032" text="&quot;Ты вернулся. В грязи. Хорошо.&#10;&#10;Гонец пересёк трясину перед рассветом. Шепнул мне в темноте. {CULTURE} шайка — разбита. Мертвы в мокряди. Тростник уже забрал то, что оставили вороны. Мои дозорные видели. Я им верю. Я верю тебе.&#10;&#10;Приходи в {HIDEOUT}. Ступай мягко. Говори, когда говорю я. Есть о чём сказать, и здесь, где ветер разносит слова, об этом не говорят. Трясина однажды сдержала с тобой уговор. Не испытывай её дважды.&quot;" />
    <string id="bp_allianceprosemoulds_033" text="&quot;Ты стоишь в моём логове, и я не стану делать вид, будто мне не претит принимать тебя здесь. Некогда я был {CHIEF_NAME} из колонны, что носила настоящие знамёна. Ныне я не ношу никаких и привечаю чужаков в темноте.&#10;&#10;Условия просты, как и подобает условиям. Двадцать пять дней. Одна цель, вычеркнутая из списков. Мои разведчики назовут шайку; ты увидишь её конец. Не оскорбляй меня промедлением.&#10;&#10;Исполнишь долг — и мы заговорим снова уже почти как равные. Провалишь — и я пожалею о любезности, что оказал нынче вечером.&quot;" />
    <string id="bp_allianceprosemoulds_034" text="&quot;Мои разведчики подали донесение, и дело ясное. {PARTY_NAME} — {ARTICLE} {CULTURE} {KIND}, движется в добром порядке по дорогам близ {AREA}. Я дважды прочёл расстановку. Она сгодится.&#10;&#10;Ты вступишь в бой с ними в одиночку. Мне нужен чистый отчёт, а не общий — доверенные мною свидетели поставлены наблюдать, и записывают они лишь то, что видят собственными глазами. Окажи им услугу — не оставляй никакой двусмысленности.&#10;&#10;Когда колонна будет разбита, возвращайся ко мне. Принеси то, что я смогу показать своим, — стяг, печать, клинок офицера. Доказательство, по старому обычаю.&quot;" />
    <string id="bp_allianceprosemoulds_035" text="&quot;Приказ изменён. Прежняя цель стёрта с доски — упущена моими дозорными, чем я займусь в свой черёд. Новая цель — {PARTY_NAME}, {ARTICLE} {CULTURE} {KIND}, в последний раз замечена близ {AREA}. Исполни это с той дисциплиной, что я просил в первый раз.&quot;" />
    <string id="bp_allianceprosemoulds_036" text="&quot;Ты вернулся. Признаюсь, я не возлагал на это дело больших надежд.&#10;&#10;Донесения дошли до меня раньше тебя — {CULTURE} колонна разбита в поле, её офицер мёртв, стяг захвачен. Похвальное дело, судя по тому, что передают мои люди. Я видывал донесения и похуже от тех, кто ещё носил перевязь. Правду сказать, и сам подавал похуже.&#10;&#10;Приходи в {HIDEOUT}, когда сменится стража. Теперь есть о чём поговорить, и я предпочту сказать это под крышей, а не у ворот. Ты заслужил место напротив меня.&quot;" />
    <string id="bp_allianceprosemoulds_037" text="&quot;Ты входишь в мою контору без доклада, и всё же гроссбух говорит, что явился ты точно в срок. Я — {CHIEF_NAME}, и всякая душа, что проходит сквозь эти цепи, — это запись, которую я оценил, обложил пошлиной и перепродал.&#10;&#10;Двадцать пять дней. Таков срок, что я даю новым должникам, а ты теперь один из них, нравится тебе это слово или нет. Первый взнос прост — одна шайка, стёртая с дорог. Чистый удар, без свидетелей, которым причитается плата.&#10;&#10;Уплати — и откроется твоя кредитная линия. Не расплатишься — и я продам то, что от тебя осталось, на вес. Наводка будет следом; мои маклеры уже оценили цель.&quot;" />
    <string id="bp_allianceprosemoulds_038" text="&quot;Мои приказчики оценили {PARTY_NAME} — {ARTICLE} {CULTURE} {KIND}, что медленно тянется по дорогам за {AREA}. Их груз из тех, что не пререкаются, а значит, охрана тоньше, чем сулит цена.&#10;&#10;Я хочу списать их со счетов. Не ограбить, не взять выкуп — закрыть. Всякий дышащий актив в той описи станет нулём в моём гроссбухе, а ты принесёшь мне печать капитана в подтверждение записи.&#10;&#10;Сделай это один. Моим писцам нужно одно имя в расписке, а долевые комиссии портят книги. Их цена всего выше в тот день, когда ты нанесёшь удар.&quot;" />
    <string id="bp_allianceprosemoulds_039" text="&quot;Переоценка сделки. Теперь {PARTY_NAME} — {ARTICLE} {CULTURE} {KIND} близ {AREA}. Прежняя цель погасила долг перед кем-то попроворнее или ушла с моего рынка. Оценка этой свежее, и навар твой.&quot;" />
    <string id="bp_allianceprosemoulds_040" text="&quot;Ты закрыл счёт. Мои маклеры внесли запись за час до того, как твоя тень достигла ворот.&#10;&#10;{CULTURE} шайка вычеркнута из списков, печать капитана отмечена, груз, надо думать, поделили те стервятники, что первыми добрались до остова. Я вписал твоё имя чёрными чернилами — в этом доме это значит кредит, — а условленная плата за наш уговор списана с должника, которого ты никогда не встретишь.&#10;&#10;Возвращайся в {HIDEOUT}, когда переменятся торговые ветра. Есть сделки покрупнее, что я предпочитаю обсуждать там, где стены мои, а свидетелям заплачено.&quot;" />
    <string id="bp_allianceprosemoulds_041" text="&quot;Ты стоишь в моём логове, будто это преторий, чужак. Я — {CHIEF_NAME}, некогда центурион легиона, чьё имя я не стану марать, произнося здесь.&#10;&#10;Двадцать пять дней. Вот твоя вахта, твой поход, твой срок службы. Принеси мне голову того, кто ещё дышит под теми же гнилыми знамёнами, что сломили наши. Мои разведчики укажут цель — ты исполнишь приказ так, будто он прибит к колонне.&#10;&#10;Провалишь — и пополнишь ряды непогребённых. Преуспеешь — и мы заговорим снова, солдат с солдатом, клятва с преломленной клятвой.&quot;" />
    <string id="bp_allianceprosemoulds_042" text="&quot;Мои дозорные следят за {PARTY_NAME} — {ARTICLE} {CULTURE} {KIND}, что идёт по дорогам близ {AREA}. Они маршируют в колонне, будто орёл всё ещё хранит их. Он не хранит.&#10;&#10;Бей их, как бьёт легионер, — быстро, в строю, без церемоний. Принеси сигнум, гладий, что угодно, что докажет убийство. Мои люди засвидетельствуют с опушки; чего они не увидят, того я не засчитаю.&#10;&#10;Выступай в третью стражу. Дороги близ {AREA} тогда пустеют, а дисциплина вознаграждает терпеливого солдата.&quot;" />
    <string id="bp_allianceprosemoulds_043" text="&quot;Новый приказ. Прежняя добыча проскользнула сквозь дозорную цепь — вина моих разведчиков, не твоя. Возьми на прицел {PARTY_NAME}, {ARTICLE} {CULTURE} {KIND}, замечена близ {AREA}. Легион научил меня никогда не оплакивать упущенную цель, когда в досягаемость входит другая.&quot;" />
    <string id="bp_allianceprosemoulds_044" text="&quot;Ты вернулся. Легион учил нас, что солдат, который возвращается, либо победил, либо солгал, — а мои гонцы заговорили раньше тебя.&#10;&#10;{CULTURE} шайка разбита на дороге. Главарь сражён, стяг взят, колонна рассеяна, как зерно. Ты сделал дело чисто, как тот, кто стоял в стене щитов и знает, что причитается стоящему рядом.&#10;&#10;Приходи в {HIDEOUT} до следующей стражи. Есть вино, что помнит лучшие дни, и приказы, для которых нужен солдат, коему я доверю больше, чем один клинок.&quot;" />
    <string id="bp_allianceprosemoulds_045" text="&quot;Далёк был твой подъём, чтобы найти меня, житель низин. Ветер здесь, наверху, сдирает с человека ложь прежде, чем тот дойдёт до моего костра. Я — {CHIEF_NAME}, и обрыв за твоей спиной длиннее твоего терпения.&#10;&#10;Двадцать пять дней. Столько крылья моих разведчиков будут терпеть твою тень на наших уступах. Принеси мне убийство — шайку тех, что ползают по долинам, жирея на том, что должно быть нашим. Наводка будет следом; мои дозорные уже приметили одну сверху.&#10;&#10;Провалишь — и скалы сведут мой счёт. Многие сорвались из тех, кто отказался.&quot;" />
    <string id="bp_allianceprosemoulds_046" text="&quot;С высокого гребня мои разведчики выследили {PARTY_NAME} — {ARTICLE} {CULTURE} {KIND}, что ползёт по нижним дорогам под {AREA}. Они идут, глядя в грязь, а не в небо. Они не увидят обрыва, пока не окажутся в нём.&#10;&#10;Бей их в одиночку. Мои дозорные сидят там, где тебе не сесть, и засчитают лишь то убийство, что видели собственными глазами. Никаких спутников, никакого дележа славы.&#10;&#10;Заходи с высот, если хватит духу. Падение делает половину работы — твоему клинку останется лишь довершить начатое тяготением.&quot;" />
    <string id="bp_allianceprosemoulds_047" text="&quot;Новая добыча, житель низин. {PARTY_NAME} — {ARTICLE} {CULTURE} {KIND}, что ползёт близ {AREA}. Прежняя цель ушла под кромку облаков, куда мои разведчики не пойдут. С этакой высоты один ходок по долинам мало чем отличается от другого.&quot;" />
    <string id="bp_allianceprosemoulds_048" text="&quot;Ты вернулся. Скалы пропустили тебя дважды — а это большая редкость, чем ты думаешь.&#10;&#10;Мои разведчики увидели это с гребня прежде, чем твой конь миновал перевал. {CULTURE} знамя, втоптанное в пыль, недвижимый главарь, стервятники, что кружат уже ниже моих дозорных. Они донесли об этом так, как доносят о погоде, — ровно, уверенно, увидев сверху.&#10;&#10;Поднимайся в {HIDEOUT}, когда улягутся восходящие потоки и свет ляжет длинными полосами по камню. Теперь, когда ты доказал, что твой клинок достаёт так же далеко, как твоё честолюбие, есть о чём поговорить.&quot;" />
    <string id="bp_allianceprosemoulds_049" text="&quot;Ты стоишь перед наследником ханов, чужак. Я — {CHIEF_NAME}, и кровь моя тянется через десять поколений всадников, что ломали империи на открытой траве.&#10;&#10;Двадцать пять дней. Вот срок, что я даю тебе, дабы доказать: твоё имя стоит высечь рядом с нашими. Принеси мне убийство — знамя, сорванное с тела, вождя, поверженного в чистом поле. Мои дозорные уже приметили добычу; наводка будет, когда я договорю.&#10;&#10;Соблюди условия — и поскачешь под волчьим стягом. Нарушишь — и предки будут знать твоё имя лишь как падаль.&quot;" />
    <string id="bp_allianceprosemoulds_050" text="&quot;Мои дозорные загнали своих коней, и весть принесена к стягу. {PARTY_NAME} — {ARTICLE} {CULTURE} {KIND} — движется по равнинам близ {AREA}, медленно и жирно от самоуверенности.&#10;&#10;Настигни их, как ханы былых времён настигали тихоходов. Возьми голову главаря, или его знак, или железо с его пояса — принеси мне доказательство, что прочтёт волк. Мои всадники будут смотреть с гребней и считать мёртвых, ибо предки записывают лишь то, что видят их глаза.&#10;&#10;Степь благоволит быстрым. Будь быстрее.&quot;" />
    <string id="bp_allianceprosemoulds_051" text="&quot;Цель сместилась, всадник. Теперь {PARTY_NAME} — {ARTICLE} {CULTURE} {KIND}, что бредёт близ {AREA}. Прежняя добыча ускакала за горизонт, что стерегут мои дозорные, а великие ханы учат: волк не гонится за тем, что унёс ветер. Это новое знамя сгодится.&quot;" />
    <string id="bp_allianceprosemoulds_052" text="&quot;Ты вернулся, и стяг от этого стоит выше. Немногие чужаки скачут назад, чтобы дважды предстать перед наследником хана.&#10;&#10;Мои дозорные принесли повесть раньше твоей пыли — {CULTURE} главарь сражён, его знамя взято, его колонна рассеяна, как мякина под степным ветром. Предки слышали, как об этом говорили у костра прошлой ночью, и один из моих старых воинов проиграл заклад, что поставил против твоих костей. Теперь он наливает тебе кумыс, хочет он того или нет.&#10;&#10;Приходи в {HIDEOUT}, пока не обернулась луна. Теперь, когда род знает твоё имя, есть о чём поговорить.&quot;" />
    <string id="bp_allianceprosemoulds_053" text="&quot;Ты входишь в мой круг из костей, чужак, а дым не дрогнул. Одно это говорит мне больше, чем когда-либо смог бы твой язык. Я — {CHIEF_NAME}, и старые боги три ночи нашёптывали твой облик в угли.&#10;&#10;Двадцать пять дней даруют тебе знамения. Не больше. Принеси мне смерть — кровь, пролитая правильной рукой, усладит гадание, и старейшины под землёй узнают твоё имя.&#10;&#10;Откажешься — и тот же огонь, что тебя согрел, прочтёт твои внутренности. Боги терпеливы. Я — менее.&quot;" />
    <string id="bp_allianceprosemoulds_054" text="&quot;Игральные кости легли не той стороной на рассвете, и вороны над {AREA} с тех пор кружат. Там движется {PARTY_NAME} — {ARTICLE} {CULTURE} {KIND}, уже отмеченный чем-то древнее моей руки.&#10;&#10;Пролей их. Пролей их там, где почва голодна. {CULTURE} молитвы не достают так глубоко, как наши, и то, чем они истекут, оживит корни под {AREA}. Возьми знак — зуб, кольцо, что угодно, что распознает дым.&#10;&#10;Ступай один. Боги считают свидетелей и предпочитают, чтобы их приношения были без чужой свиты.&quot;" />
    <string id="bp_allianceprosemoulds_055" text="&quot;Огонь отвернул лицо. Прежняя цель потеряна для костей — ушла за пределы гадания. Новый облик встаёт в углях: {PARTY_NAME}, {ARTICLE} {CULTURE} {KIND}, что бредёт близ {AREA}. Пролей вместо неё эту. Богам всё равно, чьё горло, — лишь бы чаша была полна.&quot;" />
    <string id="bp_allianceprosemoulds_056" text="&quot;Дым склонился к востоку в сумерках, и я знал. Прежде чем хоть один гонец переступил мой порог, угли уже поведали о твоём деянии.&#10;&#10;{CULTURE} знамя пало, и кровь испила земля, что долго жаждала. Старые боги нынче сыты — они произнесли твоё имя в треске огня, и на сей раз не как проклятие. Немногие заслуживают такого поворота речи.&#10;&#10;Возвращайся в {HIDEOUT}, пока не умерла следующая луна. Теперь есть обряды поглубже, что предстоит прочесть вместе, и костям не терпится вновь пасть для тебя.&quot;" />
