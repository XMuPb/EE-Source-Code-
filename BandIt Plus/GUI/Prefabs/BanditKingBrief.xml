<?xml version="1.0" encoding="utf-8"?>
<Prefab>
  <!-- reusable event panel. data-driven by BanditKingBriefVM; all six events share
       this one prefab. the frame is a fixed size for stable framing; header +
       flavor + rows + story + stakes form one top-anchored group that hugs its
       content (CoverChildren), the buttons are pinned to the bottom, and the gap
       between is the spacer. no ScrollablePanel — content is fit-trimmed
       (<=5 rows + 2-paragraph story). cascade entrance via @ArtAlpha/@HeaderAlpha/
       @FlavorAlpha/@RowsAlpha/@ButtonsAlpha. -->
  <Window>
    <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent">
      <Children>

        <!-- opaque scrim -->
        <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Sprite="BlankWhiteSquare" Color="#000000F2" />

        <!-- ── framed panel (FIXED size) ── -->
        <Widget WidthSizePolicy="Fixed" SuggestedWidth="1180" HeightSizePolicy="Fixed" SuggestedHeight="800"
                HorizontalAlignment="Center" VerticalAlignment="Center">
          <Children>

            <!-- gold border + dark inner fill -->
            <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Sprite="BlankWhiteSquare_9" Color="#C8A24EFF" />
            <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" MarginLeft="2" MarginRight="2" MarginTop="2" MarginBottom="2" Sprite="BlankWhiteSquare_9" Color="#13100AFF" />

            <!-- corner bolts -->
            <Widget WidthSizePolicy="Fixed" SuggestedWidth="9" HeightSizePolicy="Fixed" SuggestedHeight="9" HorizontalAlignment="Left" VerticalAlignment="Top" MarginLeft="10" MarginTop="10" Sprite="BlankWhiteSquare_9" Color="#E8C25AFF" DoNotAcceptEvents="true" />
            <Widget WidthSizePolicy="Fixed" SuggestedWidth="9" HeightSizePolicy="Fixed" SuggestedHeight="9" HorizontalAlignment="Right" VerticalAlignment="Top" MarginRight="10" MarginTop="10" Sprite="BlankWhiteSquare_9" Color="#E8C25AFF" DoNotAcceptEvents="true" />
            <Widget WidthSizePolicy="Fixed" SuggestedWidth="9" HeightSizePolicy="Fixed" SuggestedHeight="9" HorizontalAlignment="Left" VerticalAlignment="Bottom" MarginLeft="10" MarginBottom="10" Sprite="BlankWhiteSquare_9" Color="#E8C25AFF" DoNotAcceptEvents="true" />
            <Widget WidthSizePolicy="Fixed" SuggestedWidth="9" HeightSizePolicy="Fixed" SuggestedHeight="9" HorizontalAlignment="Right" VerticalAlignment="Bottom" MarginRight="10" MarginBottom="10" Sprite="BlankWhiteSquare_9" Color="#E8C25AFF" DoNotAcceptEvents="true" />

            <!-- ── LEFT: event art (fades in via @ArtAlpha) ── -->
            <Widget WidthSizePolicy="Fixed" SuggestedWidth="500" HeightSizePolicy="StretchToParent" HorizontalAlignment="Left" MarginLeft="2" MarginTop="2" MarginBottom="2" AlphaFactor="@ArtAlpha">
              <Children>
                <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Sprite="BlankWhiteSquare" Color="#0A0705FF" DoNotAcceptEvents="true" />
                <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Sprite="@ArtSprite" DoNotAcceptEvents="true" />
                <Widget WidthSizePolicy="Fixed" SuggestedWidth="320" HeightSizePolicy="Fixed" SuggestedHeight="320" HorizontalAlignment="Center" VerticalAlignment="Bottom" MarginBottom="60" Sprite="CharacterDeveloper\add_focus_button_glow" Color="#7A3E1440" DoNotAcceptEvents="true" />
                <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="150" VerticalAlignment="Bottom" Sprite="BlankWhiteSquare" Color="#0A07058C" DoNotAcceptEvents="true" />
                <Widget WidthSizePolicy="Fixed" SuggestedWidth="2" HeightSizePolicy="StretchToParent" HorizontalAlignment="Right" Sprite="BlankWhiteSquare" Color="#C8A24EFF" DoNotAcceptEvents="true" />
              </Children>
            </Widget>

            <!-- ── RIGHT: briefing content ── -->
            <Widget WidthSizePolicy="Fixed" SuggestedWidth="636" HeightSizePolicy="StretchToParent" HorizontalAlignment="Right" MarginRight="20" MarginTop="2" MarginBottom="2">
              <Children>

                <!-- torchlight pooling from the art side -->
                <Widget WidthSizePolicy="Fixed" SuggestedWidth="620" HeightSizePolicy="Fixed" SuggestedHeight="420" HorizontalAlignment="Left" VerticalAlignment="Top" MarginLeft="-120" MarginTop="-80" Sprite="CharacterDeveloper\add_focus_button_glow" Color="#7A3E1432" DoNotAcceptEvents="true" AlphaFactor="@HeaderAlpha" />

                <!-- header: framed portrait + banner + name/type -->
                <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="78" SuggestedHeight="92"
                        HorizontalAlignment="Left" VerticalAlignment="Top" MarginLeft="6" MarginTop="20"
                        IsVisible="@HasPortrait" AlphaFactor="@HeaderAlpha" PositionYOffset="@HeaderDriftY">
                  <Children>
                    <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Sprite="BlankWhiteSquare_9" Color="#C8A24EFF" DoNotAcceptEvents="true" />
                    <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" MarginLeft="2" MarginRight="2" MarginTop="2" MarginBottom="2" Sprite="BlankWhiteSquare_9" Color="#0A0705FF" DoNotAcceptEvents="true" />
                    <ImageIdentifierWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="70" SuggestedHeight="84"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           DataSource="{Portrait}"
                                           TextureProviderName="@TextureProviderName" ImageId="@Id" />
                  </Children>
                </Widget>
                <!-- banner sized like the portrait: the inner dark inset layer was
                     REMOVED so the banner fills the gold frame edge-to-edge -->
                <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="78" SuggestedHeight="92"
                        HorizontalAlignment="Right" VerticalAlignment="Top" MarginRight="6" MarginTop="20"
                        IsVisible="@HasBanner" AlphaFactor="@HeaderAlpha" PositionYOffset="@HeaderDriftY">
                  <Children>
                    <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Sprite="BlankWhiteSquare_9" Color="#C8A24EFF" DoNotAcceptEvents="true" />
                    <BannerTableauWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="74" SuggestedHeight="88"
                                         HorizontalAlignment="Center" VerticalAlignment="Center"
                                         BannerCodeText="@BannerCode" IsNineGrid="true" />
                  </Children>
                </Widget>
                <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="30" HorizontalAlignment="Center" VerticalAlignment="Top" MarginTop="30" Brush="BandItPlus.Codex.BodyCenterGold" Text="@KName" AlphaFactor="@HeaderAlpha" PositionYOffset="@HeaderDriftY" />
                <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="20" HorizontalAlignment="Center" VerticalAlignment="Top" MarginTop="62" Brush="BandItPlus.Codex.BodyCenter" Text="@KType" AlphaFactor="@HeaderAlpha" PositionYOffset="@HeaderDriftY" />

                <!-- colored category TAG chips: accent border + dark body + accent
                     wash, popping in with a living pulse via @TagsAlpha -->
                <!-- gate/alpha/drift live on this wrapper: DataSource re-scopes every
                     @-binding on its own widget to the collection, so they have to
                     sit one level up (same as the portrait/banner frames) -->
                <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="24"
                        VerticalAlignment="Top" MarginTop="86"
                        IsVisible="@HasTags" AlphaFactor="@TagsAlpha" PositionYOffset="@HeaderDriftY" DoNotAcceptEvents="true">
                  <Children>
                <ListPanel WidthSizePolicy="CoverChildren" HeightSizePolicy="StretchToParent"
                           HorizontalAlignment="Center"
                           StackLayout.LayoutMethod="HorizontalLeftToRight"
                           DataSource="{Tags}">
                  <ItemTemplate>
                    <Widget WidthSizePolicy="Fixed" SuggestedWidth="156" HeightSizePolicy="Fixed" SuggestedHeight="24" MarginLeft="5" MarginRight="5" DoNotAcceptEvents="true">
                      <Children>
                        <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Sprite="BlankWhiteSquare_9" Color="@AccentHex" DoNotAcceptEvents="true" />
                        <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" MarginLeft="1" MarginRight="1" MarginTop="1" MarginBottom="1" Sprite="BlankWhiteSquare_9" Color="#14100AF5" DoNotAcceptEvents="true" />
                        <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" MarginLeft="1" MarginRight="1" MarginTop="1" MarginBottom="1" Sprite="BlankWhiteSquare_9" Color="@FillHex" DoNotAcceptEvents="true" />
                        <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Brush="BandItPlus.Codex.BodyCenter" Text="@Text" DoNotAcceptEvents="true" />
                      </Children>
                    </Widget>
                  </ItemTemplate>
                </ListPanel>
                  </Children>
                </Widget>

                <!-- title flash-glow: ignites behind the title on entrance, settles
                     into a slow breathing ember via @TitleGlowAlpha -->
                <Widget WidthSizePolicy="Fixed" SuggestedWidth="560" HeightSizePolicy="Fixed" SuggestedHeight="90" HorizontalAlignment="Center" VerticalAlignment="Top" MarginTop="94" Sprite="CharacterDeveloper\add_focus_button_glow" Color="#E8C25AFF" AlphaFactor="@TitleGlowAlpha" PositionYOffset="@HeaderDriftY" DoNotAcceptEvents="true" />

                <!-- title + subline + divider -->
                <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="44" VerticalAlignment="Top" MarginTop="116" Brush="BandItPlus.Book.CardTitleC" Text="@Title" AlphaFactor="@HeaderAlpha" PositionYOffset="@HeaderDriftY" />
                <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="22" VerticalAlignment="Top" MarginTop="162" Brush="BandItPlus.Codex.BodyCenter" Text="@Subline" AlphaFactor="@HeaderAlpha" PositionYOffset="@HeaderDriftY" />
                <Widget WidthSizePolicy="Fixed" SuggestedWidth="540" HeightSizePolicy="Fixed" SuggestedHeight="10" HorizontalAlignment="Center" VerticalAlignment="Top" MarginTop="192" Sprite="horizontal_gradient_divider_9" Color="#D8B05AD2" DoNotAcceptEvents="true" AlphaFactor="@HeaderAlpha" PositionYOffset="@HeaderDriftY" />
                <TextWidget WidthSizePolicy="Fixed" SuggestedWidth="22" HeightSizePolicy="Fixed" SuggestedHeight="22" HorizontalAlignment="Center" VerticalAlignment="Top" MarginTop="186" Brush="BandItPlus.Codex.BodyCenterGold" Text="◆" DoNotAcceptEvents="true" AlphaFactor="@HeaderAlpha" PositionYOffset="@HeaderDriftY" />

                <!-- flavor prose -->
                <RichTextWidget WidthSizePolicy="Fixed" SuggestedWidth="600" HeightSizePolicy="Fixed" SuggestedHeight="52" HorizontalAlignment="Center" VerticalAlignment="Top" MarginTop="208" Brush="BandItPlus.Book.CardBody" Text="@Flavor" AlphaFactor="@FlavorAlpha" />

                <!-- content group: rows -> story -> stakes, top-anchored and hugging
                     (CoverChildren). buttons are pinned to the bottom; the empty
                     space between is the spacer. -->
                <ListPanel WidthSizePolicy="Fixed" SuggestedWidth="620" HeightSizePolicy="CoverChildren"
                           HorizontalAlignment="Center" VerticalAlignment="Top" MarginTop="270"
                           StackLayout.LayoutMethod="VerticalTopToBottom" AlphaFactor="@RowsAlpha" PositionYOffset="@RowsDriftY">
                  <Children>

                    <!-- info rows (layered accent badge + perk glyph + muted label + gold value) -->
                    <ListPanel WidthSizePolicy="Fixed" SuggestedWidth="592" HeightSizePolicy="CoverChildren" HorizontalAlignment="Center" VerticalAlignment="Top"
                               StackLayout.LayoutMethod="VerticalTopToBottom" DataSource="{Rows}">
                      <ItemTemplate>
                        <Widget WidthSizePolicy="Fixed" SuggestedWidth="592" HeightSizePolicy="Fixed" SuggestedHeight="34">
                          <Children>
                            <Widget WidthSizePolicy="Fixed" SuggestedWidth="30" HeightSizePolicy="Fixed" SuggestedHeight="30" HorizontalAlignment="Left" VerticalAlignment="Center" Sprite="GradientCircle" Color="@BadgeHex" DoNotAcceptEvents="true" />
                            <Widget WidthSizePolicy="Fixed" SuggestedWidth="23" HeightSizePolicy="Fixed" SuggestedHeight="23" HorizontalAlignment="Left" VerticalAlignment="Center" MarginLeft="4" Sprite="GradientCircle" Color="#14100AF2" DoNotAcceptEvents="true" />
                            <Widget WidthSizePolicy="Fixed" SuggestedWidth="18" HeightSizePolicy="Fixed" SuggestedHeight="18" HorizontalAlignment="Left" VerticalAlignment="Center" MarginLeft="6" Sprite="@Icon" Color="@AccentHex" DoNotAcceptEvents="true" />
                            <TextWidget WidthSizePolicy="Fixed" SuggestedWidth="230" HeightSizePolicy="StretchToParent" HorizontalAlignment="Left" MarginLeft="46" Brush="BandItPlus.Codex.Body" Text="@Label" />
                            <TextWidget WidthSizePolicy="Fixed" SuggestedWidth="296" HeightSizePolicy="StretchToParent" HorizontalAlignment="Right" Brush="BandItPlus.Codex.BodyCenterGold" Text="@Value" />
                          </Children>
                        </Widget>
                      </ItemTemplate>
                    </ListPanel>

                    <!-- labeled STORY divider (gated) -->
                    <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="16" HorizontalAlignment="Center" VerticalAlignment="Top" MarginTop="16" Brush="BandItPlus.Codex.BodyCenter" Text="@StorySectionLabel" IsVisible="@HasStory" DoNotAcceptEvents="true" />
                    <Widget WidthSizePolicy="Fixed" SuggestedWidth="540" HeightSizePolicy="Fixed" SuggestedHeight="8" HorizontalAlignment="Center" VerticalAlignment="Top" MarginTop="2" MarginBottom="6" Sprite="horizontal_gradient_divider_9" Color="#D8B05AB4" IsVisible="@HasStory" DoNotAcceptEvents="true" />

                    <!-- authored STORY prose (CoverChildren) -->
                    <RichTextWidget WidthSizePolicy="Fixed" SuggestedWidth="580" HeightSizePolicy="CoverChildren" HorizontalAlignment="Center" VerticalAlignment="Top" Brush="BandItPlus.Codex.BodySmall" Text="@StoryText" IsVisible="@HasStory" ClipContents="false" DoNotAcceptEvents="true" />

                    <!-- stakes (closes the content group, like the mockup's red line) -->
                    <TextWidget WidthSizePolicy="Fixed" SuggestedWidth="600" HeightSizePolicy="Fixed" SuggestedHeight="24" HorizontalAlignment="Center" VerticalAlignment="Top" MarginTop="18" Brush="BandItPlus.Codex.BodyCenterRed" Text="@Stakes" />

                  </Children>
                </ListPanel>

                <!-- ── forged-plate buttons pinned to the BOTTOM (mockup spacer above) ── -->
                <ButtonWidget WidthSizePolicy="Fixed" SuggestedWidth="300" HeightSizePolicy="Fixed" SuggestedHeight="58" HorizontalAlignment="Left" VerticalAlignment="Bottom" MarginLeft="6" MarginBottom="24" DoNotPassEventsToChildren="true" UpdateChildrenStates="true" Brush="BandItPlus.JailButton.Go" Command.Click="ExecutePrimary" AlphaFactor="@ButtonsAlpha" PositionYOffset="@ButtonsDriftY">
                  <Children>
                    <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="2" VerticalAlignment="Top" Sprite="BlankWhiteSquare" Color="#E8C25AFF" DoNotAcceptEvents="true" />
                    <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="2" VerticalAlignment="Bottom" Sprite="BlankWhiteSquare" Color="#E8C25AFF" DoNotAcceptEvents="true" />
                    <Widget WidthSizePolicy="Fixed" SuggestedWidth="2" HeightSizePolicy="StretchToParent" HorizontalAlignment="Left" Sprite="BlankWhiteSquare" Color="#E8C25AFF" DoNotAcceptEvents="true" />
                    <Widget WidthSizePolicy="Fixed" SuggestedWidth="2" HeightSizePolicy="StretchToParent" HorizontalAlignment="Right" Sprite="BlankWhiteSquare" Color="#E8C25AFF" DoNotAcceptEvents="true" />
                    <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Brush="BandItPlus.Book.ButtonTextLight" Text="@PrimaryText" DoNotAcceptEvents="true" />
                  </Children>
                </ButtonWidget>
                <ButtonWidget WidthSizePolicy="Fixed" SuggestedWidth="300" HeightSizePolicy="Fixed" SuggestedHeight="58" HorizontalAlignment="Right" VerticalAlignment="Bottom" MarginRight="6" MarginBottom="24" IsVisible="@HasSecondary" DoNotPassEventsToChildren="true" UpdateChildrenStates="true" Brush="BandItPlus.JailButton.Wait" Command.Click="ExecuteSecondary" AlphaFactor="@ButtonsAlpha" PositionYOffset="@ButtonsDriftY">
                  <Children>
                    <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="2" VerticalAlignment="Top" Sprite="BlankWhiteSquare" Color="#9A7B3AFF" DoNotAcceptEvents="true" />
                    <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="2" VerticalAlignment="Bottom" Sprite="BlankWhiteSquare" Color="#9A7B3AFF" DoNotAcceptEvents="true" />
                    <Widget WidthSizePolicy="Fixed" SuggestedWidth="2" HeightSizePolicy="StretchToParent" HorizontalAlignment="Left" Sprite="BlankWhiteSquare" Color="#9A7B3AFF" DoNotAcceptEvents="true" />
                    <Widget WidthSizePolicy="Fixed" SuggestedWidth="2" HeightSizePolicy="StretchToParent" HorizontalAlignment="Right" Sprite="BlankWhiteSquare" Color="#9A7B3AFF" DoNotAcceptEvents="true" />
                    <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Brush="BandItPlus.Book.ButtonTextLight" Text="@SecondaryText" DoNotAcceptEvents="true" />
                  </Children>
                </ButtonWidget>

              </Children>
            </Widget>

          </Children>
        </Widget>

        <!-- open-fade curtain -->
        <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Sprite="BlankWhiteSquare" Color="@CurtainHex" DoNotAcceptEvents="true" />

      </Children>
    </Widget>
  </Window>
</Prefab>
