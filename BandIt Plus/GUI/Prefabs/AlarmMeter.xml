<?xml version="1.0" encoding="utf-8"?>
<Prefab>
  <Constants />
  <VisualDefinitions />
  <Window>
    <!-- detection meter, top-center: eye glyph + fill bar. @Tint ramps gold->amber->red,
         @ContainerAlpha/@EyeAlpha rise with detection, @Show gates the whole thing.
         driven by BpJailbreakMissionController. fixed sizes only. -->
    <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent">
      <Children>
        <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="252" SuggestedHeight="56"
                HorizontalAlignment="Center" VerticalAlignment="Top" MarginTop="70"
                IsVisible="@Show" AlphaFactor="@ContainerAlpha"
                Sprite="BlankWhiteSquare_9" Color="#0B0906E6">
          <Children>
            <!-- gold/red top accent -->
            <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="2"
                    VerticalAlignment="Top" Sprite="BlankWhiteSquare" Color="@Tint" />

            <!-- EYE (left): radial glow + outer ring + iris -->
            <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="40" SuggestedHeight="40"
                    HorizontalAlignment="Left" VerticalAlignment="Center" MarginLeft="12">
              <Children>
                <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                        Sprite="GradientCircle" Color="@Tint" AlphaFactor="@EyeAlpha" />
                <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="30" SuggestedHeight="30"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Sprite="BlankWhiteCircleOutlined" Color="@Tint" />
                <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="13" SuggestedHeight="13"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Sprite="BlankWhiteCircle" Color="@Tint" AlphaFactor="@EyeAlpha" />
              </Children>
            </Widget>

            <!-- STATE text (right column, top) -->
            <TextWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="172" SuggestedHeight="20"
                        HorizontalAlignment="Right" VerticalAlignment="Top" MarginRight="14" MarginTop="7"
                        Brush="BandItPlus.Footer" Color="@Tint" Text="@State" />

            <!-- DETECTION BAR (right column, bottom): dark track + colored fill -->
            <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="172" SuggestedHeight="11"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom" MarginRight="14" MarginBottom="10"
                    Sprite="BlankWhiteSquare_9" Color="#000000B4">
              <Children>
                <Widget WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent" SuggestedWidth="@FillWidth"
                        HorizontalAlignment="Left" VerticalAlignment="Center"
                        Sprite="BlankWhiteSquare" Color="@Tint" />
              </Children>
            </Widget>
          </Children>
        </Widget>
      </Children>
    </Widget>
  </Window>
</Prefab>
