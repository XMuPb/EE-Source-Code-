                <TextWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed"
                            SuggestedWidth="60" SuggestedHeight="14"
                            HorizontalAlignment="Left" VerticalAlignment="Top"
                            MarginLeft="32" MarginTop="6"
                            Brush="BandItPlus.CrimsonLabel" Text="{=bp_pf_hideoutassaultpanel_003}Defenders" />
                <TextWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed"
                            SuggestedWidth="80" SuggestedHeight="18"
                            HorizontalAlignment="Left" VerticalAlignment="Top"
                            MarginLeft="32" MarginTop="19"
                            Brush="BandItPlus.CrimsonValue" Text="@DefenderCount" />
              </Children>
            </Widget>
            <!-- intel grid: Your forces (top-right) -->
            <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed"
                    SuggestedWidth="156" SuggestedHeight="40"
                    HorizontalAlignment="Right" VerticalAlignment="Top"
                    MarginRight="14" MarginTop="198"
                    Sprite="BlankWhiteSquare_9" Color="#16110CFF">
              <Children>
                <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed"
                        SuggestedWidth="16" SuggestedHeight="16"
                        HorizontalAlignment="Left" VerticalAlignment="Center" MarginLeft="8"
                        Sprite="General\Icons\Party@2x" />
                <TextWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed"
                            SuggestedWidth="70" SuggestedHeight="14"
                            HorizontalAlignment="Left" VerticalAlignment="Top"
                            MarginLeft="32" MarginTop="6"
                            Brush="BandItPlus.CrimsonLabel" Text="{=bp_pf_hideoutassaultpanel_004}Your forces" />
                <TextWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed"
                            SuggestedWidth="80" SuggestedHeight="18"
                            HorizontalAlignment="Left" VerticalAlignment="Top"
                            MarginLeft="32" MarginTop="19"
                            Brush="BandItPlus.CrimsonValue" Text="@YourForces" />
              </Children>
            </Widget>
            <!-- intel grid: Odds (bottom-left) -->
            <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed"
                    SuggestedWidth="156" SuggestedHeight="40"
                    HorizontalAlignment="Left" VerticalAlignment="Top"
                    MarginLeft="18" MarginTop="242"
                    Sprite="BlankWhiteSquare_9" Color="#16110CFF">
              <Children>
                <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed"
                        SuggestedWidth="16" SuggestedHeight="16"
                        HorizontalAlignment="Left" VerticalAlignment="Center" MarginLeft="8"
