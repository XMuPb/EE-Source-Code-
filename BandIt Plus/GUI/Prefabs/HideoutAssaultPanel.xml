                            HorizontalAlignment="Left" VerticalAlignment="Top"
                            MarginLeft="10" MarginTop="6"
                            Brush="BandItPlus.CrimsonLabel" Text="{=bp_pf_hideoutassaultpanel_006}Difficulty" />
                <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed"
                        SuggestedWidth="14" SuggestedHeight="8"
                        HorizontalAlignment="Left" VerticalAlignment="Top" MarginLeft="10" MarginTop="22"
                        Sprite="BlankWhiteSquare" Color="#3A2C20FF">
                  <Children>
                    <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                            Sprite="BlankWhiteSquare" Color="#D8424CFF" IsVisible="@Pip1On" />
                  </Children>
                </Widget>
                <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed"
                        SuggestedWidth="14" SuggestedHeight="8"
                        HorizontalAlignment="Left" VerticalAlignment="Top" MarginLeft="27" MarginTop="22"
                        Sprite="BlankWhiteSquare" Color="#3A2C20FF">
                  <Children>
                    <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                            Sprite="BlankWhiteSquare" Color="#D8424CFF" IsVisible="@Pip2On" />
                  </Children>
                </Widget>
                <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed"
                        SuggestedWidth="14" SuggestedHeight="8"
                        HorizontalAlignment="Left" VerticalAlignment="Top" MarginLeft="44" MarginTop="22"
                        Sprite="BlankWhiteSquare" Color="#3A2C20FF">
                  <Children>
                    <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                            Sprite="BlankWhiteSquare" Color="#D8424CFF" IsVisible="@Pip3On" />
                  </Children>
                </Widget>
                <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed"
                        SuggestedWidth="14" SuggestedHeight="8"
                        HorizontalAlignment="Left" VerticalAlignment="Top" MarginLeft="61" MarginTop="22"
                        Sprite="BlankWhiteSquare" Color="#3A2C20FF">
                  <Children>
                    <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                            Sprite="BlankWhiteSquare" Color="#D8424CFF" IsVisible="@Pip4On" />
                  </Children>
                </Widget>
                <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed"
                        SuggestedWidth="14" SuggestedHeight="8"
                        HorizontalAlignment="Left" VerticalAlignment="Top" MarginLeft="78" MarginTop="22"
                        Sprite="BlankWhiteSquare" Color="#3A2C20FF">
                  <Children>
                    <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                            Sprite="BlankWhiteSquare" Color="#D8424CFF" IsVisible="@Pip5On" />
                  </Children>
                </Widget>
              </Children>
            </Widget>

            <!-- faint divider -->
            <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed"
                    SuggestedHeight="1" HorizontalAlignment="Center" VerticalAlignment="Top"
                    MarginLeft="22" MarginRight="16" MarginTop="290"
                    Sprite="BlankWhiteSquare" Color="#A0202C55" />

            <!-- card 1: Reinforced Garrison -->
            <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed"
                    SuggestedHeight="40" HorizontalAlignment="Center" VerticalAlignment="Top"
                    MarginLeft="18" MarginRight="14" MarginTop="296"
                    Sprite="BlankWhiteSquare_9" Color="#FFFFFF0C">
              <Children>
                <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed"
                        SuggestedWidth="28" SuggestedHeight="28"
                        HorizontalAlignment="Left" VerticalAlignment="Center" MarginLeft="6"
                        Sprite="BlankWhiteSquare_9" Color="#000000B0">
                  <Children>
                    <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                Brush="BandItPlus.CrimsonValue" Text="◆" />
                    <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed"
                            SuggestedWidth="20" SuggestedHeight="20"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            Sprite="General\Icons\Garrison" />
                  </Children>
                </Widget>
                <TextWidget WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent"
                            SuggestedWidth="180" HorizontalAlignment="Left" VerticalAlignment="Center"
                            MarginLeft="44" Brush="BandItPlus.CrimsonBody" Text="{=bp_pf_hideoutassaultpanel_007}Reinforced Garrison" />
                <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed"
                        SuggestedWidth="84" SuggestedHeight="26"
                        HorizontalAlignment="Right" VerticalAlignment="Center" MarginRight="8"
                        Sprite="BlankWhiteSquare_9" Color="#191510F4">
                  <Children>
                    <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                Brush="BandItPlus.CrimsonValue" Text="@GarrisonValue" />
                  </Children>
                </Widget>
              </Children>
            </Widget>

            <!-- card 2: Hardened Defenders -->
            <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed"
                    SuggestedHeight="40" HorizontalAlignment="Center" VerticalAlignment="Top"
                    MarginLeft="18" MarginRight="14" MarginTop="340"
                    Sprite="BlankWhiteSquare_9" Color="#FFFFFF0C">
              <Children>
                <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed"
                        SuggestedWidth="28" SuggestedHeight="28"
                        HorizontalAlignment="Left" VerticalAlignment="Center" MarginLeft="6"
                        Sprite="BlankWhiteSquare_9" Color="#000000B0">
                  <Children>
                    <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                Brush="BandItPlus.CrimsonValue" Text="◆" />
                    <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed"
                            SuggestedWidth="20" SuggestedHeight="20"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            Sprite="General\Icons\Army" />
                  </Children>
                </Widget>
                <TextWidget WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent"
                            SuggestedWidth="180" HorizontalAlignment="Left" VerticalAlignment="Center"
                            MarginLeft="44" Brush="BandItPlus.CrimsonBody" Text="{=bp_pf_hideoutassaultpanel_008}Hardened Defenders" />
                <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed"
                        SuggestedWidth="84" SuggestedHeight="26"
                        HorizontalAlignment="Right" VerticalAlignment="Center" MarginRight="8"
                        Sprite="BlankWhiteSquare_9" Color="#191510F4">
                  <Children>
                    <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                Brush="BandItPlus.CrimsonValue" Text="@DefenderTier" />
                  </Children>
                </Widget>
              </Children>
            </Widget>

            <!-- card 3: Battle Tactics -->
            <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed"
                    SuggestedHeight="40" HorizontalAlignment="Center" VerticalAlignment="Top"
                    MarginLeft="18" MarginRight="14" MarginTop="384"
