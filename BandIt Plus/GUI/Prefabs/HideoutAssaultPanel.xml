<?xml version="1.0" encoding="utf-8"?>
<Prefab>
  <Constants />
  <VisualDefinitions />
  <Window>
    <!-- hideout assault panel — persistent crimson battle HUD, top-left. dark base +
         crimson left edge; title + mode label + hideout name; boss spotlight
         (clan-banner crest medallion + name + culture/trust); chief taunt; 2x2
         intel grid (defenders / your forces / odds / 5-pip difficulty); 3 cards
         with SpriteParts\Sve icons and live values; spoils line. text uses the
         BandItPlus.Crimson* brushes; every icon medallion keeps a fallback diamond
         behind the sprite. AlphaFactor binds @PanelAlpha (fade-in from the
         MissionView). -->
    <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent">
      <Children>
        <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed"
                SuggestedWidth="352" SuggestedHeight="478"
                HorizontalAlignment="Left" VerticalAlignment="Top"
                MarginLeft="26" MarginTop="84"
                IsVisible="@IsVisible" AlphaFactor="@PanelAlpha"
                Sprite="BlankWhiteSquare_9" Color="#0B0906FC">
          <Children>

            <!-- crimson left-edge accent -->
            <Widget WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent"
                    SuggestedWidth="5" HorizontalAlignment="Left"
                    Sprite="BlankWhiteSquare" Color="#A0202CFF" />

            <!-- title -->
            <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed"
                        SuggestedHeight="32" HorizontalAlignment="Center" VerticalAlignment="Top"
                        MarginLeft="20" MarginRight="14" MarginTop="12"
                        Brush="BandItPlus.CrimsonTitle" Text="{=bp_pf_hideoutassaultpanel_001}HIDEOUT ASSAULT" />
            <!-- mode label -->
            <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed"
                        SuggestedHeight="16" HorizontalAlignment="Center" VerticalAlignment="Top"
                        MarginLeft="20" MarginRight="14" MarginTop="44"
                        Brush="BandItPlus.CrimsonMode" Text="{=bp_pf_hideoutassaultpanel_002}— BANDIT PLUS MODE —" />
            <!-- hideout name -->
            <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed"
                        SuggestedHeight="22" HorizontalAlignment="Center" VerticalAlignment="Top"
                        MarginLeft="20" MarginRight="14" MarginTop="62"
                        Brush="BandItPlus.CrimsonValue" Text="@HideoutName" />
            <!-- divider -->
            <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed"
                    SuggestedHeight="2" HorizontalAlignment="Center" VerticalAlignment="Top"
                    MarginLeft="20" MarginRight="14" MarginTop="88"
                    Sprite="BlankWhiteSquare" Color="#A0202C99" />

            <!-- boss row -->
            <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed"
                    SuggestedHeight="44" HorizontalAlignment="Center" VerticalAlignment="Top"
                    MarginLeft="16" MarginRight="14" MarginTop="96">
              <Children>
                <!-- crest medallion: diamond fallback, banner on top -->
                <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed"
                        SuggestedWidth="42" SuggestedHeight="42"
                        HorizontalAlignment="Left" VerticalAlignment="Center"
                        Sprite="BlankWhiteSquare_9" Color="#140D0AFF">
                  <Children>
                    <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                Brush="BandItPlus.CrimsonTitle" Text="◆" />
                    <BannerTableauWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                                BannerCodeText="@BannerCode" IsVisible="@HasBanner"
                                IsNineGrid="true" />
                  </Children>
                </Widget>
                <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed"
                            SuggestedHeight="22" HorizontalAlignment="Left" VerticalAlignment="Top"
                            MarginLeft="54" MarginTop="1"
                            Brush="BandItPlus.CrimsonName" Text="@BossName" />
                <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed"
                            SuggestedHeight="16" HorizontalAlignment="Left" VerticalAlignment="Top"
                            MarginLeft="54" MarginTop="25"
                            Brush="BandItPlus.CrimsonLabel" Text="@CultureTrustLine" />
              </Children>
            </Widget>

            <!-- faint divider -->
            <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed"
                    SuggestedHeight="1" HorizontalAlignment="Center" VerticalAlignment="Top"
                    MarginLeft="22" MarginRight="16" MarginTop="146"
                    Sprite="BlankWhiteSquare" Color="#A0202C55" />

            <!-- taunt -->
            <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed"
                        SuggestedHeight="34" HorizontalAlignment="Center" VerticalAlignment="Top"
                        MarginLeft="20" MarginRight="14" MarginTop="152"
                        Brush="BandItPlus.CrimsonTaunt" Text="@TauntText" />

            <!-- faint divider -->
            <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed"
                    SuggestedHeight="1" HorizontalAlignment="Center" VerticalAlignment="Top"
                    MarginLeft="22" MarginRight="16" MarginTop="190"
                    Sprite="BlankWhiteSquare" Color="#A0202C55" />

            <!-- intel grid: Defenders (top-left) -->
            <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed"
                    SuggestedWidth="156" SuggestedHeight="40"
                    HorizontalAlignment="Left" VerticalAlignment="Top"
                    MarginLeft="18" MarginTop="198"
                    Sprite="BlankWhiteSquare_9" Color="#16110CFF">
              <Children>
                <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed"
                        SuggestedWidth="16" SuggestedHeight="16"
                        HorizontalAlignment="Left" VerticalAlignment="Center" MarginLeft="8"
