    </Styles>
  </Brush>

  <!-- BANDIT PLUS toast (left-center crest notification) -->
  <Brush Name="BandItPlus.Book.ToastTitle" Font="Galahad" TextHorizontalAlignment="Left" TextVerticalAlignment="Center">
    <Layers>
    </Layers>
    <Styles>
      <Style Name="Default" FontColor="#E8B43AFF" TextGlowColor="#00000000" TextOutlineColor="#1A0E06C0" TextOutlineAmount="0.12" TextGlowRadius="0" FontSize="24" />
    </Styles>
  </Brush>
  <Brush Name="BandItPlus.Book.ToastBody" Font="Galahad" TextHorizontalAlignment="Left" TextVerticalAlignment="Top">
