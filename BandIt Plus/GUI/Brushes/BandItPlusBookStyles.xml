    </Layers>
    <Styles>
      <Style Name="Default" FontColor="#DCC094FF" TextGlowColor="#00000000" TextOutlineColor="#1A0E06A0" TextOutlineAmount="0.08" TextGlowRadius="0" FontSize="19" />
    </Styles>
  </Brush>

  <!-- Difficulty tags on the origin cards: moss green / gold / ember red -->
  <Brush Name="BandItPlus.Book.TagEasy" Font="Galahad" TextHorizontalAlignment="Center" TextVerticalAlignment="Center">
    <Layers>
    </Layers>
    <Styles>
      <Style Name="Default" FontColor="#7FA050FF" TextGlowColor="#00000000" TextOutlineColor="#1A0E06C0" TextOutlineAmount="0.10" TextGlowRadius="0" FontSize="16" />
      <Style Name="Hovered" FontColor="#9CC468FF" TextGlowColor="#00000000" TextOutlineColor="#1A0E06C0" TextOutlineAmount="0.10" TextGlowRadius="0" FontSize="16" />
      <Style Name="Pressed" FontColor="#B8E080FF" TextGlowColor="#00000000" TextOutlineColor="#1A0E06C0" TextOutlineAmount="0.10" TextGlowRadius="0" FontSize="16" />
