    </Styles>
  </Brush>

  <!-- lore line: muted scribe's note by default, ignites on the card's Hovered
       state (UpdateChildrenStates). gauntlet ignores FontColor alpha, so the
       muted→bright shift carries the reveal instead of a fade-from-0. -->
  <Brush Name="BandItPlus.Book.CardHover" Font="Galahad" TextHorizontalAlignment="Left" TextVerticalAlignment="Top">
    <Layers>
    </Layers>
    <Styles>
      <Style Name="Default" FontColor="#8A7252FF" TextGlowColor="#00000000" TextOutlineColor="#1A0E0680" TextOutlineAmount="0.06" TextGlowRadius="0" FontSize="17" />
      <Style Name="Hovered" FontColor="#E0C896FF" TextGlowColor="#00000000" TextOutlineColor="#1A0E06A0" TextOutlineAmount="0.06" TextGlowRadius="0" FontSize="17" />
      <Style Name="Pressed" FontColor="#F0E0C0FF" TextGlowColor="#00000000" TextOutlineColor="#1A0E06A0" TextOutlineAmount="0.06" TextGlowRadius="0" FontSize="17" />
    </Styles>
  </Brush>

  <!-- Button BODY: parchment-stamp fill with hover/press state colors.
       Lives on the ButtonWidget itself (brush layers render under children,
       and engine drives Default/Hovered/Pressed automatically). -->
  <Brush Name="BandItPlus.Book.Button">
    <Layers>
      <BrushLayer Name="Frame" Sprite="button_frame_9" Color="#B08A50FF" />
    </Layers>
    <SoundProperties>
      <EventSounds>
        <EventSound EventName="Click" Audio="panels/next" />
        <EventSound EventName="HoverBegin" Audio="tab" />
      </EventSounds>
    </SoundProperties>
    <Styles>
      <Style Name="Default">
        <BrushLayer Name="Frame" Color="#B08A50FF" />
      </Style>
      <Style Name="Hovered">
        <BrushLayer Name="Frame" Color="#E0BC7CFF" />
      </Style>
      <Style Name="Pressed">
        <BrushLayer Name="Frame" Color="#6B4A22FF" />
      </Style>
      <Style Name="Disabled">
        <BrushLayer Name="Frame" Color="#B08A5070" />
      </Style>
    </Styles>
  </Brush>

  <!-- Button label: ink that deepens on hover, flips to parchment-light on press.
       Responds to the parent ButtonWidget's UpdateChildrenStates. -->
  <Brush Name="BandItPlus.Book.ButtonText" Font="Galahad" TextHorizontalAlignment="Center" TextVerticalAlignment="Center">
    <Layers>
    </Layers>
