<Brushes>
  <!-- intro book typography. Galahad (the medieval serif) throughout, warm
       iron-gall ink colors on the parchment art, sizes tuned to fill the spread —
       14pt left the pages looking empty. -->

  <!-- Chapter title: large, deep sepia ink with a soft outline — left-aligned
       like a true chapter heading on the left page -->
  <Brush Name="BandItPlus.Book.Title" Font="Galahad" TextHorizontalAlignment="Left" TextVerticalAlignment="Center">
    <Layers>
    </Layers>
    <Styles>
      <Style Name="Default" FontColor="#6B2E12FF" TextGlowColor="#00000000" TextOutlineColor="#3A1C0AFF" TextOutlineAmount="0.12" TextGlowRadius="0" FontSize="44" />
    </Styles>
  </Brush>

  <!-- Letter heading: the same chapter-title ink, but CENTERED — for the camp
       invitation letter. Cloned so Book.Title's left-aligned chapter headings
       stay untouched. -->
  <Brush Name="BandItPlus.Book.LetterTitle" Font="Galahad" TextHorizontalAlignment="Center" TextVerticalAlignment="Center">
    <Layers>
    </Layers>
    <Styles>
      <Style Name="Default" FontColor="#6B2E12FF" TextGlowColor="#00000000" TextOutlineColor="#3A1C0AFF" TextOutlineAmount="0.12" TextGlowRadius="0" FontSize="44" />
    </Styles>
  </Brush>

  <!-- reading body: storybook serif at a true reading size, iron-gall ink.
       the named styles are referenced from inline rich text — the engine parses
       <span style="NameInk">…</span>. names = rubric red, places = slate blue,
       numbers = grey. -->
  <Brush Name="BandItPlus.Book.Body" Font="Galahad" TextHorizontalAlignment="Left" TextVerticalAlignment="Top">
    <Layers>
    </Layers>
    <Styles>
      <Style Name="Default" FontColor="#42250FFF" TextGlowColor="#00000000" TextOutlineColor="#00000000" TextOutlineAmount="0.04" TextGlowRadius="0" FontSize="22" />
      <Style Name="NameInk" FontColor="#9B1F10FF" TextGlowColor="#00000000" TextOutlineColor="#00000000" TextOutlineAmount="0.04" TextGlowRadius="0" FontSize="22" />
      <Style Name="PlaceInk" FontColor="#3D6E8FFF" TextGlowColor="#00000000" TextOutlineColor="#00000000" TextOutlineAmount="0.04" TextGlowRadius="0" FontSize="22" />
      <Style Name="NumInk" FontColor="#6E635AFF" TextGlowColor="#00000000" TextOutlineColor="#00000000" TextOutlineAmount="0.04" TextGlowRadius="0" FontSize="22" />
      <Style Name="GoldInk" FontColor="#8A6418FF" TextGlowColor="#00000000" TextOutlineColor="#00000000" TextOutlineAmount="0.04" TextGlowRadius="0" FontSize="22" />
    </Styles>
  </Brush>

  <!-- Page mark (— 1 / 4 —): faded scribe's note -->
  <Brush Name="BandItPlus.Book.PageMark" Font="Galahad" TextHorizontalAlignment="Center" TextVerticalAlignment="Center">
    <Layers>
    </Layers>
    <Styles>
      <Style Name="Default" FontColor="#5A2A12AA" TextGlowColor="#00000000" TextOutlineColor="#00000000" TextOutlineAmount="0" TextGlowRadius="0" FontSize="20" />
    </Styles>
  </Brush>

  <!-- "Press to Continue": muted grey prompt, centered — flashed on/off via
       IsVisible once the page settles. -->
  <Brush Name="BandItPlus.Book.Continue" Font="Galahad" TextHorizontalAlignment="Center" TextVerticalAlignment="Center">
    <Layers>
    </Layers>
    <Styles>
      <Style Name="Default" FontColor="#6E6E6EFF" TextGlowColor="#00000000" TextOutlineColor="#1A1A1A60" TextOutlineAmount="0.06" TextGlowRadius="0" FontSize="22" />
    </Styles>
  </Brush>

  <!-- card-picker brushes -->

  <!-- Card BODY: dark leather panel with a subtle ornate rim; states lighten
       on hover, sink on press. Same sounds as the book buttons. -->
  <Brush Name="BandItPlus.Book.Card">
    <Layers>
      <BrushLayer Name="Fill" Sprite="BlankWhiteSquare_9" Color="#241708F8" />
      <BrushLayer Name="Rim" Sprite="button_frame_9" Color="#5A3A1A70" />
    </Layers>
    <SoundProperties>
      <EventSounds>
        <EventSound EventName="Click" Audio="panels/next" />
        <EventSound EventName="HoverBegin" Audio="tab" />
      </EventSounds>
    </SoundProperties>
    <Styles>
      <Style Name="Default">
        <BrushLayer Name="Fill" Color="#00000000" />
        <BrushLayer Name="Rim" Color="#5A3A1A70" />
      </Style>
      <Style Name="Hovered">
        <BrushLayer Name="Fill" Color="#1C110850" />
        <BrushLayer Name="Rim" Color="#CCA76AB0" />
      </Style>
      <Style Name="Pressed">
        <BrushLayer Name="Fill" Color="#0C070270" />
        <BrushLayer Name="Rim" Color="#E8B43AC0" />
      </Style>
      <Style Name="Disabled">
        <BrushLayer Name="Fill" Color="#00000000" />
        <BrushLayer Name="Rim" Color="#5A3A1A40" />
      </Style>
    </Styles>
  </Brush>

  <!-- Card title: rubric red, CENTERED, brightens with the card -->
  <Brush Name="BandItPlus.Book.CardTitleC" Font="Galahad" TextHorizontalAlignment="Center" TextVerticalAlignment="Center">
    <Layers>
    </Layers>
    <Styles>
      <Style Name="Default" FontColor="#9B1F10FF" TextGlowColor="#00000000" TextOutlineColor="#1A0E06C0" TextOutlineAmount="0.10" TextGlowRadius="0" FontSize="26" />
      <Style Name="Hovered" FontColor="#C03018FF" TextGlowColor="#00000000" TextOutlineColor="#1A0E06C0" TextOutlineAmount="0.10" TextGlowRadius="0" FontSize="26" />
      <Style Name="Pressed" FontColor="#F0E0C0FF" TextGlowColor="#00000000" TextOutlineColor="#1A0E06C0" TextOutlineAmount="0.10" TextGlowRadius="0" FontSize="26" />
    </Styles>
  </Brush>

  <!-- Card effect line: light parchment, CENTERED, with bright span inks -->
  <Brush Name="BandItPlus.Book.CardBodyC" Font="Galahad" TextHorizontalAlignment="Center" TextVerticalAlignment="Top">
    <Layers>
    </Layers>
    <Styles>
      <Style Name="Default" FontColor="#DCC094FF" TextGlowColor="#00000000" TextOutlineColor="#1A0E06C0" TextOutlineAmount="0.08" TextGlowRadius="0" FontSize="20" />
      <Style Name="Hovered" FontColor="#F0DCAEFF" TextGlowColor="#00000000" TextOutlineColor="#1A0E06C0" TextOutlineAmount="0.08" TextGlowRadius="0" FontSize="20" />
      <Style Name="Pressed" FontColor="#F0E0C0FF" TextGlowColor="#00000000" TextOutlineColor="#1A0E06C0" TextOutlineAmount="0.08" TextGlowRadius="0" FontSize="20" />
      <Style Name="GoldInk" FontColor="#E8B43AFF" TextGlowColor="#00000000" TextOutlineColor="#1A0E06C0" TextOutlineAmount="0.08" TextGlowRadius="0" FontSize="20" />
      <Style Name="NameInk" FontColor="#E06048FF" TextGlowColor="#00000000" TextOutlineColor="#1A0E06C0" TextOutlineAmount="0.08" TextGlowRadius="0" FontSize="20" />
      <Style Name="PlaceInk" FontColor="#7AB0D0FF" TextGlowColor="#00000000" TextOutlineColor="#1A0E06C0" TextOutlineAmount="0.08" TextGlowRadius="0" FontSize="20" />
    </Styles>
  </Brush>

  <!-- Card lore line: muted scribe's note, CENTERED, ignites on hover -->
  <Brush Name="BandItPlus.Book.CardLoreC" Font="Galahad" TextHorizontalAlignment="Center" TextVerticalAlignment="Top">
    <Layers>
    </Layers>
    <Styles>
      <Style Name="Default" FontColor="#8A7252FF" TextGlowColor="#00000000" TextOutlineColor="#1A0E0680" TextOutlineAmount="0.06" TextGlowRadius="0" FontSize="16" />
      <Style Name="Hovered" FontColor="#E0C896FF" TextGlowColor="#00000000" TextOutlineColor="#1A0E06A0" TextOutlineAmount="0.06" TextGlowRadius="0" FontSize="16" />
      <Style Name="Pressed" FontColor="#F0E0C0FF" TextGlowColor="#00000000" TextOutlineColor="#1A0E06A0" TextOutlineAmount="0.06" TextGlowRadius="0" FontSize="16" />
      <Style Name="Disabled" FontColor="#5E4E3A80" TextGlowColor="#00000000" TextOutlineColor="#1A0E0640" TextOutlineAmount="0.05" TextGlowRadius="0" FontSize="16" />
    </Styles>
  </Brush>

  <!-- Campaign-start cinematic title cards -->
  <Brush Name="BandItPlus.Book.CinematicTitle" Font="Galahad" TextHorizontalAlignment="Center" TextVerticalAlignment="Center">
    <Layers>
    </Layers>
    <Styles>
      <Style Name="Default" FontColor="#E8B43AFF" TextGlowColor="#00000000" TextOutlineColor="#1A0E06E0" TextOutlineAmount="0.14" TextGlowRadius="0" FontSize="58" />
