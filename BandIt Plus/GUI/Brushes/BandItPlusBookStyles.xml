      <Style Name="Hovered" FontColor="#E05838FF" TextGlowColor="#00000000" TextOutlineColor="#1A0E06C0" TextOutlineAmount="0.10" TextGlowRadius="0" FontSize="16" />
      <Style Name="Pressed" FontColor="#FF7048FF" TextGlowColor="#00000000" TextOutlineColor="#1A0E06C0" TextOutlineAmount="0.10" TextGlowRadius="0" FontSize="16" />
    </Styles>
  </Brush>

  <!-- Light button label for stamps sitting on DARK panels (contact panel) -->
  <Brush Name="BandItPlus.Book.ButtonTextLight" Font="Galahad" TextHorizontalAlignment="Center" TextVerticalAlignment="Center">
    <Layers>
    </Layers>
    <Styles>
      <Style Name="Default" FontColor="#DCC094FF" TextGlowColor="#00000000" TextOutlineColor="#1A0E06C0" TextOutlineAmount="0.10" TextGlowRadius="0" FontSize="22" />
      <Style Name="Hovered" FontColor="#F0DCAEFF" TextGlowColor="#00000000" TextOutlineColor="#1A0E06C0" TextOutlineAmount="0.10" TextGlowRadius="0" FontSize="22" />
      <Style Name="Pressed" FontColor="#FFF0D0FF" TextGlowColor="#00000000" TextOutlineColor="#1A0E06C0" TextOutlineAmount="0.10" TextGlowRadius="0" FontSize="22" />
      <Style Name="Disabled" FontColor="#6E5A4290" TextGlowColor="#00000000" TextOutlineColor="#1A0E0660" TextOutlineAmount="0.08" TextGlowRadius="0" FontSize="22" />
    </Styles>
  </Brush>

  <!-- ✦ CHOSEN ✦ seal on the selected card -->
  <Brush Name="BandItPlus.Book.ChosenMark" Font="Galahad" TextHorizontalAlignment="Center" TextVerticalAlignment="Center">
    <Layers>
    </Layers>
    <Styles>
      <Style Name="Default" FontColor="#E8B43AFF" TextGlowColor="#00000000" TextOutlineColor="#1A0E06C0" TextOutlineAmount="0.12" TextGlowRadius="0" FontSize="18" />
    </Styles>
  </Brush>

  <!-- Origin card title: rubric red, chapter-heading weight -->
  <Brush Name="BandItPlus.Book.CardTitle" Font="Galahad" TextHorizontalAlignment="Left" TextVerticalAlignment="Center">
    <Layers>
    </Layers>
    <Styles>
      <Style Name="Default" FontColor="#9B1F10FF" TextGlowColor="#00000000" TextOutlineColor="#3A1C0AFF" TextOutlineAmount="0.10" TextGlowRadius="0" FontSize="30" />
      <Style Name="Hovered" FontColor="#B82A16FF" TextGlowColor="#00000000" TextOutlineColor="#3A1C0AFF" TextOutlineAmount="0.10" TextGlowRadius="0" FontSize="30" />
      <Style Name="Pressed" FontColor="#F0E0C0FF" TextGlowColor="#00000000" TextOutlineColor="#3A1C0AFF" TextOutlineAmount="0.10" TextGlowRadius="0" FontSize="30" />
    </Styles>
  </Brush>

  <!-- Origin card BODY text: light parchment on the dark frame inner, with
       bright variants of the ink spans (the page inks are too dark here).
       Style names match the rich text spans (GoldInk etc). -->
  <Brush Name="BandItPlus.Book.CardBody" Font="Galahad" TextHorizontalAlignment="Left" TextVerticalAlignment="Top">
    <Layers>
    </Layers>
    <Styles>
      <Style Name="Default" FontColor="#DCC094FF" TextGlowColor="#00000000" TextOutlineColor="#1A0E06C0" TextOutlineAmount="0.08" TextGlowRadius="0" FontSize="21" />
      <Style Name="Hovered" FontColor="#F0DCAEFF" TextGlowColor="#00000000" TextOutlineColor="#1A0E06C0" TextOutlineAmount="0.08" TextGlowRadius="0" FontSize="21" />
      <Style Name="Pressed" FontColor="#F0E0C0FF" TextGlowColor="#00000000" TextOutlineColor="#1A0E06C0" TextOutlineAmount="0.08" TextGlowRadius="0" FontSize="21" />
      <Style Name="GoldInk" FontColor="#E8B43AFF" TextGlowColor="#00000000" TextOutlineColor="#1A0E06C0" TextOutlineAmount="0.08" TextGlowRadius="0" FontSize="21" />
      <Style Name="NameInk" FontColor="#E06048FF" TextGlowColor="#00000000" TextOutlineColor="#1A0E06C0" TextOutlineAmount="0.08" TextGlowRadius="0" FontSize="21" />
