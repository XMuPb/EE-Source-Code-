  </Brush>
  <Brush Name="BandItPlus.Book.TagMedium" Font="Galahad" TextHorizontalAlignment="Center" TextVerticalAlignment="Center">
    <Layers>
    </Layers>
    <Styles>
      <Style Name="Default" FontColor="#D9A33CFF" TextGlowColor="#00000000" TextOutlineColor="#1A0E06C0" TextOutlineAmount="0.10" TextGlowRadius="0" FontSize="16" />
      <Style Name="Hovered" FontColor="#F0C45CFF" TextGlowColor="#00000000" TextOutlineColor="#1A0E06C0" TextOutlineAmount="0.10" TextGlowRadius="0" FontSize="16" />
      <Style Name="Pressed" FontColor="#FFD878FF" TextGlowColor="#00000000" TextOutlineColor="#1A0E06C0" TextOutlineAmount="0.10" TextGlowRadius="0" FontSize="16" />
