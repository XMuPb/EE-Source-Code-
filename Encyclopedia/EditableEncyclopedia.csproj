    <MakeDir Directories="$(ModuleFolder)\LoreStory\RumorsAndSecrets" />
    <Copy SourceFiles="@(LoreStoryRoot)" DestinationFolder="$(ModuleFolder)\LoreStory" />
    <Copy SourceFiles="@(LoreStoryBackstory)" DestinationFolder="$(ModuleFolder)\LoreStory\Backstory" />
    <Copy SourceFiles="@(LoreStoryPersonality)" DestinationFolder="$(ModuleFolder)\LoreStory\Personality" />
